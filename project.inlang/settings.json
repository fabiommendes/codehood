{
	"$schema": "https://inlang.com/schema/project-settings",
	"baseLocale": "en",
	"locales": ["en", "pt-BR"],
	"modules": ["./node_modules/@inlang/plugin-message-format/dist/index.js"],
	"plugin.inlang.messageFormat": {
		"pathPattern": [
			"./messages/{locale}/admin.json",
			"./messages/{locale}/attendance.json",
			"./messages/{locale}/auth.json",
			"./messages/{locale}/common.json",
			"./messages/{locale}/courses.json",
			"./messages/{locale}/emails.json",
			"./messages/{locale}/errors.json",
			"./messages/{locale}/exams.json",
			"./messages/{locale}/forms.json",
			"./messages/{locale}/grades.json",
			"./messages/{locale}/nav.json",
			"./messages/{locale}/profile.json",
			"./messages/{locale}/questions.json",
			"./messages/{locale}/schedule.json"
		]
	}
}
