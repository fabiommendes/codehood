DATABASE_URL="file:./dev.db"

# Required, no default: "dev" or "prod". A deployed instance must set "prod",
# which turns off the demo-account seed and makes the session cookie Secure.
ENVIRONMENT="dev"

# Optional: the instance configuration file, relative to the project root.
# Unset uses codehood.config.ts, where the address, locale, time zone, runner
# origin and storage settings live (see "Configuration" in README.md).
# CODEHOOD_CONFIG="deploy/codehood.config.ts"

# Read by the default codehood.config.ts at every boot: the format of school
# ids at this institution, as a regex over the whole id. Unset accepts any id.
# SCHOOL_ID_PATTERN="[0-9]{9}"
