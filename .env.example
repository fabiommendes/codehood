DATABASE_URL="file:./dev.db"

# Required, no default: "dev" or "prod". A deployed instance must set "prod",
# which turns off the demo-account seed and makes the session cookie Secure.
ENVIRONMENT="dev"

# Optional, defaults to "America/Sao_Paulo" — the zone every instant is
# rendered in. Declared via astro:env (astro.config.mjs), so it
# is baked into the build; changing it needs a rebuild, not just a restart.
# Distinct from Node's own `TZ`: setting `TZ` here has no effect on this.
# SERVER_TZ="America/Sao_Paulo"

# Build time, deployments only: the instance's public address. The server then
# trusts the reverse proxy's X-Forwarded-* headers for this host.
# PUBLIC_URL="https://codehood.example.org"

# Origin the code runner is served from (https, not the PUBLIC_URL origin). Read
# at build and run time. Unset in production, code execution is off. In dev it
# defaults to PUBLIC_URL on the other loopback name (localhost <-> 127.0.0.1).
# RUNNER_ORIGIN="https://runner.example.net"

# Build time: the locale the build is compiled for (en, pt-BR). Unset uses the
# base locale. An unknown value fails the build.
# CODEHOOD_LOCALE="pt-BR"

# Optional: the format of school ids at this institution, as a regex matched
# against the whole id. Unset accepts letters, digits, '.', '_' and '-'.
# SCHOOL_ID_PATTERN="[0-9]{9}"
