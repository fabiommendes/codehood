{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "es2024",
		"strict": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"incremental": true,
		"noUncheckedIndexedAccess": true,
		// "noImplicitReturns": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@/*": ["./src/*"],
			"@prisma/*": ["./node_modules/.prisma/client/*"],
			// Outside a bundle (tsx, Playwright, tsc). Bundles resolve these ids
			// first, through src/config/integration.ts and scripts/build-manage.ts.
			"codehood:config": ["./src/config/current.ts"],
			"codehood:build": ["./src/config/build-node.ts"],
			"codehood:runners": ["./src/runner/registry-node.ts"],
			// `mdq` is linked from a sibling checkout with its own node_modules:
			// its types must see the same zod and Solid as this project.
			"zod": ["./node_modules/zod"],
			"zod/*": ["./node_modules/zod/*"],
			"solid-js": ["./node_modules/solid-js"],
			"solid-js/*": ["./node_modules/solid-js/*"]
		}
	},
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "tmp", "src/runner/plugins/elm/packages"]
}
