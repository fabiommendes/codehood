{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "es2024",
		"strict": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"incremental": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@/*": ["./src/*"],
			"@prisma/*": ["./node_modules/.prisma/client/*"]
		}
	},
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"]
}
