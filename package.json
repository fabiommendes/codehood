{
	"name": "codehood-server",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "pnpm run generate && astro dev",
		"build": "pnpm run generate && astro build",
		"preview": "astro preview",
		"manage": "tsx src/commands/index.ts",
		"generate": "pnpm run route-patterns && pnpm run openapi && pnpm run question-models",
		"openapi": "tsx scripts/generate-openapi.ts",
		"question-models": "tsx scripts/generate-question-models.ts",
		"sidebar-art": "tsx scripts/generate-sidebar-art.ts",
		"route-patterns": "tsx scripts/generate-route-patterns.ts",
		"clear": "node scripts/clean.mjs",
		"init": "node scripts/init.mjs",
		"seed": "prisma db push && prisma db seed",
		"db-reset": "rm -f dev.db && prisma db push && prisma db seed",
		"test": "tsx test/run.ts",
		"test-e2e": "tsx test/run.ts",
		"test-ui": "tsx test/run.ts --ui",
		"ui-report": "playwright show-report",
		"lint:fix": "biome format src test scripts --write && biome lint src test scripts .vscode --write",
		"lint": "biome ci .",
		"coverage": "COVERAGE=1 c8 --reporter=lcov --reporter=text-summary --exclude 'src/generated/**' --exclude 'test/**' --exclude 'prisma/**' --exclude 'scripts/**' --exclude '**/*.config.*' -- tsx test/run.ts",
		"studio": "pnpm prisma studio --url file://./dev.db",
		"astro": "astro"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.1.0",
		"@astrojs/node": "^11.1.4",
		"@astrojs/solid-js": "^7.0.2",
		"@faker-js/faker": "^10.6.0",
		"@inquirer/prompts": "^8.6.0",
		"@node-rs/argon2": "^2.1.0",
		"@prisma/adapter-better-sqlite3": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"astro": "^7.2.6",
		"commander": "^15.0.0",
		"dotenv": "^17.4.2",
		"markdown-it": "^15.0.0",
		"nanoid": "^6.0.1",
		"reflect-metadata": "^0.2.2",
		"shiki": "^4.4.3",
		"solid-js": "^1.9.15",
		"swagger-ui-dist": "^5.32.14",
		"wildleek": "^2.0.0",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.10",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/express": "^5.0.6",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.3.0",
		"@types/supertest": "^7.2.1",
		"@types/swagger-ui-dist": "^3.30.6",
		"@vitest/coverage-v8": "^5.0.0",
		"c8": "^12.0.0",
		"daisyui": "^5.7.22",
		"prisma": "7.10.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
