{
	"name": "codehood-server",
	"type": "module",
	"version": "0.3.2",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"description": "Server for Codehood, an LMS for geeky types.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fabiommendes/codehood.git"
	},
	"homepage": "https://github.com/fabiommendes/codehood",
	"bugs": "https://github.com/fabiommendes/codehood/issues",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "ENVIRONMENT=dev pnpm run generate && ENVIRONMENT=dev LOG_ENV=true astro dev",
		"build": "pnpm run generate && astro build && tsx scripts/build-manage.ts",
		"preview": "astro preview",
		"manage": "tsx src/commands/index.ts",
		"generate": "tsx scripts/compile-messages.ts && pnpm run route-patterns",
		"brand": "tsx scripts/generate-brand.ts",
		"route-patterns": "tsx scripts/generate-route-patterns.ts",
		"clear": "node scripts/clean.mjs",
		"init": "node scripts/init.mjs",
		"db:seed": "prisma db push && prisma db seed",
		"db:migrate": "tsx scripts/migrations.ts",
		"release": "tsx scripts/release.ts",
		"package": "tsx scripts/package.ts",
		"db:reset": "rm -f dev.db && prisma db push && prisma db seed",
		"db:seed:cli": "tsx scripts/seed-cli.ts",
		"db:generate": "prisma generate && tsx scripts/brand-generated-types.ts",
		"test": "tsx test/run.ts",
		"test:unit": "tsx test/run.ts --scope=unit",
		"test:e2e": "tsx test/run.ts --scope=e2e",
		"test:runner": "playwright test -c packages/runner/playwright.config.ts",
		"test:plugins": "playwright test -c src/runner/plugins/playwright.config.ts",
		"test-ui": "tsx test/run.ts --ui",
		"ui-report": "playwright show-report",
		"lint:fix": "biome check --write .",
		"lint": "biome ci . && tsx scripts/i18n-check.ts && pnpm run typecheck && pnpm run stories --check",
		"typecheck": "tsx scripts/compile-messages.ts && tsc --noEmit && astro sync && tsx scripts/astro-check.ts",
		"stories": "tsx scripts/story-coverage.ts",
		"coverage": "COVERAGE=1 c8 --reporter=lcov --reporter=text-summary --exclude 'src/generated/**' --exclude 'test/**' --exclude 'prisma/**' --exclude 'scripts/**' --exclude '**/*.config.*' -- tsx test/run.ts",
		"studio": "pnpm prisma studio --url file://./dev.db",
		"astro": "astro"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.1.0",
		"@astrojs/node": "^11.1.4",
		"@astrojs/solid-js": "^7.0.2",
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/language": "6.13.1",
		"@codemirror/legacy-modes": "6.5.5",
		"@codemirror/lint": "6.9.7",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@inlang/plugin-message-format": "^4.5.4",
		"@inquirer/prompts": "^8.6.0",
		"@lezer/highlight": "1.2.5",
		"@node-rs/argon2": "^2.1.0",
		"@prisma/adapter-better-sqlite3": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@replit/codemirror-vscode-keymap": "6.0.2",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-web-links": "0.12.0",
		"@xterm/xterm": "6.0.0",
		"acorn": "8.18.0",
		"astro": "^7.2.6",
		"commander": "^15.0.0",
		"dotenv": "^17.4.2",
		"guida": "1.0.0-beta.2",
		"markdown-it": "^15.0.0",
		"modern-screenshot": "^4.7.0",
		"nanoid": "^6.0.1",
		"prisma": "7.10.0",
		"pyodide": "314.0.7",
		"reflect-metadata": "^0.2.2",
		"shiki": "^4.4.3",
		"solid-js": "^1.9.15",
		"sucrase": "3.35.1",
		"swagger-ui-dist": "^5.32.14",
		"swipl-wasm": "8.2.6",
		"temporal-polyfill": "^1.0.5",
		"uqr": "^0.1.3",
		"wasmoon": "1.16.0",
		"wildleek": "^2.0.0",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/language-server": "2.16.15",
		"@biomejs/biome": "^2.5.10",
		"@codehood/runner": "workspace:*",
		"@codehood/runner-api": "workspace:*",
		"@faker-js/faker": "^10.6.0",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/express": "^5.0.6",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.3.0",
		"@types/supertest": "^7.2.1",
		"@types/swagger-ui-dist": "^3.30.6",
		"@vitest/coverage-v8": "^5.0.0",
		"c8": "^12.0.0",
		"daisyui": "^5.7.22",
		"esbuild": "^0.28.2",
		"fast-check": "^4.10.0",
		"fishery": "^2.4.0",
		"mdq": "link:../mdq/mdq-js",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"typescript-6": "npm:typescript@^6.0.3",
		"vite-node": "^6.0.0",
		"vitest": "^5.0.0"
	}
}
