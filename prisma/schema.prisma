/// General guidelines
/// 
/// * No UUIDs as primary keys: auto-incrementing integers are simpler and
///   more efficient. This is not a distributed system, so no coordination is 
///   needed.
/// * Most models should have some sort of Natural Key. It is not necessarely the
///   primary key in the database, but something that can uniquely identify the 
///   record with only user-visible information. The REST Api should use this.
/// * Public-facing identifiers should be separate from the primary key and unique.
/// * Sometimes we want a "public-facing" identifier in URLs slugs but no natural
///   key exists. In those cases, use a separate `publicId` field
///   with a unique constraint. We default to it being a random string of 10 
///   URL-safe characters. It must be generated in the service layer with something like
///   `nanoid(10)` since the DB cannot do it itself.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

//==============================================================================
// Auth system
//==============================================================================
enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum ApiKeyKind {
  CLI
  BOT
}

enum InviteKind {
  PERSONAL
  CLASSROOM
}

model User {
  // Basic indentification and credentials
  username     String @id @unique
  name         String
  passwordHash String
  role         Role

  // Additional required fields for the system
  email String @unique

  // Soft-nullable. @unique fields cannot be null, but those have unique sentinel
  // values that effectively make them nullable. The database value is not nullable,
  // but service code should convert them back to null's. 
  // Both for schoolId and githubId, the null sentinel is `!<username>`.
  schoolId String @unique
  githubId String @unique

  image     String?
  createdAt DateTime @default(now())

  apiKeys          ApiKey[]
  invitesSent      Invite[]          @relation("InviteCreatedBy")
  redemption       InviteRedemption?
  sessions         Session[]
  groupMemberships GroupMembership[]
  courses          Course[]
  enrollments      Enrollment[]
  attachments      Attachment[]
  responses        Response[]
  exams            Exam[]
  feedbacks        Feedback[]
}

model Group {
  id       Int    @id @default(autoincrement())
  publicId String @unique
  name     String

  members      GroupMembership[]
  questionRefs QuestionRef[]
}

/// M2M relation table linking users to groups.
model GroupMembership {
  id Int @id @default(autoincrement())

  groupId Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  user     User   @relation(fields: [username], references: [username], onDelete: Cascade)
  username String

  isAdmin Boolean @default(false)

  @@unique([groupId, username])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  username String
  user     User   @relation(fields: [username], references: [username], onDelete: Cascade)
}

model ApiKey {
  // AUDIT: is it vulnerable to enumeration attacks?
  id       Int        @id @default(autoincrement())
  publicId String     @unique
  keyHash  String     @unique
  name     String
  kind     ApiKeyKind

  // User who owns this key.
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [username], onDelete: Cascade)

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Invite {
  // AUDIT: is it vulnerable to enumeration attacks?
  id        Int        @id @default(autoincrement())
  publicId  String     @unique
  tokenHash String     @unique
  kind      InviteKind

  /// Role assigned to users who redeem this invite.
  invitedRole Role
  maxUses     Int?
  email       String?

  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id])

  createdById String
  createdBy   User   @relation("InviteCreatedBy", fields: [createdById], references: [username])

  createdAt DateTime @default(now())
  expiresAt DateTime

  redemptions InviteRedemption[]
}

model InviteRedemption {
  // AUDIT: is it vulnerable to enumeration attacks?
  id Int @id @default(autoincrement())

  inviteId Int
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  /// User who redeemed the invite.
  user     User   @relation(fields: [username], references: [username])
  username String @unique

  redeemedAt DateTime @default(now())
}

// =============================================================================
// Blob storage
// =============================================================================

/// Anonymous file content, deduped by the sha-256 of its own bytes. Carries no
/// name and no mime type: those belong to each Attachment, because the same
/// bytes may be used under different names by different owners.
/// See dev/specs/to-do/blob-attachments.md.
model Blob {
  /// Lowercase-hex sha-256 of the bytes. Identity, URL token and on-disk
  /// directory, all one value.
  hash String @id

  size Int

  /// Set when the bytes are removed from disk; the row survives as a
  /// tombstone so the URL can explain itself instead of 404ing (FR-SYNC-013,
  /// FR-SYNC-015).
  deletedAt DateTime?

  createdAt   DateTime     @default(now())
  attachments Attachment[]
}

enum AttachmentOwner {
  RESOURCE
  QUESTION
}

/// One use of a Blob by one owner, carrying the filename and mime type that
/// use is served under, plus the user charged for the bytes.
model Attachment {
  id   Int    @id @default(autoincrement())
  hash String
  blob Blob   @relation(fields: [hash], references: [hash], onDelete: Cascade)

  /// Sanitised: a bare basename, also used as the on-disk link name and as
  /// the last segment of the blob URL.
  filename String

  /// Per use-site, never per bytes. Same file can be served under different 
  /// names by different owners. e.g., an empty text file can be basically 
  /// anything that is text-based.
  mimeType String

  /// Charged for these bytes. Nullable so deleting a user does not delete the
  /// material they uploaded; the quota charge leaves with them.
  uploaderId String? @map("uploaderUsername")
  uploader   User?   @relation(fields: [uploaderId], references: [username], onDelete: SetNull)

  /// Polymorphic owner. SQLite cannot cascade this, so every owner service
  /// detaches in its own delete.
  attachedToType AttachmentOwner
  attachedToId   Int

  createdAt DateTime   @default(now())
  resources Resource[]

  @@unique([hash, filename, attachedToType, attachedToId])
  @@index([attachedToType, attachedToId])
  @@index([hash])
  @@index([uploaderId])
}

// =============================================================================
// Course related Models
// =============================================================================
enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum EventKind {
  REGULAR
  HOLIDAY
  CANCELLED
}

model Course {
  id          Int     @id @default(autoincrement())
  description String?

  disciplineSlug String
  discipline     Discipline @relation(fields: [disciplineSlug], references: [slug])

  editionSlug String  @map("edition")
  edition     Edition @relation(fields: [editionSlug], references: [slug])

  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [username])

  /// Revision marker supplied by the writer, opaque to the server.
  rev String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startAt DateTime
  endAt   DateTime

  schedule           TimeSlot[]
  events             CalendarEvent[]
  passphrases        Passphrase[]
  exams              Exam[]
  questionForCourses QuestionForCourse[]
  questions          QuestionRef[]
  enrollments        Enrollment[]
  resources          Resource[]
  invites            Invite[]

  @@unique([disciplineSlug, instructorId, editionSlug])
}

model Discipline {
  slug      String   @id
  name      String
  createdAt DateTime @default(now())

  courses Course[]
}

/// An academic term, managed by admins. `slug` is the token that appears in
/// every course URL (`/cs101/ada_2026-1`), so it is immutable once courses
/// reference it. The window (`startAt`..`endAt`) says when new courses may be
/// created for this edition; it never affects courses that already exist.
model Edition {
  slug      String   @id
  name      String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())

  courses Course[]
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

model Enrollment {
  id     Int              @id @default(autoincrement())
  status EnrollmentStatus @default(ACTIVE)

  username String
  user     User   @relation(fields: [username], references: [username], onDelete: Cascade)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([username, courseId])
}

model Passphrase {
  id Int @id @default(autoincrement())

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  value String @unique

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TimeSlot {
  id Int @id @default(autoincrement())

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Authored: `mon`, `wed-lab`. Stable when the hour changes.
  slug String

  /// Optional label for the syllabus line: "Lecture", "Lab".
  title String?

  day         Weekday
  startMin    Int
  durationMin Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]

  @@unique([courseId, slug])
  @@unique([id, courseId])
}

model CalendarEvent {
  id          Int       @id @default(autoincrement())
  kind        EventKind @default(REGULAR)
  title       String
  description String?

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  timeSlotId Int
  timeSlot   TimeSlot @relation(fields: [timeSlotId, courseId], references: [id, courseId])

  startAt DateTime

  /// Denormalized from the associated time slot. MUST never go out of sync.
  durationMin Int

  /// Week relative to the start of the course. 
  /// First week is 0, week starts at MONDAY (ISO 8601).
  week Int

  /// Revision marker supplied by the writer, opaque to the server.
  rev String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, week, timeSlotId])
  @@index([courseId, startAt])
}

enum ResourceType {
  /// External links
  LINK

  /// Files uploaded to the system. If the file is a supported media type 
  /// (image, audio, video, pdf), it will be displayed inline in the browser.
  FILE

  /// Source code snippets, with syntax highlighting.
  CODE

  /// Markdown content, rendered as HTML in the browser.
  MD
}

/// Resource is modelled after the folowing struct:
///
///   type Resource = {
///     id: string
///     title: string
///     description?: string
///     contentHash: string
///     data: ResourceData
///   }
///
///   type ResourceData
///       = { type: "LINK", url: string }
///       | { type: "FILE", attachmentId: string }
///       | { type: "MD", content: string }
///       | { type: "CODE", content: string, language: string }
///
/// This cannot be represeted cleanly in the DB, hence we denormalize some
/// fields in a table.
model Resource {
  id   Int          @id @default(autoincrement())
  type ResourceType

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Natural key from the repository path
  slug String

  title       String
  description String?

  /// Url, for LINK resources, content for MD and CODE resources. Null for FILE resources.
  data String?

  /// Language, for CODE resources. Null for LINK, FILE and MD resources.
  extra String?

  attachmentId Int?
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])

  /// Revision marker supplied by the writer, opaque to the server.
  rev String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, slug])
  @@index([courseId, type])
}

// =============================================================================
// Question Models
// =============================================================================
enum QuestionStatus {
  DRAFT
  ARCHIVED
  PUBLISHED
}

/// The set of question types the server supports. Mirrors mdq's discriminator
/// (`multiple-choice`, ...), which cannot be spelled here because a Prisma enum
/// value takes no hyphen; `src/core/schemas/question.ts` pins the two sets together.
enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECTION
  TRUE_FALSE
  ESSAY
  NUMERIC
  SHORT_ANSWER
  FILL_IN
}

/// A QuestionRef is the main entity representing a unique question in the system.
/// It holds metadata about the question, including its author, status, type,
/// and a reference to its latest version of content stored in QuestionData.
///
/// QuestionData lives in a separate table to allow for versioning of question 
/// content. Each time a question is edited, a new QuestionData entry is created,
/// and the QuestionRef.latestId is updated to point to the new version. This
/// allows us to maintain a history of changes while keeping the main question
/// entity lightweight and focused on metadata.
///
/// This also means that exams can reference specific question versions if needed,
/// ensuring that the content remains consistent even if the question is updated
/// later on.
model QuestionRef {
  id       Int    @id @default(autoincrement())
  publicId String @unique
  slug     String

  status QuestionStatus @default(DRAFT)
  type   QuestionType

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  latestId Int?
  latest   QuestionData? @relation(fields: [latestId], references: [id], name: "latestVersion")

  /// Revision marker supplied by the writer, opaque to the server.
  rev String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions           QuestionData[]
  questionTags       QuestionTags[]
  questionsForExams  QuestionsForExam[]
  questionForCourses QuestionForCourse[]
  group              Group?              @relation(fields: [groupId], references: [id])
  groupId            Int?
  submissions        Submission[]

  @@unique([slug, courseId])
}

model QuestionData {
  id          Int    @id @default(autoincrement())
  versionHash String

  refId Int
  ref   QuestionRef @relation(fields: [refId], references: [id])

  title String
  stem  String

  /// What a student may see, stored on its own so a student-facing read never
  /// selects the other half. Reassembled with `privatePayload` for grading.
  publicPayload  Json
  /// Everything the public half leaves out: the answer key, per-choice scores
  /// and feedback, instructor comments.
  privatePayload Json

  createdAt DateTime @default(now())

  refAsLatest QuestionRef[] @relation(name: "latestVersion")

  @@unique([refId, versionHash])
}

model QuestionTags {
  questionId Int
  question   QuestionRef @relation(fields: [questionId], references: [id])

  tag String

  @@id([questionId, tag])
}

model QuestionForCourse {
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  questionId Int
  question   QuestionRef @relation(fields: [questionId], references: [id])

  version String?

  @@id([courseId, questionId])
}

// =============================================================================
// Response Models
// =============================================================================
enum SubmissionStatus {
  PENDING_GRADE
  WILL_NOT_GRADE
  GRADED_AUTOMATICALLY
  GRADED_MANUALLY
}

/// One student's attempt at an exam. Collects the submissions they make for
/// each question in it.
model Response {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  /// If false, new submissions are not accepted.
  acceptingSubmissions Boolean @default(true)

  authorId String
  author   User   @relation(fields: [authorId], references: [username])

  examId Int
  exam   Exam @relation(fields: [examId], references: [id])

  /// Which attempt at `exam` this is. Zero for a graded exam, which a student
  /// answers once; the session's start as a unix timestamp in seconds for a
  /// practice exam, which they may attempt as often as they like.
  ///
  /// A plain column rather than a nullable date so the unique index below
  /// actually constrains both cases: SQLite treats a null in a unique tuple as
  /// distinct from every other null, and would let duplicates through.
  slotKey Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]

  @@unique([authorId, examId, slotKey])
  @@map("ResponseRef")
}

/// One student's attempt at a single question, within their response to an exam.
model Submission {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  /// The UI may submit on the student behalf. This can be used for backup and
  /// tracking student progress in the question resolution.
  automaticallyTriggered Boolean @default(false)

  status SubmissionStatus @default(PENDING_GRADE)

  responseId Int
  response   Response @relation(fields: [responseId], references: [id])

  questionId Int
  question   QuestionRef @relation(fields: [questionId], references: [id])

  payload Json

  /// When the student started working on this submission. Not always available.
  startedAt DateTime?
  createdAt DateTime  @default(now())

  feedbacks Feedback[]
}

/// Feedback provided for a submission, either by a human grader or an 
/// automated bot.
model Feedback {
  id Int @id @default(autoincrement())

  /// Supplied by the writer, opaque to the server. The public half of the
  /// natural key: unique within the submission and addressed directly in URLs.
  ref String

  /// The attempt being graded. A submission may collect more than one, e.g. a
  /// bot's grade followed by the instructor's revision.
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// String to represent exact decimal or fractional values.
  /// This is a number between -1 and 1 (although usually non-negative).
  score String

  /// User responsible for grading this submission.
  /// Null if the grading was done automatically in the Codehood system.
  graderId String?
  grader   User?   @relation(fields: [graderId], references: [username])

  /// This is used to identify the bot that provided automated feedback and grade
  /// for this submission. Null for human-graded submissions.
  botId String?

  feedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, ref])
}

// =============================================================================
// Exam Models
// =============================================================================
enum ExamStatus {
  /// Exam is being created, and not yet public.
  DRAFT

  /// Exam is no longer visible to students.
  ARCHIVED

  /// Exam is public, but not yet started.
  /// A Scheduled exam with no `scheduledAt` is pending a manual approval by
  /// an instructor.
  ///
  /// Students can see the title and description of an scheduled exam, but
  /// cannot view questions or submit responses until it starts.
  SCHEDULED

  /// Exam is currently ongoing, and open for submissions.
  ONGOING

  /// Exam has ended, and is no longer accepting submissions. But it is still
  /// public and visible to students.
  COMPLETED
}

enum ExamType {
  /// A practice exam used for self-assessment and learning. Practice exams are 
  /// not graded and students have immediate feedback and access to the answer key.
  /// Students can attempt practice exams multiple times.
  PRACTICE

  /// A quiz is a short assessment, typically covering a limited set of topics.
  /// Quizzes are graded and students receive feedback after submission.
  QUIZ

  /// A full-length exam covering a broader range of topics. Exams are graded and
  /// students receive feedback only after the exam has ended and instructor
  /// has released the grades.
  EXAM
}

enum TextFormat {
  PLAINTEXT
  MARKDOWN
  HTML
}

model Exam {
  id Int @id @default(autoincrement())

  /// Exam cannot change its type once created.
  type ExamType @default(EXAM)

  /// Current status of the exam.
  status ExamStatus @default(DRAFT)
  slug   String

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  title       String
  description String?
  preamble    String?
  format      TextFormat @default(MARKDOWN)

  scheduledAt DateTime?
  durationMs  Int?
  /// Extra time granted on top of durationMs (FR-EXAM-020/022), part of the
  /// exam's window for the calendar-link match in src/db/exam-link.ts.
  extraTimeMs Int       @default(0)

  /// When the instructor released this exam's grades to its students. Null
  /// until they do. Only consulted for an `EXAM`: a `PRACTICE` releases a
  /// score as soon as it is written and a `QUIZ` when its window closes.
  gradesReleasedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [username])

  /// Revision marker supplied by the writer, opaque to the server.
  rev String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examTags          ExamTags[]
  questionsForExams QuestionsForExam[]
  responses         Response[]

  @@unique([courseId, slug])
}

/// A M2M relation table linking Exams to their Questions (QuestionRefs).
/// This relation also specifies which version of the question was used in each 
/// exam.
model QuestionsForExam {
  examId Int
  exam   Exam @relation(fields: [examId], references: [id])

  questionRefId Int
  questionRef   QuestionRef @relation(fields: [questionRefId], references: [id])

  version String?

  @@id([examId, questionRefId])
}

model ExamTags {
  examId Int
  exam   Exam @relation(fields: [examId], references: [id])

  tag String

  @@id([examId, tag])
}
