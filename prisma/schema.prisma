generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

//==============================================================================
// Auth system
//==============================================================================
enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum ApiKeyKind {
  CLI
  BOT
}

enum InviteKind {
  PERSONAL
  CLASSROOM
}

model User {
  id               Int               @id @default(autoincrement())
  publicId         String            @unique
  username         String            @unique
  email            String            @unique
  schoolId         String            @unique
  githubId         String            @unique
  name             String
  passwordHash     String
  role             Role
  image            String?
  createdAt        DateTime          @default(now())
  apiKeys          ApiKey[]
  invitesSent      Invite[]          @relation("InviteCreatedBy")
  redemption       InviteRedemption?
  sessions         Session[]
  groupMemberships GroupMembership[]
  courses          Course[]
  enrollments      Enrollment[]
  questionRefs     QuestionRef[]
  responses        Response[]
  submissions      Submission[]
  exams            Exam[]
}

model Group {
  id       Int    @id @default(autoincrement())
  publicId String @unique
  name     String

  members      GroupMembership[]
  questionRefs QuestionRef[]
}

model GroupMembership {
  id Int @id @default(autoincrement())

  groupId Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  isAdmin Boolean @default(false)

  @@unique([groupId, userId])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         Int        @id @default(autoincrement())
  keyHash    String     @unique
  name       String
  kind       ApiKeyKind
  userId     Int
  lastUsedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id          Int                @id @default(autoincrement())
  tokenHash   String             @unique
  kind        InviteKind
  email       String?
  role        Role
  courseId    Int?
  maxUses     Int?
  expiresAt   DateTime
  createdById Int
  createdAt   DateTime           @default(now())
  createdBy   User               @relation("InviteCreatedBy", fields: [createdById], references: [id])
  redemptions InviteRedemption[]
}

model InviteRedemption {
  id         Int      @id @default(autoincrement())
  inviteId   Int
  userId     Int      @unique
  redeemedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  invite     Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
}

//==============================================================================
// System data
//==============================================================================
model File {
  id Int @id @default(autoincrement())

  /// A hash of the file contents used as a slug part when creating urls for the
  /// file. This is used to derive URLs and also to store the file in the
  /// filesystem.
  slugHash String @unique

  mimeType String
  size     Int

  /// Set when the bytes are removed from disk; the row survives as a
  /// tombstone so the URL can explain itself instead of 404ing (FR-SYNC-013,
  /// FR-SYNC-015).
  deletedAt DateTime?

  createdAt DateTime   @default(now())
  resources Resource[]
}

// =============================================================================
// Course related Models
// =============================================================================
enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum EventKind {
  LECTURE
  LAB
  EXAM
  REVIEW
  SEMINAR
  PROJECT
  SELF_STUDY
  HOLIDAY
  RECESS
  CANCELLED
}

model Course {
  id          Int     @id @default(autoincrement())
  description String?

  discipline     Discipline @relation(fields: [disciplineSlug], references: [slug])
  disciplineSlug String

  edition     Edition @relation(fields: [editionSlug], references: [slug])
  editionSlug String  @map("edition")

  instructorSlug String @map("instructorRef")
  instructor     User   @relation(fields: [instructorSlug], references: [username])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startAt DateTime
  endAt   DateTime

  schedule           TimeSlot[]
  events             CalendarEvent[]
  passphrases        Passphrase[]
  exams              Exam[]
  questionForCourses QuestionForCourse[]
  enrollments        Enrollment[]
  resources          Resource[]

  @@unique([disciplineSlug, instructorSlug, editionSlug])
}

model Discipline {
  slug      String   @id
  name      String
  createdAt DateTime @default(now())

  courses   Course[]
  questions QuestionRef[]
}

/// An academic term, managed by admins. `slug` is the token that appears in
/// every course URL (`/cs101/ada_2026-1`), so it is immutable once courses
/// reference it. The window (`startAt`..`endAt`) says when new courses may be
/// created for this edition; it never affects courses that already exist.
model Edition {
  slug      String   @id
  name      String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())

  courses Course[]
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

model Enrollment {
  id     Int              @id @default(autoincrement())
  status EnrollmentStatus @default(ACTIVE)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Passphrase {
  id Int @id @default(autoincrement())

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  value String @unique

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TimeSlot {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Authored: `mon`, `wed-lab`. Stable when the hour changes.
  slug String
  /// Optional label for the syllabus line: "Lecture", "Lab".
  title String?

  day         Weekday
  startMin    Int
  durationMin Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]

  @@unique([courseId, slug])
  @@unique([id, courseId])
}

model CalendarEvent {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  timeSlotId Int
  timeSlot   TimeSlot @relation(fields: [timeSlotId, courseId], references: [id, courseId])

  slug String

  startAt     DateTime
  durationMin Int
  week        Int

  kind        EventKind @default(LECTURE)
  title       String
  description String?

  /// Derived, never authored: the exam whose window overlaps this one.
  examId Int?
  exam   Exam? @relation(fields: [examId], references: [id], onDelete: SetNull)

  /// Supplied by the writer, opaque to the server. See the manifest decision.
  contentHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, slug])
  @@index([courseId, startAt])
}

enum ResourceType {
  /// External links
  LINK

  /// Files uploaded to the system. If the file is a supported media type 
  /// (image, audio, video, pdf), it will be displayed inline in the browser.
  FILE

  /// Source code snippets, with syntax highlighting.
  CODE

  /// Markdown content, rendered as HTML in the browser.
  MD
}

/// Resource is modelled after the folowing enum:
///
///   type Resource 
///       = { type: "link", url: string, title: string, description?: string }
///       | { type: "file", fileId: string, title: string, description?: string }
///       | { type: "md", title: string, description?: string, content: string }
///       | { type: "code", title: string, description?: string, content: string, language: string }
///
/// This cannot be represeted cleanly in the DB, hence we denormalize some
/// fields in a table.
model Resource {
  id   Int          @id @default(autoincrement())
  type ResourceType

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Natural key from the repository path — FR-SYNC-010. Renaming a file in
  /// the repository is a delete plus a create (FR-SYNC-011).
  slug String

  title       String
  description String?

  /// Url, for LINK resources, content for MD and CODE resources. Null for FILE resources.
  data String?

  /// Language, for CODE resources. Null for LINK, FILE and MD resources.
  extra String?

  fileId Int?
  file   File? @relation(fields: [fileId], references: [id])

  /// Supplied by the writer, opaque to the server.
  contentHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, slug])
  @@index([courseId, type])
}

// =============================================================================
// Question Models
// =============================================================================
enum QuestionStatus {
  DRAFT
  ARCHIVED
  PUBLISHED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECTION
  TRUE_FALSE
  ESSAY
}

/// A QuestionRef is the main entity representing a unique question in the system.
/// It holds metadata about the question, including its author, status, type,
/// and a reference to its latest version of content stored in QuestionData.
///
/// QuestionData lives in a separate table to allow for versioning of question 
/// content. Each time a question is edited, a new QuestionData entry is created,
/// and the QuestionRef.latestId is updated to point to the new version. This
/// allows us to maintain a history of changes while keeping the main question
/// entity lightweight and focused on metadata.
///
/// This also means that exams can reference specific question versions if needed,
/// ensuring that the content remains consistent even if the question is updated
/// later on.
model QuestionRef {
  id       Int    @id @default(autoincrement())
  publicId String
  slug     String

  status QuestionStatus @default(DRAFT)
  type   QuestionType

  disciplineSlug String
  discipline     Discipline @relation(fields: [disciplineSlug], references: [slug])

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  groupId Int?
  group   Group? @relation(fields: [groupId], references: [id])

  latestId Int?
  latest   QuestionData? @relation(fields: [latestId], references: [id], name: "latestVersion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions           QuestionData[]
  questionTags       QuestionTags[]
  questionsForExams  QuestionsForExam[]
  questionForCourses QuestionForCourse[]
  responses          Response[]

  @@unique([slug, authorId, disciplineSlug])
}

model QuestionData {
  id          Int    @id @default(autoincrement())
  versionHash String

  refId Int
  ref   QuestionRef @relation(fields: [refId], references: [id])

  title   String
  stem    String
  payload Json

  createdAt DateTime @default(now())

  refAsLatest QuestionRef[] @relation(name: "latestVersion")

  @@unique([refId, versionHash])
}

model QuestionTags {
  questionId Int
  question   QuestionRef @relation(fields: [questionId], references: [id])

  tag String

  @@id([questionId, tag])
}

model QuestionForCourse {
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  questionId Int
  question   QuestionRef @relation(fields: [questionId], references: [id])

  version String?

  @@id([courseId, questionId])
}

// =============================================================================
// Response Models
// =============================================================================
enum SubmissionStatus {
  PENDING_GRADE
  WILL_NOT_GRADE
  GRADED_AUTOMATICALLY
  GRADED_MANUALLY
}

/// A student response to a single question in a exam or practice session.
model Response {
  id Int @id @default(autoincrement())

  acceptingSubmissions Boolean @default(true)

  questionId Int
  question   QuestionRef @relation(fields: [questionId], references: [id])

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  examId Int?
  exam   Exam? @relation(fields: [examId], references: [id])

  practiceSession DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]

  @@map("ResponseRef")
}

model Submission {
  id Int @id @default(autoincrement())

  status     SubmissionStatus @default(PENDING_GRADE)
  responseId Int
  response   Response         @relation(fields: [responseId], references: [id])

  payload Json

  feedbackData Json?
  feedback     String?
  scorePercent Float?

  graderId Int?
  grader   User? @relation(fields: [graderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// Exam Models
// =============================================================================
enum ExamStatus {
  /// Exam is being created, and not yet public.
  DRAFT

  /// Exam is no longer visible to students.
  ARCHIVED

  /// Exam is public, but not yet started.
  /// A Scheduled exam with no `scheduledAt` is pending a manual approval by
  /// an instructor.
  ///
  /// Students can see the title and description of an scheduled exam, but
  /// cannot view questions or submit responses until it starts.
  SCHEDULED

  /// Exam is currently ongoing, and open for submissions.
  ONGOING

  /// Exam has ended, and is no longer accepting submissions. But it is still
  /// public and visible to students.
  COMPLETED
}

enum ExamType {
  PRACTICE
  QUIZ
  EXAM
  FINAL
}

enum TextFormat {
  PLAINTEXT
  MARKDOWN
  HTML
}

model Exam {
  id     Int        @id @default(autoincrement())
  type   ExamType   @default(EXAM)
  status ExamStatus @default(DRAFT)
  slug   String

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  title       String
  description String?
  preamble    String?
  format      TextFormat @default(MARKDOWN)

  scheduledAt DateTime?
  durationMs  Int?
  /// Extra time granted on top of durationMs (FR-EXAM-020/022), part of the
  /// exam's window for the calendar-link match in src/db/exam-link.ts.
  extraTimeMs Int @default(0)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examTags          ExamTags[]
  questionsForExams QuestionsForExam[]
  responses         Response[]
  events            CalendarEvent[]
}

/// A M2M relation table linking Exams to their Questions (QuestionRefs).
/// This relation also specifies which version of the question was used in each 
/// exam.
model QuestionsForExam {
  examId Int
  exam   Exam @relation(fields: [examId], references: [id])

  questionRefId Int
  questionRef   QuestionRef @relation(fields: [questionRefId], references: [id])

  version String?

  @@id([examId, questionRefId])
}

model ExamTags {
  examId Int
  exam   Exam @relation(fields: [examId], references: [id])

  tag String

  @@id([examId, tag])
}
