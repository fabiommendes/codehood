---
interface Props {
	title: string;
	href?: string;
	linkText?: string;
}

const { title, href, linkText = "View all →" } = Astro.props;
---

<div class="flex items-baseline justify-between">
  <h2 class="text-xl font-semibold">{title}</h2>
  {
    href && (
      <a href={href} class="text-sm text-primary hover:underline">
        {linkText}
      </a>
    )
  }
</div>
