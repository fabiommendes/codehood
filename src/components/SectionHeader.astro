---
import Link from "@/components/Link.astro";
import { m } from "@/i18n";
import type { Href } from "@/urls";

interface Props {
	title: string;
	href?: Href;
	linkText?: string;
}

const { title, href, linkText = m.common_view_all() } = Astro.props;
---

<div class="flex items-baseline justify-between">
  <h2 class="page-subheader">{title}</h2>
  {
    href && (
      <Link href={href} class="text-sm text-primary hover:underline">
        {linkText}
      </Link>
    )
  }
</div>
