---
import { actions } from "astro:actions";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import PasswordConfirm from "@/components/PasswordConfirm.astro";
import { checkInSignUp } from "@/core/schemas";
import { actionForm } from "@/forms/form-state";
import { m } from "@/i18n";

interface Props {
	rollCallId: number;
}

const { rollCallId } = Astro.props;
const form = await actionForm(Astro, actions.checkIn.signUp, checkInSignUp, {
	id: "check-in-sign-up",
});
---

<form
  method="POST"
  action={actions.checkIn.signUp}
  class="flex flex-col gap-1"
  id="check-in-sign-up"
>
  <input type="hidden" name="rollCallId" value={rollCallId} />
  <FormAlert error={form.error} class="mb-2" />

  <Field {...form.field("name")} control={{ autocomplete: "name" }} />
  <Field {...form.field("email")} control={{ autocomplete: "email" }} />
  <Field {...form.field("username")} control={{ autocomplete: "username" }} />

  <div class="grid gap-x-3 sm:grid-cols-2">
    <Field {...form.field("password")} control={{ autocomplete: "new-password" }} />
    <PasswordConfirm id="check-in-sign-up-passwordConfirm" />
  </div>

  <div class="grid gap-x-3 sm:grid-cols-2">
    <Field {...form.field("githubId")} />
    <Field {...form.field("schoolId")} />
  </div>
  <p class="label whitespace-normal">
    {m.auth_identify_note()}
  </p>

  <button type="submit" class="btn btn-primary btn-block mt-4 rounded-full">
    {m.auth_create_account()}
  </button>
</form>
