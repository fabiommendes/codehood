---
/**
 * The instructor's view of how an exam went: one row per attempt, and the way into grading.
 */
import { m } from "@/i18n";
import type { AttemptRow } from "@/services/grading";
import { attemptTotalLabel } from "./attempt-total";

interface Props {
	/// The exam page's URL.
	href: string;
	rows: AttemptRow[];
}

const { href, rows } = Astro.props;
const pending = rows.reduce((sum, row) => sum + row.pending, 0);
---

<section class="mt-8">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-lg font-semibold">{m.grades_results_title()}</h2>
    {
      rows.length > 0 && pending === 0 && (
        <a href={`${href}/grading`} class="btn btn-outline btn-sm">
          {m.grades_results_review()}
        </a>
      )
    }
  </div>

  {
    rows.length === 0 ? (
      <p class="mt-3 text-sm text-base-content/60">{m.grades_results_empty()}</p>
    ) : (
      <>
        <div class="mt-3 overflow-x-auto rounded-box border border-base-300 bg-base-100">
          <table aria-label={m.grades_results_title()} class="table">
            <thead>
              <tr>
                <th>{m.grades_results_col_student()}</th>
                <th>{m.grades_results_col_attempt()}</th>
                <th>{m.grades_results_col_answered()}</th>
                <th>{m.grades_results_col_to_grade()}</th>
                <th>{m.grades_results_col_total()}</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td>
                    <a href={`${href}/attempts/${row.author}`} class="link">
                      {row.name}
                    </a>
                    {row.dropped && <span class="badge badge-outline badge-sm ml-2">{m.grades_results_dropped()}</span>}
                  </td>
                  <td>{row.state === "submitted" ? m.grades_results_submitted() : m.grades_results_in_progress()}</td>
                  <td>{m.grades_results_answered_of({ answered: row.answered, questions: row.questions })}</td>
                  <td>{row.pending > 0 ? m.grades_results_pending({ count: row.pending }) : ""}</td>
                  <td>{attemptTotalLabel(row.total, row.state)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }
</section>
