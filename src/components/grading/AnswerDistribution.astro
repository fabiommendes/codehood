---
/**
 * How the answers to an objective question spread over its choices, as one CSS bar per row.
 */
import { m } from "@/i18n";
import type { AnswerDistribution } from "@/services/question-stats";
import { renderMarkdownInline } from "@/utils/markdown";

interface Props {
	distribution: AnswerDistribution;
}

const { distribution } = Astro.props;

const percent = (count: number): number =>
	distribution.answers === 0
		? 0
		: Math.round((count / distribution.answers) * 100);
---

<section aria-label={m.grades_dist_title()} class="mt-6">
  <h3 class="text-lg font-semibold">{m.grades_dist_title()}</h3>
  <ul class="mt-3 flex flex-col gap-3 rounded-box border border-base-300 bg-base-100 p-6">
    {
      distribution.type === "true-false"
        ? distribution.rows.map((row) => (
            <li class="flex flex-col gap-1">
              <p class="flex items-center gap-2">
                {row.kind === "statement" ? (
                  <span class="font-medium" set:html={renderMarkdownInline(row.text)} />
                ) : (
                  <span class="font-medium">{m.grades_dist_removed_statement({ id: row.id })}</span>
                )}
                {row.kind === "statement" && (
                  <span class="badge badge-success badge-soft badge-sm">
                    {row.correct ? m.grades_dist_correct_true() : m.grades_dist_correct_false()}
                  </span>
                )}
              </p>
              <div class="flex h-3 w-full overflow-hidden rounded-full bg-base-200" aria-hidden="true">
                <div class="bg-success" style={`width: ${percent(row.true)}%`}></div>
                <div class="bg-error" style={`width: ${percent(row.false)}%`}></div>
                <div class="bg-base-300" style={`width: ${percent(row.abstained)}%`}></div>
              </div>
              <p class="flex gap-4 text-sm tabular-nums text-base-content/70">
                <span>{m.grades_dist_true({ count: row.true })}</span>
                <span>{m.grades_dist_false({ count: row.false })}</span>
                <span>{m.grades_dist_abstained({ count: row.abstained })}</span>
              </p>
            </li>
          ))
        : distribution.rows.map((row) => (
            <li class="flex flex-col gap-1">
              <p class="flex items-center gap-2">
                {row.kind === "choice" ? (
                  <span class="font-medium" set:html={renderMarkdownInline(row.text)} />
                ) : (
                  <span class="font-medium text-base-content/60">
                    {row.kind === "removed"
                      ? m.grades_dist_removed({ id: row.id })
                      : distribution.type === "multiple-selection"
                        ? m.grades_dist_none_selected()
                        : m.grades_dist_blank()}
                  </span>
                )}
                {row.kind === "choice" && row.correct && (
                  <span class="inline-flex items-center gap-1 text-success">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
                    <span class="sr-only">{m.grades_dist_correct()}</span>
                  </span>
                )}
              </p>
              <div class="flex items-center gap-3">
                <div class="h-3 flex-1 overflow-hidden rounded-full bg-base-200" aria-hidden="true">
                  <div
                    class={row.kind === "choice" && row.correct ? "h-full bg-success" : row.kind === "choice" ? "h-full bg-primary" : "h-full bg-base-content/30"}
                    style={`width: ${percent(row.count)}%`}
                  ></div>
                </div>
                <span class="w-24 text-right text-sm tabular-nums text-base-content/70">
                  {m.grades_dist_count({ count: row.count, percent: percent(row.count) })}
                </span>
              </div>
            </li>
          ))
    }
  </ul>
</section>
