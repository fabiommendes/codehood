---
/**
 * A student's saved answer as visible text, or as the question's view when
 * the answer is a pick, a set of blanks or a list of lines.
 */
import type { AnswerPayload } from "@/components/exam/answer-payload";
import type { QuestionPublic } from "@/db";
import { m } from "@/i18n";
import type { ReviewResult } from "@/services/review";
import AnswerView from "./AnswerView";
import { displayAnswer } from "./answer-text";

interface Props {
	/// The public half of the question, as the student saw it.
	question: QuestionPublic["question"];
	payload: AnswerPayload | undefined;
	/// The marks to show on the view, without a score of its own; read-only without it.
	result?: ReviewResult;
}

const { question, payload, result } = Astro.props;
const shown = displayAnswer(question.type, payload);
---

{shown.kind === "empty" && <p class="text-base-content/60">{m.grades_answer_none()}</p>}
{
  shown.kind === "text" && (
    <p class:list={["text-base-content", shown.multiline && "whitespace-pre-wrap"]}>{shown.text}</p>
  )
}
{shown.kind === "view" && <AnswerView client:load question={question} payload={payload} result={result} />}
