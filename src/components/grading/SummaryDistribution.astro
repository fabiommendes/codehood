---
/**
 * How the answers to an automatic question spread over the responses students gave, one CSS bar per distinct response.
 */
import { m } from "@/i18n";
import type { SummaryGroup } from "@/services/response-summary";

interface Props {
	groups: SummaryGroup[];
}

const { groups } = Astro.props;
const total = groups.reduce((sum, group) => sum + group.count, 0);
const percent = (count: number): number =>
	total === 0 ? 0 : Math.round((count / total) * 100);
---

<section aria-label={m.grades_dist_title()} class="mt-6">
  <h3 class="page-subsubheader">{m.grades_dist_title()}</h3>
  <ul class="mt-3 flex flex-col gap-3 rounded-box border border-edge bg-base-100 p-6">
    {
      groups.map((group) => (
        <li class="flex flex-col gap-1">
          <p class="font-medium" title={group.title}>{group.text}</p>
          <div class="flex items-center gap-3">
            <div class="h-3 flex-1 overflow-hidden rounded-full bg-base-200" aria-hidden="true">
              <div class="h-full bg-primary" style={`width: ${percent(group.count)}%`}></div>
            </div>
            <span class="w-24 text-right text-sm tabular-nums text-base-content/70">
              {m.grades_dist_count({ count: group.count, percent: percent(group.count) })}
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</section>
