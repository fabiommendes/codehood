---
/**
 * Every active student against every exam and every pushed grade column.
 *
 * An exam cell reads the total the instructor has graded so far. A hidden
 * pushed column carries the control that releases it to the students.
 */
import ReleaseGradeColumn from "@/components/grading/ReleaseGradeColumn";
import { formatScore } from "@/services/exam-result";
import {
	formatGradeValue,
	type GradeCell,
	type GradesTable,
	type PushedGrades,
} from "@/services/grades-table";

interface Props {
	/// The course's URL prefix.
	href: string;
	table: GradesTable;
	/// The pushed grade columns, lined up with the rows of `table`.
	pushed: PushedGrades;
}

const { href, table, pushed } = Astro.props;
const segments = href.split("/").filter(Boolean);
const params = {
	discipline: segments[0] ?? "",
	course: segments[1] ?? "",
};

const label = (cell: GradeCell): string => {
	switch (cell.kind) {
		case "total":
			return formatScore(cell.total);
		case "pending":
			return "Pending";
		case "in-progress":
			return "In progress";
		case "missed":
			return "Missed";
		case "empty":
			return "";
	}
};
const hasAttempt = (cell: GradeCell): boolean =>
	cell.kind === "total" ||
	cell.kind === "pending" ||
	cell.kind === "in-progress";
---

<div class="mt-6 overflow-x-auto rounded-box border border-base-300 bg-base-100">
  <table aria-label="Grades" class="table min-w-max">
    <thead>
      <tr>
        <th scope="col" class="sticky left-0 z-10 bg-base-100 max-sm:px-2">Student</th>
        {
          table.columns.map((column) => (
            <th scope="col" class="align-top max-sm:px-2">
              <div class="max-sm:w-24 max-sm:whitespace-normal">
                <a href={`${href}/exams/${column.exam.slug}`} class="link">
                  {column.exam.title}
                </a>
                <div class="mt-1 text-xs font-normal text-base-content/60">
                  {column.mean === null ? "no average" : `avg ${formatScore(column.mean)}`} · {column.attempted} of {column.students}
                </div>
              </div>
            </th>
          ))
        }
        {
          pushed.columns.map((column) => (
            <th scope="col" class="align-top max-sm:px-2">
              <div class="max-sm:w-24 max-sm:whitespace-normal">
                <span>{column.title}</span>
                {column.releasedAt === null && (
                  <>
                    {" "}
                    <span class="badge badge-ghost badge-sm">Hidden</span>
                    <ReleaseGradeColumn
                      client:load
                      discipline={params.discipline}
                      course={params.course}
                      slug={column.slug}
                      title={column.title}
                      valued={column.valued}
                    />
                  </>
                )}
              </div>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        table.rows.map((row, rowIndex) => (
          <tr>
            <th scope="row" class="sticky left-0 z-10 bg-base-100 font-medium max-sm:px-2">
              <span class="block max-sm:w-24 max-sm:truncate" title={row.name}>{row.name}</span>
            </th>
            {row.cells.map((cell, index) => (
              <td class="max-sm:px-2">
                {hasAttempt(cell) ? (
                  <a href={`${href}/exams/${table.columns[index]?.exam.slug}/attempts/${row.username}`} class="link">
                    {label(cell)}
                  </a>
                ) : (
                  label(cell)
                )}
              </td>
            ))}
            {(pushed.values[rowIndex] ?? []).map((value) => (
              <td class="max-sm:px-2">
                {value === null ? "" : formatGradeValue(value)}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
