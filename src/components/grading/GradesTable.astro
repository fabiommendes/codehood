---
/**
 * Every active student against every exam and every pushed grade column.
 *
 * An exam cell reads the total the instructor has graded so far. A hidden
 * pushed column carries the control that releases it to the students.
 */
import Icon from "@/components/grading/Icon.astro";
import ReleaseGradeColumn from "@/components/grading/ReleaseGradeColumn";
import { m } from "@/i18n";
import { formatScore } from "@/services/exam-result";
import {
	formatGradeValue,
	type GradeCell,
	type GradesTable,
	type PushedGrades,
} from "@/services/grades-table";
import type { CourseUrls } from "@/urls";
import { adjustmentLabel } from "@/utils/adjustment-label";
import { formatAttendancePercent } from "@/utils/course-grades";

interface Props {
	/// The URLs of the course.
	course: CourseUrls;
	table: GradesTable;
	/// The pushed grade columns, lined up with the rows of `table`.
	pushed: PushedGrades;
	/// Roll calls attended and held by username; the Attendance column shows only when given.
	attendance?: ReadonlyMap<string, { present: number; total: number }>;
}

const { course, table, pushed, attendance } = Astro.props;
/// The URLs of the exam in the column at `index`; the cells of a row line up with `table.columns`.
const examAt = (index: number) =>
	course.exam(table.columns[index]?.exam.slug ?? "");
const segments = course.index().split("/").filter(Boolean);
const params = {
	discipline: segments[0] ?? "",
	course: segments[1] ?? "",
};

const label = (cell: GradeCell): string => {
	switch (cell.kind) {
		case "total":
			return formatScore(cell.total);
		case "pending":
			return m.grades_table_cell_pending();
		case "in-progress":
			return m.grades_table_cell_in_progress();
		case "missed":
			return m.grades_table_cell_missed();
		case "empty":
			return "";
	}
};
/// The tooltip of an adjusted total: what was applied to it, in order, never the notes.
const adjustmentTitle = (cell: GradeCell): string | undefined => {
	if (cell.kind !== "total" || !cell.adjustments) return undefined;
	return cell.adjustments
		.map((adjustment) => adjustmentLabel(adjustment))
		.join(", ");
};
/// The color of an adjusted total: red when the adjustments lowered it, green when they raised it.
const totalTone = (cell: GradeCell): string | undefined => {
	if (cell.kind !== "total" || cell.unadjusted == null) return undefined;
	if (cell.total < cell.unadjusted) return "text-error";
	return cell.total > cell.unadjusted ? "text-success" : undefined;
};
const hasAttempt = (cell: GradeCell): boolean =>
	cell.kind === "total" ||
	cell.kind === "pending" ||
	cell.kind === "in-progress";
---

<div class="mt-6 overflow-x-auto rounded-box border border-edge bg-base-100 shadow-sm">
  <table aria-label={m.grades_table_label()} class="table min-w-max">
    <thead class="bg-base-200/50">
      <tr>
        <th scope="col" class="sticky left-0 z-10 bg-[color-mix(in_oklab,var(--color-base-200)_50%,var(--color-base-100))] max-sm:px-2">{m.grades_table_col_student()}</th>
        {
          table.columns.map((column) => (
            <th scope="col" class="align-top max-sm:px-2">
              <div class="max-sm:w-24 max-sm:whitespace-normal">
                <a href={course.exam(column.exam.slug).index()} class="link">
                  {column.exam.title}
                </a>
                <div class="mt-1 text-xs font-normal text-muted">
                  {column.mean === null ? m.grades_table_no_average() : m.grades_table_average({ score: formatScore(column.mean) })} · {m.grades_table_attempted({ attempted: column.attempted, students: column.students })}
                </div>
              </div>
            </th>
          ))
        }
        {
          pushed.columns.map((column) => (
            <th scope="col" class="align-top max-sm:px-2">
              <div class="max-sm:w-24 max-sm:whitespace-normal">
                <span>{column.title}</span>
                {column.releasedAt === null && (
                  <>
                    {" "}
                    <span class="badge badge-ghost badge-sm">{m.grades_table_hidden()}</span>
                    <ReleaseGradeColumn
                      client:load
                      discipline={params.discipline}
                      course={params.course}
                      slug={column.slug}
                      title={column.title}
                      valued={column.valued}
                    />
                  </>
                )}
              </div>
            </th>
          ))
        }
        {
          attendance && (
            <th scope="col" class="align-top max-sm:px-2">
              <a href={course.attendance()} class="link">{m.grades_table_col_attendance()}</a>
            </th>
          )
        }
      </tr>
    </thead>
    <tbody>
      {
        table.rows.map((row, rowIndex) => (
          <tr>
            <th scope="row" class="sticky left-0 z-10 bg-base-100 font-medium max-sm:px-2">
              <span class="block max-sm:w-24 max-sm:truncate" title={row.name}>{row.name}</span>
            </th>
            {row.cells.map((cell, index) => (
              <td class="max-sm:px-2">
                {hasAttempt(cell) ? (
                  <>
                    <a
                      href={examAt(index).attempt(row.username)}
                      class="link"
                      title={adjustmentTitle(cell)}
                    >
                      {cell.kind === "total" && cell.unadjusted != null ? (
                        <>
                          <ins class:list={["font-semibold no-underline", totalTone(cell)]}>{label(cell)}</ins>{" "}
                          <del class="text-muted">{formatScore(cell.unadjusted)}</del>
                        </>
                      ) : (
                        label(cell)
                      )}
                    </a>
                    {cell.kind === "total" && cell.unadjusted !== undefined && (
                      <a
                        href={examAt(index).adjustments()}
                        class="link ml-1 align-middle text-muted"
                        aria-label={m.grades_adjustment_title()}
                        title={m.grades_adjustment_title()}
                      >
                        <Icon name="badgePlus" />
                      </a>
                    )}
                  </>
                ) : (
                  label(cell)
                )}
              </td>
            ))}
            {(pushed.values[rowIndex] ?? []).map((value) => (
              <td class="max-sm:px-2">
                {value === null ? "" : formatGradeValue(value)}
              </td>
            ))}
            {attendance && (
              <td class="max-sm:px-2">
                {formatAttendancePercent(
                  attendance.get(row.username)?.present ?? 0,
                  attendance.get(row.username)?.total ?? 0,
                )}
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
