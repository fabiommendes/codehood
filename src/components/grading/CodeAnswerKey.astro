---
/** The statement of a code question and its model answer, highlighted like the students' code. */
import { type CodeQuestion, firstFencedCode } from "mdq";
import CodeBlock from "@/components/CodeBlock.astro";
import { m } from "@/i18n";
import { highlightCodeBlocks, renderMarkdown } from "@/utils/markdown";

interface Props {
	question: CodeQuestion;
}

const { question } = Astro.props;
const key = question.answerKey ? firstFencedCode(question.answerKey) : null;
const stemHtml = await highlightCodeBlocks(renderMarkdown(question.stem));
---

<div class="prose prose-sm max-w-none" set:html={stemHtml} />
{key && (
  <div class="mt-4">
    <p class="text-sm font-semibold text-muted">{m.grades_code_model_answer()}</p>
    <CodeBlock class="mt-2" code={key} lang={question.language} data-model-answer="" />
  </div>
)}
