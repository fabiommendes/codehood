---
// The resources of one meeting, as compact rows under its description on the
// schedule. A file downloads, a link opens in another tab, a note or snippet
// opens its page.
import type { Resource } from "@/db";
import { RESOURCE_ICONS } from "@/utils/resource-icons";
import { fileDownloadName, resourceHref } from "@/utils/resource-url";

interface Props {
	resources: Resource[];
	/// The course's own URL, which note and snippet pages hang from.
	href: string;
}

const { resources, href } = Astro.props;
---

{
  resources.length > 0 && (
    <ul aria-label="Resources" class="mt-2 flex flex-col text-sm">
      {resources.map((resource) => {
        const file = resource.data.type === "FILE" ? resource.data : undefined;
        const external = resource.data.type === "LINK";
        return (
          <li>
            <a
              href={resourceHref(resource, href)}
              download={file ? fileDownloadName(resource, file) : undefined}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
              class="-mx-1 inline-flex items-center gap-1.5 rounded px-1 py-0.5 hover:bg-base-200 hover:text-primary"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                class="shrink-0 text-base-content/60"
                aria-hidden="true"
              >
                <path
                  d={RESOURCE_ICONS[resource.data.type]}
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {resource.title}
            </a>
          </li>
        );
      })}
    </ul>
  )
}
