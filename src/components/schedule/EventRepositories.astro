---
// The repositories a meeting cites, as compact rows next to its resources,
// each one a link to the repository's page.
import { m } from "@/i18n";

interface Props {
	repositories: ReadonlyArray<{ slug: string; title: string }>;
	/// The course's own URL, which repository pages hang from.
	href: string;
}

const { repositories, href } = Astro.props;
---

{
  repositories.length > 0 && (
    <ul aria-label={m.repositories_tab_label()} class="mt-2 flex flex-col text-sm">
      {repositories.map((repository) => (
        <li>
          <a
            href={`${href}/repositories/${repository.slug}`}
            class="-mx-1 inline-flex items-center gap-1.5 rounded px-1 py-0.5 hover:bg-base-200 hover:text-primary"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              class="shrink-0 text-base-content/60"
              aria-hidden="true"
            >
              <path
                d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {repository.title}
          </a>
        </li>
      ))}
    </ul>
  )
}
