---
// The breadcrumb at the top of the page content. On desktop it is sticky
// above the top bar: as the page scrolls it rises into the middle of the bar,
// lined up with the page column, and stays there. On phones the bar's middle
// holds the logo, so it scrolls away with the content. The course root is
// drawn as the course tile.
import CourseTile from "@/components/CourseTile.astro";
import { m } from "@/i18n";
import type { Crumb } from "@/utils/breadcrumbs";

interface Props {
	trail: readonly Crumb[];
	/// Plain, in place, for the design pages.
	static?: boolean;
}

const { trail, static: isStatic = false } = Astro.props;
---

{
  trail.length > 0 && (
    <nav
      aria-label={m.nav_breadcrumb()}
      data-breadcrumbs
      data-static={isStatic || undefined}
      class="breadcrumbs flex h-9 min-w-0 items-center overflow-hidden py-0 text-sm text-muted"
    >
      <ul>
        {trail.map((crumb) => (
          <li>
            {crumb.href ? (
              crumb.tile ? (
                <a href={crumb.href} aria-label={crumb.label} title={crumb.label}>
                  <CourseTile seed={crumb.tile} size={18} class="ring-1 ring-base-300" />
                </a>
              ) : (
                <a href={crumb.href}>{crumb.label}</a>
              )
            ) : (
              <span aria-current="page" class="text-base-content">
                {crumb.label}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /* Lines the first crumb up with the usual page column (`mx-auto max-w-4xl
     px-4`) of the content area, and on desktop leaves the right end of the
     top bar to its controls (`--crumbs-reserve`, measured below). */
  [data-breadcrumbs]:not([data-static]) {
    --crumbs-left: max(1rem, calc((100% - 56rem) / 2 + 1rem));
    position: relative;
    z-index: 40;
    width: calc(100% - 2 * var(--crumbs-left));
    margin: 1rem 0 -1.25rem var(--crumbs-left);
  }
  @media (min-width: 64rem) {
    [data-breadcrumbs]:not([data-static]) {
      position: sticky;
      /* Centred in the 4rem bar. */
      top: 0.875rem;
      width: calc(100% - var(--crumbs-left) - var(--crumbs-reserve, 12rem));
      /* Only the links take clicks; the rest of the box lies over the bar. */
      pointer-events: none;
    }
    [data-breadcrumbs]:not([data-static]) a {
      pointer-events: auto;
    }
  }
  /* Daisy scrolls the list; here it shrinks. Middle crumbs share the room
     left by the course and the last crumb equally, each capped at its own
     width, so a long title gives way before a short one. The last crumb
     truncates only once it takes more than 40% of the bar; the course never.
     Separators stay whole. */
  [data-breadcrumbs] > ul {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  [data-breadcrumbs] > ul > li {
    flex: 1 1 0;
    min-width: 2.25rem;
    max-width: max-content;
  }
  [data-breadcrumbs] > ul > li::before {
    flex-shrink: 0;
  }
  [data-breadcrumbs] > ul > li:first-child {
    flex: none;
    min-width: 0;
  }
  [data-breadcrumbs] > ul > li:last-child {
    flex: none;
    max-width: 40%;
  }
  [data-breadcrumbs] > ul > li > a,
  [data-breadcrumbs] > ul > li > span {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  // The bar's controls change width with the user's name; keep clear of them.
  const controls = document.querySelector<HTMLElement>("[data-bar-controls]");
  if (controls) {
    const reserve = (): void => {
      const width = controls.getBoundingClientRect().width;
      document.documentElement.style.setProperty("--crumbs-reserve", `calc(${width}px + 2rem)`);
    };
    new ResizeObserver(reserve).observe(controls);
  }
</script>
