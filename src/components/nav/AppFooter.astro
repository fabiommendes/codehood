---
// The one-line footer of AppLayout and the landing page: logo, source code,
// and the version. The design system link shows in development only.
import Link from "@/components/Link.astro";
import Logo from "@/components/Logo.astro";
import { m } from "@/i18n";
import { external, urls } from "@/urls";
import { homepage, version } from "../../../package.json";

interface Props {
	class?: string;
	/// Shows the "Report a problem" button; the page must mount `ReportDialog`.
	reportable?: boolean;
}

const { class: className, reportable = false } = Astro.props;
---

<footer
  class:list={[
    "flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-edge py-3 text-sm text-muted",
    className,
  ]}
>
  <Logo height={22} />
  <Link href={external(homepage)} class="hover:text-primary">{m.nav_source_code()}</Link>
  {
    reportable && (
      <button type="button" data-report-open class="hover:text-primary">
        {m.report_open()}
      </button>
    )
  }
  {
    import.meta.env.DEV && (
      <Link href={urls.design.index()} class="hover:text-primary">
        {m.nav_design_system()}
      </Link>
    )
  }
  <span class="ml-auto font-mono text-xs">v{version}</span>
</footer>
