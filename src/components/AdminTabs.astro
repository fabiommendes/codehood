---
// The admin section's tab strip, shared by every page under /admin (see
// dev/specs/to-review/admin-view.md). Some destinations don't have a page
// yet; their tab just isn't reachable until they do, the same way
// /design/forms existed as a stub before it had real content.
import Tabs from "@/components/ui/Tabs.astro";

interface Props {
	active: "overview" | "users" | "courses" | "disciplines" | "editions";
}

const { active } = Astro.props;

const items = [
	{ key: "overview", label: "Overview", href: "/admin" },
	{ key: "users", label: "Users", href: "/admin/users" },
	{ key: "courses", label: "Courses", href: "/admin/courses" },
	{ key: "disciplines", label: "Disciplines", href: "/admin/disciplines" },
	{ key: "editions", label: "Editions", href: "/admin/editions" },
] as const;
---

<Tabs items={items} active={active} />
