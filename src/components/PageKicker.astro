---
import BrandSquares from "./BrandSquares.astro";

interface Props {
	text: string;
	// Landing page section headings use the brand-stripe flourish when squares is set;
	// other page kickers can remain text-only.
	squares?: boolean;
	class?: string;
}

const { text, squares = false, class: className } = Astro.props;
---

{
  squares ? (
    <div class:list={["mb-2 flex items-center gap-2", className]}>
      <BrandSquares />
      <span class="kicker">{text}</span>
    </div>
  ) : (
    <span class:list={["kicker", className]}>{text}</span>
  )
}
