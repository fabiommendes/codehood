---
// The only header a course page has: badge, title, instructor line, and the
// tab strip, on every page under /<discipline>/<course>/. There is no
// back-link and no "Instructor view" badge; the strip is the whole of the
// page's navigation, and an instructor's extra tabs are the only thing that
// marks them as one.
import { hasPerm } from "@/auth/permissions";
import { NotAllowed } from "@/core/error";
import { type Course, db } from "@/db";
import { m } from "@/i18n";
import { courseHref } from "@/urls";
import { type CourseTabKey, courseTabs } from "@/utils/course-tabs";
import Tabs from "./ui/Tabs.astro";

interface Props {
	course: Course;
	/// Absent on a page that has no tab of its own.
	active?: CourseTabKey;
}

const { course, active } = Astro.props;
// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;

// courseTabs only needs `id`/`instructor` (see its `enrollment.manage` check),
// both of which the public Course already carries — no enrollment data needed.
const ref = {
	discipline: course.discipline.slug,
	instructor: course.instructor.username,
	edition: course.edition.slug,
};
// The service already hides uncommitted repositories from whoever may not write.
const hasRepositories = await db.repository
	.findMany({ course: course.id }, { actor })
	.then((all) => all.length > 0)
	.catch((error) => {
		if (error instanceof NotAllowed) return false;
		throw error;
	});
const tabs = [...courseTabs(course, ref, actor, { hasRepositories })];
// The instructor's reports tab counts what is still `OPEN`.
if (hasPerm(actor, "enrollment.manage", course)) {
	const open = await db.report.countOpen(course.id, { actor });
	tabs.push({
		key: "reports",
		label:
			open > 0
				? `${m.nav_course_tab_reports()} ${open}`
				: m.nav_course_tab_reports(),
		href: `${courseHref(ref)}/reports`,
	});
}
---

<div data-page-header>
	<span class="badge badge-outline badge-sm font-mono"
		>{course.discipline.slug}</span
	>
	<h1 class="mt-2 text-3xl font-bold">{course.discipline.name}</h1>
	<p class="mt-1 text-base-content/60">
		{course.instructor.name} · {course.edition.slug}
	</p>
</div>

<div class="mt-6">
	<Tabs items={tabs} active={active ?? ""} />
</div>
