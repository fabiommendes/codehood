---
// The only header a course page has: title, instructor line, and the
// tab strip, on every page under /<discipline>/<course>/. There is no
// back-link and no "Instructor view" badge; the strip is the whole of the
// page's navigation, and an instructor's extra tabs are the only thing that
// marks them as one.
import type { Course } from "@/db";
import type { CourseTab, CourseTabKey } from "@/utils/course-tabs";
import Tabs from "./ui/Tabs.astro";

interface Props {
	course: Pick<Course, "discipline" | "instructor" | "edition">;
	/// The strip `loadCourse` computed for the viewing actor.
	tabs: readonly CourseTab[];
	/// Absent on a page that has no tab of its own.
	active?: CourseTabKey;
}

const { course, tabs, active } = Astro.props;
---

<div data-page-header>
	<h1 class="text-3xl font-bold">{course.discipline.name}</h1>
	<p class="mt-1 text-muted">
		{course.instructor.name} · {course.edition.slug}
	</p>
</div>

<div class="mt-6">
	<Tabs items={tabs} active={active ?? ""} />
</div>
