---
import Link from "@/components/Link.astro";
/**
 * The questions of an exam for its instructor: number, title, grading, type, weight and, once attempts closed, how they went.
 *
 * Average and discrimination show only when `stats` is given; the full table
 * lives in the results page.
 */
import { locale, m } from "@/i18n";
import { formatScore } from "@/services/exam-result";
import type {
	DiscriminationGap,
	QuestionStats,
} from "@/services/question-stats";
import type { CourseUrls } from "@/urls";

interface Row {
	slug: string;
	/// The question's title; the slug when the question no longer resolves.
	title: string;
	/// The label of the question's type, empty when unknown.
	type: string;
	/// How the question is graded (`automationLabel`), empty when unknown.
	grading: string;
	weight: number;
}

interface Props {
	/// The URLs of the exam's course.
	course: CourseUrls;
	/// One row per exam question, in exam order.
	rows: Row[];
	/// The statistics of each question, by slug; absent while no attempt is closed.
	stats?: ReadonlyMap<string, QuestionStats>;
}

const { course, rows, stats } = Astro.props;

const twoDecimals = new Intl.NumberFormat(locale, {
	minimumFractionDigits: 2,
	maximumFractionDigits: 2,
});
/// A weight shows at least two decimals, so the weights of a column line up.
const weightFormat = new Intl.NumberFormat(locale, {
	minimumFractionDigits: 2,
	maximumFractionDigits: 4,
});
const gapReasons: Record<DiscriminationGap, string> = {
	"few-attempts": m.grades_stats_gap_few_attempts(),
	"single-question": m.grades_stats_gap_single_question(),
	"no-variance": m.grades_stats_gap_no_variance(),
};
---

<section id="questions" class="mt-8 scroll-mt-20" data-testid="exam-questions">
  <h3 class="page-subsubheader">{m.exams_detail_questions_heading()}</h3>
  {
    rows.length === 0 ? (
      <p class="mt-3 text-sm text-muted">{m.exams_detail_no_questions()}</p>
    ) : (
      <div class="mt-3 overflow-x-auto rounded-box border border-edge bg-base-100 shadow-sm">
        <table aria-label={m.exams_detail_questions_heading()} class="table">
          <thead class="bg-base-200/50">
            <tr>
              <th scope="col">{m.grades_stats_col_question()}</th>
              <th scope="col">{m.exams_detail_questions_col_type()}</th>
              <th scope="col" class="text-center">{m.exams_detail_questions_col_weight()}</th>
              {stats && <th scope="col" class="text-right">{m.grades_stats_col_average()}</th>}
              {stats && <th scope="col" class="text-center">{m.grades_stats_col_discrimination()}</th>}
            </tr>
          </thead>
          <tbody>
            {rows.map((row, index) => {
              const entry = stats?.get(row.slug);
              const reason = entry?.discriminationGap ? gapReasons[entry.discriminationGap] : undefined;
              return (
                <tr data-question={row.slug}>
                  <td>
                    <div class="flex items-center gap-3">
                      <span class="min-w-8 font-display text-lg font-bold tabular-nums">{m.exams_attempt_question_short({ number: index + 1 })}</span>
                      <div class="min-w-0">
                        <Link href={course.question(row.slug)} class="link">{row.title}</Link>
                        {row.grading && <p class="text-sm text-muted">{row.grading}</p>}
                      </div>
                    </div>
                  </td>
                  <td class="text-sm text-muted">{row.type}</td>
                  <td class="text-center tabular-nums">{weightFormat.format(row.weight)}</td>
                  {stats && (
                    <td class="text-right tabular-nums">
                      {entry?.average != null ? formatScore(entry.average) : ""}
                    </td>
                  )}
                  {stats && (
                    <td class="text-center tabular-nums">
                      {entry?.discrimination != null ? (
                        twoDecimals.format(entry.discrimination)
                      ) : (
                        <span title={reason}>
                          <span aria-hidden="true">—</span>
                          {reason && <span class="sr-only">{reason}</span>}
                        </span>
                      )}
                    </td>
                  )}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )
  }
</section>
