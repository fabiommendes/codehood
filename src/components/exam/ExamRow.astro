---
// A single exam as a `ListRow` card: title, a detail line (type, duration,
// schedule), and a trailing status badge. Shared by the student exam list and
// the course home page's exam preview.
import ListRow from "@/components/ListRow.astro";
import type { Exam } from "@/db";
import { m } from "@/i18n";
import {
	type AttemptState,
	type ExceptionTiming,
	examPhase,
	personalTiming,
} from "@/services/exam-state";
import {
	examBadge,
	examTypeLabels,
	formatDuration,
} from "@/utils/exam-display";
import { formatDateTime } from "@/utils/schedule-time";

interface Props {
	exam: Exam;
	/** The course's base URL, e.g. `/cs101/ada_2026-1` — links to `${href}/exams/${slug}`. */
	href: string;
	/** The student's total as a percentage, when their grades are released and complete. */
	score?: string;
	/** The viewer's own attempt state, which replaces the phase badge once they have submitted. */
	state?: AttemptState;
	/** Answers still waiting for a grade, shown to whoever teaches the course. */
	pending?: number;
	/** Whether the badge may repeat the exam's phase, false under a heading that already says it. */
	phaseBadge?: boolean;
	/** The viewer's own exception on this exam, which moves the date and the phase shown. */
	exception?: ExceptionTiming | null;
}

const {
	exam,
	href,
	score,
	state,
	pending = 0,
	phaseBadge = true,
	exception = null,
} = Astro.props;

const timing = personalTiming(exam, exception);
const phase = examPhase(timing, new Date());
const badge = examBadge(phase, state);
/// A score already says the exam is graded, and a heading may already say its phase.
const showBadge =
	!score && (phaseBadge || badge.label !== examBadge(phase).label);
/// The date, or m.exams_not_scheduled() while that is still news; an exam opened or closed by hand has no date worth showing.
const schedule = timing.scheduledAt
	? formatDateTime(timing.scheduledAt)
	: phase === "upcoming"
		? "Not scheduled"
		: null;
const detail = [
	examTypeLabels[exam.type],
	formatDuration(exam.duration),
	schedule,
]
	.filter(Boolean)
	.join(" · ");
---

<ListRow href={`${href}/exams/${exam.slug}`} muted={phase === "draft"}>
  <p class="font-medium">{exam.title}</p>
  <p class="text-sm text-base-content/60">
    {detail}
    {pending > 0 && (
      <span class="font-medium text-base-content/80">
        {` · ${m.exams_row_answers_to_grade({ count: pending })}`}
      </span>
    )}
  </p>
  <span slot="trailing" class="flex items-center gap-3">
    {score && <span class="text-lg font-semibold">{score}</span>}
    {showBadge && (
      <span class:list={["badge badge-sm", badge.className]}>{badge.label}</span>
    )}
  </span>
</ListRow>
