---
// A single-row card: optional leading icon/chip/dot, main content, optional
// trailing badge/link/date. Renders as an <a> when href is given, a <button>
// that opens a <dialog> when openDialog is given (see AppLayout's generic
// data-open-dialog wiring), or a plain <div> otherwise. Used for exam,
// resource, and "upcoming" list rows across the app.
interface Props {
	href?: string;
	openDialog?: string;
	/** Downloads the link instead of following it, saved under this file name. */
	download?: string;
	/** Opens the link in another tab, without a referrer. */
	external?: boolean;
	muted?: boolean;
	class?: string;
}

const {
	href,
	openDialog,
	download,
	external = false,
	muted = false,
	class: className,
} = Astro.props;

const cardClass = [
	// A visible rule and a faint tint set the row apart from the page, which
	// is base-100 itself, in both themes.
	"card border border-base-content/15 bg-base-200/50",
	(href || openDialog) && "transition-colors hover:border-primary",
	openDialog && "w-full text-left",
	muted && "opacity-70",
	className,
]
	.filter(Boolean)
	.join(" ");

const Tag = href ? "a" : openDialog ? "button" : "div";
---

<Tag
  href={href}
  download={download}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  type={openDialog ? "button" : undefined}
  data-open-dialog={openDialog}
  class={cardClass}
>
  <div class="card-body flex-row items-center gap-4 py-4">
    <slot name="leading" />
    <div class="min-w-0 flex-1">
      <slot />
    </div>
    <slot name="trailing" />
  </div>
</Tag>
