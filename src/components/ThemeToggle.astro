---
import { m } from "@/i18n";

interface Props {
	class?: string;
	/// `menu` renders a labeled menu item that names the theme it switches to,
	/// for the user menu on small screens.
	variant?: "icon" | "menu";
}

const { class: className, variant = "icon" } = Astro.props;
---

{
  variant === "menu" ? (
    <button type="button" class={className} data-theme-toggle>
      <span class="theme-only-light">{m.common_dark_theme()}</span>
      <span class="theme-only-dark">{m.common_light_theme()}</span>
    </button>
  ) : (
<button type="button" class:list={["btn btn-square btn-ghost", className]} aria-label={m.common_dark_theme()} aria-pressed="false" data-theme-toggle>
  <svg class="theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
    <path
      d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    />
  </svg>
  <svg class="theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
  </svg>
</button>
  )
}

<style is:global>
  /* Only the icon matching the active theme is shown — see the inline anti-flash
     script in Layout.astro and the click handler below for how data-theme is set. */
  [data-theme="codehood-dark"] .theme-icon-sun {
    display: none;
  }
  [data-theme="codehood"] .theme-icon-moon {
    display: none;
  }
  [data-theme="codehood-dark"] .theme-only-light,
  [data-theme="codehood"] .theme-only-dark {
    display: none;
  }
</style>

<script>
	const STORAGE_KEY = "codehood-theme";

	const DARK = "codehood-dark";
	const LIGHT = "codehood";
	const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

	/// The theme the operating system asks for.
	const systemTheme = () => (systemDark.matches ? DARK : LIGHT);

	/// Shows `theme` on the page, on the icon toggles and in the browser's chrome.
	function apply(theme: string) {
		const dark = theme === DARK;
		document.documentElement.setAttribute("data-theme", theme);
		for (const btn of document.querySelectorAll("[data-theme-toggle][aria-pressed]")) {
			btn.setAttribute("aria-pressed", String(dark));
		}
		for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
			meta.content = (dark ? meta.dataset.dark : meta.dataset.light) ?? meta.content;
		}
	}

	apply(document.documentElement.getAttribute("data-theme") ?? systemTheme());

	// A choice is stored only while it differs from the system, so switching
	// back to the system's theme, here or in the OS, follows the OS again.
	document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const next = document.documentElement.getAttribute("data-theme") === DARK ? LIGHT : DARK;
			if (next === systemTheme()) localStorage.removeItem(STORAGE_KEY);
			else localStorage.setItem(STORAGE_KEY, next);
			apply(next);
		});
	});

	systemDark.addEventListener("change", () => {
		if (localStorage.getItem(STORAGE_KEY) === systemTheme()) localStorage.removeItem(STORAGE_KEY);
		if (!localStorage.getItem(STORAGE_KEY)) apply(systemTheme());
	});
</script>
