---
// The landing page's hero flourish (src/pages/index.astro), reused wherever the app
// wants the logo's non-gray colors as one quiet continuous stripe.
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={["brand-stripe inline-block h-1 w-9 rounded-full", className]}
  aria-hidden="true"></span>

<style>
  .brand-stripe {
    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-error),
      var(--color-warning),
      var(--color-success)
    );
  }
</style>
