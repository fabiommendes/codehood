---
import { LOGO, LOGO_BOX, LOGO_SQUARES, MARK } from "@/components/brand/paper";

interface Props {
	height?: number;
	class?: string;
	style?: string;
	/// `mark` draws the compact mark (C, o and the house) instead of the full logo.
	variant?: "full" | "mark";
}

const { height = 28, class: className, style, variant = "full" } = Astro.props;

/// Below this height the logo drops cut edges, tilt and flanks, and switches to
/// tone steps with a translucent outline in the dark theme (see
/// docs/ui/identity.md).
const SMALL = 32;

const small = variant === "mark" || height < SMALL;
const pieces = variant === "mark" ? MARK : LOGO;
const box =
	variant === "mark" ? LOGO_BOX.mark : small ? LOGO_BOX.core : LOGO_BOX.full;
const [, , boxWidth = 1, boxHeight = 1] = box.split(" ").map(Number);
const width = (height * boxWidth) / boxHeight;

/// Tilts each piece a little, as if glued by hand. Deterministic so the logo
/// looks the same on every render.
const tilt = (i: number) =>
	small ? undefined : `transform:rotate(${(((i * 37) % 7) - 3) * 0.8}deg)`;
---

<svg
  width={width}
  height={height}
  style={style}
  viewBox={box}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="codehood"
  class:list={["brand-logo", small && "is-small", className]}
>
  {
    small ? (
      <g class="lp-outline">
        {pieces.map((p) => (
          <path d={p.d} stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
        ))}
      </g>
    ) : (
      <>
        <filter id="brand-cut" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.12" numOctaves="2" seed="4" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.2" />
        </filter>
        {LOGO_SQUARES.map((d, i) => (
          <path class="lp-pixel" d={d} style={tilt(i)} filter="url(#brand-cut)" />
        ))}
      </>
    )
  }
  {
    pieces.map((p, i) => (
      <path
        class={`lp-${p.piece}`}
        d={p.d}
        style={tilt(i + LOGO_SQUARES.length)}
        filter={small ? undefined : "url(#brand-cut)"}
      />
    ))
  }
</svg>
