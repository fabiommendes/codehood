---
import { m } from "@/i18n";

interface Props {
	/// DOM id of the confirmation input.
	id: string;
	/// Name of the password input of the same form this one must match.
	matches?: string;
}

const { id, matches = "password" } = Astro.props;
---

<fieldset class="fieldset">
  <legend class="fieldset-legend"><label for={id}>{matches === "password" ? m.forms_password_confirm() : m.forms_password_confirm_new()}</label></legend>
  <input
    type="password"
    id={id}
    required
    minlength="8"
    autocomplete="new-password"
    class="input w-full"
    data-password-confirm={matches}
  />
  <p class="label whitespace-normal text-error" data-password-mismatch hidden>
    {m.forms_password_mismatch()}
  </p>
</fieldset>

<script>
  // Blocks the submit of any form holding a confirmation that differs from the
  // password it points at. The server never sees the confirmation.
  document.addEventListener("submit", (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement)) return;
    const confirm = form.querySelector<HTMLInputElement>(
      "[data-password-confirm]",
    );
    if (!confirm) return;
    const password = form.elements.namedItem(
      confirm.dataset.passwordConfirm ?? "password",
    ) as HTMLInputElement | null;
    const mismatch = form.querySelector<HTMLElement>("[data-password-mismatch]");
    const differs = password !== null && password.value !== confirm.value;
    if (differs) event.preventDefault();
    if (mismatch) mismatch.hidden = !differs;
  });
</script>
