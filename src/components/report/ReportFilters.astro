---
// The filters of a report queue: one button group per filter, each button a link that sets it in the query string.
import {
	type ReportKind,
	type ReportStatus,
	reportKind,
	reportStatus,
} from "@/core/schemas";
import { m } from "@/i18n";
import { ALL_REPORTS, type ReportFilters } from "@/utils/report-filters";
import { REPORT_KIND_LABELS, REPORT_STATUS_LABELS } from "@/utils/report-row";

interface Props {
	filters: ReportFilters;
	/// Hides the type filter, for a queue that holds a single type.
	hideKind?: boolean;
}

const { filters, hideKind = false } = Astro.props;

/// The queue's URL with `status` and `kind` replaced; `kind` is left out when unset or hidden.
function hrefWith(
	status: ReportStatus | null,
	kind: ReportKind | null,
): string {
	const params = new URLSearchParams({ status: status ?? ALL_REPORTS });
	if (kind && !hideKind) params.set("kind", kind);
	return `?${params}`;
}

const statusOptions = [
	...reportStatus.options.map((value) => ({
		value,
		label: REPORT_STATUS_LABELS[value](),
	})),
	{ value: null, label: m.report_filter_all() },
];
const kindOptions = [
	{ value: null, label: m.report_filter_all() },
	...reportKind.options.map((value) => ({
		value,
		label: REPORT_KIND_LABELS[value](),
	})),
];
---

<div class="mb-6 flex flex-wrap items-end gap-4">
  <div role="group" aria-label={m.report_filter_status()} class="join">
    {
      statusOptions.map((option) => (
        <a
          href={hrefWith(option.value, filters.kind)}
          class:list={["btn join-item", filters.status === option.value && "btn-active"]}
          aria-current={filters.status === option.value ? "true" : undefined}
        >
          {option.label}
        </a>
      ))
    }
  </div>
  {
    !hideKind && (
      <div role="group" aria-label={m.report_filter_type()} class="join">
        {kindOptions.map((option) => (
          <a
            href={hrefWith(filters.status, option.value)}
            class:list={["btn join-item", filters.kind === option.value && "btn-active"]}
            aria-current={filters.kind === option.value ? "true" : undefined}
          >
            {option.label}
          </a>
        ))}
      </div>
    )
  }
</div>
