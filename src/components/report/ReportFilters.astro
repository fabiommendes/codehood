---
import ToggleGroup from "@/components/ui/ToggleGroup";
// The filters of a report queue: one button group per filter, each button a link that sets it in the query string.
import {
	type ReportKind,
	type ReportStatus,
	reportKind,
	reportStatus,
} from "@/core/schemas/report";
import { m } from "@/i18n";
import { ALL_REPORTS, type ReportFilters } from "@/utils/report-filters";
import { REPORT_KIND_LABELS, REPORT_STATUS_LABELS } from "@/utils/report-row";

interface Props {
	filters: ReportFilters;
	/// Hides the type filter, for a queue that holds a single type.
	hideKind?: boolean;
}

const { filters, hideKind = false } = Astro.props;

/// The page size the queue's URL asks for, kept across filters.
const limit = Astro.url.searchParams.get("limit");

/// The first page of the queue with `status` and `kind` replaced; `kind` is left out when unset or hidden.
function hrefWith(
	status: ReportStatus | null,
	kind: ReportKind | null,
): string {
	const params = new URLSearchParams({ status: status ?? ALL_REPORTS });
	if (kind && !hideKind) params.set("kind", kind);
	if (limit) params.set("limit", limit);
	return `?${params}`;
}

const statusOptions = [
	...reportStatus.options.map((value) => ({
		value: value as ReportStatus | typeof ALL_REPORTS,
		label: REPORT_STATUS_LABELS[value](),
		href: hrefWith(value, filters.kind),
	})),
	{
		value: ALL_REPORTS,
		label: m.report_filter_all(),
		href: hrefWith(null, filters.kind),
	},
];
const kindOptions = [
	{
		value: ALL_REPORTS as ReportKind | typeof ALL_REPORTS,
		label: m.report_filter_all(),
		href: hrefWith(filters.status, null),
	},
	...reportKind.options.map((value) => ({
		value,
		label: REPORT_KIND_LABELS[value](),
		href: hrefWith(filters.status, value),
	})),
];
---

<div class="mb-6 flex flex-wrap items-end gap-4">
  <ToggleGroup
    label={m.report_filter_status()}
    options={statusOptions}
    value={filters.status ?? ALL_REPORTS}
  />
  {
    !hideKind && (
      <ToggleGroup
        label={m.report_filter_type()}
        options={kindOptions}
        value={filters.kind ?? ALL_REPORTS}
      />
    )
  }
</div>
