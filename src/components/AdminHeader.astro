---
// The header of every page under /admin: title, one line on what the section
// covers, and the tab strip. Same shape as CourseHeader, so the tabs stay in
// place while moving between pages and each page starts with its content.
import Tabs from "@/components/ui/Tabs.astro";
import { m } from "@/i18n";
import { ADMIN_TABS } from "@/utils/admin-tabs";

interface Props {
	active:
		| "overview"
		| "users"
		| "courses"
		| "disciplines"
		| "editions"
		| "reports";
}

const { active } = Astro.props;

const items = ADMIN_TABS;
---

<div data-page-header>
	<h1 class="text-3xl font-bold">{m.nav_admin()}</h1>
	<p class="mt-1 text-base-content/60">
		{m.nav_admin_intro()}
	</p>
</div>

<div class="mt-6">
	<Tabs items={items} active={active} />
</div>
