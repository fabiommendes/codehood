---
import PageKicker from "@/components/PageKicker.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { formatScore } from "@/services/exam-result";
import { loadStudentHome } from "@/utils/load-student-home";
import { formatRelative, formatTimeLeft } from "@/utils/relative-time";
import { formatDateTime } from "@/utils/schedule-time";

export const prerender = false;

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect("/login");

const now = new Date();
const home = await loadStudentHome(actor, now);
const busy =
	home.openNow.length +
		home.upcoming.length +
		home.today.length +
		home.results.length >
	0;

const exact = (date: Date) => formatDateTime(date, { year: "numeric" });
const clock = (date: Date) =>
	formatDateTime(date, {
		weekday: undefined,
		month: undefined,
		day: undefined,
	});
---

<AppLayout title="Home">
  <main class="mx-auto max-w-4xl px-4 py-10">
    <PageKicker text="Your term" squares />
    <h1 class="text-3xl font-bold">Home</h1>

    {
      home.openNow.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">Open now</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.openNow.map(({ course, exam, deadline, started }) => (
              <a
                href={`${course.href}/exams/${exam.slug}`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                      {deadline && !started && (
                        <span title={exact(deadline)}> · Closes {formatRelative(deadline, now)}</span>
                      )}
                    </p>
                  </div>
                  {started ? (
                    <span class="font-medium" title={deadline ? exact(deadline) : undefined}>
                      {deadline ? formatTimeLeft(deadline, now) : "In progress"}
                    </span>
                  ) : (
                    <span class="btn btn-primary btn-sm">Start</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.upcoming.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">Coming up</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.upcoming.map(({ course, exam, opensAt }) => (
              <a
                href={`${course.href}/exams/${exam.slug}`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                    </p>
                  </div>
                  <span title={exact(opensAt)}>Opens {formatRelative(opensAt, now)}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.today.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">Today</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.today.map(({ course, title, kind, startAt }) => (
              <a
                href={`${course.href}/schedule`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                      {kind === "CANCELLED" && " · Cancelled"}
                    </p>
                  </div>
                  <span title={exact(startAt)}>{clock(startAt)}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.results.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">New results</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.results.map(({ course, exam, total, releasedAt }) => (
              <a
                href={`${course.href}/exams/${exam.slug}`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                      <span title={exact(releasedAt)}> · Released {formatRelative(releasedAt, now)}</span>
                    </p>
                  </div>
                  {total === null ? (
                    <span class="text-base-content/70">Waiting for grades</span>
                  ) : (
                    <span class="text-lg font-semibold">{formatScore(total)}</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      !busy && (
        <section class="mt-8">
          <p class="text-lg font-medium">Nothing needs you right now</p>
          {home.next && (
            <p class="mt-1 text-sm text-base-content/70">
              Next:{" "}
              <span class="font-medium">
                {home.next.kind === "exam" ? home.next.exam.title : home.next.event.title}
              </span>{" "}
              · <span class="font-mono">{home.next.course.code}</span> ·{" "}
              <span title={exact(home.next.at)}>{formatRelative(home.next.at, now)}</span>
            </p>
          )}
        </section>
      )
    }
  </main>
</AppLayout>
