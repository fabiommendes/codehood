---
import EmptyState from "@/components/EmptyState.astro";
import PageKicker from "@/components/PageKicker.astro";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { formatScore } from "@/services/exam-result";
import { loadInstructorHome } from "@/utils/load-instructor-home";
import { loadStudentHome } from "@/utils/load-student-home";
import { formatRelative, formatTimeLeft } from "@/utils/relative-time";
import { formatDateTime } from "@/utils/schedule-time";

export const prerender = false;

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect("/login");

const now = new Date();
const [home, teaching] = await Promise.all([
	loadStudentHome(actor, now),
	loadInstructorHome(actor, now),
]);
const teachingBusy =
	teaching.inProgress.length +
		teaching.toGrade.length +
		teaching.regrades.length +
		teaching.toRelease.length +
		teaching.problems.length >
	0;
const studentBusy =
	home.openNow.length +
		home.upcoming.length +
		home.today.length +
		home.results.length +
		home.regrades.length >
	0;
const busy = teachingBusy || studentBusy;

const card =
	"card card-border bg-base-100 transition-colors hover:border-primary";

const exact = (date: Date) => formatDateTime(date, { year: "numeric" });
const clock = (date: Date) =>
	formatDateTime(date, {
		weekday: undefined,
		month: undefined,
		day: undefined,
	});
---

<AppLayout title={m.courses_home_title()}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <PageKicker text={m.courses_home_kicker()} squares />
    <h1 class="text-3xl font-bold">{m.courses_home_title()}</h1>

    {
      teaching.inProgress.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_in_progress()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.inProgress.map(({ course, exam, submitted, enrolled, closesAt }) => (
              <a href={`${course.href}/exams/${exam.slug}`} class={card}>
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                      {closesAt && (
                        <span title={exact(closesAt)}> · {m.courses_home_closes({ when: formatRelative(closesAt, now) })}</span>
                      )}
                    </p>
                  </div>
                  <span>{m.courses_home_submitted({ submitted, enrolled })}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      teaching.toGrade.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_to_grade()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.toGrade.map(({ course, exam, pending }) => (
              <a href={`${course.href}/exams/${exam.slug}/grading`} class={card}>
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                    </p>
                  </div>
                  <span>{m.courses_home_answers_to_grade({ count: pending })}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      teaching.regrades.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.grades_regrade_home_queue()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.regrades.map(({ course, exam, open }) => (
              <a href={`${course.href}/exams/${exam.slug}/regrades`} class={card}>
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                    </p>
                  </div>
                  <span>{m.grades_regrade_home_open({ count: open })}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      teaching.toRelease.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_ready_to_release()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.toRelease.map(({ course, exam, attempts }) => (
              <a href={`${course.href}/exams/${exam.slug}`} class={card}>
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                    </p>
                  </div>
                  <span>{m.courses_home_attempts_graded({ count: attempts })}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      teaching.problems.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_question_problems()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.problems.map(({ course, questions }) => (
              <a href={`${course.href}/questions`} class={card}>
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{course.name}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                    </p>
                  </div>
                  <span>{m.courses_home_questions_with_problems({ count: questions })}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.openNow.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_open_now()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.openNow.map(({ course, exam, deadline, started }) => (
              <a
                href={`${course.href}/exams/${exam.slug}`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                      {deadline && !started && (
                        <span title={exact(deadline)}> · {m.courses_home_closes({ when: formatRelative(deadline, now) })}</span>
                      )}
                    </p>
                  </div>
                  {started ? (
                    <span class="font-medium" title={deadline ? exact(deadline) : undefined}>
                      {deadline ? formatTimeLeft(deadline, now) : m.courses_home_status_in_progress()}
                    </span>
                  ) : (
                    <span class="btn btn-primary btn-sm">{m.courses_home_start()}</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.upcoming.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_coming_up()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.upcoming.map(({ course, exam, opensAt }) => (
              <a
                href={`${course.href}/exams/${exam.slug}`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                    </p>
                  </div>
                  <span title={exact(opensAt)}>{m.courses_home_opens({ when: formatRelative(opensAt, now) })}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.today.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_today()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.today.map(({ course, title, kind, startAt }) => (
              <a
                href={`${course.href}/schedule`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                      {kind === "CANCELLED" && ` · ${m.schedule_event_cancelled()}`}
                    </p>
                  </div>
                  <span title={exact(startAt)}>{clock(startAt)}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.results.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_new_results()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.results.map(({ course, exam, total, releasedAt }) => (
              <a
                href={`${course.href}/exams/${exam.slug}`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span>
                      <span title={exact(releasedAt)}> · {m.courses_home_released({ when: formatRelative(releasedAt, now) })}</span>
                    </p>
                  </div>
                  {total === null ? (
                    <span class="text-base-content/70">{m.courses_home_waiting_for_grades()}</span>
                  ) : (
                    <span class="text-lg font-semibold">{formatScore(total)}</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.regrades.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.grades_regrade_home_resolved()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.regrades.map(({ course, exam, request }) => (
              <a href={`${course.href}/exams/${exam.slug}`} class={card}>
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-base-content/60">
                      <span class="font-mono">{course.code}</span> · {request.question}
                    </p>
                  </div>
                  <span class:list={["badge", request.status === "ACCEPTED" ? "badge-success" : "badge-error"]}>
                    {request.status === "ACCEPTED" ? m.grades_regrade_accepted() : m.grades_regrade_rejected()}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      !busy && (
        <EmptyState scene="binaryTree" title={m.courses_home_idle_title()} class="mt-10">
          {home.next ? (
            <p>
              {m.courses_home_next()}{" "}
              <span class="font-medium">
                {home.next.kind === "exam" ? home.next.exam.title : home.next.event.title}
              </span>{" "}
              · <span class="font-mono">{home.next.course.code}</span> ·{" "}
              <span title={exact(home.next.at)}>{formatRelative(home.next.at, now)}</span>
            </p>
          ) : (
            <p>{m.courses_home_nothing_ahead()}</p>
          )}
        </EmptyState>
      )
    }
  </main>
</AppLayout>
