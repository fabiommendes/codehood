---
import CountRow from "@/components/CountRow.astro";
import EmptyState from "@/components/EmptyState.astro";
import PageKicker from "@/components/PageKicker.astro";
import OpenRollCallDialog from "@/components/roll-call/OpenRollCallDialog";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { formatScore } from "@/services/exam-result";
import { loadInstructorHome } from "@/utils/load-instructor-home";
import { loadStudentHome } from "@/utils/load-student-home";
import { formatRelative, formatTimeLeft } from "@/utils/relative-time";
import { formatDateTime } from "@/utils/schedule-time";

export const prerender = false;

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect("/login");

const now = new Date();
const [home, teaching] = await Promise.all([
	loadStudentHome(actor, now),
	loadInstructorHome(actor, now),
]);
const teachingBusy =
	teaching.today.length +
		teaching.reports.length +
		teaching.inProgress.length +
		teaching.toGrade.length +
		teaching.regrades.length +
		teaching.toRelease.length +
		teaching.problems.length >
	0;
const studentBusy =
	home.openNow.length +
		home.upcoming.length +
		home.today.length +
		home.results.length +
		home.regrades.length >
	0;
const busy = teachingBusy || studentBusy;

const card =
	"card card-border bg-base-100 transition-colors hover:border-primary";

/// Today's meetings and classes in one list, by start time; each says its role when the actor has both.
const today = [
	...teaching.today.map((meeting) => ({ teaching: meeting, event: meeting })),
	...home.today.map((event) => ({ teaching: undefined, event })),
].sort((a, b) => a.event.startAt.getTime() - b.event.startAt.getTime());
const showRole = teaching.today.length > 0 && home.today.length > 0;

/// The earlier of the two roles' next thing, for the idle page.
const next = [teaching.next, home.next]
	.filter((entry) => entry !== null)
	.sort((a, b) => a.at.getTime() - b.at.getTime())[0];

const exact = (date: Date) => formatDateTime(date, { year: "numeric" });
const clock = (date: Date) =>
	formatDateTime(date, {
		weekday: undefined,
		month: undefined,
		day: undefined,
	});
---

<AppLayout title={m.courses_home_title()}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <PageKicker text={m.courses_home_kicker()} squares />
    <h1 class="text-3xl font-bold">{m.courses_home_title()}</h1>

    {
      today.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_today()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {today.map(({ teaching: meeting, event }) => (
              <div class="card card-border bg-base-100">
                <div class="card-body flex-row flex-wrap items-center gap-x-4 gap-y-2 py-4">
                  <div class="min-w-0 flex-1">
                    <a href={`${event.course.href}/schedule`} class="font-medium link-hover">{event.title}</a>
                    <p class="text-sm text-muted">
                      <span class="font-mono">{event.course.code}</span>
                      {event.course.edition && ` · ${event.course.edition}`} ·{" "}
                      <time datetime={event.startAt.toISOString()} title={exact(event.startAt)}>
                        {meeting ? `${clock(meeting.startAt)}–${clock(meeting.endsAt)}` : clock(event.startAt)}
                      </time>
                      {event.kind === "CANCELLED" && ` · ${m.schedule_event_cancelled()}`}
                      {showRole && ` · ${meeting ? m.courses_home_role_teaching() : m.courses_home_role_taking()}`}
                    </p>
                  </div>
                  {meeting &&
                    meeting.kind === "REGULAR" &&
                    (meeting.rollCall === "none" ? (
                      <OpenRollCallDialog
                        client:load
                        label={m.courses_home_open_roll_call()}
                        discipline={meeting.meeting.discipline}
                        course={meeting.meeting.course}
                        week={meeting.meeting.week}
                        timeSlot={meeting.meeting.timeSlot}
                        href={meeting.course.href}
                        warning={
                          meeting.inMeeting
                            ? undefined
                            : m.attendance_open_outside_meeting({
                                start: clock(meeting.startAt),
                                end: clock(meeting.endsAt),
                              })
                        }
                      />
                    ) : (
                      <a
                        href={`${meeting.course.href}/roll-call/${meeting.meeting.week}/${meeting.meeting.timeSlot}`}
                        class:list={["btn btn-sm", meeting.rollCall === "open" ? "btn-primary" : "btn-ghost"]}
                      >
                        {m.courses_home_view_roll_call()}
                      </a>
                    ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      teaching.inProgress.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_in_progress()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.inProgress.map(({ course, exam, started, submitted, enrolled, personalWindows, closesAt }) =>
              personalWindows > 0 ? (
                <CountRow
                  href={`${course.href}/exams/${exam.slug}`}
                  count={personalWindows}
                  unit={m.courses_home_unit_personal_time()}
                  label={m.courses_home_personal_windows({ count: personalWindows })}
                  title={exam.title}
                  course={course}
                >
                  {closesAt && (
                    <time datetime={closesAt.toISOString()} title={exact(closesAt)}> · {m.courses_home_closes({ when: formatRelative(closesAt, now) })}</time>
                  )}
                  {started > 0 && ` · ${m.courses_home_answering_now({ count: started })}`}
                </CountRow>
              ) : (
                <CountRow
                  href={`${course.href}/exams/${exam.slug}`}
                  count={submitted}
                  of={enrolled}
                  unit={m.courses_home_unit_submitted()}
                  label={m.courses_home_submitted({ submitted, enrolled })}
                  title={exam.title}
                  course={course}
                >
                  {closesAt && (
                    <time datetime={closesAt.toISOString()} title={exact(closesAt)}> · {m.courses_home_closes({ when: formatRelative(closesAt, now) })}</time>
                  )}
                  {started > 0 && ` · ${m.courses_home_answering_now({ count: started })}`}
                </CountRow>
              ),
            )}
          </div>
        </section>
      )
    }

    {
      teaching.toGrade.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_to_grade()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.toGrade.map(({ course, exam, pending }) => (
              <CountRow
                href={`${course.href}/exams/${exam.slug}/grading`}
                count={pending}
                unit={m.courses_home_unit_to_grade()}
                label={m.courses_home_answers_to_grade({ count: pending })}
                title={exam.title}
                course={course}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      teaching.regrades.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.grades_regrade_home_queue()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.regrades.map(({ course, exam, open, oldest }) => (
              <CountRow
                href={`${course.href}/exams/${exam.slug}/regrades`}
                count={open}
                unit={m.courses_home_unit_open()}
                label={m.grades_regrade_home_open({ count: open })}
                title={exam.title}
                course={course}
              >
                {" · "}
                <time datetime={oldest.toISOString()} title={exact(oldest)}>
                  {m.courses_home_oldest_request({ when: formatRelative(oldest, now) })}
                </time>
              </CountRow>
            ))}
          </div>
        </section>
      )
    }

    {
      teaching.toRelease.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_ready_to_release()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.toRelease.map(({ course, exam, attempts }) => (
              <CountRow
                href={`${course.href}/exams/${exam.slug}`}
                count={attempts}
                unit={m.courses_home_unit_to_release()}
                label={m.courses_home_attempts_graded({ count: attempts })}
                title={exam.title}
                course={course}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      teaching.problems.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_question_problems()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.problems.map(({ course, questions }) => (
              <CountRow
                href={`${course.href}/questions`}
                count={questions}
                unit={m.courses_home_unit_with_problems()}
                label={m.courses_home_questions_with_problems({ count: questions })}
                title={course.name}
                course={course}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      teaching.reports.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_reports()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {teaching.reports.map(({ course, open }) => (
              <CountRow
                href={`${course.href}/reports`}
                count={open}
                unit={m.courses_home_unit_open()}
                label={m.courses_home_open_reports({ count: open })}
                title={course.name}
                course={course}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      home.openNow.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_open_now()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.openNow.map(({ course, exam, deadline, started }) => (
              <a
                href={`${course.href}/exams/${exam.slug}`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-muted">
                      <span class="font-mono">{course.code}</span>
                      {course.edition && ` · ${course.edition}`}
                      {deadline && !started && (
                        <time datetime={deadline.toISOString()} title={exact(deadline)}> · {m.courses_home_closes({ when: formatRelative(deadline, now) })}</time>
                      )}
                    </p>
                  </div>
                  {started ? (
                    <span class="font-medium" title={deadline ? exact(deadline) : undefined}>
                      {deadline ? formatTimeLeft(deadline, now) : m.courses_home_status_in_progress()}
                    </span>
                  ) : (
                    <span class="btn btn-primary btn-sm">{m.courses_home_start()}</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.upcoming.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_coming_up()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.upcoming.map(({ course, exam, opensAt }) => (
              <a
                href={`${course.href}/exams/${exam.slug}`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-muted">
                      <span class="font-mono">{course.code}</span>
                      {course.edition && ` · ${course.edition}`}
                    </p>
                  </div>
                  <time datetime={opensAt.toISOString()} title={exact(opensAt)}>{m.courses_home_opens({ when: formatRelative(opensAt, now) })}</time>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.results.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.courses_home_new_results()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.results.map(({ course, exam, total, releasedAt }) => (
              <a
                href={`${course.href}/exams/${exam.slug}`}
                class="card card-border bg-base-100 transition-colors hover:border-primary"
              >
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-muted">
                      <span class="font-mono">{course.code}</span>
                      {course.edition && ` · ${course.edition}`}
                      <time datetime={releasedAt.toISOString()} title={exact(releasedAt)}> · {m.courses_home_released({ when: formatRelative(releasedAt, now) })}</time>
                    </p>
                  </div>
                  {total === null ? (
                    <span class="text-base-content/70">{m.courses_home_waiting_for_grades()}</span>
                  ) : (
                    <span class="text-lg font-semibold">{formatScore(total)}</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      home.regrades.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{m.grades_regrade_home_resolved()}</h2>
          <div class="mt-3 flex flex-col gap-3">
            {home.regrades.map(({ course, exam, request, questionTitle }) => (
              <a href={`${course.href}/exams/${exam.slug}`} class={card}>
                <div class="card-body flex-row items-center gap-4 py-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">{exam.title}</p>
                    <p class="text-sm text-muted">
                      <span class="font-mono">{course.code}</span>
                      {course.edition && ` · ${course.edition}`} · {questionTitle ?? request.question}
                    </p>
                  </div>
                  <span class:list={["badge", request.status === "ACCEPTED" ? "badge-success" : "badge-error"]}>
                    {request.status === "ACCEPTED" ? m.grades_regrade_accepted() : m.grades_regrade_rejected()}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      !busy && (
        <EmptyState scene="binaryTree" title={m.courses_home_idle_title()} class="mt-10">
          {next ? (
            <p>
              {m.courses_home_next()}{" "}
              <span class="font-medium">
                {next.kind === "exam" ? next.exam.title : next.event.title}
              </span>{" "}
              · <span class="font-mono">{next.course.code}</span> ·{" "}
              <time datetime={next.at.toISOString()} title={exact(next.at)}>{formatRelative(next.at, now)}</time>
            </p>
          ) : (
            <p>{m.courses_home_nothing_ahead()}</p>
          )}
        </EmptyState>
      )
    }
  </main>
</AppLayout>
