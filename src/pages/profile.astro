---
export const prerender = false;

import { actions } from "astro:actions";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import PageKicker from "@/components/PageKicker.astro";
import PasswordConfirm from "@/components/PasswordConfirm.astro";
import Tabs from "@/components/ui/Tabs.astro";
import { apiKeyForm, passwordChange, profileUpdate } from "@/core/schemas";
import { type ApiKey, db } from "@/db";
import { errorMessage } from "@/forms/field-errors";
import { actionForm } from "@/forms/form-state";
import { locale, m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { roleLabels } from "@/utils/roles";

const logoutEverywhereResult = Astro.getActionResult(
	actions.profile.logoutEverywhere,
);
if (logoutEverywhereResult && !logoutEverywhereResult.error) {
	return Astro.redirect("/login");
}

if (!Astro.locals.actor) {
	return Astro.redirect("/login");
}

const actor = Astro.locals.actor;
const user = await db.user.findOne({ username: actor.username }, { actor });
if (!user) {
	return Astro.redirect("/login");
}

const apiKeys = await db.apiKey.findMany(
	{ createdBy: user.username },
	{ actor },
);

const calendarFeed = await db.calendarFeed.get(user.username, { actor });
const rotateFeedResult = Astro.getActionResult(
	actions.profile.rotateCalendarFeed,
);
const removeFeedResult = Astro.getActionResult(
	actions.profile.removeCalendarFeed,
);
const feedUrl = calendarFeed
	? `${Astro.url.origin}/calendar/${calendarFeed.token}.ics`
	: null;

const updateResult = Astro.getActionResult(actions.profile.update);
const passwordResult = Astro.getActionResult(actions.profile.changePassword);
const createApiKeyResult = Astro.getActionResult(actions.auth.createApiKey);
const revokeApiKeyResult = Astro.getActionResult(actions.auth.revokeApiKey);

const updateForm = await actionForm(
	Astro,
	actions.profile.update,
	profileUpdate,
	{ id: "profile" },
);
const passwordForm = await actionForm(
	Astro,
	actions.profile.changePassword,
	passwordChange,
	{ id: "password-change" },
);
const apiKeyCreateForm = await actionForm(
	Astro,
	actions.auth.createApiKey,
	apiKeyForm,
	{ id: "api-key" },
);

/// The profile field `name`: the stored value, or what was typed when the save was refused. GitHub and school id are required of students only.
function profileField(name: "name" | "email" | "githubId" | "schoolId") {
	const field = updateForm.field(name);
	const required =
		name === "githubId" || name === "schoolId"
			? user?.role === "STUDENT"
			: field.required;
	const shown = updateResult?.error
		? field
		: { ...field, value: user?.[name] ?? "" };
	return { ...shown, required };
}

function formatDate(date: Date | null): string {
	if (!date) return m.profile_never();
	return date.toLocaleDateString(locale, {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}

// Land on whichever tab the just-submitted form lives on, so a validation
// error (or a fresh success message) doesn't get hidden behind "Details".
const activeTab: "details" | "account" | "apikeys" | "calendar" =
	createApiKeyResult || revokeApiKeyResult
		? "apikeys"
		: passwordResult || logoutEverywhereResult
			? "account"
			: rotateFeedResult ||
					removeFeedResult ||
					Astro.url.searchParams.get("tab") === "calendar"
				? "calendar"
				: "details";

const profileTabs = [
	{ key: "details", label: m.profile_tab_details() },
	{ key: "account", label: m.profile_tab_account() },
	{ key: "apikeys", label: m.profile_tab_api_keys() },
	{ key: "calendar", label: m.profile_tab_calendar() },
];
---

<AppLayout title={m.profile_title()}>
  <main class="mx-auto flex max-w-4xl flex-col gap-6 px-4 py-10">
    <div>
      <PageKicker text={m.profile_kicker()} />
      <h1 class="text-2xl font-bold">{m.profile_title()}</h1>
    </div>

    <Tabs items={profileTabs} active={activeTab} name="profile-tabs">
      <Fragment slot="details">
        <div class="flex flex-col gap-8">
          <div class="card card-border">
            <div class="card-body">
              <div class="flex items-center justify-between">
                <h2 class="card-title">{m.profile_details_heading()}</h2>
                <span class="badge badge-neutral">{roleLabels[user.role]}</span>
              </div>

              {
                updateResult && !updateResult.error && (
                  <div role="alert" class="alert alert-success">
                    <span>{m.profile_updated()}</span>
                  </div>
                )
              }

              <form
                method="POST"
                action={actions.profile.update}
                class="flex flex-col gap-4"
              >
                <FormAlert error={updateForm.error} />
                <Field {...profileField("name")} />
                <Field {...profileField("email")} />

                <fieldset class="fieldset">
                  <legend class="fieldset-legend">{m.profile_username_label()}</legend>
                  <input
                    type="text"
                    value={user.username}
                    class="input w-full"
                    disabled
                  />
                  <p class="label whitespace-normal">
                    {m.profile_username_note()}
                  </p>
                </fieldset>

                <Field {...profileField("githubId")} />
                <Field {...profileField("schoolId")} />

                <div class="card-actions">
                  <button type="submit" class="btn btn-primary"
                    >{m.profile_save()}</button
                  >
                </div>
              </form>
            </div>
          </div>
        </div>
      </Fragment>

      <Fragment slot="account">
        <div class="flex flex-col gap-8">
          <div class="card card-border">
            <div class="card-body">
              <h2 class="card-title">{m.profile_password_heading()}</h2>
              <p class="text-sm text-base-content/60">
                {m.profile_password_note()}
              </p>

              {
                passwordResult && !passwordResult.error && (
                  <div role="alert" class="alert alert-success">
                    <span>{m.profile_password_changed()}</span>
                  </div>
                )
              }

              <form
                method="POST"
                action={actions.profile.changePassword}
                class="flex flex-col gap-4"
              >
                <FormAlert error={passwordForm.error} />
                <Field {...passwordForm.field("currentPassword")} control={{ autocomplete: "current-password" }} />
                <Field {...passwordForm.field("newPassword")} control={{ autocomplete: "new-password" }} />
                <PasswordConfirm id="password-change-confirm" matches="newPassword" />

                <div class="card-actions">
                  <button type="submit" class="btn btn-primary"
                    >{m.profile_password_heading()}</button
                  >
                </div>
              </form>
            </div>
          </div>

          <div class="card card-border">
            <div class="card-body">
              <h2 class="card-title">{m.profile_security_heading()}</h2>
              <p class="text-sm text-base-content/60">
                {m.profile_security_note()}
              </p>
              <FormAlert error={logoutEverywhereResult?.error && errorMessage(logoutEverywhereResult.error)} />
              <form
                method="POST"
                action={actions.profile.logoutEverywhere}
                class="card-actions"
              >
                <button type="submit" class="btn btn-outline btn-error"
                  >{m.profile_logout_everywhere()}</button
                >
              </form>
            </div>
          </div>
        </div>
      </Fragment>

      <Fragment slot="apikeys">
        <div>
          <div class="card card-border">
            <div class="card-body">
              <h2 class="card-title">{m.profile_api_keys_heading()}</h2>
              <p class="text-sm text-base-content/60">
                {m.profile_api_keys_note()}
              </p>
              <a
                href="/getting-started"
                class="text-sm text-primary hover:underline"
                >{m.profile_api_keys_guide()}</a
              >

              {
                createApiKeyResult && !createApiKeyResult.error && (
                  <div
                    role="alert"
                    class="alert alert-success flex-col items-start"
                  >
                    <span>{m.profile_api_key_created()}</span>
                    <code class="w-full break-all rounded bg-base-300 px-2 py-1 text-xs">
                      {createApiKeyResult.data.token}
                    </code>
                  </div>
                )
              }
              <FormAlert error={revokeApiKeyResult?.error && errorMessage(revokeApiKeyResult.error)} />

              {
                apiKeys.length > 0 && (
                  <ul class="list">
                    {apiKeys.map((key: ApiKey) => (
                      <li class="list-row items-center">
                        <div>
                          <div class="font-medium">{key.name}</div>
                          <div class="text-xs text-base-content/60">
                            {m.profile_api_key_dates({
                              created: formatDate(key.createdAt),
                              lastUsed: formatDate(key.lastUsedAt),
                            })}
                          </div>
                        </div>
                        <span class="badge badge-outline">
                          {key.kind.toLowerCase()}
                        </span>
                        <form method="POST" action={actions.auth.revokeApiKey}>
                          <input
                            type="hidden"
                            name="publicId"
                            value={key.publicId}
                          />
                          <button type="submit" class="btn btn-sm btn-ghost">
                            {m.profile_api_key_revoke()}
                          </button>
                        </form>
                      </li>
                    ))}
                  </ul>
                )
              }

              <div class="divider"></div>

              <form
                method="POST"
                action={actions.auth.createApiKey}
                class="flex flex-wrap items-end gap-4"
              >
                <FormAlert error={apiKeyCreateForm.error} class="w-full" />
                <Field {...apiKeyCreateForm.field("name")} />
                <fieldset class="fieldset">
                  <legend class="fieldset-legend"><label for="api-key-kind">{m.profile_api_key_kind()}</label></legend>
                  <select name="kind" id="api-key-kind" class="select">
                    <option value="CLI">CLI</option>
                    <option value="BOT">{m.profile_api_key_kind_bot()}</option>
                  </select>
                </fieldset>

                <button type="submit" class="btn">{m.profile_api_key_create()}</button>
              </form>
            </div>
          </div>
        </div>
      </Fragment>

      <Fragment slot="calendar">
        <div class="card card-border">
          <div class="card-body">
            <h2 class="card-title">{m.profile_calendar_heading()}</h2>
            <p class="text-sm text-base-content/60">
              {m.profile_calendar_note()}
            </p>
            <FormAlert
              error={(rotateFeedResult?.error && errorMessage(rotateFeedResult.error)) ||
                (removeFeedResult?.error && errorMessage(removeFeedResult.error))}
            />

            {
              feedUrl && calendarFeed ? (
                <>
                  <fieldset class="fieldset">
                    <legend class="fieldset-legend">
                      <label for="calendar-feed-url">{m.profile_calendar_link()}</label>
                    </legend>
                    <div class="join w-full">
                      <input
                        id="calendar-feed-url"
                        type="text"
                        readonly
                        value={feedUrl}
                        class="input join-item w-full"
                      />
                      <button
                        type="button"
                        class="btn join-item"
                        data-copy-from="calendar-feed-url"
                        data-copied={m.profile_calendar_copied()}
                      >
                        {m.profile_calendar_copy()}
                      </button>
                    </div>
                  </fieldset>
                  <p class="text-xs text-base-content/60">
                    {calendarFeed.lastUsedAt
                      ? m.profile_calendar_last_used({ date: formatDate(calendarFeed.lastUsedAt) })
                      : m.profile_calendar_never_used()}
                  </p>
                  <div role="alert" class="alert alert-warning">
                    <span>{m.profile_calendar_warning()}</span>
                  </div>
                  <div class="card-actions">
                    <form method="POST" action={actions.profile.rotateCalendarFeed}>
                      <button type="submit" class="btn">{m.profile_calendar_rotate()}</button>
                    </form>
                    <form method="POST" action={actions.profile.removeCalendarFeed}>
                      <button type="submit" class="btn btn-outline btn-error"
                        >{m.profile_calendar_remove()}</button
                      >
                    </form>
                  </div>
                </>
              ) : (
                <form method="POST" action={actions.profile.rotateCalendarFeed} class="card-actions">
                  <button type="submit" class="btn btn-primary">{m.profile_calendar_create()}</button>
                </form>
              )
            }
          </div>
        </div>
      </Fragment>
    </Tabs>
  </main>
</AppLayout>

<script>
  // Copies the value of the input a button points to, and flashes its label.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-from]")) {
    button.addEventListener("click", async () => {
      const input = document.getElementById(button.dataset.copyFrom ?? "");
      if (!(input instanceof HTMLInputElement)) return;
      await navigator.clipboard.writeText(input.value);
      const label = button.textContent;
      button.textContent = button.dataset.copied ?? label;
      setTimeout(() => {
        button.textContent = label;
      }, 1500);
    });
  }
</script>
