---
export const prerender = false;

import { actions } from "astro:actions";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import { sessionLogin } from "@/core/schemas";
import { actionForm } from "@/forms/form-state";
import CenteredLayout from "@/layouts/CenteredLayout.astro";

/// Where to go after logging in. Only paths on this site are accepted, so the
/// parameter cannot send someone to another origin.
const localPath = (value: unknown) =>
	typeof value === "string" && /^\/(?![/\\])/.test(value) ? value : "/";

// The action posts back to `?_action=...`, which drops the query string, so the
// form carries `next` along.
const result = Astro.getActionResult(actions.auth.login);
const next = localPath(
	result
		? (await Astro.request.clone().formData()).get("next")
		: Astro.url.searchParams.get("next"),
);
if (result && !result.error) {
	return Astro.redirect(next);
}

const form = await actionForm(Astro, actions.auth.login, sessionLogin, {
	id: "login",
});
---

<CenteredLayout title="Log in">
  <form method="POST" action={actions.auth.login} class="flex flex-col gap-4">
    <input type="hidden" name="next" value={next} />
    <FormAlert error={form.error} />
    <Field {...form.field("login")} />
    <Field {...form.field("password")} />

    <div class="card-actions">
      <button type="submit" class="btn btn-primary btn-block rounded-full">Log in</button>
    </div>
  </form>
</CenteredLayout>
