---
export const prerender = false;

import { actions } from "astro:actions";
import CenteredLayout from "@/layouts/CenteredLayout.astro";

const result = Astro.getActionResult(actions.auth.login);
if (result && !result.error) {
	return Astro.redirect("/");
}
---

<CenteredLayout title="Log in">
  {
    result?.error && (
      <div role="alert" class="alert alert-error">
        <span>{result.error.message}</span>
      </div>
    )
  }

  <form method="POST" action={actions.auth.login} class="flex flex-col gap-4">
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Email or username</legend>
      <input type="text" name="login" required class="input w-full" />
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Password</legend>
      <input type="password" name="password" required class="input w-full" />
    </fieldset>

    <div class="card-actions">
      <button type="submit" class="btn btn-primary btn-block rounded-full">Log in</button>
    </div>
  </form>
</CenteredLayout>
