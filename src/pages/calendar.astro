---
// The viewer's own schedule, aggregated across every course they take or
// teach (FR-CAL-021): what comes up next, then a month grid navigated with
// ?month=YYYY-MM and the month's meetings and dated exams listed by day, so a
// phone, which only has room for dots in the grid, still reads every title.
// The month defaults to the next entry's (or the last one's) in the server
// zone.
import ListRow from "@/components/ListRow.astro";
import PageKicker from "@/components/PageKicker.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Alert from "@/components/ui/Alert";
import { db } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import {
	type CalendarEntry,
	calendarEntries,
} from "@/services/calendar-entries";
import { courseHref } from "@/urls";
import { examTypeLabels, formatDuration } from "@/utils/exam-display";
import { formatDateTime, localDateOf, toInstant } from "@/utils/schedule-time";

export const prerender = false;

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect("/login");

const courses = await db.course.findMany({}, { actor });
const courseIds = courses.map((c) => c.id);

// A per-course color dot, cycling through a fixed palette so the same course
// always reads the same color within one page load.
const DOT_PALETTE = [
	"bg-primary",
	"bg-error",
	"bg-warning",
	"bg-success",
	"bg-info",
	"bg-secondary",
	"bg-accent",
	"bg-neutral",
];
const courseColor = new Map(
	courses.map((c, i) => [c.id, DOT_PALETTE[i % DOT_PALETTE.length]]),
);
const courseHrefs = new Map(
	courses.map((c) => [
		c.id,
		courseHref({
			discipline: c.discipline.slug,
			instructor: c.instructor.username,
			edition: c.edition.slug,
		}),
	]),
);
const courseNames = new Map(courses.map((c) => [c.id, c.discipline.name]));

const now = new Date();

const events =
	courseIds.length > 0
		? await db.calendarEvent.findMany({ courseIds }, { actor })
		: [];
const exams = (
	await Promise.all(
		courses.map(async (course) =>
			(
				await db.exam.findMany({ course: course.id }, { actor })
			).map((exam) => ({ courseId: course.id, exam })),
		),
	)
).flat();
const entries = calendarEntries(events, exams);

const monthParam = Astro.url.searchParams.get("month");
const monthMatch = monthParam?.match(/^(\d{4})-(\d{2})$/);
// Without ?month, open on the next entry's month, else the last one's, else today's.
const defaultMonthDate =
	entries.find((entry) => entry.endAt >= now)?.startAt ??
	entries.at(-1)?.startAt ??
	now;
const [year, month] = (
	monthMatch
		? [Number(monthMatch[1]), Number(monthMatch[2])]
		: localDateOf(defaultMonthDate).slice(0, 7).split("-").map(Number)
) as [number, number];

const monthStart = toInstant(`${year}-${String(month).padStart(2, "0")}-01`, 0);
const nextMonthYear = month === 12 ? year + 1 : year;
const nextMonth = month === 12 ? 1 : month + 1;
const monthEnd = toInstant(
	`${nextMonthYear}-${String(nextMonth).padStart(2, "0")}-01`,
	0,
);

const today = localDateOf(now);
const currentMonth = today.slice(0, 7);
const shownMonth = `${year}-${String(month).padStart(2, "0")}`;
const todayHref = `/calendar?month=${currentMonth}`;

const prevMonth = month === 1 ? 12 : month - 1;
const prevMonthYear = month === 1 ? year - 1 : year;
const nextHref = `/calendar?month=${nextMonthYear}-${String(nextMonth).padStart(2, "0")}`;
const prevHref = `/calendar?month=${prevMonthYear}-${String(prevMonth).padStart(2, "0")}`;

// Paging stops at the months that hold something: the first and last entry,
// and today. Beyond them every month is empty.
const entryMonths = entries.map((entry) =>
	localDateOf(entry.startAt).slice(0, 7),
);
const firstMonth = [currentMonth, ...entryMonths].reduce((a, b) =>
	a < b ? a : b,
);
const lastMonth = [currentMonth, ...entryMonths].reduce((a, b) =>
	a > b ? a : b,
);
const hasPrev = shownMonth > firstMonth;
const hasNext = shownMonth < lastMonth;

const monthEntries = entries.filter(
	(entry) => entry.startAt >= monthStart && entry.startAt < monthEnd,
);

const entriesByDay = new Map<string, CalendarEntry[]>();
for (const entry of monthEntries) {
	const day = localDateOf(entry.startAt);
	entriesByDay.set(day, [...(entriesByDay.get(day) ?? []), entry]);
}

const upcoming = entries.filter((entry) => entry.endAt >= now).slice(0, 5);

/// A day's heading in the month's list, e.g. "Mon, Jan 12".
function dayLabel(instant: Date): string {
	return formatDateTime(instant, { hour: undefined, minute: undefined });
}

/// An event's start on the 24-hour clock, e.g. "14:00".
function startTime(instant: Date): string {
	return formatDateTime(instant, {
		weekday: undefined,
		month: undefined,
		day: undefined,
	});
}

/// Where an entry leads: a meeting to its course's schedule, an exam to its own page.
function entryHref(entry: CalendarEntry): string | undefined {
	const href = courseHrefs.get(entry.courseId);
	if (!href) return undefined;
	return entry.kind === "exam"
		? `${href}/exams/${entry.exam.slug}`
		: `${href}/schedule`;
}

/// An entry's title as its course wrote it.
function entryTitle(entry: CalendarEntry): string {
	return entry.kind === "exam" ? entry.exam.title : entry.event.title;
}

/// The marker shape before an entry, a dot for a meeting and a square for an exam.
function markerShape(entry: CalendarEntry): string {
	return entry.kind === "exam" ? "rounded-[2px]" : "rounded-full";
}

/// A grid cell's first `count` entries, exams ahead of meetings so an exam is the last to fold into "+N more".
function cellEntries(dayEntries: CalendarEntry[], count: number) {
	return [
		...dayEntries.filter((entry) => entry.kind === "exam"),
		...dayEntries.filter((entry) => entry.kind === "event"),
	].slice(0, count);
}

const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
const startWeekday = new Date(Date.UTC(year, month - 1, 1)).getUTCDay();
const cells: (number | null)[] = [
	...Array(startWeekday).fill(null),
	...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
const weekdayLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
// timeZone: "UTC" is deliberate and correct here, not a violation of "always
// render in SERVER_TZ": the Date above is a pure calendar-math placeholder
// built with Date.UTC from already-resolved year/month integers, not an
// authored instant, so formatting it in any other zone could shift the
// calendar date it represents (the exact "Jan 31 for Feb 1st" bug the
// SERVER_TZ rule exists to prevent — see src/utils/schedule-time.ts).
const monthLabel = new Intl.DateTimeFormat("en-US", {
	month: "long",
	year: "numeric",
	timeZone: "UTC",
}).format(new Date(Date.UTC(year, month - 1, 1)));
---

<AppLayout title="Calendar">
  <main class="mx-auto max-w-4xl px-4 py-10">
    <PageKicker text="Term overview" squares />
    <h1 class="text-3xl font-bold">Calendar</h1>
    <p class="mt-2 text-base-content/70">
      Your schedule across every course you take or teach.
    </p>

    {
      courses.length === 0 && (
        <Alert variant="info" class="mt-6">
          <span>You're not enrolled in or teaching any courses yet.</span>
        </Alert>
      )
    }

    <section class="mt-8" aria-label="Upcoming">
      <SectionHeader title="Upcoming" />
      {
        upcoming.length === 0 ? (
          <p class="mt-4 text-sm text-base-content/60">Nothing coming up.</p>
        ) : (
          <div class="mt-4 flex flex-col gap-3">
            {upcoming.map((entry) => (
              <ListRow href={entryHref(entry)}>
                <span
                  slot="leading"
                  class:list={[
                    "inline-block h-2.5 w-2.5 shrink-0",
                    markerShape(entry),
                    courseColor.get(entry.courseId),
                  ]}
                />
                <p class="font-medium">
                  {entryTitle(entry)}
                  {entry.kind === "exam" && (
                    <span class="badge badge-secondary badge-sm ml-2">
                      {examTypeLabels[entry.exam.type]}
                    </span>
                  )}
                </p>
                <p class="text-sm text-base-content/60">
                  {courseNames.get(entry.courseId)}
                  {entry.kind === "exam" && entry.exam.duration && (
                    <span> · {formatDuration(entry.exam.duration)}</span>
                  )}
                </p>
                <span slot="trailing" class="text-sm text-base-content/60">
                  {formatDateTime(entry.startAt)}
                </span>
              </ListRow>
            ))}
          </div>
        )
      }
    </section>

    <div class="mt-10 rounded-box border border-base-300 bg-base-100 p-3 sm:p-5">
      <div class="flex items-center justify-between">
        {
          hasPrev ? (
            <a href={prevHref} class="btn btn-ghost btn-sm" aria-label="Previous month">
              ←
            </a>
          ) : (
            <span class="btn btn-ghost btn-sm invisible" aria-hidden="true">
              ←
            </span>
          )
        }
        <div class="flex items-center gap-3">
          <h2 class="font-display text-lg font-semibold">{monthLabel}</h2>
          {
            shownMonth !== currentMonth && (
              <a href={todayHref} class="btn btn-outline btn-xs">
                Today
              </a>
            )
          }
        </div>
        {
          hasNext ? (
            <a href={nextHref} class="btn btn-ghost btn-sm" aria-label="Next month">
              →
            </a>
          ) : (
            <span class="btn btn-ghost btn-sm invisible" aria-hidden="true">
              →
            </span>
          )
        }
      </div>

      <div
        class="mt-4 grid grid-cols-7 gap-1 text-center text-xs text-base-content/50"
      >
        {weekdayLabels.map((day) => <div class="py-1">{day}</div>)}
      </div>
      <div class="grid grid-cols-7 gap-1">
        {
          cells.map((day) => {
            if (!day) return <div />;
            const dayKey = `${shownMonth}-${String(day).padStart(2, "0")}`;
            const dayEntries = entriesByDay.get(dayKey) ?? [];
            const isToday = dayKey === today;
            const isPast = dayKey < today;
            const Cell = dayEntries.length > 0 ? "a" : "div";
            return (
              <Cell
                href={dayEntries.length > 0 ? `#day-${dayKey}` : undefined}
                aria-current={isToday ? "date" : undefined}
                class:list={[
                  "flex h-14 flex-col items-center gap-1 rounded-field border p-1 text-sm sm:h-16",
                  dayEntries.length > 0
                    ? "border-primary/40 bg-primary/5 transition-colors hover:border-primary"
                    : "border-base-300",
                  isToday && "border-primary ring-1 ring-primary",
                ]}
              >
                <span
                  class:list={[
                    isToday
                      ? "rounded-full bg-primary px-1.5 font-semibold text-primary-content"
                      : dayEntries.length > 0
                        ? "font-semibold"
                        : "text-base-content/70",
                    isPast && !isToday && "opacity-50",
                  ]}
                >
                  {day}
                </span>
                {/* Phones get one marker per entry; the titles are in the list below. */}
                <span class="flex gap-0.5 sm:hidden">
                  {cellEntries(dayEntries, 3).map((entry) => (
                    <span
                      class:list={[
                        "inline-block h-1.5 w-1.5",
                        markerShape(entry),
                        courseColor.get(entry.courseId),
                      ]}
                    />
                  ))}
                </span>
                {cellEntries(dayEntries, 2).map((entry) =>
                  entry.kind === "exam" ? (
                    <span
                      title={entry.exam.title}
                      class="hidden w-full min-w-0 items-center gap-1 rounded-sm bg-secondary/15 px-0.5 text-[10px] text-base-content sm:flex"
                    >
                      <span
                        class:list={[
                          "inline-block h-1.5 w-1.5 shrink-0",
                          markerShape(entry),
                          courseColor.get(entry.courseId),
                        ]}
                      />
                      <span class="shrink-0 font-semibold">
                        {examTypeLabels[entry.exam.type]}
                      </span>
                      <span class="truncate">{entry.exam.title}</span>
                    </span>
                  ) : (
                    <span
                      title={entry.event.title}
                      class="hidden w-full min-w-0 items-center gap-1 text-[10px] text-base-content/60 sm:flex"
                    >
                      <span
                        class:list={[
                          "inline-block h-1.5 w-1.5 shrink-0",
                          markerShape(entry),
                          courseColor.get(entry.courseId),
                        ]}
                      />
                      <span class="truncate">{entry.event.title}</span>
                    </span>
                  ),
                )}
                {dayEntries.length > 2 && (
                  <span class="hidden text-[10px] text-base-content/40 sm:inline">
                    +{dayEntries.length - 2} more
                  </span>
                )}
              </Cell>
            );
          })
        }
      </div>

      {
        monthEntries.length === 0 && courses.length > 0 && (
          <p class="mt-4 text-center text-sm text-base-content/50">
            Nothing scheduled this month.
          </p>
        )
      }
    </div>

    {
      monthEntries.length > 0 && (
        <section class="mt-6" aria-label={`Events in ${monthLabel}`}>
          <ol class="flex flex-col gap-4">
            {[...entriesByDay].map(([dayKey, dayEntries]) => (
              <li id={`day-${dayKey}`} class="group scroll-mt-20">
                <h3
                  class:list={[
                    "text-sm font-semibold group-target:text-primary",
                    dayKey < today && "text-base-content/50",
                  ]}
                >
                  {dayLabel(dayEntries[0]!.startAt)}
                  {dayKey === today && <span class="badge badge-primary badge-sm ml-2">Today</span>}
                </h3>
                <ul class="mt-2 divide-y divide-base-300 rounded-box border border-base-300 bg-base-100 group-target:border-primary">
                  {dayEntries.map((entry) => (
                    <li>
                      <a
                        href={entryHref(entry)}
                        class="flex items-baseline gap-3 px-4 py-2.5 text-sm hover:bg-base-200"
                      >
                        <span class="w-12 shrink-0 tabular-nums text-base-content/60">
                          {startTime(entry.startAt)}
                        </span>
                        <span
                          class:list={[
                            "inline-block h-2 w-2 shrink-0 self-center",
                            markerShape(entry),
                            courseColor.get(entry.courseId),
                          ]}
                        />
                        {entry.kind === "exam" ? (
                          <span class="min-w-0 flex-1">
                            <span class="font-medium">{entry.exam.title}</span>
                            <span class="badge badge-secondary badge-sm ml-2">
                              {examTypeLabels[entry.exam.type]}
                            </span>
                            <span class="block text-xs text-base-content/60 sm:ml-2 sm:inline">
                              {courseNames.get(entry.courseId)}
                              {entry.exam.duration && (
                                <span> · {formatDuration(entry.exam.duration)}</span>
                              )}
                            </span>
                          </span>
                        ) : (
                          <span class="min-w-0 flex-1">
                            <span
                              class:list={[
                                "font-medium",
                                entry.event.kind === "CANCELLED" && "line-through opacity-60",
                              ]}
                            >
                              {entry.event.title}
                            </span>
                            {entry.event.kind !== "REGULAR" && (
                              <span class="badge badge-ghost badge-sm ml-2">
                                {entry.event.kind === "HOLIDAY" ? "Holiday" : "Cancelled"}
                              </span>
                            )}
                            <span class="block text-xs text-base-content/60 sm:ml-2 sm:inline">
                              {courseNames.get(entry.courseId)}
                            </span>
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </main>
</AppLayout>
