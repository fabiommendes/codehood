---
// Reached via Astro.rewrite (see src/utils/load-course.ts), which keeps the
// original URL in the browser while rendering this page — so a course page a
// visitor isn't enrolled in or doesn't teach ends up here with `?course=` set
// to the segment they asked for, which tells the message this was a course
// page. The segment itself is never printed.
import { m } from "@/i18n";
import ErrorLayout from "@/layouts/ErrorLayout.astro";

export const prerender = false;

Astro.response.status = 403;
const course = Astro.url.searchParams.get("course");
---

<ErrorLayout code="403" title={m.nav_403_title()} scene="lockedHouse">
  {course ? m.nav_403_course() : m.nav_403_page()}
  <div slot="actions">
    <a href="/courses" class="btn btn-primary rounded-full">{m.nav_back_to_my_courses()}</a>
  </div>
</ErrorLayout>
