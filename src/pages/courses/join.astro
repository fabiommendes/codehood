---
import { actions } from "astro:actions";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import PageKicker from "@/components/PageKicker.astro";
import { passphraseRedeem } from "@/core/schemas";
import { actionForm } from "@/forms/form-state";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { courseHref } from "@/urls";

export const prerender = false;

if (!Astro.locals.actor) {
	const next = Astro.url.pathname + Astro.url.search;
	return Astro.redirect(`/login?next=${encodeURIComponent(next)}`);
}

const result = Astro.getActionResult(actions.course.joinCourse);
if (result && !result.error) {
	return Astro.redirect(`${courseHref(result.data)}?joined`);
}

const form = await actionForm(
	Astro,
	actions.course.joinCourse,
	passphraseRedeem,
	{ id: "join" },
);
// A link from the landing page carries the code in `?code=`; a failed submit
// brings back what was typed instead.
const field = form.field("value");
const code = result?.error
	? field.value
	: (Astro.url.searchParams.get("code") ?? "");
---

<AppLayout title={m.auth_join_title()}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <div class="max-w-md">
    <PageKicker text={m.auth_join_kicker()} squares />
    <h1 class="text-3xl font-bold">{m.auth_join_title()}</h1>

    <form
      method="POST"
      action={actions.course.joinCourse}
      class="mt-6 flex flex-col gap-4"
    >
      <FormAlert error={form.error} />
      <Field
        {...field}
        value={code}
        class="font-mono uppercase tracking-widest"
        control={{
          autofocus: true,
          autocomplete: "off",
          autocapitalize: "characters",
          spellcheck: false,
        }}
      />

      <div class="card-actions">
        <button type="submit" class="btn btn-primary btn-block rounded-full">
          {m.auth_join_submit()}
        </button>
      </div>
    </form>
    </div>
  </main>
</AppLayout>
