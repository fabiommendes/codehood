---
import PageKicker from "@/components/PageKicker.astro";
import Alert from "@/components/ui/Alert";
import { courseService } from "@/db/services/course.service";
import AppLayout from "@/layouts/AppLayout.astro";
import { courseHref } from "@/utils/course-url";

export const prerender = false;

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect("/login");

const justLeft = Astro.url.searchParams.has("left");

// No "my courses" filter needed: the actor already is one. This returns
// exactly what that user may see — courses they teach plus courses they're
// enrolled in — which is precisely the definition of their course list.
const courses = await courseService.findMany({}, { actor });
---

<AppLayout title="My courses">
  <main class="mx-auto max-w-5xl px-4 py-10">
    <PageKicker text="Term overview" squares />
    <h1 class="text-3xl font-bold">My courses</h1>
    <p class="mt-2 text-base-content/70">Courses you take or teach.</p>

    {
      justLeft && (
        <Alert variant="success" class="mt-6">
          <span>
            You've left the course. Nothing was deleted — your submissions stay
            on record.
          </span>
        </Alert>
      )
    }

    {
      courses.length === 0 ? (
        <p class="mt-8 text-base-content/60">
          You're not enrolled in or teaching any courses yet.
        </p>
      ) : (
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {courses.map((course) => {
            const href = courseHref({
              disciplineSlug: course.disciplineSlug,
              username: course.instructor.username,
              edition: course.editionSlug,
            });
            const isInstructor = course.instructor.id === actor.id;
            return (
              <a
                href={href}
                class="card card-border bg-base-100 shadow-sm transition-shadow hover:shadow-md"
              >
                <div class="card-body">
                  <span
                    class:list={[
                      "badge badge-sm font-mono",
                      isInstructor ? "badge-primary" : "badge-outline",
                    ]}
                  >
                    {course.disciplineSlug}
                  </span>
                  <h2 class="card-title mt-1">{course.discipline.name}</h2>
                  <p class="text-sm text-base-content/60">
                    {isInstructor ? "You're teaching" : course.instructor.name}
                  </p>
                  <p class="mt-3 text-xs text-base-content/50">
                    {course.editionSlug} · {course._count.enrollments} enrolled
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </main>
</AppLayout>
