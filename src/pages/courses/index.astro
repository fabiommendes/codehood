---
import PageKicker from "@/components/PageKicker.astro";
import Alert from "@/components/ui/Alert";
import { db } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import { courseHref } from "@/urls";

export const prerender = false;

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect("/login");

const justLeft = Astro.url.searchParams.has("left");

// No "my courses" filter needed: the actor already is one. This returns
// exactly what that user may see — courses they teach plus courses they're
// enrolled in — which is precisely the definition of their course list.
const courses = await db.course.findMany({}, { actor });
---

<AppLayout title="My courses">
  <main class="mx-auto max-w-5xl px-4 py-10">
    <PageKicker text="Term overview" squares />
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold">My courses</h1>
        <p class="mt-2 text-base-content/70">Courses you take or teach.</p>
      </div>
      <a href="/courses/join" class="btn btn-primary rounded-full">
        Join a course
      </a>
    </div>

    {
      justLeft && (
        <Alert variant="success" class="mt-6">
          <span>
            You've left the course. Nothing was deleted — your submissions stay
            on record.
          </span>
        </Alert>
      )
    }

    {
      courses.length === 0 ? (
        <div class="mt-8 rounded-box border border-dashed border-base-300 p-8 text-center">
          <p class="font-medium">No courses yet</p>
          <p class="mt-1 text-sm text-base-content/60">
            Courses you take or teach show up here. Enter the code your
            instructor shows in class to join one.
          </p>
          <a href="/courses/join" class="btn btn-primary mt-4 rounded-full">
            Join a course
          </a>
        </div>
      ) : (
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {courses.map((course) => {
            const href = courseHref({
              discipline: course.discipline.slug,
              instructor: course.instructor.username,
              edition: course.edition.slug,
            });
            const isInstructor = course.instructor.username === actor.username;
            return (
              <a
                href={href}
                class="card card-border bg-base-100 shadow-sm transition-shadow hover:shadow-md"
              >
                <div class="card-body">
                  <span
                    class:list={[
                      "badge badge-sm font-mono",
                      isInstructor ? "badge-primary" : "badge-outline",
                    ]}
                  >
                    {course.discipline.slug}
                  </span>
                  <h2 class="card-title mt-1">{course.discipline.name}</h2>
                  <p class="text-sm text-base-content/60">
                    {isInstructor ? "You're teaching" : course.instructor.name}
                  </p>
                  <p class="mt-3 text-xs text-base-content/50">
                    {course.edition.slug} · {course.enrollmentCount} enrolled
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </main>
</AppLayout>
