---
export const prerender = false;

import { actions } from "astro:actions";
import AttendanceResult from "@/components/check-in/AttendanceResult.astro";
import CenteredLayout from "@/layouts/CenteredLayout.astro";

if (!Astro.locals.actor) {
	return Astro.redirect("/login?next=%2Fcheck-in");
}

const result = Astro.getActionResult(actions.checkIn.register);
---

<CenteredLayout title="Check in">
  {
    result?.error && (
      <div role="alert" class="alert alert-error">
        <span>{result.error.message}</span>
      </div>
    )
  }
  {result?.data && <AttendanceResult view={result.data} />}

  <form
    method="POST"
    action={actions.checkIn.register}
    class="flex flex-col gap-4"
  >
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Code</legend>
      <input
        type="text"
        name="code"
        required
        minlength="6"
        maxlength="6"
        autocomplete="off"
        autocapitalize="characters"
        class="input w-full font-mono uppercase"
      />
    </fieldset>
    <div class="card-actions">
      <button type="submit" class="btn btn-primary btn-block rounded-full">Register</button>
    </div>
  </form>
</CenteredLayout>
