---
export const prerender = false;

import { actions } from "astro:actions";
import AttendanceResult from "@/components/check-in/AttendanceResult.astro";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import { checkInCode } from "@/core/schemas";
import { actionForm } from "@/forms/form-state";
import { m } from "@/i18n";
import CenteredLayout from "@/layouts/CenteredLayout.astro";

if (!Astro.locals.actor) {
	return Astro.redirect("/login?next=%2Fcheck-in");
}

const result = Astro.getActionResult(actions.checkIn.register);
const form = await actionForm(Astro, actions.checkIn.register, checkInCode, {
	id: "check-in",
});
---

<CenteredLayout title={m.auth_check_in_title()}>
  {result?.data && <AttendanceResult view={result.data} />}

  <form
    method="POST"
    action={actions.checkIn.register}
    class="flex flex-col gap-4"
  >
    <FormAlert error={form.error} />
    <Field
      {...form.field("code")}
      class="font-mono uppercase"
      control={{
        minlength: 6,
        maxlength: 6,
        autocomplete: "off",
        autocapitalize: "characters",
      }}
    />
    <div class="card-actions">
      <button type="submit" class="btn btn-primary btn-block rounded-full">{m.auth_check_in_register()}</button>
    </div>
  </form>
</CenteredLayout>
