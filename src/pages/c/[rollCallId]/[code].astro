---
export const prerender = false;

import { actions } from "astro:actions";
import {
	type AttendanceView,
	checkInMessage,
	clientIp,
	completeClaim,
	isCodeRefusal,
	register,
	resumeClaim,
	startClaim,
} from "@/actions/check-in";
import AttendanceRefused from "@/components/check-in/AttendanceRefused.astro";
import AttendanceResult from "@/components/check-in/AttendanceResult.astro";
import SignUpForm from "@/components/check-in/SignUpForm.astro";
import type { RollCallId } from "@/core/schemas";
import { escapeHtml, m } from "@/i18n";
import CenteredLayout from "@/layouts/CenteredLayout.astro";

const { rollCallId: rawId = "", code = "" } = Astro.params;
const rollCallId = /^[1-9]\d*$/.test(rawId)
	? (Number(rawId) as RollCallId)
	: null;
const actor = Astro.locals.actor;

const signUp = Astro.getActionResult(actions.checkIn.signUp);
if (signUp && !signUp.error) {
	return Astro.redirect(Astro.url.pathname);
}

let view: AttendanceView | null = null;
let error: string | null =
	rollCallId === null ? m.auth_check_in_invalid_code() : null;
let wantsSignUp = false;
/// Whether typing the code again might work, as it may after a wrong or expired one.
let retypeable = true;

if (rollCallId !== null) {
	try {
		if (actor) {
			const attempt = { actor, cookies: Astro.cookies, ip: clientIp(Astro) };
			view =
				(await completeClaim({ ...attempt, rollCallId })) ??
				(await register({ ...attempt, rollCallId, code }));
		} else {
			const claim =
				(await resumeClaim(Astro.cookies, rollCallId)) ??
				(await startClaim({
					cookies: Astro.cookies,
					ip: clientIp(Astro),
					rollCallId,
					code,
				}));
			if (!claim.actsAsInvite) {
				return Astro.redirect(
					`/login?next=${encodeURIComponent(Astro.url.pathname)}`,
				);
			}
			wantsSignUp = true;
		}
	} catch (e) {
		error = checkInMessage(e);
		if (error === null) throw e;
		retypeable = isCodeRefusal(e);
	}
}

const logInHref = `/login?next=${encodeURIComponent(Astro.url.pathname)}`;
const logInLink = `<a class="link link-primary" href="${escapeHtml(logInHref)}">${escapeHtml(m.auth_check_in_log_in())}</a>`;
---

<CenteredLayout title={wantsSignUp ? m.auth_check_in_join_class() : m.auth_check_in_title()}>
  {
    error && (
      <AttendanceRefused message={error} next={!actor ? "start" : retypeable ? "retype" : "courses"} />
    )
  }
  {view && <AttendanceResult view={view} />}
  {
    wantsSignUp && rollCallId !== null && (
      <>
        <p class="text-sm text-base-content/70" set:html={m.auth_check_in_sign_up_intro({ link: logInLink })} />
        <SignUpForm rollCallId={rollCallId} />
      </>
    )
  }
</CenteredLayout>
