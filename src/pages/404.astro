---
import { m } from "@/i18n";
import ErrorLayout from "@/layouts/ErrorLayout.astro";

export const prerender = false;

Astro.response.status = 404;
const signedIn = Boolean(Astro.locals.actor);
---

<ErrorLayout code="404" title={m.nav_404_title()} scene="missingLeaf">
  {m.nav_404_text()}
  <div slot="actions">
    <a
      href={signedIn ? "/courses" : "/"}
      class="btn btn-primary rounded-full"
    >
      {signedIn ? m.nav_back_to_my_courses() : m.nav_back_to_home()}
    </a>
  </div>
</ErrorLayout>
