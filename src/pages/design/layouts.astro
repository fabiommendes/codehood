---
import Avatar from "@/components/Avatar.astro";
import Logo from "@/components/Logo.astro";
import AppFooter from "@/components/nav/AppFooter.astro";
import AppSidebar, {
	type SidebarCourse,
} from "@/components/nav/AppSidebar.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import PencilFilter from "@/components/nav/PencilFilter.astro";
import UserMenu from "@/components/nav/UserMenu.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import DesignLayout from "@/layouts/DesignLayout.astro";
import type { Crumb } from "@/utils/breadcrumbs";

export const prerender = false;

/// Sample data for the navigation pieces below.
const SAMPLE_COURSES: SidebarCourse[] = [
	{
		code: "cs201",
		edition: "2026-1",
		href: "/cs201/alan_2026-1",
		teaching: false,
	},
	{
		code: "cs101",
		edition: "2026-1",
		href: "/cs101/ada_2026-1",
		teaching: true,
	},
	{
		code: "ma141",
		edition: "2026-1",
		href: "/ma141/euler_2026-1",
		teaching: false,
	},
];
const SAMPLE_USER = {
	name: "Grace Hopper",
	username: "grace",
	role: "INSTRUCTOR",
} as const;
/// Sample trails for the top bar: a typical one and one long enough to truncate.
const SAMPLE_TRAILS: Crumb[][] = [
	[
		{ label: "cs201 · 2026-1", href: "#" },
		{ label: "Exams", href: "#" },
		{ label: "Midterm", href: "#" },
		{ label: "Grading", href: "#" },
		{ label: "Two sums" },
	],
	[
		{ label: "cs201 · 2026-1", href: "#" },
		{ label: "Exams", href: "#" },
		{
			label:
				"Final exam on balanced search trees, hash tables with open addressing, and amortized analysis",
			href: "#",
		},
		{ label: "Grace Hopper" },
	],
];
const SIDEBAR_PAGES = [
	["Home", "/"],
	["My courses", "/courses"],
	["A course", "/cs201/alan_2026-1/exams"],
	["Admin", "/admin"],
] as const;

const layouts = [
	{
		name: "Layout",
		path: "src/layouts/Layout.astro",
		description:
			"The base HTML shell: <html>/<head>, global CSS (themes, fonts, paper grain), favicon. Every other layout wraps this one. Pages never use it directly.",
		usage: `<Layout title="Page title">\n  ...\n</Layout>`,
		demo: "/design/layouts/layout",
	},
	{
		name: "AppLayout",
		path: "src/layouts/AppLayout.astro",
		description:
			"The signed-in app shell: a top bar (logo, breadcrumb, theme toggle, user menu), the sidebar and a one-line footer, all from src/components/nav/ (see Navigation below). The sidebar is always visible on large screens and a drawer on small ones. Used by every signed-in page.",
		usage: `<AppLayout title="Profile">\n  ...\n</AppLayout>`,
		demo: "/design/layouts/app-layout",
	},
	{
		name: "CenteredLayout",
		path: "src/layouts/CenteredLayout.astro",
		description:
			"A single centered card on the paper-grain page background, with the logo and a heading above a slot. Used by login and invite-acceptance, anywhere a page's whole job is one form. Login is a loud screen; see Elements.",
		usage: `<CenteredLayout title="Log in">\n  <form>...</form>\n</CenteredLayout>`,
		demo: "/design/layouts/centered-layout",
	},
	{
		name: "DesignLayout",
		path: "src/layouts/DesignLayout.astro",
		description:
			"This page's own shell: a slim navbar, the theme toggle and the tab strip that links every page of the design system.",
		usage: `<DesignLayout title="Layouts" active="layouts">\n  ...\n</DesignLayout>`,
		demo: "/design/layouts/design-layout",
	},
];
---

<DesignLayout title="Layouts" active="layouts">
  <section class="mb-14">
    <h1 class="text-3xl font-bold">Layouts</h1>
    <p class="mt-3 max-w-2xl text-base-content/70">
      Four page shells cover the whole app so far. Pick the one that matches
      what the page is for, rather than rebuilding a header or a centered card
      from scratch.
    </p>
  </section>

  <section class="mb-14 flex flex-col gap-5">
    {
      layouts.map((layout) => (
        <div class="card card-border bg-base-100">
          <div class="card-body">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="card-title font-mono text-lg">{layout.name}</h2>
              <span class="text-xs text-base-content/50">{layout.path}</span>
            </div>
            <p class="text-base-content/70">{layout.description}</p>
              <!-- prettier-ignore -->
              <pre class="mt-2 overflow-x-auto rounded-box bg-neutral p-4 font-mono text-sm text-neutral-content"><code>{layout.usage}</code></pre>
            <div class="card-actions mt-1">
              <a href={layout.demo} class="btn btn-sm btn-outline">
                View demo →
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <section class="mb-12">
    <PencilFilter />
    <h2 class="mb-2 text-xl font-semibold">Navigation</h2>
    <p class="mb-5 max-w-2xl text-sm text-base-content/70">
      The pieces AppLayout is built from, in <code>src/components/nav/</code>, rendered with sample data. The current
      item and the open menu are outlined in pencil (<code>.pencil</code>); menu items have hand-cut corners
      (<code>.cut</code>). The sketch at the foot of the sidebar depends on the area.
    </p>

    <h3 class="mb-3 font-semibold">Top bar</h3>
    <p class="mb-3 max-w-2xl text-sm text-base-content/70">
      The logo is centered over the sidebar column. The breadcrumb fades in once the page header scrolls under the
      bar; phones show neither the breadcrumb nor the user's name.
    </p>
    <div class="mb-8 grid gap-4">
      {
        ["codehood", "codehood-dark"].map((theme) =>
          SAMPLE_TRAILS.map((trail) => (
            <div data-theme={theme} class="overflow-hidden rounded-box border border-base-300 text-base-content">
              <div class="navbar min-h-16 bg-base-100 p-0">
                <div class="navbar-start w-64 shrink-0 justify-center self-stretch border-r border-base-300 px-4">
                  <Logo height={36} />
                </div>
                <div class="navbar-end w-auto min-w-0 flex-1 gap-2 px-4">
                  <Breadcrumbs trail={trail} static />
                  <div class="flex shrink-0 items-center gap-2">
                    <ThemeToggle />
                    <UserMenu user={SAMPLE_USER} />
                  </div>
                </div>
              </div>
            </div>
          )),
        )
      }
    </div>

    <h3 class="mb-3 font-semibold">AppSidebar</h3>
    {
      ["codehood", "codehood-dark"].map((theme) => (
        <div class="mb-4 flex flex-wrap gap-4">
          {SIDEBAR_PAGES.map(([label, path]) => (
            <figure class="grid gap-1">
              <div data-theme={theme} class="h-[520px] overflow-hidden rounded-box border border-base-300 text-base-content">
                <AppSidebar courses={SAMPLE_COURSES} currentPath={path} admin />
              </div>
              {theme === "codehood" && <figcaption class="text-xs text-base-content/60">{label}</figcaption>}
            </figure>
          ))}
        </div>
      ))
    }

    <h3 class="mt-8 mb-3 font-semibold">UserMenu and Avatar</h3>
    <div class="grid gap-4 md:grid-cols-2">
      {
        ["codehood", "codehood-dark"].map((theme) => (
          <div data-theme={theme} class="relative h-72 rounded-box border border-base-300 bg-base-100 p-4 text-base-content">
            <div class="flex justify-end">
              <UserMenu user={SAMPLE_USER} open />
            </div>
          </div>
        ))
      }
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      {["ada", "alan", "grace", "linus", "barbara", "edsger"].map((u) => <Avatar username={u} size={36} />)}
      <span class="text-sm text-base-content/60">Avatar without a picture: a tile seeded by the username.</span>
    </div>

    <h3 class="mt-8 mb-3 font-semibold">AppFooter</h3>
    <div class="grid gap-4 md:grid-cols-2">
      {
        ["codehood", "codehood-dark"].map((theme) => (
          <div data-theme={theme} class="rounded-box border border-base-300 bg-base-100 text-base-content">
            <AppFooter class="px-4" />
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="mb-5 text-xl font-semibold">Structural patterns</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h3 class="font-semibold">Content width</h3>
          <p class="text-sm text-base-content/70">
            Reading-width content (forms, settings) caps at{" "}
            <code class="font-mono text-xs">max-w-2xl</code>, wider layouts
            (this page, dashboards) at{" "}
            <code class="font-mono text-xs">max-w-5xl</code>, both centered with{
              " "
            }
            <code class="font-mono text-xs">mx-auto</code>.
          </p>
        </div>
      </div>
      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h3 class="font-semibold">Stacking sections</h3>
          <p class="text-sm text-base-content/70">
            Vertically stacked cards (see the profile page) use{" "}
            <code class="font-mono text-xs">flex flex-col gap-8</code> on the parent
            rather than margins on each card, so spacing survives reordering.
          </p>
        </div>
      </div>
      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h3 class="font-semibold">Responsive grids</h3>
          <p class="text-sm text-base-content/70">
            Card grids go single-column on small screens and widen with a
            breakpoint prefix, e.g.{" "}
            <code class="font-mono text-xs"
              >grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4</code
            >.
          </p>
        </div>
      </div>
      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h3 class="font-semibold">Navbar</h3>
          <p class="text-sm text-base-content/70">
            <code class="font-mono text-xs">navbar</code> with{" "}
            <code class="font-mono text-xs">navbar-start</code>/<code
              class="font-mono text-xs">navbar-end</code
            >, a bottom border, and <code class="font-mono text-xs"
              >bg-base-100</code
            >; see AppLayout and DesignLayout above.
          </p>
        </div>
      </div>
    </div>
  </section>
</DesignLayout>
