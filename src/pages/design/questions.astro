---
import {
	Essay,
	FillIn,
	MultipleChoice,
	MultipleSelection,
	Numeric,
	ShortAnswer,
	TrueFalse,
} from "mdq/solid";
import { AnyQuestionView, mdqMessages } from "@/components/question/mdq";
import Card from "@/components/ui/Card";
import { locale } from "@/i18n";
import DesignLayout from "@/layouts/DesignLayout.astro";
import {
	correctResponses,
	NotAutoGradable,
	type PublicQuestion,
	publicForm,
	scoreResponse,
} from "@/mdq";
import {
	essay,
	fillIn,
	multipleChoice,
	multipleSelection,
	numeric,
	shortAnswer,
	trueFalse,
} from "@/mdq/fixtures";

export const prerender = false;

// Every fixture below is a document, built the way an mdq file would be after
// validation. The showcase feeds the components `publicForm()` of it, and
// computes each review result with `scoreResponse()` and `correctResponses()`
// rather than hand-writing the payloads the components expect.

const capitals = multipleChoice({
	stem: "Which city is the capital of Brazil?",
	choices: [
		{ id: "brasilia", text: "Brasília", score: 1, feedback: "Correct." },
		{ id: "rio", text: "Rio de Janeiro", score: 0 },
		{
			id: "sao-paulo",
			text: "São Paulo",
			score: -0.5,
			feedback: "The largest city, not the capital.",
		},
	],
});

const markdownFixture = multipleChoice({
	title: "Big-O of binary search",
	stem: "A function repeatedly halves the search range until it finds the target or the range is empty.\n\nWhat is the time complexity of binary search on a sorted array of `n` elements?",
	epilogue: "See *Introduction to Algorithms*, ch. 2, for the derivation.",
	tags: ["algorithms", "complexity"],
	choices: [
		{
			id: "log-n",
			text: "`O(log n)`",
			score: 1,
			feedback: "Correct: the range halves each step.",
		},
		{
			id: "linear",
			text: "`O(n)`",
			score: 0,
			feedback: "That is linear search.",
		},
		{ id: "n-log-n", text: "`O(n log n)`", score: 0 },
		{ id: "constant", text: "`O(1)`", score: 0 },
	],
});

// A type this version of the components has no renderer for, which is what a
// payload from a newer server looks like.
const unknownStub = {
	type: "matching",
	stem: "Match each country to its capital.",
} as unknown as PublicQuestion;

const wrongPickResult = {
	...scoreResponse(capitals, "sao-paulo"),
	correct: correctResponses(capitals),
};

const correctPickResult = {
	...scoreResponse(capitals, "brasilia"),
	correct: correctResponses(capitals),
};

const withheldResult = scoreResponse(capitals, "brasilia");

//
// Multiple selection
//

const primes = multipleSelection({
	stem: "Which of the following numbers are prime?",
	choices: [
		{ id: "two", text: "2", correct: true, feedback: "Prime." },
		{ id: "three", text: "3", correct: true, feedback: "Prime." },
		{ id: "four", text: "4", correct: false, feedback: "Not prime: 2 × 2." },
		{ id: "nine", text: "9", correct: false, feedback: "Not prime: 3 × 3." },
	],
});

// Ticked every correct choice and nothing else.
const perfectAnswer = ["two", "three"];
const perfectResult = {
	...scoreResponse(primes, perfectAnswer),
	correct: correctResponses(primes),
};

// Ticked "four" (wrong) and missed "two".
const partialAnswer = ["three", "four"];
const partialResult = {
	...scoreResponse(primes, partialAnswer),
	correct: correctResponses(primes),
};

// Same answer, graded, but with the key withheld.
const withheldSelectionResult = scoreResponse(primes, partialAnswer);

//
// True/false
//

const protocols = trueFalse({
	stem: "Judge each statement about network protocols.",
	choices: [
		{
			id: "tcp-order",
			text: "TCP guarantees ordered delivery.",
			correct: true,
			feedback: "True: TCP reassembles segments in order.",
		},
		{
			id: "udp-guarantee",
			text: "UDP guarantees delivery.",
			correct: false,
			feedback: "False: UDP makes no delivery guarantee at all.",
		},
		{
			id: "http2-multiplex",
			text: "HTTP/2 multiplexes multiple streams over one connection.",
			correct: true,
			feedback: "True: that is the point of HTTP/2 framing.",
		},
		{
			id: "dns-tcp",
			text: "DNS resolution requires TCP.",
			correct: false,
			feedback:
				"False: DNS mostly uses UDP, falling back to TCP only for large responses.",
		},
	],
});

// Some true, some false, and the rest unmarked, so all three toggle positions
// are visible on the same card.
const partlyMarkedAnswer = { "tcp-order": true, "udp-guarantee": false };

const flawlessAnswer = {
	"tcp-order": true,
	"udp-guarantee": false,
	"http2-multiplex": true,
	"dns-tcp": false,
};
const flawlessResult = {
	...scoreResponse(protocols, flawlessAnswer),
	correct: correctResponses(protocols),
};

// Got "tcp-order" right, "udp-guarantee" wrong, and abstained on
// "http2-multiplex".
const mixedAnswer = {
	"tcp-order": true,
	"udp-guarantee": true,
	"dns-tcp": false,
};
const mixedResult = {
	...scoreResponse(protocols, mixedAnswer),
	correct: correctResponses(protocols),
};

// Same answer, graded, but with the key withheld.
const withheldTrueFalseResult = scoreResponse(protocols, mixedAnswer);

//
// Essay
//

const greenhouse = essay({
	stem: "The atmosphere is transparent to most incoming sunlight but not to the heat the surface radiates back.\n\nDescribe how the greenhouse effect works and how it affects the climate.",
	content: "text",
	answerKey:
		"Sunlight passes through the atmosphere and warms the surface, which re-radiates the energy as *infrared*. Greenhouse gases absorb part of that infrared and re-emit it downwards, keeping the lower atmosphere warmer than it would otherwise be. Raising their concentration raises the equilibrium temperature.",
	comment: "Accept any answer that names absorption and re-emission.",
});

const areaFunction = essay({
	stem: "Write a function `area(r)` that returns the area of a circle of radius `r`.",
	content: "code",
	highlight: "python",
	answerKey: "import math\n\n\ndef area(r):\n    return math.pi * r**2",
});

const definition = essay({
	stem: "In one sentence, define idempotence.",
	content: "plain",
	answerKey:
		"An operation is idempotent when applying it more than once has the same effect as applying it once.",
});

const greenhouseAnswer =
	"The sun heats the ground, and the ground gives off *infrared*. Gases like CO2 and methane absorb it and send some of it back down, so the lower atmosphere stays warmer. More of those gases means more of the heat stays.";

const codeAnswer = "def area(r):\n    return 3.14159 * r * r";

// An essay is not auto-gradable, so a response to it waits for an instructor.
function pendingResult(question: typeof greenhouse) {
	try {
		scoreResponse(question, greenhouseAnswer);
	} catch (error) {
		if (!(error instanceof NotAutoGradable)) throw error;
	}
	return { pending: true as const, correct: correctResponses(question) };
}
const ungradedResult = pendingResult(greenhouse);

// What an instructor's grade looks like: a real score, no `pending`.
const gradedResult = {
	score: 0.75,
	feedback: ["Correct mechanism, but the answer never mentions equilibrium."],
	correct: correctResponses(greenhouse),
};

// Graded with the model answer withheld, the normal state while an exam is
// still open.
const withheldEssayResult = {
	score: 1,
	feedback: ["Exactly right."],
};

//
// Numeric
//

const water = numeric({
	stem: "Assume pure water at 4 °C, where its density is exactly 1 g/mL.\n\nHow many grams of water are there in a liter?",
	answer: 1000,
	unit: "g",
	tolerance: { absolute: 5 },
	incorrectFeedback:
		"Off by a factor of ten? Check the milliliter-to-liter step.",
});

const pi = numeric({
	stem: "Give the value of `π` to two decimal places.",
	answer: 3.14,
	decimalPlaces: 2,
	tolerance: { absolute: 0.005 },
});

const slope = numeric({
	stem: "What is the slope of the line through `(0, 1)` and `(3, 0)`?",
	answer: "-1/3",
	domain: "fraction",
	tolerance: { relative: 0.01 },
});

// Inside the 5 g tolerance, and outside it.
const closeEnough = 998;
const wayOff = 100;

const acceptedResult = {
	...scoreResponse(water, closeEnough),
	correct: correctResponses(water),
};

const rejectedResult = {
	...scoreResponse(water, wayOff),
	correct: correctResponses(water),
};

// Graded with the expected value withheld.
const withheldNumericResult = scoreResponse(water, closeEnough);

//
// Short answer
//

const capital = shortAnswer({
	stem: "What is the capital of Brazil?",
	accept: [
		{ pattern: "Brasília", feedback: "Good call!" },
		{ pattern: "`BSB`", comment: "The airport code, for the aviation-minded." },
	],
	reject: [
		{
			pattern: "Rio de Janeiro",
			feedback: "It used to be, but it is not anymore.",
		},
	],
	incorrectFeedback: "Sorry, that is not the correct answer.",
});

// A response matching neither list is the instructor's rather than the grader's.
const isnan = shortAnswer({
	stem: "Which **Python** function checks whether a number is `NaN`?",
	accept: ["`math.isnan`"],
	reject: [
		{ pattern: "`isnan`", feedback: "Close: it lives in the `math` module." },
	],
	unmatched: "manual",
});

const headcount = shortAnswer({
	stem: "How many people were in the room? Write the number in digits.",
	accept: ["12"],
	preAccept: ["/\\d+/"],
	preReject: [{ pattern: "/0+/", feedback: "Zero is not a count." }],
});

const openEnded = shortAnswer({
	stem: "In a few words, why does binary search need a sorted array?",
	accept: [],
	unmatched: "manual",
});

const rightResult = {
	...scoreResponse(capital, "brasília"),
	correct: correctResponses(capital),
};

const wrongResult = {
	...scoreResponse(capital, "Rio de Janeiro"),
	correct: correctResponses(capital),
};

// Matched neither list, and `isnan` leaves those to the instructor.
function unsettled(response: string) {
	try {
		scoreResponse(isnan, response);
	} catch (error) {
		if (!(error instanceof NotAutoGradable)) throw error;
	}
	return { pending: true as const, correct: correctResponses(isnan) };
}
const unsettledResult = unsettled("numpy.isnan");

//
// Fill in the blanks
//

const brasilia = fillIn({
	stem: "Fill each blank with the answer its control asks for.\n\nThe capital of Brazil is [^capital], a city of roughly [^size] on the [^river] plateau.",
	blanks: [
		{
			id: "capital",
			type: "multiple-choice",
			choices: [
				{ id: "brasilia", text: "Brasília", score: 1, feedback: "Correct." },
				{ id: "rio", text: "Rio de Janeiro" },
				{
					id: "lisbon",
					text: "Lisbon",
					score: -0.25,
					feedback: "Right language, wrong continent.",
				},
			],
		},
		{
			id: "size",
			type: "numeric",
			answer: 2800000,
			unit: "people",
			tolerance: { relative: 0.1 },
		},
		{ id: "river", type: "short-answer", accept: ["Central", "Planalto"] },
	],
});

// Choices carrying Markdown, which is why the blank is not a native `<select>`.
const complexity = fillIn({
	title: "Binary search",
	stem: "Binary search runs in [^time] time and uses [^space] extra space.",
	blanks: [
		{
			id: "time",
			type: "multiple-choice",
			choices: [
				{ id: "log", text: "`O(log n)`", score: 1 },
				{ id: "linear", text: "`O(n)`" },
			],
		},
		{
			id: "space",
			type: "multiple-choice",
			choices: [
				{ id: "constant", text: "`O(1)`", score: 1 },
				{ id: "linear", text: "`O(n)`" },
			],
		},
	],
});

const filledIn = { capital: "brasilia", size: "2750000", river: "Planalto" };

const mixedUp = { capital: "lisbon", size: "12", river: "" };

// The component takes the score and feedback only: no key, no per-blank marks.
const filledInResult = scoreResponse(brasilia, filledIn);

const mixedUpResult = scoreResponse(brasilia, mixedUp);

// The side nav. Its ids are the `id` of the matching <section> below; the
// order is the order they appear on the page, which is the order the types
// were built in.
const sectionLinks = [
	{ id: "multiple-choice", label: "Multiple choice" },
	{ id: "multiple-selection", label: "Multiple selection" },
	{ id: "true-false", label: "True / false" },
	{ id: "essay", label: "Essay" },
	{ id: "numeric", label: "Numeric" },
	{ id: "short-answer", label: "Short answer" },
	{ id: "fill-in", label: "Fill in the blanks" },
	{ id: "unknown", label: "Unknown type" },
] as const;
---

<DesignLayout title="Questions" active="questions">
  <div class="lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-10">
    {/*
      Sticky rather than fixed: it stays in the page's own column, so it can
      never land on top of the content at a width nobody tested. Below `lg`
      there is no room beside the cards, and the nav is simply not rendered —
      the page is short enough to scroll on a phone.
    */}
    <nav aria-label="Question types" class="sticky top-6 self-start max-lg:hidden">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-base-content/40">
        Question types
      </p>
      <ul class="flex flex-col gap-1 border-l border-base-300">
        {
          sectionLinks.map((link) => (
            <li>
              <a
                href={`#${link.id}`}
                data-section-link={link.id}
                class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-sm text-base-content/60 transition-colors hover:border-base-300 hover:text-base-content aria-current:border-primary aria-current:font-semibold aria-current:text-primary"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
  <section class="mb-14">
    <h1 class="text-3xl font-bold">Questions</h1>
    <p class="mt-3 max-w-2xl text-base-content/70">
      The components of <code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">mdq/solid</code> and its
      <code class="font-mono">QuestionView</code> dispatcher, rendering question documents built with the
      fixtures of <code class="font-mono">src/mdq/fixtures.ts</code>. The components get{" "}
      <code class="font-mono">publicForm()</code> of each document, and every review result comes from{" "}
      <code class="font-mono">scoreResponse()</code> and <code class="font-mono">correctResponses()</code>
      &mdash; nothing on this page hand-writes the payloads the components expect, except an instructor's grade.
    </p>
  </section>

  <section id="multiple-choice" class="mb-14 scroll-mt-6">
    <h2 class="text-2xl font-bold">Multiple choice</h2>

    <section class="mt-6">
      <h3 class="mb-2 text-xl font-semibold">Answer mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        The interactive form a student fills in. One is empty; the other is seeded with a choice already picked,
        to show the controlled path. Markdown in the stem and inline code in the choices come from{" "}
        <code class="font-mono">markdownFixture</code>, a fixture whose stem has two paragraphs and that has an{" "}
        <code class="font-mono">epilogue</code> and <code class="font-mono">tags</code>.
      </p>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <Card title="Unanswered">
          <MultipleChoice client:load locale={locale} question={publicForm(capitals)} mode="answer" />
        </Card>
        <Card title="Pre-answered, with markdown">
          <MultipleChoice client:load locale={locale} question={publicForm(markdownFixture)} mode="answer" value="log-n" />
        </Card>
      </div>
    </section>

    <section class="mt-10">
      <h3 class="mb-2 text-xl font-semibold">Readonly mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        The question shown back to a student without letting them change it: the picked option carries a check and
        the others are muted, and typed answers read as plain text.
      </p>
      <Card>
        <MultipleChoice messages={mdqMessages} question={publicForm(capitals)} mode="readonly" value="rio" />
      </Card>
    </section>

    <section class="mt-10">
      <h3 class="mb-2 text-xl font-semibold">Review mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        Three graded states, all driven by <code class="font-mono">scoreResponse(capitals, ...)</code> and{" "}
        <code class="font-mono">correctResponses(capitals)</code>: a correct pick, a wrong pick with the choice's own
        feedback and a score below zero, and a graded answer whose key is withheld
        (<code class="font-mono">result</code> with no <code class="font-mono">correct</code>) &mdash; that last
        one is what an exam still open for review looks like, and it deliberately shows no right/wrong markers.
      </p>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        <Card title="Correct pick">
          <MultipleChoice messages={mdqMessages}
            question={publicForm(capitals)}
            mode="review"
            value="brasilia"
            result={correctPickResult}
          />
        </Card>
        <Card title="Wrong pick, with feedback">
          <MultipleChoice messages={mdqMessages}
            question={publicForm(capitals)}
            mode="review"
            value="sao-paulo"
            result={wrongPickResult}
          />
        </Card>
        <Card title="Key withheld">
          <MultipleChoice messages={mdqMessages}
            question={publicForm(capitals)}
            mode="review"
            value="brasilia"
            result={withheldResult}
          />
        </Card>
      </div>
    </section>
  </section>

  <section id="multiple-selection" class="mb-14 scroll-mt-6">
    <h2 class="text-2xl font-bold">Multiple selection</h2>

    <section class="mt-6">
      <h3 class="mb-2 text-xl font-semibold">Answer mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        Checkboxes rather than radios &mdash; toggling a row adds or removes its id from the answer set. One card
        is empty; the other is seeded with a couple of choices already ticked, to show the controlled path.
      </p>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <Card title="Unanswered">
          <MultipleSelection client:load locale={locale} question={publicForm(primes)} mode="answer" />
        </Card>
        <Card title="Pre-answered">
          <MultipleSelection
            client:load locale={locale}
            question={publicForm(primes)}
            mode="answer"
            value={["two", "three"]}
          />
        </Card>
      </div>
    </section>

    <section class="mt-10">
      <h3 class="mb-2 text-xl font-semibold">Readonly mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        Same visuals as answer mode, but the checkboxes are disabled and nothing is clickable.
      </p>
      <Card>
        <MultipleSelection messages={mdqMessages} question={publicForm(primes)} mode="readonly" value={["three"]} />
      </Card>
    </section>

    <section class="mt-10">
      <h3 class="mb-2 text-xl font-semibold">Review mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        Marking is by judgement, not by ticked-ness: a row reads correct when whether it was ticked matches
        whether <code class="font-mono">result.correct</code> says it should have been. The middle card ticked "4"
        (wrong) and left "2" alone (also wrong &mdash; a correct choice left unticked asserts it is false), so it
        shows feedback attached to a choice the student never touched. The last card grades the same answer with
        the key withheld, and shows no markers at all.
      </p>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        <Card title="Perfect answer">
          <MultipleSelection messages={mdqMessages}
            question={publicForm(primes)}
            mode="review"
            value={perfectAnswer}
            result={perfectResult}
          />
        </Card>
        <Card title="Ticked wrong, missed right">
          <MultipleSelection messages={mdqMessages}
            question={publicForm(primes)}
            mode="review"
            value={partialAnswer}
            result={partialResult}
          />
        </Card>
        <Card title="Key withheld">
          <MultipleSelection messages={mdqMessages}
            question={publicForm(primes)}
            mode="review"
            value={partialAnswer}
            result={withheldSelectionResult}
          />
        </Card>
      </div>
    </section>
  </section>

  <section id="true-false" class="mb-14 scroll-mt-6">
    <h2 class="text-2xl font-bold">True / false</h2>

    <section class="mt-6">
      <h3 class="mb-2 text-xl font-semibold">Answer mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        Each statement gets one toggle with three states, not a checkbox: unchecked is False, checked is True, and
        the knob centered (the native <code class="font-mono">indeterminate</code> property) is unmarked, because a
        student can judge a statement or abstain on it. Clicking (or pressing space) cycles unmarked &rarr; True
        &rarr; False &rarr; unmarked, so the middle state stays reachable instead of only being where an untouched
        toggle starts. One card is fully unmarked; the other has "tcp-order" marked True, "udp-guarantee" marked
        False, and "http2-multiplex" and "dns-tcp" left unmarked, so all three positions show at once.
      </p>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <Card title="Unanswered">
          <TrueFalse client:load locale={locale} question={publicForm(protocols)} mode="answer" />
        </Card>
        <Card title="Partly marked">
          <TrueFalse client:load locale={locale} question={publicForm(protocols)} mode="answer" value={partlyMarkedAnswer} />
        </Card>
      </div>
    </section>

    <section class="mt-10">
      <h3 class="mb-2 text-xl font-semibold">Readonly mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        Same visuals as answer mode, but every toggle is disabled and nothing is clickable.
      </p>
      {/*
        `client:load locale={locale}` here is load-bearing, not decorative: the centered knob
        for an abstained statement comes from the `indeterminate` DOM property,
        which cannot be expressed in server-rendered markup. Without
        hydration, an abstained statement would render looking like a
        confident "False" — do not remove this directive as an "optimization."
      */}
      <Card>
        <TrueFalse client:load locale={locale} question={publicForm(protocols)} mode="readonly" value={partlyMarkedAnswer} />
      </Card>
    </section>

    <section class="mt-10">
      <h3 class="mb-2 text-xl font-semibold">Review mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        Three outcomes per statement, not two: judged correctly, judged wrongly, and abstained. The middle card
        marked "tcp-order" right, "udp-guarantee" wrong, and left "http2-multiplex" unmarked, so it shows feedback
        landing on the wrong statement <em>and</em> on the abstained one — mdq.spec includes abstentions in the
        feedback deliberately, since a student who skipped a statement is who the explanation is for. The
        abstained row renders muted, with neither a check nor an x, because the grading does not penalize it. The
        last card grades the same answer with the key withheld, and shows no markers at all.
      </p>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <Card title="Flawless paper">
          <TrueFalse
            client:load locale={locale}
            question={publicForm(protocols)}
            mode="review"
            value={flawlessAnswer}
            result={flawlessResult}
          />
        </Card>
        <Card title="Right, wrong, and abstained">
          <TrueFalse
            client:load locale={locale}
            question={publicForm(protocols)}
            mode="review"
            value={mixedAnswer}
            result={mixedResult}
          />
        </Card>
        <Card title="Key withheld">
          <TrueFalse
            client:load locale={locale}
            question={publicForm(protocols)}
            mode="review"
            value={mixedAnswer}
            result={withheldTrueFalseResult}
          />
        </Card>
      </div>
    </section>
  </section>

  <section id="essay" class="mb-14 scroll-mt-6">
    <h2 class="text-2xl font-bold">Essay</h2>

    <section class="mt-6">
      <h3 class="mb-2 text-xl font-semibold">Answer mode</h3>
      <p class="mb-5 text-sm text-base-content/60">
        One textarea, shaped by the question's <code class="font-mono">input</code> field:{" "}
        <code class="font-mono">text</code> accepts Markdown, <code class="font-mono">plain</code> does not, and{" "}
        <code class="font-mono">code</code> gets a monospace box with spell-checking off and the{" "}
        <code class="font-mono">highlight</code> language on a badge. There is no rich-text widget and no syntax
