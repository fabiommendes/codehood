</DesignLayout>

<script>
  // Marks the link for whichever section is currently on screen. `aria-current`
  // rather than a class, because that is what the state actually is, and the
  // stylesheet keys off it directly.
  const links = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-section-link]")).map(
      (link) => [link.dataset.sectionLink ?? "", link],
    ),
  );

  const visible = new Set<string>();

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target.id);
        else visible.delete(entry.target.id);
      }

      highlight();
    },
    { rootMargin: "-10% 0px -70% 0px" },
  );

  function highlight() {
    // The topmost section still on screen wins, so scrolling through a long
    // section does not hand the highlight to the next one the moment its
    // heading peeks in.
    //
    // At the very bottom of the document the last section wins outright: the
    // page has stopped scrolling, so a short final section never reaches the
    // observer's band and the highlight would otherwise stay stuck on the one
    // above it — including right after someone clicked the last link.
    const ids = Array.from(links.keys());
    const atBottom =
      window.scrollY + window.innerHeight >=
      document.documentElement.scrollHeight - 2;
    const current = atBottom ? ids[ids.length - 1] : ids.find((id) => visible.has(id));

    for (const [id, link] of links) {
      if (id === current) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  }

  for (const id of links.keys()) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }

  window.addEventListener("scroll", highlight, { passive: true });
</script>
