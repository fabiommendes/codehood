---
import AdminHeader from "@/components/AdminHeader.astro";
import GlassWall from "@/components/brand/GlassWall.astro";
import { SCENES, type SceneName } from "@/components/brand/scenes";
import CliSetupLink from "@/components/CliSetupLink.astro";
import CountRow from "@/components/CountRow.astro";
import CourseTile from "@/components/CourseTile.astro";
import CsvDownload from "@/components/CsvDownload.astro";
import EmptyState from "@/components/EmptyState.astro";
import ExamRow from "@/components/exam/ExamRow.astro";
import QuestionNumber from "@/components/exam/QuestionNumber";
import QuestionNumberAstro from "@/components/exam/QuestionNumber.astro";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import AppliedItems, {
	type AppliedItem,
} from "@/components/grading/AppliedItems";
import PasswordConfirm from "@/components/PasswordConfirm.astro";
import AttachmentList from "@/components/question/AttachmentList";
import ReportFilters from "@/components/report/ReportFilters.astro";
import OpenRollCallDialog from "@/components/roll-call/OpenRollCallDialog";
import SectionHeader from "@/components/SectionHeader.astro";
import Button from "@/components/ui/Button";
import type { Exam } from "@/db";
import type { FieldSpec } from "@/forms/describe-field";
import DesignLayout from "@/layouts/DesignLayout.astro";

export const prerender = false;

// Like `/design/components`, the Solid islands here render on the server only
// (no `client:*`), so buttons and dialogs look real but do nothing.

const now = Date.now();
const hours = (n: number) => new Date(now + n * 3_600_000);

const sectionLinks = [
	{ id: "headers", label: "Headers" },
	{ id: "course", label: "Course tiles and rows" },
	{ id: "empty", label: "Empty states" },
	{ id: "labels", label: "Question labels" },
	{ id: "fields", label: "Fields" },
	{ id: "password", label: "Password" },
	{ id: "files", label: "Files" },
	{ id: "grading", label: "Grading" },
	{ id: "reports", label: "Report filters" },
	{ id: "roll-call", label: "Roll call" },
	{ id: "glass-wall", label: "Glass wall" },
] as const;

/// An exam as `ExamRow` reads it: only the fields the row uses, the rest absent.
function exam(
	fields: Pick<Exam, "slug" | "title" | "type" | "status"> & Partial<Exam>,
) {
	return {
		scheduledAt: null,
		duration: null,
		extraTime: null,
		gradesReleasedAt: null,
		...fields,
	} as Exam;
}

const examRows = [
	{
		label: "Scheduled",
		exam: exam({
			slug: "midterm",
			title: "Midterm",
			type: "EXAM",
			status: "SCHEDULED",
			scheduledAt: hours(72),
			duration: { hours: 2 },
		}),
	},
	{
		label: "Ongoing",
		exam: exam({
			slug: "quiz-02",
			title: "Quiz 2: Graphs",
			type: "QUIZ",
			status: "ONGOING",
			scheduledAt: hours(-0.25),
			duration: { minutes: 30 },
		}),
	},
	{
		label: "Completed, with a score",
		score: "86%",
		exam: exam({
			slug: "quiz-01",
			title: "Quiz 1: Complexity",
			type: "QUIZ",
			status: "COMPLETED",
			scheduledAt: hours(-200),
			duration: { minutes: 30 },
		}),
	},
	{
		label: "Instructor view, answers to grade",
		pending: 12,
		exam: exam({
			slug: "final",
			title: "Final",
			type: "EXAM",
			status: "COMPLETED",
			scheduledAt: hours(-48),
			duration: { hours: 3 },
		}),
	},
	{
		label: "Draft",
		exam: exam({
			slug: "practice",
			title: "Practice: Trees",
			type: "PRACTICE",
			status: "DRAFT",
		}),
	},
];

/// One scene with actions and one without are enough; `/design/motifs` shows them all.
const scenes: SceneName[] = ["lockedHouse", "constellation"];

/// Specs as `describeField` produces them from a schema.
const text = { required: true, attrs: { minlength: 3, maxlength: 80 } };
const fields: FieldSpec[] = [
	{
		...text,
		name: "title",
		kind: "text",
		label: "Title",
		hint: "Shown on the exam list.",
	},
	{
		...text,
		name: "email",
		kind: "email",
		label: "E-mail",
		placeholder: "ada@example.org",
		attrs: {},
	},
	{
		...text,
		name: "url",
		kind: "url",
		label: "Repository URL",
		required: false,
		attrs: {},
	},
	{
		...text,
		name: "seats",
		kind: "number",
		label: "Seats",
		attrs: { min: 1, max: 200 },
	},
	{ ...text, name: "day", kind: "date", label: "Day", attrs: {} },
	{ ...text, name: "start", kind: "datetime", label: "Starts at", attrs: {} },
	{
		...text,
		name: "kind",
		kind: "enum",
		label: "Type",
		attrs: {},
		options: [
			{ value: "QUIZ", label: "Quiz" },
			{ value: "EXAM", label: "Exam" },
			{ value: "PRACTICE", label: "Practice" },
		],
	},
	{
		...text,
		name: "format",
		kind: "enum",
		widget: "radio",
		label: "Format",
		attrs: {},
		options: [
			{ value: "PLAINTEXT", label: "Plain text" },
			{ value: "MARKDOWN", label: "Markdown" },
		],
	},
	{
		...text,
		name: "history",
		kind: "boolean",
		widget: "toggle",
		label: "Record the edit history",
		required: false,
		attrs: {},
	},
	{
		...text,
		name: "agree",
		kind: "boolean",
		label: "I agree",
		required: false,
		attrs: {},
	},
	{
		...text,
		name: "notes",
		kind: "textarea",
		label: "Notes",
		required: false,
		attrs: {},
		placeholder: "Anything the graders should know.",
	},
];

/// The value shown back and the errors of the fields in "With errors".
const invalid: Record<string, { value?: string; errors: string[] }> = {
	title: { value: "ab", errors: ["Use at least 3 characters."] },
	email: { value: "ada@", errors: ["Enter a valid e-mail address."] },
	kind: { errors: ["Choose a type."] },
	format: { errors: ["Choose a format."] },
};

const attachments = [
	{ name: "dataset.csv", format: "csv", label: "12 KB" },
	{ name: "notes.pdf", format: "pdf" },
	{
		name: "starter.py",
		format: "python",
		text: 'def solve(graph, start):\n    """Return the vertices reachable from start."""\n    raise NotImplementedError\n',
	},
];

const appliedStudent: AppliedItem[] = [
	{
		text: "Correct base case",
		value: "0.6",
		feedback: "The recursion stops where it should.",
	},
	{ text: "Off-by-one on the loop bound", value: "-0.1", feedback: null },
];
const appliedInstructor: AppliedItem[] = appliedStudent.map((item, index) => ({
	...item,
	comment: ["Same approach as the key.", "Third time this term."][index],
}));

const csvRows = [
	["Student", "Grade"],
	["Ada Lovelace", "9.5"],
	["Grace Hopper", "10"],
];
---

<DesignLayout title="Blocks" active="blocks">
  <div class="lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-10">
    <nav aria-label="Blocks" class="sticky top-6 self-start max-lg:hidden">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">Blocks</p>
      <ul class="flex flex-col gap-1 border-l border-edge">
        {
          sectionLinks.map((link) => (
            <li>
              <a
                href={`#${link.id}`}
                class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-sm text-muted transition-colors hover:border-edge hover:text-base-content"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="min-w-0">
      <section class="mb-14">
        <h1 class="text-3xl font-bold">Blocks</h1>
        <p class="mt-3 max-w-2xl text-base-content/70">
          Components that more than one page uses and that no other design page shows: headers, tiles, empty
          states, form fields, file lists and the small pieces of grading and reports. Each renders from fixture
          props. Components tied to one page, or that need a course loaded from the database, are not here.
        </p>
      </section>

      <section id="headers" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Headers</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">AdminHeader</code> opens every page under <code class="font-mono">/admin</code>;{" "}
          <code class="font-mono">SectionHeader</code> heads a block of a page, with an optional link;{" "}
          <code class="font-mono">CliSetupLink</code> is the link an empty section of the instructor's course shows.
        </p>
        <h3 class="mb-3 text-xl font-semibold">AdminHeader</h3>
        <div class="rounded-box border border-edge bg-base-100 p-5">
          <AdminHeader active="users" />
        </div>
        <h3 class="mt-10 mb-3 text-xl font-semibold">SectionHeader</h3>
        <div class="flex max-w-xl flex-col gap-6 rounded-box border border-edge bg-base-100 p-5">
          <SectionHeader title="Upcoming" href="#" />
          <SectionHeader title="Resources" href="#" linkText="Open the library" />
          <SectionHeader title="Without a link" />
        </div>
        <h3 class="mt-10 mb-3 text-xl font-semibold">CliSetupLink</h3>
        <div class="rounded-box border border-edge bg-base-100 p-5">
          <p class="text-sm text-muted">Nothing published yet. <CliSetupLink /></p>
        </div>
      </section>

      <section id="course" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Course tiles and rows</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">CourseTile</code> draws the same tile for the same seed, in both themes.{" "}
          <code class="font-mono">CountRow</code> leads with the number that asks for action;{" "}
          <code class="font-mono">ExamRow</code> is a <code class="font-mono">ListRow</code> for an exam.
        </p>
        <h3 class="mb-3 text-xl font-semibold">CourseTile</h3>
        <div class="flex flex-wrap items-end gap-4 rounded-box border border-edge bg-base-100 p-5">
          {
            [14, 20, 32, 48, 72].map((size) => (
              <figure class="text-center">
                <CourseTile seed="/algorithms/ada_2026-2" size={size} />
                <figcaption class="mt-1 font-mono text-xs text-muted">{size}</figcaption>
              </figure>
            ))
          }
          <span class="mx-2 h-12 border-l border-edge"></span>
          {
            ["/algorithms/ada_2026-2", "/databases/ada_2026-2", "/compilers/turing_2026-1", "/os/hopper_2026-1"].map(
              (seed) => (
                <figure class="text-center">
                  <CourseTile seed={seed} size={48} />
                  <figcaption class="mt-1 font-mono text-xs text-muted">{seed.split("/")[1]}</figcaption>
                </figure>
              ),
            )
          }
        </div>
        <h3 class="mt-10 mb-3 text-xl font-semibold">CountRow</h3>
        <div class="grid max-w-3xl gap-3 sm:grid-cols-2">
          <CountRow
            href="#"
            count={5}
            unit="to grade"
            label="5 answers to grade"
            title="Quiz 2: Graphs"
            course={{ href: "/algorithms/ada_2026-2", code: "algorithms", edition: "2026-2" }}
          />
          <CountRow
            href="#"
            count={3}
            of={10}
            unit="graded"
            label="3 of 10 answers graded"
            title="Midterm"
            course={{ href: "/databases/ada_2026-2", code: "databases", edition: "2026-2" }}
          />
        </div>
        <h3 class="mt-10 mb-3 text-xl font-semibold">ExamRow</h3>
        <div class="flex max-w-3xl flex-col gap-4">
          {
            examRows.map((row) => (
              <div>
                <p class="mb-1 text-xs text-muted">{row.label}</p>
                <ExamRow exam={row.exam} href="#" score={row.score} pending={row.pending} />
              </div>
            ))
          }
        </div>
      </section>

      <section id="empty" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Empty states</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">EmptyState</code>: an illustration, what is missing and who acts next. With and without the
          actions slot.
        </p>
        <div class="flex flex-col gap-10">
          {
            scenes.map((name, index) => (
              <div class="rounded-box border border-edge bg-base-100 p-6">
                <p class="mb-4 font-mono text-xs text-muted">{name}</p>
                <EmptyState scene={name} title={SCENES[name].caption}>
                  Nothing here yet. Whoever teaches the course publishes it with the CLI.
                  {index === 0 && (
                    <Fragment slot="actions">
                      <Button variant="primary">Do something</Button>
                      <Button variant="ghost">Later</Button>
                    </Fragment>
                  )}
                </EmptyState>
              </div>
            ))
          }
        </div>
      </section>

      <section id="labels" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Question labels</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">QuestionNumber</code> exists as an Astro component and as a Solid one; points are
          out of 100.
        </p>
        <div class="grid max-w-xl gap-4 rounded-box border border-edge bg-base-100 p-5 sm:grid-cols-2">
          <div>
            <p class="mb-2 text-xs text-muted">Astro</p>
            <p class="text-lg"><QuestionNumberAstro number={3} /></p>
            <p class="text-lg"><QuestionNumberAstro number={12} points="12.5" /></p>
          </div>
          <div>
            <p class="mb-2 text-xs text-muted">Solid</p>
            <p class="text-lg"><QuestionNumber number={3} /></p>
            <p class="text-lg"><QuestionNumber number={12} points="12.5" tone="text-primary" class="text-2xl" /></p>
          </div>
        </div>
      </section>

      <section id="fields" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Fields</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">Field</code> renders one control, with label, hint and errors, from a spec
          derived from a Zod schema. <code class="font-mono">FormAlert</code> shows the error that belongs to no
          field.
        </p>
        <div class="grid max-w-3xl gap-x-6 gap-y-2 rounded-box border border-edge bg-base-100 p-5 sm:grid-cols-2">
          {fields.map((spec) => <Field {...spec} id={`blocks-${spec.name}`} />)}
        </div>
        <h3 class="mt-10 mb-3 text-xl font-semibold">With errors</h3>
        <div class="grid max-w-3xl gap-x-6 gap-y-2 rounded-box border border-edge bg-base-100 p-5 sm:grid-cols-2">
          {
            fields
              .filter((spec) => spec.name in invalid)
              .map((spec) => (
                <Field {...spec} id={`blocks-err-${spec.name}`} {...invalid[spec.name]} />
              ))
          }
        </div>
        <h3 class="mt-10 mb-3 text-xl font-semibold">FormAlert</h3>
        <div class="max-w-xl">
          <FormAlert error="You may not edit this exam." />
        </div>
      </section>

      <section id="password" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Password</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">PasswordConfirm</code> sits after a password input and blocks the submit when
          the two differ. Type different values and press the button to see the message.
        </p>
        <form class="max-w-sm rounded-box border border-edge bg-base-100 p-5" onsubmit="return false">
          <fieldset class="fieldset">
            <legend class="fieldset-legend"><label for="blocks-password">Password</label></legend>
            <input
              type="password"
              id="blocks-password"
              name="password"
              required
              minlength="8"
              autocomplete="new-password"
              class="input w-full"
            />
          </fieldset>
          <PasswordConfirm id="blocks-password-confirm" />
          <button type="submit" class="btn btn-primary mt-4">Save</button>
        </form>
      </section>

      <section id="files" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Files</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">AttachmentList</code> lists what a question gives the student; a fenced
          attachment also shows its code. <code class="font-mono">CsvDownload</code> builds the file in the browser
          from the rows on the page, so the button works here.
        </p>
        <h3 class="mb-3 text-xl font-semibold">AttachmentList</h3>
        <div class="max-w-xl">
          <AttachmentList attachments={attachments} url={(name: string) => `#${name}`} />
        </div>
        <h3 class="mt-10 mb-3 text-xl font-semibold">Without download links</h3>
        <div class="max-w-xl">
          <AttachmentList attachments={attachments.slice(0, 2)} url={() => null} />
        </div>
        <h3 class="mt-10 mb-3 text-xl font-semibold">CsvDownload</h3>
        <div class="flex gap-3">
          <CsvDownload id="blocks-grades" filename="grades.csv" rows={csvRows} />
          <CsvDownload id="blocks-grades-off" filename="grades.csv" rows={csvRows} disabled />
        </div>
      </section>

      <section id="grading" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Grading</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">AppliedItems</code>: the rubric items applied to an answer. The instructor also
          sees the private comment of each item.
        </p>
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <h3 class="mb-1 text-xl font-semibold">Student</h3>
            <AppliedItems items={appliedStudent} />
          </div>
          <div>
            <h3 class="mb-1 text-xl font-semibold">Instructor</h3>
            <AppliedItems items={appliedInstructor} />
          </div>
        </div>
      </section>

      <section id="reports" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Report filters</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">ReportFilters</code>: one button group per filter, each button a link that sets it
          in the query string.
        </p>
        <div class="flex flex-col gap-6 rounded-box border border-edge bg-base-100 p-5">
          <ReportFilters filters={{ status: "OPEN", kind: null }} />
          <ReportFilters filters={{ status: null, kind: "BUG" }} />
          <ReportFilters filters={{ status: "OPEN", kind: null }} hideKind />
        </div>
      </section>

      <section id="roll-call" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Roll call</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">OpenRollCallDialog</code>: the button that starts a meeting's roll call. The dialog
          opens from the button on the real pages; here it is rendered closed.
        </p>
        <div class="flex gap-3">
          <OpenRollCallDialog
            discipline="algorithms"
            course="ada_2026-2"
            week={4}
            timeSlot="tue-10"
            href="/algorithms/ada_2026-2"
          />
          <OpenRollCallDialog
            discipline="algorithms"
            course="ada_2026-2"
            week={4}
            timeSlot="thu-10"
            href="/algorithms/ada_2026-2"
            label="Open roll call"
            warning="The meeting starts in 2 hours."
          />
        </div>
      </section>

      <section id="glass-wall" class="mb-14 scroll-mt-6">
        <h2 class="text-2xl font-bold">Glass wall</h2>
        <p class="mt-2 mb-6 text-sm text-muted">
          <code class="font-mono">GlassWall</code>: the field of turning Ds behind the sign-in and error screens, here
          clipped to a box.
        </p>
        <div class="relative isolate h-64 overflow-hidden rounded-box border border-edge bg-base-200">
          <GlassWall cols={40} rows={20} />
        </div>
      </section>
    </div>
  </div>
</DesignLayout>
