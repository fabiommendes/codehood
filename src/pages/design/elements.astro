---
import BrandSquares from "@/components/BrandSquares.astro";
import ListRow from "@/components/ListRow.astro";
import PageKicker from "@/components/PageKicker.astro";
import Alert from "@/components/ui/Alert";
import Badge from "@/components/ui/Badge";
import Button from "@/components/ui/Button";
import Card from "@/components/ui/Card";
import Table from "@/components/ui/Table";
import Tabs from "@/components/ui/Tabs.astro";
import DesignLayout from "@/layouts/DesignLayout.astro";

export const prerender = false;

const buttonVariants = [
	"primary",
	"secondary",
	"accent",
	"neutral",
	"ghost",
	"outline",
] as const;
const badgeVariants = [
	"neutral",
	"primary",
	"secondary",
	"accent",
	"info",
	"success",
	"warning",
	"error",
] as const;
const alertVariants = ["info", "success", "warning", "error"] as const;

const themes = [
	{ id: "codehood", title: "Cerrado (light)" },
	{ id: "codehood-dark", title: "Forest (dark)" },
] as const;

const tableRows = [
	{ name: "my laptop", kind: "cli", lastUsed: "yesterday" },
	{ name: "grading bot", kind: "bot", lastUsed: "never" },
];
const tableColumns = [
	{
		title: "Name",
		class: "font-medium",
		render: (row: (typeof tableRows)[number]) => row.name,
	},
	{ title: "Kind", render: (row: (typeof tableRows)[number]) => row.kind },
	{
		title: "Last used",
		class: "text-right",
		headerClass: "text-right",
		render: (row: (typeof tableRows)[number]) => row.lastUsed,
	},
];

const tabItems = [
	{ key: "overview", label: "Overview" },
	{ key: "history", label: "History" },
] as const;
---

<DesignLayout title="Elements" active="elements">
  <section class="mb-14">
    <h1 class="text-3xl font-bold">Elements</h1>
    <p class="mt-3 max-w-2xl text-base-content/70">
      Reusable pieces from <code
        class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm"
        >src/components/ui/</code
      >. These aren't recreations for the showcase &mdash; every example below
      is the same component the rest of the app imports.
    </p>
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">Both themes</h2>
    <p class="mb-5 text-sm text-base-content/60">
      The same components inside a <code class="font-mono">data-theme</code> wrapper for each theme. Cards and
      buttons get the irregular hand-cut radius from <code class="font-mono">global.css</code>; badges and chips
      use a smaller one, inputs a plain 8 px.
    </p>
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
      {
        themes.map((theme) => (
          <div data-theme={theme.id} class="flex flex-col gap-4 rounded-box border border-base-300 bg-base-200 p-4 text-base-content">
            <p class="text-sm font-semibold">{theme.title}</p>
            <div class="flex flex-wrap gap-2">
              {buttonVariants.map((variant) => (
                <Button variant={variant}>{variant}</Button>
              ))}
            </div>
            <div class="flex flex-wrap gap-2">
              {badgeVariants.map((variant) => (
                <Badge variant={variant}>{variant}</Badge>
              ))}
            </div>
            <div class="flex flex-col gap-2">
              {alertVariants.map((variant) => (
                <Alert variant={variant}>
                  <span class="capitalize">{variant}</span>: a {variant} message.
                </Alert>
              ))}
            </div>
            <Card title="Card">
              <p class="text-sm text-base-content/70">Surface on base-100, border on base-300.</p>
            </Card>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">Loud and quiet screens</h2>
    <p class="mb-5 text-sm text-base-content/60">
      Personality is strong at the edges and quiet where people work. Quiet screens keep the colors, type and
      rounded paper shapes, and drop tilt, tape and illustration.
    </p>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h3 class="card-title">Loud</h3>
          <p class="text-sm text-base-content/70">
            Landing page, login, empty states, error pages, released grades, first visit. May use tilt (cards
            alternate -0.4° and 0.3°), tape, illustration and motifs.
          </p>
        </div>
      </div>
      <div class="card card-border bg-base-100">
        <div class="card-body">
          <h3 class="card-title">Quiet</h3>
          <p class="text-sm text-base-content/70">
            Exam in progress, reading a resource or question, grade tables, rosters, forms. Radius and color only:
            no tilt, tape or illustration. Everything on this page is shown quiet.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">Button</h2>
    <p class="mb-5 text-sm text-base-content/60">
      <code class="font-mono">{`<Button variant="primary">`}</code> &mdash; renders
      an
      <code class="font-mono">&lt;a&gt;</code> instead of a <code
        class="font-mono">&lt;button&gt;</code
      > when given an <code class="font-mono">href</code>.
    </p>
    <div class="card card-border bg-base-100">
      <div class="card-body flex-row flex-wrap gap-3">
        {
          buttonVariants.map((variant) => (
            <Button variant={variant}>{variant}</Button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">Badge</h2>
    <p class="mb-5 text-sm text-base-content/60">
      <code class="font-mono">{`<Badge variant="success">`}</code> &mdash; used for
      role labels and API key kinds elsewhere in the app.
    </p>
    <div class="card card-border bg-base-100">
      <div class="card-body flex-row flex-wrap items-center gap-3">
        {
          badgeVariants.map((variant) => (
            <Badge variant={variant}>{variant}</Badge>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">Alert</h2>
    <p class="mb-5 text-sm text-base-content/60">
      <code class="font-mono">{`<Alert variant="error">`}</code> &mdash; the same
      pattern used for action-result messages on the login, invite, and profile pages.
    </p>
    <div class="flex flex-col gap-3">
      {
        alertVariants.map((variant) => (
          <Alert variant={variant}>
            <span class="capitalize">{variant}</span> &mdash; this is what a{" "}
            {variant} message looks like.
          </Alert>
        ))
      }
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">Card</h2>
    <p class="mb-5 text-sm text-base-content/60">
      <code class="font-mono">{`<Card title="...">`}</code> &mdash; a bordered container
      with an optional title; every section on this page (including this one) is one.
    </p>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <Card title="With a title">
        <p class="text-sm text-base-content/70">
          Pass a <code class="font-mono text-xs">title</code> prop and it renders
          as a card-title heading.
        </p>
      </Card>
      <Card>
        <p class="text-sm text-base-content/70">
          Omit it and the card is just a bordered container for whatever you put
          inside.
        </p>
      </Card>
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">Divider &amp; list</h2>
    <p class="mb-5 text-sm text-base-content/60">
      Not (yet) wrapped in components &mdash; plain daisyUI classes, used as-is
      on the profile page's API key list.
    </p>
    <div class="card card-border bg-base-100">
      <div class="card-body">
        <ul class="list">
          <li class="list-row">
            <div>
              <div class="font-medium">my laptop</div>
              <div class="text-xs text-base-content/60">
                created Jan 3 &middot; last used yesterday
              </div>
            </div>
            <Badge variant="neutral" style="outline">cli</Badge>
          </li>
          <li class="list-row">
            <div>
              <div class="font-medium">grading bot</div>
              <div class="text-xs text-base-content/60">
                created Feb 12 &middot; last used never
              </div>
            </div>
            <Badge variant="neutral" style="outline">bot</Badge>
          </li>
        </ul>
        <div class="divider"></div>
        <p class="text-xs text-base-content/50">
          <code class="font-mono">divider</code> separates the list from whatever
          follows it &mdash; on the profile page, the create-key form.
        </p>
      </div>
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">Table</h2>
    <p class="mb-5 text-sm text-base-content/60">
      <code class="font-mono">{`<Table columns={...} data={...} />`}</code> &mdash;
      a data-driven
      <code class="font-mono">&lt;table&gt;</code>; each column declares its
      header and how to render a row's cell, so the markup never repeats per
      row.
    </p>
    <Table columns={tableColumns} data={tableRows} />
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">Tabs</h2>
    <p class="mb-5 text-sm text-base-content/60">
      <code class="font-mono">{`<Tabs items={...} active="..." />`}</code> &mdash;
      the tab strip on this very page. Link mode (shown above, no <code
        class="font-mono">name</code
      > prop) renders <code class="font-mono">&lt;a&gt;</code>
      tabs that navigate; pass a <code class="font-mono">name</code> instead for same-page
      tabs driven by radio inputs, as on the profile page.
    </p>
    <div class="card card-border bg-base-100">
      <div class="card-body">
        <Tabs items={tabItems} active="overview" />
      </div>
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold">ListRow</h2>
    <p class="mb-5 text-sm text-base-content/60">
      <code class="font-mono">{`<ListRow href="..." muted>`}</code> &mdash; a single-row
      card with optional leading/trailing slots. Renders an <code
        class="font-mono">&lt;a&gt;</code
      > when given
      <code class="font-mono">href</code>, a <code class="font-mono"
        >&lt;button&gt;</code
      > when given
      <code class="font-mono">openDialog</code>, or a plain <code
        class="font-mono">&lt;div&gt;</code
      > otherwise. Used for exam, resource, and upcoming-item rows across the app.
    </p>
    <div class="flex flex-col gap-3">
      <ListRow href="#">
        <div class="font-medium">Midterm exam</div>
        <div class="text-xs text-base-content/60">
          opens Mar 3 &middot; 90 minutes
        </div>
        <Fragment slot="trailing">
          <Badge variant="primary">open</Badge>
        </Fragment>
      </ListRow>
      <ListRow muted>
        <div class="font-medium">Final exam</div>
        <div class="text-xs text-base-content/60">opens Jun 12</div>
        <Fragment slot="trailing">
          <Badge variant="neutral" style="outline">locked</Badge>
        </Fragment>
      </ListRow>
    </div>
  </section>

  <section>
    <h2 class="mb-2 text-xl font-semibold">PageKicker &amp; BrandSquares</h2>
    <p class="mb-5 text-sm text-base-content/60">
      <code class="font-mono">{`<PageKicker text="..." squares />`}</code> &mdash;
      the small mono eyebrow above a page's heading, seen at the top of the design
      index. The
      <code class="font-mono">squares</code> prop pairs it with <code
        class="font-mono">&lt;BrandSquares /&gt;</code
      >, a short stripe running through the primary, error, warning and success
      tokens; only the landing page's hero kicker uses it, every other kicker
      is text-only.
    </p>
    <div class="card card-border bg-base-100">
      <div class="card-body gap-4">
        <PageKicker text="Reference" squares />
        <PageKicker text="Section" />
        <div class="flex items-center gap-2">
          <BrandSquares />
          <span class="text-xs text-base-content/60"
            >BrandSquares on its own</span
          >
        </div>
      </div>
    </div>
  </section>
</DesignLayout>
