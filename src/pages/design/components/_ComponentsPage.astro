---
import Link from "@/components/Link.astro";
import DesignLayout from "@/layouts/DesignLayout.astro";
import { anchor, type Href, urls } from "@/urls";
import { themes } from "./_themes";

/**
 * The frame of a theme page of the component catalogue: the theme tabs, a sidebar with its sections and the title.
 *
 * The `intro` slot holds the paragraph under the title; the default slot, the sections.
 */
interface Props {
	/// Which theme this is: its `href` in `themes`.
	href: Href;
	/// Anchors of the sections, in page order.
	sections: readonly { id: string; label: string }[];
}

const { href, sections } = Astro.props;
const theme = themes.find((t) => t.href === href);
const label = theme?.label ?? "";
---

<DesignLayout title={`${label} components`} active="components">
  <nav aria-label="Component themes" class="mb-8 flex flex-wrap gap-2">
    <Link href={urls.design.components.index()} class="btn btn-sm btn-ghost">All</Link>
    {
      themes.map((t) => (
        <Link
          href={t.href}
          class:list={["btn btn-sm", t.href === href ? "btn-active btn-primary" : "btn-ghost"]}
          aria-current={t.href === href ? "page" : undefined}
        >
          {t.label}
        </Link>
      ))
    }
  </nav>

  <div class="lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-10">
    <nav aria-label={label} class="sticky top-6 self-start max-lg:hidden">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">{label}</p>
      <ul class="flex flex-col gap-1 border-l border-edge">
        {
          sections.map((link) => (
            <li>
              <Link
                href={anchor(link.id)}
                class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-sm text-muted transition-colors hover:border-edge hover:text-base-content"
              >
                {link.label}
              </Link>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="min-w-0">
      <section class="mb-14">
        <h1 class="text-3xl font-bold">{label}</h1>
        <p class="mt-3 max-w-2xl text-base-content/70">
          <slot name="intro" />
        </p>
      </section>

      <slot />
    </div>
  </div>
</DesignLayout>
