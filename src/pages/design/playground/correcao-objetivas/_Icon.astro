---
import { ICONS, type IconName } from "./_icons";

interface Props {
	name: IconName;
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[name]}></svg>
