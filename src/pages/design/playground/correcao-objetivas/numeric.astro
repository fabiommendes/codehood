---
import { numeric } from "./_data";
import Frame from "./_Frame.astro";
import Groups from "./_Groups.astro";
import { guard } from "./_guard";

export const prerender = false;
const g = await guard(Astro as never);
if ("redirect" in g) return g.redirect;
const q = numeric();
const names = Astro.url.searchParams.get("names") === "1";
// The zoomed window of the axis, in seconds, and the tolerance band of the key.
const LOW = 1.95;
const HIGH = 2.15;
const BAND = [2.0, 2.04] as const;
const at = (v: number) => ((v - LOW) / (HIGH - LOW)) * 100;
const PX = 8;
const bars = [
	{ v: 2.0, right: 6, wrong: 0, off: 0 },
	{ v: 2.02, right: 13, wrong: 2, off: 0 },
	{ v: 2.1, right: 0, wrong: 0, off: 4 },
];
const far = [
	{ label: "4,08", n: 3, tag: "esqueceu a raiz" },
	{ label: "outros", n: 5, tag: "valores soltos" },
];
const ticks = [1.95, 2.0, 2.05, 2.1, 2.15];
---

<Frame q={q} grading={g}>
  <section class="mt-8">
    <h3 class="page-subsubheader">Valores enviados</h3>
    <p class="mt-1 text-sm text-muted">Histograma dos valores, em segundos. A faixa verde é a tolerância do gabarito. Âmbar: valor na faixa, mas com a unidade errada.</p>
    <div class="mt-3 grid gap-6 rounded-box border border-edge bg-base-100 p-6" style="grid-template-columns:minmax(0,2.2fr) minmax(0,1fr)">
      <div>
        <div class="relative border-b border-base-content/30" style="height:10rem">
          <div style={`background:color-mix(in oklab,var(--color-success) 18%,transparent);position:absolute;top:0;bottom:0;left:${at(BAND[0])}%;width:${at(BAND[1]) - at(BAND[0])}%`}></div>
          <span class="text-xs text-success" style={`position:absolute;top:0;left:${at(BAND[0])}%;white-space:nowrap;padding-left:2px`}>tolerância 2,02 ± 0,02</span>
          {bars.map((b) => (
            <div class="flex flex-col items-center justify-end" style={`position:absolute;bottom:0;width:3rem;transform:translateX(-50%);left:${at(b.v)}%`}>
              <span class="text-xs tabular-nums">{b.right + b.wrong + b.off}</span>
              {b.wrong > 0 && <div class="w-full bg-warning" style={`height:${b.wrong * PX}px`}></div>}
              {b.off > 0 && <div class="w-full bg-base-content/30" style={`height:${b.off * PX}px`}></div>}
              {b.right > 0 && <div class="w-full bg-success" style={`height:${b.right * PX}px`}></div>}
            </div>
          ))}
        </div>
        <div class="relative text-xs tabular-nums text-muted" style="height:1.5rem">
          {ticks.map((t) => <span style={`position:absolute;transform:translateX(-50%);left:${at(t)}%`}>{t.toFixed(2).replace(".", ",")}</span>)}
        </div>
      </div>
      <div class="border-l border-dashed border-base-content/30 pl-6">
        <p class="text-xs text-muted">Fora da janela</p>
        <div class="mt-1 flex items-end gap-6 border-b border-base-content/30" style="height:10rem">
          {far.map((f) => (
            <div class="flex flex-col items-center">
              <span class="text-xs tabular-nums">{f.n}</span>
              <div class="w-8 bg-base-content/30" style={`height:${f.n * PX}px`}></div>
            </div>
          ))}
        </div>
        <div class="flex gap-6 text-xs tabular-nums text-muted">
          {far.map((f) => <span class="w-8 text-center">{f.label}</span>)}
        </div>
      </div>
    </div>
  </section>
  {q.blocks.map((block) => <Groups block={{ ...block, title: "Respostas agrupadas por valor e erro típico" }} names={names} />)}
</Frame>
