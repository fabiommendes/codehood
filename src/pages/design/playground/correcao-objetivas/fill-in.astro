---
import { fillIn, type Member as M } from "./_data";
import Frame from "./_Frame.astro";
import GroupedAnswers from "./_GroupedAnswers";
import { guard } from "./_guard";
import Members from "./_Members";
import { groupRows, memberRow } from "./_rows";

export const prerender = false;
const g = await guard(Astro as never);
if ("redirect" in g) return g.redirect;
const q = fillIn();
const names = Astro.url.searchParams.get("names") === "1";
const wrongBy = new Map<number, { member: M; misses: string[] }>();
q.blocks.forEach((block, i) => {
	for (const g of block.groups) {
		if (g.score === 100) continue;
		for (const m of g.members) {
			const entry = wrongBy.get(m.student.id) ?? { member: m, misses: [] };
			entry.misses.push(`${i + 1}: ${g.label}`);
			wrongBy.set(m.student.id, entry);
		}
	}
});
const missed = [...wrongBy.values()]
	.sort((a, b) => b.misses.length - a.misses.length)
	.map((e) =>
		memberRow(
			{
				...e.member,
				auto: Math.round(
					((q.blocks.length - e.misses.length) / q.blocks.length) * 100,
				),
			},
			names,
			e.misses.join("  ·  "),
		),
	);
---

<Frame q={q} grading={g}>
  <section class="mt-8">
    <h3 class="page-subsubheader">Valores por lacuna</h3>
    {q.blocks.map((block) => (
      <div class="mt-4">
        <h4 class="mb-2 text-sm font-medium">{block.title}</h4>
        <GroupedAnswers client:load rows={groupRows(block, names)} responseHeader="Valor" mode="accepted" />
      </div>
    ))}
  </section>

  <section class="mt-8">
    <h3 class="page-subsubheader">Quem errou alguma lacuna ({missed.length})</h3>
    <p class="mt-1 text-sm text-muted">A nota da questão é a parte de lacunas certas. Alterar a nota vale para a questão inteira.</p>
    <div class="mt-3"><Members client:load rows={missed} detailTitle="Lacunas erradas" note={q.changeNote} /></div>
  </section>
</Frame>
