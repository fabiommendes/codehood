---
import { multipleSelection } from "./_data";
import Frame from "./_Frame.astro";
import GroupedAnswers, { type Check } from "./_GroupedAnswers";
import { groupRows, memberRow } from "./_rows";

export const prerender = false;
const q = multipleSelection();
const names = Astro.url.searchParams.get("names") === "1";
const options = q.key.map((k, i) => ({
	letter: "ABCDE"[i] as string,
	text: k.text.slice(3),
	key: k.ok === true,
}));
const everyone = q.blocks.flatMap((b) =>
	b.groups.flatMap((g) =>
		g.members.map((m) => ({
			member: m,
			marked: (m.detail ?? g.label).match(/\b[A-E]\b/g) ?? ([] as string[]),
		})),
	),
);
const total = everyone.length;
const optionRows = options.map((o) => {
	const who = everyone.filter((e) => e.marked.includes(o.letter));
	const percent = Math.round((who.length / total) * 100);
	const mean =
		who.length >= 3
			? who.reduce((s, e) => s + e.member.student.avg, 0) / who.length
			: null;
	// A key option few marked, or a wrong one many marked, is worth a look at the key.
	const review = o.key ? percent < 70 : percent > 25;
	return {
		id: o.letter,
		response: {
			kind: "choice" as const,
			marker: "checkbox" as const,
			key: o.key,
			text: `${o.letter}. ${o.text}`,
		},
		count: who.length,
		percent,
		changed: who.filter((e) => e.member.manual !== undefined).length,
		mean,
		diagnosis: review
			? o.key
				? "Pouca gente marcou uma alternativa do gabarito."
				: "Muita gente marcou uma alternativa fora do gabarito."
			: undefined,
		members: who.map((e) =>
			memberRow(e.member, names, `marcou ${e.marked.join(" + ")}`),
		),
	};
});
const keyLetters = options.filter((o) => o.key).map((o) => o.letter);
const comboRows = (block: (typeof q.blocks)[number]) =>
	groupRows(block, names).map((row) => {
		const letters = row.response.text.match(/\b[A-E]\b/g);
		if (!letters || row.response.text.startsWith("Outras")) return row;
		const boxes: Check[] = options.map((o) => ({
			letter: o.letter,
			on: letters.includes(o.letter),
			key: keyLetters.includes(o.letter),
		}));
		return {
			...row,
			response: { kind: "choices" as const, boxes, text: row.response.text },
		};
	});
---

<Frame q={q}>
  <section class="mt-8">
    <h3 class="page-subsubheader">Por alternativa</h3>
    <p class="mt-1 text-sm text-muted">Quantos marcaram cada alternativa. A caixa verde é do gabarito.</p>
    <div class="mt-3"><GroupedAnswers client:load rows={optionRows} responseHeader="Alternativa" detailTitle="Marcou" /></div>
  </section>
  {q.blocks.map((block) => (
    <section class="mt-8">
      <h3 class="page-subsubheader">{block.title ?? "Respostas agrupadas"}</h3>
      <p class="mt-1 text-sm text-muted">Verde: marcada e no gabarito. Vermelho: marcada fora do gabarito. Borda verde vazia: do gabarito e não marcada.</p>
      <div class="mt-3"><GroupedAnswers client:load rows={comboRows(block)} responseHeader="Combinação" /></div>
    </section>
  ))}
</Frame>
