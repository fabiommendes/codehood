---
import { trueFalse } from "./_data";
import Frame from "./_Frame.astro";
import GroupedAnswers from "./_GroupedAnswers";
import { memberRow } from "./_rows";

export const prerender = false;
const q = trueFalse();
const names = Astro.url.searchParams.get("names") === "1";
const gabarito = q.key.map((k) => (k.ok ? "V" : "F"));
const everyone = q.blocks.flatMap((b) =>
	b.groups.flatMap((g) =>
		g.members.map((m) => ({
			member: m,
			pattern: (m.detail ?? g.label).split(" · "),
		})),
	),
);
const total = everyone.length;
const mean = (list: typeof everyone) =>
	list.reduce((s, e) => s + e.member.student.avg, 0) / Math.max(1, list.length);
const rows = q.key.map((k, i) => {
	const marks = everyone.map((e) => e.pattern[i]);
	const wrong = everyone.filter((e) => e.pattern[i] !== gabarito[i]);
	const meanWrong = wrong.length >= 3 ? mean(wrong) : null;
	const meanRight = mean(everyone.filter((e) => e.pattern[i] === gabarito[i]));
	return {
		id: `item-${i + 1}`,
		response: {
			kind: "statement" as const,
			text: k.text,
			truth: gabarito[i] as "V" | "F",
			marked: {
				V: marks.filter((x) => x === "V").length,
				F: marks.filter((x) => x === "F").length,
			},
		},
		sub: `Gabarito: ${gabarito[i] === "V" ? "verdadeira" : "falsa"}`,
		count: wrong.length,
		percent: Math.round((wrong.length / total) * 100),
		changed: wrong.filter((e) => e.member.manual !== undefined).length,
		mean: meanWrong,
		diagnosis:
			meanWrong !== null && meanWrong >= meanRight
				? "A média de quem errou este item é maior que a de quem acertou."
				: undefined,
		members: wrong.map((e) =>
			memberRow(
				e.member,
				names,
				`marcou ${gabarito[i] === "V" ? "F" : "V"} · respostas ${e.pattern.join(" ")}`,
			),
		),
	};
});
---

<Frame q={q}>
  <section class="mt-8">
    <h3 class="page-subsubheader">Afirmação por afirmação</h3>
    <p class="mt-1 text-sm text-muted">Cada linha é um item do gabarito. A barra mostra quem marcou V (verde) e F (vermelho). "Erraram" e a marcação contam só quem errou o item.</p>
    <div class="mt-3"><GroupedAnswers client:load rows={rows} responseHeader="Afirmação" countTitle="Erraram" detailTitle="Respostas" note="A nota é da questão inteira, não do item." /></div>
  </section>
</Frame>
