---
import { fmt, trueFalse } from "./_data";
import Frame from "./_Frame.astro";
import Member from "./_Member.astro";

export const prerender = false;
const q = trueFalse();
const names = Astro.url.searchParams.get("names") === "1";
const gabarito = q.key.map((k) => (k.ok ? "V" : "F"));
const everyone = q.blocks.flatMap((b) =>
	b.groups.flatMap((g) =>
		g.members.map((m) => ({
			member: m,
			pattern: (m.detail ?? g.label).split(" · "),
		})),
	),
);
const total = everyone.length;
const rows = q.key.map((k, i) => {
	const marks = everyone.map((e) => e.pattern[i]);
	const wrong = everyone.filter((e) => e.pattern[i] !== gabarito[i]);
	const mean = (list: typeof everyone) =>
		list.reduce((s, e) => s + e.member.student.avg, 0) /
		Math.max(1, list.length);
	return {
		text: k.text,
		gabarito: gabarito[i] as string,
		v: marks.filter((x) => x === "V").length,
		f: marks.filter((x) => x === "F").length,
		wrong,
		meanWrong: wrong.length >= 3 ? mean(wrong) : null,
		meanRight: mean(everyone.filter((e) => e.pattern[i] === gabarito[i])),
	};
});
---

<Frame q={q}>
  <section class="mt-8">
    <h3 class="page-subsubheader">Afirmação por afirmação</h3>
    <p class="mt-1 text-sm text-muted">Cada linha é um item do gabarito. Abra uma linha para ver quem errou aquele item e alterar a nota.</p>
    <ul class="mt-3 overflow-hidden rounded-box border border-edge bg-base-100">
      <li class="grid items-end gap-3 border-b border-edge px-4 py-2 text-xs text-muted" style="grid-template-columns:minmax(0,1fr) 4.5rem minmax(10rem,16rem) 5rem 7rem">
        <span>Afirmação</span><span class="text-center">Gabarito</span><span>Marcaram V · F</span><span class="text-right">Erraram</span><span class="text-right" title="Média nas outras questões, de quem errou o item. Só com 3 ou mais.">Média de quem errou</span>
      </li>
      {rows.map((r) => (
        <li class="border-t border-edge first:border-t-0">
          <details>
            <summary class="grid cursor-pointer list-none items-center gap-3 px-4 py-3 hover:bg-base-200/60" style="grid-template-columns:minmax(0,1fr) 4.5rem minmax(10rem,16rem) 5rem 7rem">
              <span class="font-medium">{r.text}</span>
              <span class="text-center"><span class={`badge badge-sm ${r.gabarito === "V" ? "badge-success" : "badge-error"} badge-soft`}>{r.gabarito === "V" ? "Verdadeira" : "Falsa"}</span></span>
              <span>
                <span class="flex h-3 overflow-hidden rounded-full bg-base-200">
                  <span class="bg-success" style={`width:${(r.v / total) * 100}%`}></span>
                  <span class="bg-error" style={`width:${(r.f / total) * 100}%`}></span>
                </span>
                <span class="mt-0.5 flex justify-between text-xs tabular-nums text-muted"><span>V {r.v}</span><span>F {r.f}</span></span>
              </span>
              <span class={`text-right tabular-nums ${r.wrong.length >= 10 ? "font-semibold text-warning" : ""}`}>{r.wrong.length} <span class="text-muted">({Math.round((r.wrong.length / total) * 100)}%)</span></span>
              <span class="text-right tabular-nums">
                {r.meanWrong === null ? <span class="text-muted">–</span> : fmt(r.meanWrong)}
                {r.meanWrong !== null && r.meanWrong >= r.meanRight && <span class="badge badge-warning badge-xs mt-0.5 block">acima de quem acertou</span>}
              </span>
            </summary>
            <ul class="border-t border-edge bg-base-200/30">
              {r.wrong.length === 0 && <li class="px-4 py-2 text-sm text-muted">Ninguém errou este item.</li>}
              {r.wrong.map((e) => (
                <Member member={e.member} names={names} detail={`marcou ${r.gabarito === "V" ? "F" : "V"} · respostas ${e.pattern.join(" ")}`} note="A nota é da questão inteira, não do item." />
              ))}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  </section>
</Frame>
