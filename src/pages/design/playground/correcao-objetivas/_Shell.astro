---
/// The real course page chrome (layout, sidebar card, course header) around a mockup.
import CourseHeader from "@/components/CourseHeader.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { gradingExamNav } from "@/utils/load-grading";
import type { Grading } from "./_guard";

interface Props {
	title: string;
	grading: Grading;
}

const { title, grading: result } = Astro.props;
// biome-ignore lint/style/noNonNullAssertion: loadGrading redirected an anonymous visitor.
const actor = Astro.locals.actor!;
---

<AppLayout
  title={title}
  trail={breadcrumbs(Astro.url, { course: result.course, item: "Quiz 1", question: title })}
  nav={await gradingExamNav(result, actor)}
>
  <CourseHeader course={result.course} tabs={result.tabs} active="exams" />
  <slot />
</AppLayout>
