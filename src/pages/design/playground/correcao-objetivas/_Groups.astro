---
import type { Block } from "./_data";
/// Distinct responses with count, score and the mean of who chose them, as a sortable table.
import GroupedAnswers from "./_GroupedAnswers";
import { groupRows } from "./_rows";

interface Props {
	block: Block;
	names: boolean;
	note?: string;
	/// Draws each item as a radio or a checkbox, green when it scores 100.
	lead?: "radio" | "checkbox";
}

const { block, names, note, lead } = Astro.props;
const rows = groupRows(block, names).map((row) =>
	lead && row.id !== "Em branco"
		? {
				...row,
				response: {
					kind: "choice" as const,
					marker: lead,
					key: row.score === 100,
					text: row.response.text,
				},
			}
		: row,
);
---

<section class="mt-8">
  {block.title && <h3 class="page-subsubheader">{block.title}</h3>}
  <div class="mt-3">
    <GroupedAnswers
      client:load
      rows={rows}
      responseHeader={block.responseHeader}
      mode={block.mode}
      note={note}
    />
  </div>
</section>
