---
import { ordering } from "./_data";
import Frame from "./_Frame.astro";
import Groups from "./_Groups.astro";
import { Matrix } from "./_Tables";

export const prerender = false;
const q = ordering();
const names = Astro.url.searchParams.get("names") === "1";
const steps = q.key.map((k) => k.text.replace(/^\d+\. /, ""));
const groups = q.blocks.flatMap((b) => b.groups);
const total = groups.reduce((n, g) => n + g.members.length, 0);
// How many students put each step at each position.
const cell = (step: string, position: number): number =>
	groups
		.filter((g) => g.chips?.[position]?.text === step)
		.reduce((n, g) => n + g.members.length, 0);
---

<Frame q={q}>
  <section class="mt-8">
    <h3 class="page-subsubheader">Onde cada etapa foi colocada</h3>
    <p class="mt-1 text-sm text-muted">Linhas: etapas na ordem do gabarito. Colunas: posição escolhida. A diagonal é o gabarito. Fora dela, quanto mais forte a cor, mais alunos se enganaram assim.</p>
    <div class="mt-3">
      <Matrix client:load total={total} rows={steps.map((step) => ({ step, cells: steps.map((_, p) => cell(step, p)) }))} />
    </div>
  </section>
  {q.blocks.map((block) => <Groups block={{ ...block, title: "Ordens inteiras" }} names={names} />)}
</Frame>
