---
import { shortAnswer } from "./_data";
import Frame from "./_Frame.astro";
import GroupedAnswers from "./_GroupedAnswers";
import { guard } from "./_guard";
import { groupRows } from "./_rows";

export const prerender = false;
const g = await guard(Astro as never);
if ("redirect" in g) return g.redirect;
const q = shortAnswer();
const names = Astro.url.searchParams.get("names") === "1";
const all = q.blocks.flatMap((b) => b.groups);
const accepted = all.filter((g) => g.score === 100);
const rejected = all.filter((g) => g.score !== 100);
const count = (list: typeof all) =>
	list.reduce((n, g) => n + g.members.length, 0);
const block = q.blocks[0];
if (!block) throw new Error("fixture without a block");
const rows = groupRows(
	{ ...block, groups: [...accepted, ...rejected] },
	names,
	(m) => (m.detail ? `“${m.detail}”` : undefined),
).map((row) => {
	const g = all.find((x) => x.label === row.id);
	const variants = new Set(g?.members.map((m) => m.detail)).size;
	const grafias = `${variants} ${variants === 1 ? "grafia" : "grafias"}`;
	const rejectedHigh = g?.score !== 100 && row.mean !== null && row.mean >= 70;
	return {
		...row,
		sub: row.sub ? `${grafias} · ${row.sub}` : grafias,
		diagnosis: rejectedHigh
			? "Texto recusado de média alta: pode faltar no gabarito."
			: undefined,
	};
});
---

<Frame q={q} grading={g}>
  <section class="mt-8">
    <h3 class="page-subsubheader">Textos distintos</h3>
    <p class="mt-1 text-sm text-muted">
      Textos iguais depois de ignorar maiúsculas e acentos ficam juntos. <strong>{accepted.length} aceitos</strong> ({count(accepted)} alunos), <strong>{rejected.length} recusados</strong> ({count(rejected)} alunos).
      Um texto recusado que parece certo indica falta no gabarito.
    </p>
    <div class="mt-3">
      <GroupedAnswers client:load rows={rows} responseHeader="Texto normalizado" mode="accepted" detailTitle="Escreveu" />
    </div>
  </section>
</Frame>
