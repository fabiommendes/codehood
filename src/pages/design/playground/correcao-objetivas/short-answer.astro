---
import { fmt, meanOf, shortAnswer } from "./_data";
import Frame from "./_Frame.astro";
import Member from "./_Member.astro";

export const prerender = false;
const q = shortAnswer();
const names = Astro.url.searchParams.get("names") === "1";
const all = q.blocks.flatMap((b) => b.groups);
const accepted = all.filter((g) => g.score === 100);
const rejected = all.filter((g) => g.score !== 100);
const count = (list: typeof all) =>
	list.reduce((n, g) => n + g.members.length, 0);
const total = count(all);
---

<Frame q={q}>
  <section class="mt-8">
    <h3 class="page-subsubheader">Textos distintos</h3>
    <p class="mt-1 text-sm text-muted">
      Textos iguais depois de ignorar maiúsculas e acentos ficam juntos. <strong>{accepted.length} aceitos</strong> ({count(accepted)} alunos), <strong>{rejected.length} recusados</strong> ({count(rejected)} alunos).
      Um texto recusado que parece certo indica falta no gabarito.
    </p>
    <ul class="mt-3 flex flex-col gap-2">
      {[...accepted, ...rejected].map((g) => {
        const ok = g.score === 100;
        const mean = meanOf(g);
        const variants = new Set(g.members.map((m) => m.detail)).size;
        return (
          <li>
            <details class={`rounded-box border bg-base-100 ${ok ? "border-success/40" : "border-edge"}`}>
              <summary class="flex cursor-pointer list-none items-center gap-4 px-4 py-3 hover:bg-base-200/60">
                <span style="width:1.75rem;height:1.75rem" class={`flex shrink-0 items-center justify-center rounded-full text-sm font-bold ${ok ? "bg-success text-success-content" : "bg-base-300 text-base-content/60"}`} aria-label={ok ? "Aceito" : "Recusado"}>{ok ? "✓" : "✗"}</span>
                <span class="min-w-0 flex-1">
                  <span class="text-lg font-medium">“{g.label}”</span>
                  <span class="block text-xs text-muted">{variants} {variants === 1 ? "grafia" : "grafias"}{g.sub ? ` · ${g.sub}` : ""}</span>
                </span>
                <span class="hidden w-40 sm:block"><span class="block h-2 overflow-hidden rounded-full bg-base-200"><span class={`block h-full ${ok ? "bg-success" : "bg-base-content/30"}`} style={`width:${(g.members.length / total) * 100 * 2.5}%`}></span></span></span>
                <span class="w-24 text-right tabular-nums">{g.members.length} <span class="text-muted">({Math.round((g.members.length / total) * 100)}%)</span></span>
                <span class="w-24 text-right text-sm tabular-nums" title="Média nas outras questões">{mean === null ? <span class="text-muted">–</span> : <>média {fmt(mean)}</>}{!ok && mean !== null && mean >= 70 && <span class="badge badge-warning badge-xs ml-1">alta</span>}</span>
              </summary>
              <ul class="border-t border-edge bg-base-200/30">
                {g.members.map((m) => <Member member={m} names={names} detail={`escreveu “${m.detail}”`} />)}
              </ul>
            </details>
          </li>
        );
      })}
    </ul>
  </section>
</Frame>
