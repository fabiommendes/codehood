---
/// The frame every type shares: header, summary line, needs attention, [type body], changed by hand, statement and key.
import QuestionNumber from "@/components/exam/QuestionNumber.astro";
import AnswerKey from "@/components/grading/AnswerKey";
import { type Fixture, fmt, studentLabel } from "./_data";
import { docOf } from "./_docs";
import type { Grading } from "./_guard";
import Icon from "./_Icon.astro";
import Overrides from "./_Overrides";
import Shell from "./_Shell.astro";

interface Props {
	q: Fixture;
	grading: Grading;
}

const { q, grading } = Astro.props;
const names = Astro.url.searchParams.get("names") === "1";
const back = "/design/playground/correcao-objetivas";
const regrades = "/cs101/ada_2026-2/exams/quiz-01/regrades";
---

<Shell title={q.title} grading={grading}>
  <a href={back} class="text-sm text-muted hover:text-primary">← Mockups da correção</a>
  <p class="mt-2 text-sm"><QuestionNumber number={q.position} points={q.points} /> <span class="badge badge-ghost badge-sm ml-1">{q.typeLabel}</span></p>
  <div class="relative flex items-center gap-2">
    <a href="#" class="btn btn-ghost btn-sm btn-square text-base-content/60 lg:absolute lg:right-full lg:mr-1" aria-label="Questão anterior" title="Questão anterior">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"></path></svg>
    </a>
    <h2 class="page-subheader">{q.title}</h2>
    <a href="#" class="btn btn-ghost btn-sm btn-square text-base-content/60" aria-label="Próxima questão" title="Próxima questão">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"></path></svg>
    </a>
  </div>

  <details class="mt-4 overflow-hidden rounded-box border border-edge bg-base-200/25 shadow-sm">
    <summary class="cursor-pointer bg-base-200/50 px-4 py-2 text-sm font-medium">Enunciado e gabarito</summary>
    <div class="border-t border-edge p-6">
      <AnswerKey client:load question={docOf(q)} />
    </div>
  </details>

  <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-lg" data-testid="summary">
    <span><strong>{q.answers}</strong> respostas</span>
    <span class="text-muted">·</span>
    <span><strong>{q.correctPct}%</strong> corretas</span>
    {q.discrimination !== null && <span class="badge badge-warning badge-soft" title="Quem vai bem na prova erra tanto quanto quem vai mal. Vale conferir o gabarito.">discriminação baixa ({fmt(q.discrimination, 2)})</span>}
    {q.pending > 0 && <a href="#atencao" class="badge badge-warning">{q.pending} sem nota</a>}
  </p>

  {(q.attention.length > 0 || q.showEmptyAttention) && (
    <section id="atencao" class="mt-6">
      <h3 class="page-subsubheader">Requer atenção{q.attention.length > 0 && ` (${q.attention.length})`}</h3>
      {q.attention.length === 0 ? (
        <p class="mt-2 text-sm text-muted">Nada requer atenção: todas as respostas têm nota e não há pedidos de revisão.</p>
      ) : (
        <ul class="mt-3 overflow-hidden rounded-box border border-warning/40 bg-base-100">
          {q.attention.map((row) => (
            <li class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-edge px-4 py-2 text-sm first:border-t-0">
              <span class="w-44 shrink-0 font-medium">{studentLabel(row.student, names)}</span>
              <span class="badge badge-warning badge-soft badge-sm">{row.kind === "pending" ? "Sem nota" : row.kind === "regrade" ? "Revisão pedida" : "Suspeita"}</span>
              <span class="min-w-48 flex-1 text-muted">{row.detail}</span>
              {row.kind === "pending" && (
                <form class="flex items-center gap-2">
                  <input type="number" min="0" max="100" placeholder="0 a 100" class="input input-sm w-24" aria-label="Nota" />
                  <button type="button" class="btn btn-success btn-soft btn-sm">Marcar como certa</button>
                  <button type="button" class="btn btn-primary btn-sm">Dar nota</button>
                </form>
              )}
              {row.kind === "regrade" && <a href={regrades} class="btn btn-ghost btn-sm btn-square" aria-label="Ver pedido" title="Ver pedido"><Icon name="message" /></a>}
              {row.kind === "suspicious" && (
                <span class="flex gap-2">
                  <button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Ignorar" title="Ignorar"><Icon name="eyeOff" /></button>
                  <button type="button" class="btn btn-ghost btn-sm btn-square text-error" aria-label="Aplicar sanção" title="Aplicar sanção"><Icon name="gavel" /></button>
                </span>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  <slot />

  {q.overrides.length > 0 && (
    <section class="mt-8">
      <h3 class="page-subsubheader">Alteradas à mão ({q.overrides.length})</h3>
      <div class="mt-3">
        <Overrides
          client:load
          rows={q.overrides.map((o) => ({ name: studentLabel(o.student, names), kind: o.kind, auto: o.auto, final: o.final, comment: o.comment, when: o.when }))}
        />
      </div>
    </section>
  )}

  <p role="note" class="alert alert-info alert-soft mt-8 py-2 text-sm">Fixar uma nova versão da questão na prova não corrige de novo as respostas que já existem. Por enquanto, use "Alterar nota".</p>

  <div class="fab">
    <a href="#" class="btn btn-lg btn-circle btn-primary" aria-label="Editar questão" title="Editar questão">
      <Icon name="pencil" />
    </a>
  </div>
  <div class="h-20" aria-hidden="true"></div>
</Shell>
