---
// Prototype of the student's answer to an MDQ `code` question, driven by a
// fake `runTests` so every result state shows without a runner or a database.
import { readFileSync } from "node:fs";
import path from "node:path";
import { parseQuestion, publicForm, resolveTests } from "mdq";
import PageKicker from "@/components/PageKicker.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { pretestSources } from "@/utils/pretest-sources";
import Demo, { type Scenario } from "./_Demo";

export const prerender = false;

const dir = path.join(
	process.cwd(),
	"workers/chalk-worker/example/questions/elm",
);
const parsed = parseQuestion(readFileSync(path.join(dir, "soma.md"), "utf8"));
if (parsed.type !== "code") throw new Error("soma.md is not a code question");
const origins = (parsed.tests ?? []).flatMap((source) =>
	source.origin ? [source.origin] : [],
);
// The example file has no `{example}` region: turn its first region into one and add a public one, so both show.
const texts = Object.fromEntries(
	origins.map((origin) => [
		origin,
		readFileSync(path.join(dir, origin), "utf8"),
	]),
);
texts["Pre.elm"] =
	`${texts["Pre.elm"]?.replace("{public}", "{example}")}\n\n-- mdq: [0] {public} Soma negativos\nnegativos : Test\nnegativos =\n    test "negativos" <| \\_ -> Expect.equal -3 (soma [ -1, -2 ])\n`;
const question = resolveTests(parsed, texts);
const pub = publicForm(question);
const pretests = pretestSources(question);

const scenarios: { id: Scenario; title: string; autorun: boolean }[] = [
	{ id: "pass", title: "All pass", autorun: true },
	{ id: "fail", title: "Some fail", autorun: true },
	{ id: "build-error", title: "Build error", autorun: true },
	{ id: "runner-error", title: "Runner error", autorun: true },
	{ id: "running", title: "Running", autorun: true },
	{ id: "unavailable", title: "runTests throws", autorun: true },
];
---

<AppLayout title="Code question">
  <main class="mx-auto max-w-5xl px-4 py-10">
    <div class="mb-6">
      <PageKicker text="Playground" />
      <h1 class="text-3xl font-bold">Code question, answer mode</h1>
      <p class="mt-2 max-w-2xl text-base-content/70">
        <code>elm/soma.md</code> from the chalk worker examples. Each card has a fake runner and
        runs the pretests on load; click "Run pretests" to run again.
        Sources sent: {pretests.length} (<code>Pre.elm</code>, all regions public; <code>Hidden.elm</code> stays out).
      </p>
    </div>
    <div class="grid gap-8 lg:grid-cols-2">
      {
        scenarios.map((scenario) => (
          <section class="flex min-w-0 flex-col gap-2">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/60">{scenario.title}</h2>
            <div class="rounded-box border border-base-300 bg-base-100 p-4">
              <Demo client:load question={pub} pretests={pretests} scenario={scenario.id} autorun={scenario.autorun} />
            </div>
          </section>
        ))
      }
    </div>
  </main>
</AppLayout>
