---
import PageKicker from "@/components/PageKicker.astro";
import DesignLayout from "@/layouts/DesignLayout.astro";

export const prerender = false;

// Every page under this folder, `index.astro` and `_`-prefixed helpers aside.
const pages = Object.keys(import.meta.glob("./**/*.astro"))
	.filter((path) => path !== "./index.astro")
	.filter((path) => !path.split("/").some((part) => part.startsWith("_")))
	.map((path) => {
		const route = path
			.slice(2)
			.replace(/\.astro$/, "")
			.replace(/\/index$/, "");
		return { route, href: `/design/playground/${route}` };
	})
	.sort((a, b) => a.route.localeCompare(b.route));
---

<DesignLayout title="Playground" active="playground">
  <div class="mb-8 max-w-2xl">
    <PageKicker text="Scratchpad" />
    <h1 class="text-3xl font-bold">Playground</h1>
    <p class="mt-3 text-base-content/70">
      Temporary pages for prototypes and design work in progress, built with the app's own layouts and components.
      One subfolder per piece of work. A release refuses to ship while anything but this index lives here.
    </p>
  </div>

  {
    pages.length === 0 ? (
      <p class="text-sm text-base-content/60">Nothing in progress.</p>
    ) : (
      <ul class="menu rounded-box border border-base-300 bg-base-100">
        {pages.map((page) => (
          <li>
            <a href={page.href} class="font-mono text-sm">
              {page.route}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</DesignLayout>
