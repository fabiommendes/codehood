---
/**
 * Static mock of the client runner IDE: toolbar, editor, terminal, status row.
 *
 * No runtime behind it. Every visual state is a prop so the playground pages
 * can lay the states side by side.
 */
import { highlight, type Language } from "./_highlight";

export type Mode = "snippet" | "answer" | "review";
export type RunState =
	| "idle"
	| "downloading"
	| "running"
	| "waiting-input"
	| "done"
	| "error"
	| "stopped"
	| "truncated"
	| "download-failed"
	| "disabled"
	| "unsupported"
	| "unconfigured";

import type { TerminalLine } from "./_samples";

interface Props {
	mode: Mode;
	language: Language;
	code: string;
	/// File name shown in the toolbar; defaults to `main.<ext>`.
	filename?: string;
	state?: RunState;
	/// Lines already written to the terminal. Hidden when empty and idle.
	terminal?: TerminalLine[];
	/// Snippet mode: the student clicked "Edit"; the editor is writable.
	editing?: boolean;
	/// Download progress in bytes, for the `downloading` state.
	downloaded?: number;
	total?: number;
	/// Last autosave time (answer mode).
	savedAt?: string;
	/// Answer mode: a save is in flight and slow enough to show.
	saving?: boolean;
	/// Narrow screens: a one-line input field pinned under the terminal, so
	/// typing does not depend on a cursor inside xterm under the keyboard.
	inputBar?: boolean;
	/// Answer mode: the server has not confirmed any save since this time.
	unsyncedSince?: string;
	/// Answer mode: a local draft and the server's answer disagree.
	conflict?: { localAt: string; serverAt: string; serverCode: string };
	/// Review mode: which submission is open and how many there are.
	submission?: { index: number; total: number; student: string };
	/// Density: shorter editor and collapsed terminal until a run happens.
	compact?: boolean;
	/// Review mode: the teacher edited an in-memory copy of the submission.
	modified?: boolean;
	/// When the last run ended and how, for the status row.
	lastRun?: string;
	class?: string;
}

const EXT: Record<Language, string> = {
	python: "py",
	prolog: "pl",
	javascript: "js",
	typescript: "ts",
	lua: "lua",
};
const LABEL: Record<Language, string> = {
	python: "Python",
	prolog: "Prolog",
	javascript: "JavaScript",
	typescript: "TypeScript",
	lua: "Lua",
};

const {
	mode,
	language,
	code,
	filename = `main.${EXT[language]}`,
	state = "idle",
	terminal = [],
	editing = false,
	downloaded = 0,
	total = 0,
	savedAt,
	saving = false,
	inputBar = false,
	unsyncedSince,
	conflict,
	submission,
	compact = false,
	modified = false,
	lastRun,
	class: className,
} = Astro.props;

const lines = highlight(code, language);
const readonly =
	(mode === "review" && !modified) || (mode === "snippet" && !editing);
const busy = state === "running" || state === "waiting-input";
/// States where running is impossible rather than merely paused.
const blocked =
	state === "disabled" || state === "unsupported" || state === "unconfigured";
const canRun = !busy && state !== "downloading" && !blocked && !conflict;
const showTerminal =
	!blocked &&
	(terminal.length > 0 || busy || state === "download-failed" || !compact);
const mb = (bytes: number) => `${(bytes / 1_000_000).toFixed(1)} MB`;
const percent = total ? Math.round((downloaded / total) * 100) : 0;
const id = `ide-${crypto.randomUUID().slice(0, 8)}`;

const BLOCKED_MESSAGE: Partial<Record<RunState, string>> = {
	disabled:
		"The professor disabled code execution in this exam. You can still write and submit your answer.",
	unsupported:
		"This browser cannot run code here (no Worker or WebAssembly support). Use a recent Firefox, Chrome or Safari; your answer still saves.",
	unconfigured:
		"Code execution is not set up on this server. Ask the administrator; your answer still saves.",
};

// Fixed colours from the dark palette: the terminal header is dark in every
// theme, so semantic colours tuned for the light theme do not read on it.
const DARK = {
	success: "text-[#89d185]",
	warning: "text-[#e5c07b]",
	error: "text-[#f48771]",
	muted: "text-[#858585]",
	text: "text-[#d4d4d4]",
};
const terminalStatus: Partial<
	Record<RunState, { text: string; tone: string }>
> = {
	running: { text: "Running", tone: DARK.success },
	"waiting-input": { text: "Waiting for input", tone: DARK.warning },
	done: { text: "Exited with code 0", tone: DARK.muted },
	error: { text: "Exited with code 1", tone: DARK.error },
	stopped: { text: "Stopped by you", tone: DARK.muted },
	truncated: { text: "Stopped: output limit", tone: DARK.warning },
};
const status = terminalStatus[state];

const lineTone: Record<TerminalLine["kind"], string> = {
	out: "text-[#d4d4d4]",
	err: "text-[#f48771]",
	in: "text-[#d4d4d4] bg-white/5",
	sys: "text-[#858585] italic",
	warn: "text-[#e5c07b]",
};
const escapeHtml = (text: string) =>
	text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
// Built as a string: whitespace inside `<pre>` is content, so the template's
// own indentation must not leak into it.
// URLs in the output become links that open in a new tab after a confirm
// dialog, never with access to this window (`noopener`).
const LINK_ATTRS =
	'class="underline decoration-dotted underline-offset-2" href="#" target="_blank" rel="noopener noreferrer" title="Opens in a new tab after you confirm"';
const linkify = (html: string) =>
	html.replace(/https?:\/\/[^\s<]+/g, (url) => `<a ${LINK_ATTRS}>${url}</a>`);
const terminalHtml = terminal
	.map(
		(line) =>
			`<span class="${lineTone[line.kind]}">${linkify(escapeHtml(line.text))}</span>`,
	)
	.join("\n");
const CURSOR =
	'<span class="inline-block h-4 w-2 translate-y-0.5 animate-pulse bg-[#d4d4d4] align-text-bottom"></span>';
const EMPTY =
	'<span class="text-[#858585] italic">Run to see the output here.</span>';
const terminalBody =
	terminalHtml +
	(state === "waiting-input" ? CURSOR : "") +
	(terminal.length === 0 && state === "idle" ? EMPTY : "");
---

<div class:list={["overflow-hidden rounded-box border border-base-300 bg-base-100", className]}>
  {/* Review mode: which submission, and the teacher's way to the next one. */}
  {
    mode === "review" && submission && (
      <div class="flex flex-wrap items-center gap-3 border-b border-base-300 bg-base-200/50 px-3 py-2 text-sm">
        <div class="join">
          <a href="#" class="btn btn-sm btn-ghost join-item" aria-label="Previous submission">‹</a>
          <span class="join-item flex items-center border border-base-300 bg-base-100 px-3 tabular-nums">
            {submission.index} of {submission.total}
          </span>
          <a href="#" class="btn btn-sm btn-ghost join-item" aria-label="Next submission">›</a>
        </div>
        <span class="font-semibold">{submission.student}</span>
        <span class="ml-auto text-xs text-muted">Fresh sandbox per submission. Runs never touch the grade.</span>
      </div>
    )
  }

  {/* Toolbar: file, language, actions. */}
  <div class="flex flex-wrap items-center gap-2 border-b border-base-300 bg-base-200/50 px-3 py-1.5">
    <span class="font-mono text-xs">{filename}</span>
    <span class="badge badge-ghost badge-xs">{LABEL[language]}</span>
    {readonly && mode === "snippet" && <span class="badge badge-ghost badge-xs">read-only</span>}
    {mode === "review" && modified && <span class="badge badge-warning badge-soft badge-xs">modified</span>}
    {
      mode === "snippet" && !editing && (
        <span class="text-xs text-muted hidden sm:inline">Edit to try changes; the note keeps the original.</span>
      )
    }
    {
      mode === "review" && modified && (
        <span class="text-xs text-muted hidden sm:inline">A copy in memory; the submission is unchanged.</span>
      )
    }
    {
      language === "prolog" && !blocked && (
        <span class="text-xs text-muted">Run restarts Prolog: consults the file, opens the toplevel.</span>
      )
    }
    <div class="ml-auto flex items-center gap-1.5">
      {
        mode === "review" && modified && (
          <button type="button" class="btn btn-sm btn-ghost">
            Back to submission
          </button>
        )
      }
      {
        mode === "snippet" && !editing && (
          <button type="button" class="btn btn-sm btn-ghost">
            Edit
          </button>
        )
      }
      {
        mode === "snippet" && editing && (
          <button type="button" class="btn btn-sm btn-ghost">
            Reset
          </button>
        )
      }
      {
        mode === "answer" && (
          <button type="button" class="btn btn-sm btn-ghost" title="Back to the starter code">
            Reset
          </button>
        )
      }
      {
        busy || state === "downloading" ? (
          <button type="button" class="btn btn-sm btn-soft btn-error">
            {state === "downloading" ? (
              <span class="loading loading-spinner loading-xs" />
            ) : (
              <span class="inline-block size-2.5 bg-current" aria-hidden="true" />
            )}
            {state === "downloading" ? "Cancel" : "Stop"}
          </button>
        ) : (
          <button
            type="button"
            class="btn btn-sm btn-soft btn-success"
            disabled={!canRun}
            title={blocked ? "Code execution is unavailable" : conflict ? "Pick a version first" : undefined}
          >
            <svg viewBox="0 0 16 16" class="size-3 fill-current" aria-hidden="true">
              <path d="M4 2.5v11l9-5.5z" />
            </svg>
            {mode === "review" ? "Run submission" : "Run"}
          </button>
        )
      }
    </div>
  </div>

  {
    state === "downloading" && (
      <div class="flex items-center gap-3 border-b border-base-300 bg-base-200/30 px-3 py-2 text-xs">
        <span class="shrink-0">Downloading the {LABEL[language]} runtime</span>
        <progress class="progress progress-primary h-1.5 flex-1" value={downloaded} max={total} />
        <span class="shrink-0 tabular-nums text-muted">
          {mb(downloaded)} of {mb(total)} · {percent}%
        </span>
      </div>
    )
  }

  {
    blocked && (
      <p role="status" class="flex items-center gap-2 border-b border-base-300 bg-base-200/30 px-3 py-2 text-xs text-base-content/70">
        <svg viewBox="0 0 16 16" class="size-3.5 shrink-0 fill-current" aria-hidden="true">
          <path d="M5 7V5a3 3 0 0 1 6 0v2h1v7H4V7zm1.5 0h3V5a1.5 1.5 0 0 0-3 0z" />
        </svg>
        {BLOCKED_MESSAGE[state]}
      </p>
    )
  }

  {
    conflict && (
      <div class="border-b border-warning/40 bg-warning/10 p-3 text-sm">
        <p class="font-semibold">Two versions of this answer</p>
        <p class="mt-0.5 text-xs text-base-content/70">
          This browser kept a draft the server never received. Pick the one to continue from; the other is discarded.
        </p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="rounded-box border border-base-300 bg-base-100">
            <div class="flex items-center justify-between px-3 py-1.5 text-xs">
              <span class="font-semibold">This browser</span>
              <span class="text-muted">edited {conflict.localAt}</span>
            </div>
            <pre class="max-h-28 overflow-hidden bg-base-200 px-3 py-2 font-mono text-xs leading-5">{code.trim()}</pre>
            <div class="p-2">
              <button type="button" class="btn btn-sm btn-block">Keep this browser's draft</button>
            </div>
          </div>
          <div class="rounded-box border border-base-300 bg-base-100">
            <div class="flex items-center justify-between px-3 py-1.5 text-xs">
              <span class="font-semibold">Server</span>
              <span class="text-muted">saved {conflict.serverAt}</span>
            </div>
            <pre class="max-h-28 overflow-hidden bg-base-200 px-3 py-2 font-mono text-xs leading-5">{conflict.serverCode.trim()}</pre>
            <div class="p-2">
              <button type="button" class="btn btn-sm btn-block">Use the server's version</button>
            </div>
          </div>
        </div>
      </div>
    )
  }

  {/* Editor (CodeMirror 6, VS Code Dark+ theme in the real thing). */}
  {
    !conflict && (
      <div
        id={`${id}-editor`}
        aria-label={`${filename}, ${LABEL[language]} code${readonly ? ", read-only" : ""}`}
        class:list={[
          "relative overflow-auto bg-[#1e1e1e] font-mono text-[13px] leading-5 text-[#d4d4d4]",
          compact ? "max-h-56" : "max-h-96",
          readonly && "select-text",
        ]}
      >
        {/* Long lines scroll sideways; the fade on the right says so. */}
        <div aria-hidden="true" class="pointer-events-none sticky top-0 right-0 z-10 float-right h-0 w-0">
          <div class="h-screen w-6 -translate-x-6 bg-linear-to-l from-[#1e1e1e] to-transparent" />
        </div>
        <table class="w-full border-separate border-spacing-0">
          <tbody>
            {lines.map((line, index) => (
              <tr class:list={[!readonly && index === lines.length - 1 && "bg-white/4"]}>
                <td class="w-10 select-none pr-3 pl-2 text-right align-top text-[#858585] tabular-nums">
                  {index + 1}
                </td>
                <td class="whitespace-pre pr-3 align-top">
                  <span set:html={line} />
                  {!readonly && index === lines.length - 1 && (
                    <span class="inline-block h-4 w-px translate-y-0.5 animate-pulse bg-[#aeafad] align-text-bottom" />
                  )}
                </td>
              </tr>
            ))}
            <tr>
              <td class="h-3" colspan="2" />
            </tr>
          </tbody>
        </table>
      </div>
    )
  }

  {/* Terminal (xterm.js in the real thing). */}
  {
    showTerminal && (
      <div
        id={`${id}-terminal`}
        aria-label="Program output"
        class="border-t border-[#3c3c3c] bg-[#181818] font-mono text-[13px] leading-5"
      >
        {
          <div class="flex items-center gap-2 bg-[#252526] px-3 py-1 text-[11px] uppercase tracking-wide text-[#a0a0a0]">
            <span>Terminal</span>
            {mode === "review" && modified && terminal.length > 0 && (
              <span class:list={["normal-case tracking-normal", DARK.warning]}>output of the modified copy</span>
            )}
            <span role="status" aria-live="polite" class="ml-auto flex items-center gap-1.5 normal-case tracking-normal">
              {status && (
                <span class:list={["flex items-center gap-1.5", status.tone]}>
                  {busy && <span class="loading loading-spinner loading-xs" />}
                  {status.text}
                </span>
              )}
              {state === "done" && lastRun && <span class={DARK.muted}>· {lastRun}</span>}
            </span>
          </div>
        }
        {state === "download-failed" ? (
          <div class="p-3">
            <div role="alert" class="flex flex-wrap items-center gap-3 rounded-box border border-[#f48771]/40 bg-[#f48771]/10 px-3 py-2 text-sm text-[#f48771]">
              <span class="flex-1">Could not download the {LABEL[language]} runtime. Check your connection and try again.</span>
              <button type="button" class="btn btn-sm btn-outline border-[#d4d4d4]/60 text-[#d4d4d4]">
                Try again
              </button>
            </div>
          </div>
        ) : (
          <pre class:list={["overflow-auto px-3 py-2", compact ? "max-h-40" : "min-h-24 max-h-64"]} set:html={terminalBody} />
        )}
        {inputBar && state === "waiting-input" && (
          <form class="sticky bottom-0 flex gap-2 border-t border-[#3c3c3c] bg-[#252526] p-2">
            <input
              class="input input-sm flex-1 border-[#3c3c3c] bg-[#1e1e1e] font-mono text-[#d4d4d4]"
              aria-label="Program input"
              placeholder="Type a line and send it"
              autocomplete="off"
            />
            <button type="button" class="btn btn-sm btn-outline border-[#d4d4d4]/60 text-[#d4d4d4]">
              Send
            </button>
          </form>
        )}
      </div>
    )
  }

  {/* Status row: save state, sync warnings. */}
  {
    mode === "answer" && (savedAt || saving || unsyncedSince) && (
      <div role="status" aria-live="polite" class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-base-300 bg-base-200/50 px-3 py-1.5 text-xs">
        {lastRun && state !== "done" && <span class="text-muted">Last run {lastRun}</span>}
        {saving && <span class="ml-auto text-muted">Saving…</span>}
        {savedAt && !saving && !unsyncedSince && <span class="ml-auto text-muted">Saved at {savedAt}</span>}
        {unsyncedSince && (
          <span class="ml-auto flex items-center gap-1.5 text-warning">
            <span class="status status-warning status-xs" />
            Server has not received your changes since {unsyncedSince}. Draft kept in this browser.
          </span>
        )}
      </div>
    )
  }
</div>
