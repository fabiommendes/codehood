---
import ExamQuestion from "./_ExamQuestion.astro";
import Ide from "./_Ide.astro";
import Page from "./_Page.astro";
import {
	JS_SUM,
	LUA_FACT,
	PROLOG_FAMILY,
	PY_BUG,
	PY_FIB,
	TERM_ERROR,
	TERM_FIB,
} from "./_samples";

export const prerender = false;

const nav = [
	{ n: 1, answered: true },
	{ n: 2, answered: true },
	{ n: 3, answered: true, current: true },
	{ n: 4, answered: false },
	{ n: 5, answered: false },
	{ n: 6, answered: false },
];
---

<Page
  title="Exam density"
  lead="A six-question exam where five answers are code. Editors are compact (max 14 lines before scrolling) and the terminal only opens after the first run, so the page scrolls like a normal exam."
>
  {/* Two rows on phones (timer and Submit, then the question links), one row from `sm` up. */}
  <div class="sticky top-16 z-20 -mx-4 mt-8 border-b border-base-300 bg-base-100 px-4 py-2 sm:py-3">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="font-mono text-sm tabular-nums">47:12</span>
      <span class="text-sm text-muted">3 of 6 answered</span>
      <span class="badge badge-soft badge-success badge-sm">Code runs on</span>
      <nav class="order-last flex w-full gap-1.5 sm:order-none sm:ml-auto sm:w-auto">
        {
          nav.map((q) => (
            <a
              href={`#question-${q.n}`}
              class:list={[
                "btn btn-sm font-mono btn-outline h-9 flex-1 sm:h-11 sm:w-12 sm:flex-none",
                q.answered ? "border-base-content/70" : "border-base-content/15 text-base-content/50",
                q.current && "outline-2 outline-offset-2 outline-primary",
              ]}
            >
              {q.n}
            </a>
          ))
        }
      </nav>
      <button type="button" class="btn btn-primary btn-sm ml-auto h-9 shrink-0 sm:ml-0 sm:h-11">Submit</button>
    </div>
  </div>

  <div class="mt-8 space-y-10">
    <ExamQuestion number={1} title="Fibonacci" points="1.5">
      <p class="text-sm">Print the first ten Fibonacci numbers, one per line with their index.</p>
      <Ide mode="answer" language="python" code={PY_FIB} compact state="done" terminal={TERM_FIB} lastRun="0.2 s" savedAt="14:12" />
    </ExamQuestion>

    <ExamQuestion number={2} title="Sum of a list" points="1.0">
      <p class="text-sm">Write <code class="font-mono">sum(list)</code> without using <code class="font-mono">reduce</code>.</p>
      <Ide mode="answer" language="javascript" code={JS_SUM} compact savedAt="14:15" />
    </ExamQuestion>

    <ExamQuestion number={3} title="Mean" points="1.5">
      <p class="text-sm">Compute the mean of a list. Decide what to do with an empty list and document it.</p>
      <Ide mode="answer" language="python" code={PY_BUG} compact state="error" terminal={TERM_ERROR} lastRun="14:31" saving />
    </ExamQuestion>

    <ExamQuestion number={4} title="Which statement is true?" points="1.0" saved="saved">
      <p class="text-sm">About Python's <code class="font-mono">input()</code>:</p>
      <div class="mt-2 flex flex-col gap-2 text-sm">
        <label class="flex items-center gap-2"><input type="radio" name="q4" class="radio radio-sm" /> It returns an int when the user types digits.</label>
        <label class="flex items-center gap-2"><input type="radio" name="q4" class="radio radio-sm" /> It always returns a string.</label>
        <label class="flex items-center gap-2"><input type="radio" name="q4" class="radio radio-sm" /> It raises on empty input.</label>
      </div>
    </ExamQuestion>

    <ExamQuestion number={5} title="Family tree" points="3.0">
      <p class="text-sm">Define <code class="font-mono">grandparent/2</code> and <code class="font-mono">sibling/2</code>.</p>
      <Ide mode="answer" language="prolog" code={PROLOG_FAMILY} compact />
    </ExamQuestion>

    <ExamQuestion number={6} title="Factorial" points="2.0">
      <p class="text-sm">Recursive factorial in Lua. Then rewrite it with a loop in the same file.</p>
      <Ide mode="answer" language="lua" code={LUA_FACT} compact />
    </ExamQuestion>
  </div>

  <section class="mt-14 rounded-box border border-base-300 bg-base-200/30 p-4 text-sm">
    <p class="font-semibold">Notes on density</p>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      <li>Unrun editors (2, 5, 6) have no terminal: a code question costs about the height of a textarea with the same lines.</li>
      <li>After a run the terminal opens below, capped at 10 lines in compact mode; the full box never exceeds the viewport.</li>
      <li>Downloads are per page, so question 1's first run pays for the others in the same language.</li>
      <li>The sticky bar shows whether code runs are on for this exam, next to the timer.</li>
      <li>Code questions carry their own save state in the IDE's status row; the folder tab shows it only for other question types.</li>
      <li>Long lines scroll sideways inside the editor; the fade on its right edge marks that.</li>
    </ul>
  </section>
</Page>
