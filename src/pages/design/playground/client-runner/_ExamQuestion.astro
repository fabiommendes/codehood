---
/// The exam attempt question frame (number column, folder tab, card), as in `ExamAttempt.tsx`.
interface Props {
	number: number;
	title: string;
	points: string;
	saved?: "saved" | "saving" | "failed" | "none";
}

const { number, title, points, saved = "none" } = Astro.props;
const FOLDER =
	"absolute inset-y-0 -z-10 bg-linear-to-b from-base-300 to-[color-mix(in_oklab,var(--color-base-300)_75%,var(--color-base-200))] shadow-[inset_0_1px_0_color-mix(in_oklab,var(--color-base-100)_70%,transparent)]";
---

<section id={`question-${number}`} class="grid gap-x-4 sm:grid-cols-[4.5rem_1fr] scroll-mt-48">
  <div class="hidden sm:block">
    <div class="sticky top-36">
      <p class="font-display text-4xl font-bold text-base-content/30 tabular-nums">{number}</p>
      <p class="mt-2 text-xs text-muted">Points</p>
      <p class="text-sm font-semibold tabular-nums">{points}</p>
    </div>
  </div>
  <header class="relative z-10 inline-flex min-w-1/3 max-w-[calc(100%-1.5rem)] items-baseline gap-3 justify-self-start sm:col-start-2 py-2 pr-6 pl-6">
    <span aria-hidden="true" class:list={[FOLDER, "left-0 right-2 rounded-tl-[18px_8px]"]}></span>
    <span aria-hidden="true" class:list={[FOLDER, "-right-3 w-9 origin-bottom skew-x-[18deg] rounded-tr-xl"]}></span>
    <span class="font-display text-xl font-bold sm:hidden">{number}</span>
    <h3 class="min-w-0 truncate font-display text-base font-semibold">{title}</h3>
    <span class="whitespace-nowrap text-xs tabular-nums sm:hidden">{points} pts</span>
    {saved === "saved" && <span class="text-xs text-muted">Saved</span>}
    {saved === "saving" && <span class="text-xs text-muted">Saving…</span>}
    {saved === "failed" && <span class="text-xs text-error">Not saved</span>}
  </header>
  <div class="card card-border min-w-0 overflow-hidden rounded-tl-none! bg-base-200/25 shadow-sm sm:col-start-2">
    <div class="card-body">
      <slot />
    </div>
  </div>
</section>
