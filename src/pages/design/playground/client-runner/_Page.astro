---
/// App shell plus the header and the links between the client runner pages.
import AppLayout from "@/layouts/AppLayout.astro";

interface Props {
	title: string;
	lead: string;
	wide?: boolean;
}

const { title, lead, wide = false } = Astro.props;
const pages = [
	{ href: "/design/playground/client-runner", label: "Overview" },
	{ href: "/design/playground/client-runner/modes", label: "Modes" },
	{ href: "/design/playground/client-runner/states", label: "States" },
	{ href: "/design/playground/client-runner/exam", label: "Exam density" },
	{ href: "/design/playground/client-runner/mobile", label: "Mobile" },
];
const current = Astro.url.pathname.replace(/\/$/, "");
---

<AppLayout title={title}>
  <main class:list={["mx-auto px-4 py-10", wide ? "max-w-5xl" : "max-w-4xl"]}>
    <nav class="mb-6 flex flex-wrap items-center gap-1 text-sm">
      <a href="/design/playground" class="link link-hover text-muted">Playground</a>
      <span class="text-muted">/</span>
      {
        pages.map((page) => (
          <a href={page.href} class:list={["btn btn-xs", current === page.href ? "btn-neutral" : "btn-ghost"]}>
            {page.label}
          </a>
        ))
      }
    </nav>
    <h1 class="text-3xl font-bold">{title}</h1>
    <p class="mt-2 max-w-2xl text-base-content/70">{lead}</p>
    <slot />
  </main>
</AppLayout>
