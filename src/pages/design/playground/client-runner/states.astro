---
import Ide from "./_Ide.astro";
import Page from "./_Page.astro";
import {
	PY_AREA,
	PY_AREA_SERVER,
	PY_BUG,
	PY_FIB,
	PY_LOOP,
	TERM_ERROR,
	TERM_FIB,
	TERM_INPUT,
	TERM_LINK,
	TERM_STOPPED,
	TERM_TRUNCATED,
} from "./_samples";

export const prerender = false;

const states = [
	{
		title: "First run: downloading the runtime",
		note: "Run becomes Cancel and the progress strip sits between toolbar and editor. The editor stays usable. The download is shared by every editor on the page.",
		props: {
			state: "downloading",
			downloaded: 12_400_000,
			total: 31_000_000,
			savedAt: "14:30",
		},
		code: PY_FIB,
	},
	{
		title: "Running, with Stop",
		note: "Stop takes Run's slot and colour. The terminal header shows the live state; output streams below.",
		props: { state: "running", terminal: TERM_FIB, savedAt: "14:30" },
		code: PY_FIB,
	},
	{
		title: "Waiting for input()",
		note: "The terminal gets a cursor and the header says so. The student types directly in the terminal.",
		props: { state: "waiting-input", terminal: TERM_INPUT, savedAt: "14:31" },
		code: PY_AREA,
	},
	{
		title: "Stopped by the student",
		note: "After Stop: the Worker is gone, the output stays, the header says who ended it. Run is back.",
		props: {
			state: "stopped",
			terminal: TERM_STOPPED,
			savedAt: "14:33",
			lastRun: "14:33",
		},
		code: PY_LOOP,
	},
	{
		title: "Finished, with a link in the output",
		note: "URLs become links. They open in a new tab, with noopener, after a confirm dialog (student code wrote that URL).",
		props: {
			state: "done",
			terminal: TERM_LINK,
			savedAt: "14:31",
			lastRun: "0.3 s",
		},
		code: PY_AREA,
	},
	{
		title: "Runtime error",
		note: "Traceback in the terminal's error colour; exit code in the header. Nothing else changes: the editor keeps the code.",
		props: {
			state: "error",
			terminal: TERM_ERROR,
			savedAt: "14:31",
			lastRun: "14:31",
		},
		code: PY_BUG,
	},
	{
		title: "Download failed",
		note: "The alert replaces the terminal, with Try again right there. Run stays enabled too; both retry.",
		props: { state: "download-failed", savedAt: "14:30" },
		code: PY_FIB,
	},
	{
		title: "Output truncated by the limit",
		note: "The last line explains why the program stopped. Same place the student is already looking.",
		props: {
			state: "truncated",
			terminal: TERM_TRUNCATED,
			savedAt: "14:33",
			lastRun: "14:33",
		},
		code: PY_LOOP,
	},
	{
		title: "Execution disabled by the professor",
		note: "Run is disabled with the reason in a strip under the toolbar. No terminal: there is nothing to show. The editor still works as an answer field.",
		props: { state: "disabled", savedAt: "14:30" },
		code: PY_AREA,
	},
	{
		title: "Browser not supported",
		note: "No Worker or WebAssembly (old browsers, some locked-down ones). Same strip as the disabled state; the answer field keeps working.",
		props: { state: "unsupported", savedAt: "14:30" },
		code: PY_AREA,
	},
	{
		title: "Execution not set up on this server",
		note: "No RUNNER_ORIGIN configured. Same strip; the message points at the administrator, not the student.",
		props: { state: "unconfigured", savedAt: "14:30" },
		code: PY_AREA,
	},
	{
		title: "Saving…",
		note: "A slow save shows here, in the status row, instead of the exam header: one indicator per code question.",
		props: { state: "idle", saving: true },
		code: PY_AREA,
	},
	{
		title: "Saved at HH:MM",
		note: "Status row, right side, muted. Mirrors the per-question Saved label of the exam header; this one carries the time because code answers change often.",
		props: { state: "idle", savedAt: "14:32" },
		code: PY_AREA,
	},
	{
		title: "Server not receiving the autosave",
		note: "Same row, warning colour, with what the student should know: the draft is in this browser. Does not block Run or editing.",
		props: { state: "idle", unsyncedSince: "14:20" },
		code: PY_AREA,
	},
] as const;
---

<Page
  title="States"
  lead="Every state of the answer-mode IDE, one per box. The exam frame is left out so the component is easier to compare."
>
  <div class="mt-8 space-y-10">
    {
      states.map((entry) => (
        <section>
          <h2 class="text-lg font-semibold">{entry.title}</h2>
          <p class="mb-3 mt-1 text-sm text-muted">{entry.note}</p>
          <Ide mode="answer" language="python" code={entry.code} {...entry.props} />
        </section>
      ))
    }

    <section>
      <h2 class="text-lg font-semibold">Draft conflict: local draft and server disagree</h2>
      <p class="mb-3 mt-1 text-sm text-muted">
        Happens when the page reloads after a stretch without sync. The two versions take the editor's place until the
        student picks one; the toolbar and terminal stay, so it reads as "the same box, paused". Run is disabled until
        then.
      </p>
      <Ide
        mode="answer"
        language="python"
        code={PY_AREA}
        state="idle"
        conflict={{ localAt: "14:32", serverAt: "14:20", serverCode: PY_AREA_SERVER }}
      />
    </section>
  </div>
</Page>
