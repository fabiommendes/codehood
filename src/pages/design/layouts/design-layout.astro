---
import Link from "@/components/Link.astro";
import DesignLayout from "@/layouts/DesignLayout.astro";
import { urls } from "@/urls";

export const prerender = false;
---

<DesignLayout title="DesignLayout demo" active="overview">
  <Link href={urls.design.layouts.index()} class="btn btn-sm btn-ghost fixed bottom-4 right-4 shadow">← Layouts</Link>
  <h1 class="text-3xl font-bold">The showcase's own shell</h1>
  <p class="mt-3 max-w-2xl text-base-content/70">
    This page renders <code class="font-mono">&lt;DesignLayout&gt;</code>: the navbar and the tab strip
    above are it. Every page under <code class="font-mono">/design</code>, including this one, uses it.
  </p>
</DesignLayout>
