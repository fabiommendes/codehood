---
import Link from "@/components/Link.astro";
import CenteredLayout from "@/layouts/CenteredLayout.astro";
import { urls } from "@/urls";

export const prerender = false;
---

<CenteredLayout title="Example">
  <Link href={urls.design.layouts.index()} class="btn btn-sm btn-ghost fixed bottom-4 right-4 shadow">← Layouts</Link>
  <p class="text-sm text-base-content/70">
    This card is <code class="font-mono">&lt;CenteredLayout&gt;</code>: a logo, a heading, and a slot for
    whatever single-purpose content goes in the middle. Login and invite-acceptance both use this shell.
  </p>
</CenteredLayout>
