---
import PageKicker from "@/components/PageKicker.astro";
import DesignLayout from "@/layouts/DesignLayout.astro";

export const prerender = false;

const sections = [
	{
		href: "/design/brand",
		title: "Brand",
		description:
			"The logo in both themes, its flanks, small sizes and the ipê calendar.",
	},
	{
		href: "/design/motifs",
		title: "Motifs",
		description: "Athos Bulcão tiles, course tiles, icons and illustrations.",
	},
	{
		href: "/design/themes",
		title: "Themes",
		description:
			"The light and dark themes side by side, rendering the same screens.",
	},
	{
		href: "/design/typography",
		title: "Typography",
		description:
			"Fraunces, Atkinson Hyperlegible and JetBrains Mono: roles, heading scale, body copy, code.",
	},
	{
		href: "/design/colors",
		title: "Colors",
		description:
			"Cerrado (light) and Forest (dark) tokens side by side, with content colors and contrast notes.",
	},
	{
		href: "/design/layouts",
		title: "Layouts",
		description:
			"The page shells the app is built from: Layout, AppLayout, CenteredLayout, DesignLayout.",
	},
	{
		href: "/design/elements",
		title: "Elements",
		description:
			"Buttons, badges, alerts and cards in both themes, and the loud and quiet screen rule.",
	},
	{
		href: "/design/questions",
		title: "Questions",
		description:
			"MultipleChoiceView in answer, readonly, and review mode, driven by real Question objects.",
	},
	{
		href: "/design/forms",
		title: "Forms",
		description:
			"Inputs, selects, textareas, checkboxes, radios and validation states.",
	},
];
---

<DesignLayout title="Overview" active="overview">
  <div class="mb-10 max-w-2xl">
    <PageKicker text="Reference" />
    <h1 class="text-3xl font-bold">Codehood design system</h1>
    <p class="mt-3 text-base-content/70">
      A living reference for the tokens and reusable pieces the app is built from, kept in step with{" "}
      <code class="font-mono text-sm">docs/ui/identity.md</code>. Every color, font, and component shown here is
      the real thing: the same themes and components used across the app, not a separate mockup.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="card card-border bg-base-100 transition-colors hover:border-primary"
        >
          <div class="card-body">
            <h2 class="card-title">{section.title}</h2>
            <p class="text-sm text-base-content/70">{section.description}</p>
          </div>
        </a>
      ))
    }
  </div>
</DesignLayout>
