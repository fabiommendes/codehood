---
// Astro renders this automatically for unhandled SSR errors and passes the error
// as a prop — see https://docs.astro.build/en/basics/astro-pages/#custom-500-error-page.
// It's also just a normal route, reachable directly at /500 for previewing.
import { m } from "@/i18n";
import ErrorLayout from "@/layouts/ErrorLayout.astro";

const error = Astro.props.error as Error | undefined;
---

<ErrorLayout code="500" title={m.nav_500_title()} scene="crash">
  {m.nav_500_text()}
  <div slot="actions" class="flex flex-col items-center gap-4">
    <div class="flex flex-wrap items-center justify-center gap-3">
      <button type="button" class="btn btn-primary rounded-full" onclick="location.reload()">
        {m.nav_try_again()}
      </button>
      <a href="/courses" class="btn btn-ghost">{m.nav_back_to_my_courses()}</a>
    </div>
    {
      import.meta.env.DEV && error && (
        <details class="mt-2 w-full max-w-lg text-left">
          <summary class="cursor-pointer text-sm text-base-content/60">{m.nav_error_details_dev()}</summary>
          <pre class="mt-2 overflow-x-auto rounded-box bg-neutral p-4 font-mono text-xs text-neutral-content">{error.stack ?? error.message}</pre>
        </details>
      )
    }
  </div>
</ErrorLayout>
