---
export const prerender = false;

import { actions } from "astro:actions";
import AdminHeader from "@/components/AdminHeader.astro";
import DisciplinesTable, {
	type DisciplineRow,
} from "@/components/admin/DisciplinesTable";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import { disciplineCreate, disciplineEdit } from "@/core/schemas";
import { db } from "@/db";
import { errorMessage } from "@/forms/field-errors";
import { actionForm, submittedValues } from "@/forms/form-state";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";

// adminMiddleware (src/middleware/admin.ts) already redirects anonymous/
// non-admin visitors before this runs; the check below is here only so
// TypeScript narrows `Astro.locals.user` for the calls that need an `Actor`.
if (!Astro.locals.actor) return Astro.redirect("/login");
const actor = Astro.locals.actor;

const createResult = Astro.getActionResult(actions.admin.createDiscipline);
const updateResult = Astro.getActionResult(actions.admin.updateDiscipline);
const deleteResult = Astro.getActionResult(actions.admin.deleteDiscipline);

const createForm = await actionForm(
	Astro,
	actions.admin.createDiscipline,
	disciplineCreate,
	{ id: "create-discipline" },
);

const editForm = await actionForm(
	Astro,
	actions.admin.updateDiscipline,
	disciplineEdit,
	{ id: "edit-discipline" },
);
const failedSlug = updateResult?.error
	? (await submittedValues(Astro.request)).slug
	: undefined;

const disciplines = await db.discipline.findMany({});
const courses = await db.course.findMany({}, { actor });
const courseCounts = new Map<string, number>();
for (const course of courses) {
	courseCounts.set(
		course.discipline.slug,
		(courseCounts.get(course.discipline.slug) ?? 0) + 1,
	);
}

const disciplineRows: DisciplineRow[] = disciplines.map((discipline) => ({
	slug: discipline.slug,
	name: discipline.name,
	courseCount: courseCounts.get(discipline.slug) ?? 0,
}));
---

<AppLayout title={m.admin_disciplines_page_title()}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <AdminHeader active="disciplines" />

    <p class="max-w-xl text-base-content/60">
      {m.admin_disciplines_intro()}
    </p>

    {
      createResult && !createResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>{m.admin_discipline_created({ slug: createResult.data.slug })}</span>
        </div>
      )
    }

    <div class="card card-border mt-6 bg-base-100">
      <div class="card-body">
        <h2 class="card-title">{m.admin_new_discipline()}</h2>
        <form
          method="POST"
          action={actions.admin.createDiscipline}
          class="mt-2 flex flex-wrap items-start gap-4"
        >
          <FormAlert error={createForm.error} class="w-full" />
          <div class="w-64"><Field {...createForm.field("slug")} class="font-mono" /></div>
          <div class="w-64"><Field {...createForm.field("name")} /></div>

          <button
            type="submit"
            class="btn btn-square btn-primary mt-7"
            aria-label={m.admin_new_discipline()}
            title={m.admin_new_discipline()}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>

    {
      updateResult && !updateResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>{m.admin_discipline_updated()}</span>
        </div>
      )
    }
    <FormAlert error={deleteResult?.error && errorMessage(deleteResult.error)} class="mt-6" />
    {
      deleteResult && !deleteResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>{m.admin_discipline_deleted()}</span>
        </div>
      )
    }

    <DisciplinesTable
      disciplines={disciplineRows}
      editForm={editForm}
      failedSlug={failedSlug}
    />
  </main>
</AppLayout>
