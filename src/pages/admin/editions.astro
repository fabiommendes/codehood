---
export const prerender = false;

import { actions } from "astro:actions";
import AdminTabs from "@/components/AdminTabs.astro";
import EditionsTable, {
  type EditionRow,
} from "@/components/admin/EditionsTable";
import PageKicker from "@/components/PageKicker.astro";
import { courseService } from "@/db/services/course.service";
import { editionService, isEditionOpen } from "@/db/services/edition.service";
import AppLayout from "@/layouts/AppLayout.astro";

// adminMiddleware (src/middleware/admin.ts) already redirects anonymous/
// non-admin visitors before this runs; the check below is here only so
// TypeScript narrows `Astro.locals.user` for the calls that need an `Actor`.
if (!Astro.locals.actor) return Astro.redirect("/login");
const actor = Astro.locals.actor;

const createResult = Astro.getActionResult(actions.admin.createEdition);
const updateResult = Astro.getActionResult(actions.admin.updateEdition);
const deleteResult = Astro.getActionResult(actions.admin.deleteEdition);

const editions = await editionService.findMany({});
const courses = await courseService.findMany({}, { actor });
const courseCounts = new Map<string, number>();
for (const course of courses) {
  courseCounts.set(
    course.editionSlug,
    (courseCounts.get(course.editionSlug) ?? 0) + 1,
  );
}

const editionRows: EditionRow[] = editions.map((edition) => ({
  slug: edition.slug,
  name: edition.name,
  startAt: edition.startAt,
  endAt: edition.endAt,
  courseCount: courseCounts.get(edition.slug) ?? 0,
  isLive: isEditionOpen(edition),
}));
---

<AppLayout title="Admin · Editions">
  <main class="mx-auto max-w-4xl px-4 py-10">
    <AdminTabs active="editions" />

    <PageKicker text="Admin" />
    <h1 class="text-3xl font-bold">Editions</h1>
    <p class="mt-2 max-w-xl text-base-content/60">
      Terms and their active windows. Instructors can only create courses inside
      a window; admins and the system account can create in any edition.
    </p>

    {
      createResult?.error && (
        <div role="alert" class="alert alert-error mt-6">
          <span>{createResult.error.message}</span>
        </div>
      )
    }
    {
      createResult && !createResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>Edition "{createResult.data.slug}" created.</span>
        </div>
      )
    }

    <div class="card card-border mt-6 bg-base-100">
      <div class="card-body">
        <h2 class="card-title">New edition</h2>
        <form
          method="POST"
          action={actions.admin.createEdition}
          class="mt-2 flex flex-wrap items-end gap-4"
        >
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Slug</legend>
            <input
              type="text"
              name="slug"
              required
              placeholder="2026-2"
              class="input font-mono"
            />
          </fieldset>

          <fieldset class="fieldset">
            <legend class="fieldset-legend">Name</legend>
            <input
              type="text"
              name="name"
              required
              placeholder="Second term"
              class="input"
            />
          </fieldset>

          <fieldset class="fieldset">
            <legend class="fieldset-legend">Starts</legend>
            <input type="date" name="startAt" required class="input" />
          </fieldset>

          <fieldset class="fieldset">
            <legend class="fieldset-legend">Ends</legend>
            <input type="date" name="endAt" required class="input" />
          </fieldset>

          <button
            type="submit"
            class="btn btn-square btn-primary"
            aria-label="New edition"
            title="New edition"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>

    {
      updateResult?.error && (
        <div role="alert" class="alert alert-error mt-6">
          <span>{updateResult.error.message}</span>
        </div>
      )
    }
    {
      updateResult && !updateResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>Edition updated.</span>
        </div>
      )
    }
    {
      deleteResult?.error && (
        <div role="alert" class="alert alert-error mt-6">
          <span>{deleteResult.error.message}</span>
        </div>
      )
    }
    {
      deleteResult && !deleteResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>Edition deleted.</span>
        </div>
      )
    }

    <EditionsTable editions={editionRows} />
  </main>
</AppLayout>
