---
export const prerender = false;

import { actions } from "astro:actions";
import AdminHeader from "@/components/AdminHeader.astro";
import EditionsTable, {
	type EditionRow,
} from "@/components/admin/EditionsTable";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import { editionForm } from "@/core/schemas";
import { db, isEditionOpen } from "@/db";
import { errorMessage } from "@/forms/field-errors";
import { actionForm, submittedValues } from "@/forms/form-state";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";

// adminMiddleware (src/middleware/admin.ts) already redirects anonymous/
// non-admin visitors before this runs; the check below is here only so
// TypeScript narrows `Astro.locals.user` for the calls that need an `Actor`.
if (!Astro.locals.actor) return Astro.redirect("/login");
const actor = Astro.locals.actor;

const createResult = Astro.getActionResult(actions.admin.createEdition);
const updateResult = Astro.getActionResult(actions.admin.updateEdition);
const deleteResult = Astro.getActionResult(actions.admin.deleteEdition);

const createForm = await actionForm(
	Astro,
	actions.admin.createEdition,
	editionForm,
	{ id: "create-edition" },
);
const editForm = await actionForm(
	Astro,
	actions.admin.updateEdition,
	editionForm,
	{ id: "edit-edition" },
);
const failedSlug = updateResult?.error
	? (await submittedValues(Astro.request)).slug
	: undefined;

const editions = await db.edition.findMany({});
const courses = await db.course.findMany({}, { actor });
const courseCounts = new Map<string, number>();
for (const course of courses) {
	courseCounts.set(
		course.edition.slug,
		(courseCounts.get(course.edition.slug) ?? 0) + 1,
	);
}

const editionRows: EditionRow[] = editions.map((edition) => ({
	slug: edition.slug,
	name: edition.name,
	startAt: edition.startAt,
	endAt: edition.endAt,
	courseCount: courseCounts.get(edition.slug) ?? 0,
	isLive: isEditionOpen(edition),
}));
---

<AppLayout title={m.admin_editions_page_title()}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <AdminHeader active="editions" />

    <p class="max-w-xl text-base-content/60">
      {m.admin_editions_intro()}
    </p>

    {
      createResult && !createResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>{m.admin_edition_created({ slug: createResult.data.slug })}</span>
        </div>
      )
    }

    <div class="card card-border mt-6 bg-base-100">
      <div class="card-body">
        <h2 class="card-title">{m.admin_new_edition()}</h2>
        <form
          method="POST"
          action={actions.admin.createEdition}
          class="mt-2 flex flex-wrap items-start gap-4"
        >
          <FormAlert error={createForm.error} class="w-full" />
          <Field {...createForm.field("slug")} class="font-mono" />
          <Field {...createForm.field("name")} />
          <Field {...createForm.field("startAt")} />
          <Field {...createForm.field("endAt")} />

          <button
            type="submit"
            class="btn btn-square btn-primary mt-7"
            aria-label={m.admin_new_edition()}
            title={m.admin_new_edition()}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>

    {
      updateResult && !updateResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>{m.admin_edition_updated()}</span>
        </div>
      )
    }
    <FormAlert error={deleteResult?.error && errorMessage(deleteResult.error)} class="mt-6" />
    {
      deleteResult && !deleteResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>{m.admin_edition_deleted()}</span>
        </div>
      )
    }

    <EditionsTable
      editions={editionRows}
      editForm={editForm}
      failedSlug={failedSlug}
    />
  </main>
</AppLayout>
