---
export const prerender = false;

import { actions } from "astro:actions";
import AdminHeader from "@/components/AdminHeader.astro";
import UsersTable from "@/components/admin/UsersTable";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import { passwordReset, userCreateForm } from "@/core/schemas";
import { db, type User } from "@/db";
import { errorMessage } from "@/forms/field-errors";
import { actionForm, submittedValues } from "@/forms/form-state";
import { m, SLOT, splitAtSlot } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";

// adminMiddleware (src/middleware/admin.ts) already redirects anonymous/
// non-admin visitors before this runs; the check below is here only so
// TypeScript narrows `Astro.locals.user` for the calls that need an `Actor`.
if (!Astro.locals.actor) return Astro.redirect("/login");

const forceLogoutResult = Astro.getActionResult(actions.admin.forceLogout);
const createUserResult = Astro.getActionResult(actions.admin.createUser);
const resetResult = Astro.getActionResult(actions.admin.resetPassword);

const createForm = await actionForm(
	Astro,
	actions.admin.createUser,
	userCreateForm,
	{ id: "create-user" },
);

const role = createForm.field("role");

const resetForm = await actionForm(
	Astro,
	actions.admin.resetPassword,
	passwordReset,
	{ id: "reset-password" },
);
const resetUsername = resetResult
	? (await submittedValues(Astro.request)).username
	: undefined;

const users = (await db.user.findMany(
	{},
	{ actor: Astro.locals.actor },
)) as Array<User & { createdAt: Date }>;

const counts = {
	ADMIN: users.filter((u) => u.role === "ADMIN").length,
	INSTRUCTOR: users.filter((u) => u.role === "INSTRUCTOR").length,
	STUDENT: users.filter((u) => u.role === "STUDENT").length,
};

// The account-created message split around the username, which is rendered apart.
const [createdBefore, createdAfter] = splitAtSlot(
	m.admin_users_created({ username: SLOT }),
);
---

<AppLayout title={m.admin_users_page_title()}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <AdminHeader active="users" />

    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-base-content/60">
        {m.admin_users_total({ count: users.length })}
      </p>
      <button
        type="button"
        class="btn btn-primary btn-sm"
        data-open-dialog="add-user-dialog"
      >
        {m.admin_users_add()}
      </button>
    </div>

    {
      createUserResult && !createUserResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>
            {createdBefore}<span class="font-mono"
              >@{createUserResult.data.username}</span
            >{createdAfter}
          </span>
        </div>
      )
    }

    <dialog
      id="add-user-dialog"
      class="modal"
      data-reopen={createUserResult?.error ? "" : undefined}
    >
      <div class="modal-box">
        <form method="dialog">
          <button class="btn btn-circle btn-ghost btn-sm absolute right-2 top-2"
            >✕</button
          >
        </form>
        <h3 class="text-lg font-bold">{m.admin_users_add()}</h3>
        <form
          method="POST"
          action={actions.admin.createUser}
          class="mt-4 flex flex-col gap-4"
        >
          <FormAlert error={createForm.error} />
          <Field {...createForm.field("name")} />
          <Field {...createForm.field("email")} />
          <Field {...createForm.field("username")} class="font-mono" />
          <Field {...role} value={role.value || "STUDENT"} />
          <Field {...createForm.field("githubId")} />
          <Field {...createForm.field("schoolId")} />
          <Field {...createForm.field("password")} />

          <div class="modal-action">
            <button type="submit" class="btn btn-primary">
              {m.admin_users_add_submit()}
            </button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>{m.admin_close_backdrop()}</button>
      </form>
    </dialog>

    <div class="stats mt-8 max-w-md border border-base-300 bg-base-100">
      <div class="stat">
        <div class="stat-title">{m.admin_users_stat_admins()}</div>
        <div class="stat-value text-2xl">{counts.ADMIN}</div>
      </div>
      <div class="stat">
        <div class="stat-title">{m.admin_users_stat_instructors()}</div>
        <div class="stat-value text-2xl">{counts.INSTRUCTOR}</div>
      </div>
      <div class="stat">
        <div class="stat-title">{m.admin_users_stat_students()}</div>
        <div class="stat-value text-2xl">{counts.STUDENT}</div>
      </div>
    </div>

    <FormAlert error={forceLogoutResult?.error && errorMessage(forceLogoutResult.error)} class="mt-6" />
    {
      forceLogoutResult && !forceLogoutResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>{m.admin_force_logout_done()}</span>
        </div>
      )
    }

    {
      resetResult && !resetResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>{m.admin_reset_password_done({ username: `@${resetUsername}` })}</span>
        </div>
      )
    }

    <UsersTable
      users={users}
      resetForm={resetForm}
      failedUsername={resetResult?.error ? resetUsername : undefined}
    />
  </main>
</AppLayout>
