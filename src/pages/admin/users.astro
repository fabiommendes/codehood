---
export const prerender = false;

import { actions } from "astro:actions";
import AdminHeader from "@/components/AdminHeader.astro";
import UsersTable from "@/components/admin/UsersTable";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import { userCreateForm } from "@/core/schemas";
import { db, type User } from "@/db";
import { actionForm } from "@/forms/form-state";
import AppLayout from "@/layouts/AppLayout.astro";

// adminMiddleware (src/middleware/admin.ts) already redirects anonymous/
// non-admin visitors before this runs; the check below is here only so
// TypeScript narrows `Astro.locals.user` for the calls that need an `Actor`.
if (!Astro.locals.actor) return Astro.redirect("/login");

const forceLogoutResult = Astro.getActionResult(actions.admin.forceLogout);
const createUserResult = Astro.getActionResult(actions.admin.createUser);

const createForm = await actionForm(
	Astro,
	actions.admin.createUser,
	userCreateForm,
	{ id: "create-user" },
);

const role = createForm.field("role");

const users = (await db.user.findMany(
	{},
	{ actor: Astro.locals.actor },
)) as Array<User & { createdAt: Date }>;

const counts = {
	ADMIN: users.filter((u) => u.role === "ADMIN").length,
	INSTRUCTOR: users.filter((u) => u.role === "INSTRUCTOR").length,
	STUDENT: users.filter((u) => u.role === "STUDENT").length,
};
---

<AppLayout title="Admin · Users">
  <main class="mx-auto max-w-4xl px-4 py-10">
    <AdminHeader active="users" />

    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-base-content/60">
        Every account on this Codehood instance: {users.length} in total.
      </p>
      <button
        type="button"
        class="btn btn-primary btn-sm"
        data-open-dialog="add-user-dialog"
      >
        Add new user
      </button>
    </div>

    {
      createUserResult && !createUserResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>
            Account created for{" "}
            <span class="font-mono">@{createUserResult.data.username}</span>.
          </span>
        </div>
      )
    }

    <dialog
      id="add-user-dialog"
      class="modal"
      data-reopen={createUserResult?.error ? "" : undefined}
    >
      <div class="modal-box">
        <form method="dialog">
          <button class="btn btn-circle btn-ghost btn-sm absolute right-2 top-2"
            >✕</button
          >
        </form>
        <h3 class="text-lg font-bold">Add new user</h3>
        <form
          method="POST"
          action={actions.admin.createUser}
          class="mt-4 flex flex-col gap-4"
        >
          <FormAlert error={createForm.error} />
          <Field {...createForm.field("name")} />
          <Field {...createForm.field("email")} />
          <Field {...createForm.field("username")} class="font-mono" />
          <Field {...role} value={role.value || "STUDENT"} />
          <Field {...createForm.field("githubId")} />
          <Field {...createForm.field("schoolId")} />
          <Field {...createForm.field("password")} />

          <div class="modal-action">
            <button type="submit" class="btn btn-primary"> Add user </button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <div class="stats mt-8 max-w-md border border-base-300 bg-base-100">
      <div class="stat">
        <div class="stat-title">Admins</div>
        <div class="stat-value text-2xl">{counts.ADMIN}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Instructors</div>
        <div class="stat-value text-2xl">{counts.INSTRUCTOR}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Students</div>
        <div class="stat-value text-2xl">{counts.STUDENT}</div>
      </div>
    </div>

    <FormAlert error={forceLogoutResult?.error?.message} class="mt-6" />
    {
      forceLogoutResult && !forceLogoutResult.error && (
        <div role="alert" class="alert alert-success mt-6">
          <span>Every session for that account has been logged out.</span>
        </div>
      )
    }

    <UsersTable users={users} />
  </main>
</AppLayout>

<script>
  import "@/components/admin/reopen-dialogs";
</script>
