---
export const prerender = false;

import AdminHeader from "@/components/AdminHeader.astro";
import CoursesTable from "@/components/admin/CoursesTable";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { listUrl, readPage } from "@/utils/list-page";
import { pageLinks } from "@/utils/page-links";

// adminMiddleware (src/middleware/admin.ts) already redirects anonymous/
// non-admin visitors before this runs; the check below is here only so
// TypeScript narrows `Astro.locals.user` for the calls that need an `Actor`.
if (!Astro.locals.actor) return Astro.redirect("/login");
const actor = Astro.locals.actor;
const [page, total] = await Promise.all([
	readPage(Astro.url, (params) => db.course.findPage(params, { actor })),
	db.course.count({}, { actor }),
]);
const cursor = { ...pageLinks(listUrl(Astro.url), page), total };
---

<AppLayout title={m.admin_courses_page_title()}>
	<AdminHeader active="courses" />

	<p class="max-w-xl text-muted">
		{m.admin_courses_intro()}
	</p>

	<CoursesTable courses={page.items} cursor={cursor} />
</AppLayout>
