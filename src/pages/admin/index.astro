---
export const prerender = false;

import { actions } from "astro:actions";
import AdminHeader from "@/components/AdminHeader.astro";
import InvitesTable from "@/components/admin/InvitesTable";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import { disciplineCreate, editionForm, invitePersonal } from "@/core/schemas";
import { db, type Invite, isEditionOpen } from "@/db";
import { errorMessage } from "@/forms/field-errors";
import { actionForm } from "@/forms/form-state";
import { m, SLOT, splitAtSlot } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";

// adminMiddleware (src/middleware/admin.ts) already redirects anonymous/
// non-admin visitors before this runs; the check below is here only so
// TypeScript narrows `Astro.locals.user` for the calls that need an `Actor`.
if (!Astro.locals.actor) return Astro.redirect("/login");
const actor = Astro.locals.actor;

const revokeResult = Astro.getActionResult(actions.admin.revokeInvite);
const disciplineResult = Astro.getActionResult(actions.admin.createDiscipline);
const editionResult = Astro.getActionResult(actions.admin.createEdition);

const inviteResult = Astro.getActionResult(actions.auth.createPersonalInvite);
const inviteUrl = inviteResult?.data
	? new URL(`/invite/${inviteResult.data.token}`, Astro.url).toString()
	: null;

const inviteForm = await actionForm(
	Astro,
	actions.auth.createPersonalInvite,
	invitePersonal,
	{ id: "invite-instructor" },
);
const disciplineForm = await actionForm(
	Astro,
	actions.admin.createDiscipline,
	disciplineCreate,
	{ id: "new-discipline" },
);
const editionFormState = await actionForm(
	Astro,
	actions.admin.createEdition,
	editionForm,
	{ id: "new-edition" },
);

const [users, courses, disciplines, editions, invites] = await Promise.all([
	db.user.findMany({}, { actor }),
	db.course.findMany({}, { actor }),
	db.discipline.findMany({}),
	db.edition.findMany({}),
	db.invite.findMany({ kind: "PERSONAL" }, { actor }),
]);

const userCounts = {
	ADMIN: users.filter((u) => u.role === "ADMIN").length,
	INSTRUCTOR: users.filter((u) => u.role === "INSTRUCTOR").length,
	STUDENT: users.filter((u) => u.role === "STUDENT").length,
};

const liveEditions = editions.filter((e) => isEditionOpen(e)).length;

const sampleList = disciplines
	.slice(0, 3)
	.map((d) => d.slug)
	.join(", ");
const disciplineSample =
	disciplines.length > 3
		? m.admin_overview_disciplines_more({
				list: sampleList,
				count: disciplines.length - 3,
			})
		: sampleList;

const pendingInvites: Invite[] = invites.filter(
	(invite) => invite.invitedRole === "INSTRUCTOR",
);
const [disciplineExampleBefore, disciplineExampleAfter] = splitAtSlot(
	m.admin_overview_discipline_text({ example: SLOT }),
);
const [editionExampleBefore, editionExampleAfter] = splitAtSlot(
	m.admin_overview_edition_text({ example: SLOT }),
);
const disciplineCreatedParts = disciplineResult?.data
	? splitAtSlot(
			m.admin_overview_discipline_created({
				slug: disciplineResult.data.slug,
				link: SLOT,
			}),
		)
	: [];
const editionCreatedParts = editionResult?.data
	? splitAtSlot(
			m.admin_overview_edition_created({
				slug: editionResult.data.slug,
				link: SLOT,
			}),
		)
	: [];
---

<AppLayout title={m.admin_overview_page_title()}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <AdminHeader active="overview" />

    <div
      class="stats stats-vertical sm:stats-horizontal border border-base-300 bg-base-100"
    >
      <div class="stat">
        <div class="stat-title">{m.admin_overview_stat_users()}</div>
        <div class="stat-value text-2xl">{users.length}</div>
        <div class="stat-desc">
          {m.admin_overview_admins({ count: userCounts.ADMIN })} · {
            m.admin_overview_instructors({ count: userCounts.INSTRUCTOR })
          } · {m.admin_overview_students({ count: userCounts.STUDENT })}
        </div>
      </div>
      <div class="stat">
        <div class="stat-title">{m.admin_overview_stat_courses()}</div>
        <div class="stat-value text-2xl">{courses.length}</div>
        <div class="stat-desc">{m.admin_overview_across_disciplines({ count: disciplines.length })}</div>
      </div>
      <div class="stat">
        <div class="stat-title">{m.admin_overview_stat_disciplines()}</div>
        <div class="stat-value text-2xl">{disciplines.length}</div>
        <div class="stat-desc">{disciplineSample || m.admin_overview_none_yet()}</div>
      </div>
      <div class="stat">
        <div class="stat-title">{m.admin_overview_stat_editions()}</div>
        <div class="stat-value text-2xl">{editions.length}</div>
        <div class="stat-desc">{m.admin_overview_live_now({ count: liveEditions })}</div>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="text-lg font-semibold">{m.admin_overview_actions_title()}</h2>
      <p class="mt-1 text-sm text-base-content/60">
        {m.admin_overview_actions_intro()}
      </p>

      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="card card-border flex flex-col bg-base-100">
          <div class="card-body flex-1">
            <div class="flex items-start gap-3">
              <span
                class="grid h-9 w-9 shrink-0 place-items-center rounded-field bg-primary/10 text-primary"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5v-11Z"
                    stroke="currentColor"
                    stroke-width="1.6"></path>
                  <path
                    d="m4.5 6 7.5 6 7.5-6"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <div>
                <h3 class="text-sm font-semibold">{m.admin_overview_invite_title()}</h3>
                <p class="mt-1 text-sm text-base-content/60">
                  {m.admin_overview_invite_text()}
                </p>
              </div>
            </div>
            <div class="mt-4 flex flex-1 items-end justify-end">
              <button
                type="button"
                class="btn btn-primary btn-sm"
                data-open-dialog="invite-instructor-dialog"
              >
                {m.admin_overview_invite_button()}
              </button>
            </div>
          </div>
        </div>

        <div class="card card-border flex flex-col bg-base-100">
          <div class="card-body flex-1">
            <div class="flex items-start gap-3">
              <span
                class="grid h-9 w-9 shrink-0 place-items-center rounded-field bg-accent/10 text-accent"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M6 4.5h9.5L19 8v11.5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5.5a1 1 0 0 1 1-1Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"></path>
                  <path
                    d="M14.5 4.5V8H19"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"></path>
                  <path
                    d="M8.5 12.5h7M8.5 15.5h7"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"></path>
                </svg>
              </span>
              <div>
                <h3 class="text-sm font-semibold">{m.admin_new_discipline()}</h3>
                <p class="mt-1 text-sm text-base-content/60">
                  {disciplineExampleBefore}<span class="font-mono">cs102</span>{disciplineExampleAfter}
                </p>
              </div>
            </div>
            <div class="mt-4 flex flex-1 items-end justify-end">
              <button
                type="button"
                class="btn btn-outline btn-sm"
                data-open-dialog="new-discipline-dialog"
              >
                {m.admin_new_discipline()}
              </button>
            </div>
          </div>
        </div>

        <div class="card card-border flex flex-col bg-base-100">
          <div class="card-body flex-1">
            <div class="flex items-start gap-3">
              <span
                class="grid h-9 w-9 shrink-0 place-items-center rounded-field bg-secondary/10 text-secondary"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M7 3.5v3M17 3.5v3M4 9h16M5.5 6h13A1.5 1.5 0 0 1 20 7.5v12A1.5 1.5 0 0 1 18.5 21h-13A1.5 1.5 0 0 1 4 19.5v-12A1.5 1.5 0 0 1 5.5 6Z"
                    stroke="currentColor"
                    stroke-width="1.6"></path>
                </svg>
              </span>
              <div>
                <h3 class="text-sm font-semibold">{m.admin_new_edition()}</h3>
                <p class="mt-1 text-sm text-base-content/60">
                  {editionExampleBefore}<span class="font-mono">2026-1</span>{editionExampleAfter}
                </p>
              </div>
            </div>
            <div class="mt-4 flex flex-1 items-end justify-end">
              <button
                type="button"
                class="btn btn-outline btn-sm"
                data-open-dialog="new-edition-dialog"
              >
                {m.admin_new_edition()}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="text-lg font-semibold">{m.admin_overview_pending_title()}</h2>
      <p class="mt-1 text-sm text-base-content/60">
        {m.admin_overview_pending_intro()}
      </p>

      {
        inviteUrl && (
          <>
            <div role="alert" class="alert alert-success mt-4">
              <span>{m.admin_overview_invite_created()}</span>
            </div>
            <div class="join mt-3 w-full">
              <input
                type="text"
                readonly
                value={inviteUrl}
                class="input join-item w-full font-mono text-sm"
                id="invite-url"
              />
              <button
                type="button"
                class="btn btn-square btn-primary join-item"
                id="copy-invite-url"
                aria-label={m.admin_overview_copy_aria()}
                title={m.admin_overview_copy_title()}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <rect
                    x="8"
                    y="8"
                    width="12"
                    height="12"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.6"
                  />
                  <path
                    d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>
          </>
        )
      }
      <FormAlert error={revokeResult?.error && errorMessage(revokeResult.error)} class="mt-4" />
      {
        revokeResult && !revokeResult.error && (
          <div role="alert" class="alert alert-success mt-4">
            <span>{m.admin_overview_invite_revoked()}</span>
          </div>
        )
      }
      {
        disciplineResult && !disciplineResult.error && (
          <div role="alert" class="alert alert-success mt-4">
            <span>
              {disciplineCreatedParts[0]}<a href="/admin/disciplines" class="underline">{m.admin_overview_discipline_link()}</a>{disciplineCreatedParts[1]}
            </span>
          </div>
        )
      }
      {
        editionResult && !editionResult.error && (
          <div role="alert" class="alert alert-success mt-4">
            <span>
              {editionCreatedParts[0]}<a href="/admin/editions" class="underline">{m.admin_overview_edition_link()}</a>{editionCreatedParts[1]}
            </span>
          </div>
        )
      }

      {
        pendingInvites.length > 0 ? (
          <InvitesTable invites={pendingInvites} />
        ) : (
          <p class="mt-4 text-sm text-base-content/50">
            {m.admin_overview_no_pending()}
          </p>
        )
      }

      <div role="alert" class="alert alert-info mt-4">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"
          ></circle>
          <path
            d="M12 11v5.5M12 8v.01"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
        <span>{m.admin_overview_link_once()}</span>
      </div>
    </div>

    <dialog
      id="invite-instructor-dialog"
      class="modal"
      data-reopen={inviteResult?.error ? "" : undefined}
    >
      <div class="modal-box">
        <form method="dialog">
          <button class="btn btn-circle btn-ghost btn-sm absolute right-2 top-2"
            >✕</button
          >
        </form>
        <h3 class="text-lg font-bold">{m.admin_overview_invite_title()}</h3>
        <p class="mt-2 text-sm text-base-content/70">
          {m.admin_overview_invite_dialog_text()}
        </p>
        <form
          method="POST"
          action={actions.auth.createPersonalInvite}
          class="mt-4 flex flex-col gap-4"
        >
          <FormAlert error={inviteForm.error} />
          <Field {...inviteForm.field("email")} />
          <div class="modal-action">
            <button type="submit" class="btn btn-primary">
              {m.admin_overview_invite_submit()}
            </button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>{m.admin_close_backdrop()}</button>
      </form>
    </dialog>

    <dialog
      id="new-discipline-dialog"
      class="modal"
      data-reopen={disciplineResult?.error ? "" : undefined}
    >
      <div class="modal-box">
        <form method="dialog">
          <button class="btn btn-circle btn-ghost btn-sm absolute right-2 top-2"
            >✕</button
          >
        </form>
        <h3 class="text-lg font-bold">{m.admin_new_discipline()}</h3>
        <form
          method="POST"
          action={actions.admin.createDiscipline}
          class="mt-4 flex flex-col gap-4"
        >
          <FormAlert error={disciplineForm.error} />
          <Field {...disciplineForm.field("slug")} class="font-mono" />
          <Field {...disciplineForm.field("name")} />
          <div class="modal-action">
            <button type="submit" class="btn btn-primary">
              {m.admin_overview_create_discipline()}
            </button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>{m.admin_close_backdrop()}</button>
      </form>
    </dialog>

    <dialog
      id="new-edition-dialog"
      class="modal"
      data-reopen={editionResult?.error ? "" : undefined}
    >
      <div class="modal-box">
        <form method="dialog">
          <button class="btn btn-circle btn-ghost btn-sm absolute right-2 top-2"
            >✕</button
          >
        </form>
        <h3 class="text-lg font-bold">{m.admin_new_edition()}</h3>
        <form
          method="POST"
          action={actions.admin.createEdition}
          class="mt-4 flex flex-col gap-4"
        >
          <FormAlert error={editionFormState.error} />
          <Field {...editionFormState.field("slug")} class="font-mono" />
          <Field {...editionFormState.field("name")} />
          <Field {...editionFormState.field("startAt")} />
          <Field {...editionFormState.field("endAt")} />
          <div class="modal-action">
            <button type="submit" class="btn btn-primary">
              {m.admin_overview_create_edition()}
            </button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>{m.admin_close_backdrop()}</button>
      </form>
    </dialog>
  </main>
</AppLayout>

<script>
  import { m, SLOT, splitAtSlot } from "@/i18n";

  const button = document.getElementById("copy-invite-url");
  const input = document.getElementById(
    "invite-url",
  ) as HTMLInputElement | null;
  const copyIcon = button?.innerHTML ?? "";
  const checkIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

  button?.addEventListener("click", async () => {
    if (!input) return;
    await navigator.clipboard.writeText(input.value);
    button.innerHTML = checkIcon;
    button.setAttribute("aria-label", m.admin_overview_copied());
    setTimeout(() => {
      button.innerHTML = copyIcon;
      button.setAttribute("aria-label", m.admin_overview_copy_aria());
    }, 1500);
  });
</script>
