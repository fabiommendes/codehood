---
import CourseHeader from "@/components/CourseHeader.astro";
import ReportFilters from "@/components/report/ReportFilters.astro";
import ReportQueue from "@/components/report/ReportQueue";
import { CursorPagination } from "@/components/ui/Pagination";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { homeNav } from "@/utils/course-tabs-nav";
import { listUrl, readPage } from "@/utils/list-page";
import { loadCourse } from "@/utils/load-course";
import { pageLinks } from "@/utils/page-links";
import { parseReportFilters } from "@/utils/report-filters";
import { toReportRow } from "@/utils/report-row";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: loadCourse({ manage: true }) already required Astro.locals.actor.
const actor = Astro.locals.actor!;

const filters = parseReportFilters(Astro.url.searchParams);
const filter = {
	course: course.id,
	kind: ["CONTENT" as const],
	status: filters.status ? [filters.status] : undefined,
};
const [page, total] = await Promise.all([
	readPage(Astro.url, (params) =>
		db.report.findPage({ ...filter, ...params }, { actor }),
	),
	db.report.count(filter, { actor }),
]);
---

<AppLayout
	title={m.report_course_title()}
	trail={breadcrumbs(Astro.url, { course })}
	nav={homeNav(href)}
>
	<main class="mx-auto max-w-4xl px-4 py-10">
		<CourseHeader course={course} active="home" />

		<p class="mb-6 max-w-xl text-muted">{m.report_course_intro()}</p>

		<ReportFilters filters={filters} hideKind />
		<ReportQueue
			client:load
			reports={page.items.map(toReportRow)}
			status={filters.status}
			kind="CONTENT"
		/>
		<CursorPagination {...pageLinks(listUrl(Astro.url), page)} total={total} />
	</main>
</AppLayout>
