---
import CourseHeader from "@/components/CourseHeader.astro";
import Alert from "@/components/ui/Alert";
import AppLayout from "@/layouts/AppLayout.astro";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course, href } = result;
---

<AppLayout title={`Manage · ${course.discipline.name}`}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="manage" />

    <p class="mt-4 text-sm text-base-content/60">
      Enrollment — invite links, revocation, and the passphrase — lives on the{" "}
      <a href={`${href}/roster`} class="text-primary hover:underline">Students tab</a>.
    </p>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">Sync status</h2>
      <Alert variant="info" class="mt-4">
        <span>Preview data — content sync doesn't run yet. Nothing here reflects a real <code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">codehood push</code>.</span>
      </Alert>
      <a href={`${href}/questions`} class="mt-3 inline-block text-sm text-primary hover:underline">
        View the question bank (preview) →
      </a>
    </section>
  </main>
</AppLayout>
