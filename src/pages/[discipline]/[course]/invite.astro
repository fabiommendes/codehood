---
export const prerender = false;

import { actions } from "astro:actions";
import Alert from "@/components/ui/Alert";
import AppLayout from "@/layouts/AppLayout.astro";
import { courseHref } from "@/utils/course-url";
import { loadCourse } from "@/utils/load-course";

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course } = result;

const href = courseHref({
	disciplineSlug: course.disciplineSlug,
	username: course.instructor.username,
	edition: course.edition,
});

let inviteUrl: string | null = null;
let errorMessage: string | null = null;

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();
	const maxUsesRaw = formData.get("maxUses");
	const maxUses = maxUsesRaw ? Number(maxUsesRaw) : undefined;

	const { data, error } = await Astro.callAction(
		actions.auth.createClassroomInvite,
		{
			courseId: course.id,
			maxUses,
		},
	);

	if (error) {
		errorMessage =
			error.message ||
			"You need to be logged in as an instructor to create an invite.";
	} else {
		inviteUrl = new URL(`/invite/${data.token}`, Astro.url).toString();
	}
}
---

<AppLayout title={`Invite students · ${course.discipline.name}`}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <a href={`${href}/roster`} class="text-sm text-base-content/60 hover:text-primary">← Roster</a>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-3xl font-bold">Invite students</h1>
      <span class="badge badge-primary badge-sm">Instructor view</span>
    </div>
    <p class="mt-2 text-base-content/60">{course.discipline.name}</p>

    <p class="mt-6 max-w-xl text-base-content/70">
      Generate a shareable join link. Anyone who opens it can create a student account and enroll in this
      course — no per-student email required.
    </p>

    {errorMessage && (
      <Alert variant="error" class="mt-6">
        <span>{errorMessage}</span>
      </Alert>
    )}

    {inviteUrl && (
      <Alert variant="success" class="mt-6">
        <span>Invite link created — it expires in 7 days.</span>
      </Alert>
    )}

    {inviteUrl && (
      <div class="mt-4 join w-full">
        <input type="text" readonly value={inviteUrl} class="input join-item w-full font-mono text-sm" id="invite-url" />
        <button type="button" class="btn btn-primary join-item" id="copy-invite-url">
          Copy
        </button>
      </div>
    )}

    <form method="POST" class="mt-8 flex flex-col gap-4">
      <fieldset class="fieldset max-w-xs">
        <legend class="fieldset-legend">Limit to N uses (optional)</legend>
        <input type="number" name="maxUses" min="1" placeholder="Unlimited" class="input w-full" />
        <p class="label">Leave blank to let any number of students join before it expires.</p>
      </fieldset>

      <div class="card-actions">
        <button type="submit" class="btn btn-primary">
          Generate invite link
        </button>
      </div>
    </form>
  </main>
</AppLayout>

<script>
	const button = document.getElementById("copy-invite-url");
	const input = document.getElementById("invite-url") as HTMLInputElement | null;

	button?.addEventListener("click", async () => {
		if (!input) return;
		await navigator.clipboard.writeText(input.value);
		button.textContent = "Copied!";
		setTimeout(() => {
			button.textContent = "Copy";
		}, 1500);
	});
</script>
