---
// The instructor's page for one roll call: its state, and every enrolled
// student with a presence checkbox.
import CourseHeader from "@/components/CourseHeader.astro";
import RollCallManager from "@/components/roll-call/RollCallManager";
import { slug } from "@/core/schemas/base";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { compareStudents } from "@/services/grading";
import { urls } from "@/urls";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { loadCourse } from "@/utils/load-course";
import { loadScheduleNav } from "@/utils/load-schedule-nav";
import { formatDateTime } from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment, week, timeSlot } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course, links, tabs } = result;

// biome-ignore lint/style/noNonNullAssertion: loadCourse({ manage: true }) already required Astro.locals.user.
const actor = Astro.locals.actor!;

const weekNumber = Number(week);
if (
	!Number.isInteger(weekNumber) ||
	!timeSlot ||
	!slug.safeParse(timeSlot).success
) {
	return Astro.rewrite(urls.notFound());
}
const pk = { course: course.id, week: weekNumber, timeSlot };
const rollCall = await db.rollCall.findOne(pk, { actor });
const event = await db.calendarEvent.findOne(pk, { actor });
if (!rollCall || !event) return Astro.rewrite(urls.notFound());

const report = await db.rollCall.courseAttendance(course.id, { actor });
const students = report.students
	.map((s) => ({
		username: s.username,
		name: s.name,
		dropped: s.status === "DROPPED",
	}))
	.toSorted(compareStudents);

const courseParams = {
	discipline: course.discipline.slug,
	course: `${course.instructor.username}_${course.edition.slug}`,
};
---

<AppLayout
  title={m.attendance_roll_call_page_title({ event: event.title })}
  trail={breadcrumbs(Astro.url, { course })}
  nav={await loadScheduleNav(course, links, actor, `${m.schedule_week({ week: weekNumber })} · ${formatDateTime(event.startAt)}`)}
>
  <CourseHeader course={course} tabs={tabs} active="schedule" />
  <h2 class="mt-8 mb-4 page-subheader">{event.title}</h2>
  <RollCallManager
    {...courseParams}
    week={weekNumber}
    timeSlot={timeSlot}
    projectHref={links.rollCallProject(weekNumber, timeSlot)}
    scheduleHref={links.schedule()}
    students={students}
    initial={{
      closesAt: rollCall.closesAt,
      attendances: rollCall.attendances,
    }}
    now={Date.now()}
    client:load
  />
</AppLayout>
