---
import { hasPerm } from "@/auth/permissions";
import CliSetupLink from "@/components/CliSetupLink.astro";
import CourseHeader from "@/components/CourseHeader.astro";
import ExamRow from "@/components/exam/ExamRow.astro";
import ListRow from "@/components/ListRow.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Alert from "@/components/ui/Alert";
import { db, groupExamsForStudent } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import { loadCourse } from "@/utils/load-course";
import {
	durationToMinutes,
	formatClock,
	formatDateTime,
	formatTime,
	toMinutes,
} from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: loadCourse already required Astro.locals.user.
const actor = Astro.locals.actor!;

// The course's URL segments, read off the loaded course — see roster.astro's
// `courseParams` for why not `Astro.params` directly.
const courseParams = {
	discipline: course.discipline.slug,
	course: `${course.instructor.username}_${course.edition.slug}`,
};
// Looked up by the viewer's own username rather than read off `course` —
// `Course` no longer carries the roster (see the enrollment-privacy fix), and
// `enrollment.read` already lets anyone check their own row. An instructor
// viewing their own course has no enrollment row here — there is nothing for
// them to leave.
const ownEnrollment = await db.enrollment.findOne(
	{ course: course.id, username: actor.username },
	{ actor },
);
const isEnrolled = ownEnrollment?.status === "ACTIVE";
const canWrite = hasPerm(actor, "course.update-contents", course);

function formatDate(date: Date): string {
	return formatDateTime(date, {
		weekday: undefined,
		hour: undefined,
		minute: undefined,
		year: "numeric",
	});
}

const WEEKDAY_LABEL: Record<string, string> = {
	SUNDAY: "Sun",
	MONDAY: "Mon",
	TUESDAY: "Tue",
	WEDNESDAY: "Wed",
	THURSDAY: "Thu",
	FRIDAY: "Fri",
	SATURDAY: "Sat",
};

// Same call and grouping the exam list page uses — the "Upcoming exams"
// section is a preview of the `upcoming` group, falling back to `practice`
// when there is none.
const exams = await db.exam.findMany({ course: course.id }, { actor });
const examGroups = groupExamsForStudent(exams);
const upcomingExams =
	examGroups.find((g) => g.key === "upcoming") ??
	examGroups.find((g) => g.key === "practice");

// The syllabus line and the next few meetings. Both come from the same source
// the Schedule tab reads; this section is a preview of it, not a copy.
const slots = await db.timeSlot.findMany({ course: course.id }, { actor });
const resources = await db.resource.findMany({ course: course.id }, { actor });

/// What kind of resource this is, in words: a file's type, a link, markdown, or a code language.
function resourceKind(resource: (typeof resources)[number]): string {
	switch (resource.data.type) {
		case "FILE":
			return resource.data.mimeType;
		case "LINK":
			return "Link";
		case "MD":
			return "Markdown";
		case "CODE":
			return resource.data.language;
	}
}

const justJoined = Astro.url.searchParams.has("joined");

const nextEvents = await db.calendarEvent.findMany(
	{ courseIds: [course.id], from: new Date(), limit: 3 },
	{ actor },
);
---

<AppLayout title={course.discipline.name}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    {
      justJoined && (
        <Alert variant="success" class="mb-6">
          <span>You joined {course.discipline.name}.</span>
        </Alert>
      )
    }

    <CourseHeader course={course} active="home" />

    {
      course.description && (
        <p class="mt-6 max-w-2xl text-base-content/70">{course.description}</p>
      )
    }

    <div
      class="stats stats-vertical sm:stats-horizontal mt-8 border border-base-300 bg-base-100"
    >
      <div class="stat">
        <div class="stat-title">Exams</div>
        <div class="stat-value text-2xl">{exams.length}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Students</div>
        <div class="stat-value text-2xl">{course.enrollmentCount}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Resources</div>
        <div class="stat-value text-2xl">{resources.length}</div>
      </div>
    </div>

    {
      upcomingExams && (
        <section class="mt-10">
          <SectionHeader
            title={upcomingExams.key === "practice" ? "Practice" : "Upcoming exams"}
            href={`${href}/exams`}
          />

          <div class="mt-4 flex flex-col gap-3">
            {upcomingExams.exams.map((exam) => (
              <ExamRow exam={exam} href={href} />
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-10">
      <SectionHeader title="Resources" href={`${href}/resources`} />

      {
        resources.length === 0 ? (
          <p class="mt-4 text-sm text-base-content/60">
            {canWrite ? (
              <>
                No resources pushed yet. <CliSetupLink />
              </>
            ) : (
              "No resources yet — the instructor publishes them with the CLI."
            )}
          </p>
        ) : (
          <div class="mt-4 flex flex-col gap-3">
            {resources.slice(0, 3).map((resource) => (
              <ListRow href={`${href}/resources/${resource.slug}`}>
                <p class="font-medium">{resource.title}</p>
                <p class="text-sm text-base-content/60">{resourceKind(resource)}</p>
              </ListRow>
            ))}
          </div>
        )
      }
    </section>

    <section class="mt-10">
      <SectionHeader title="Schedule" href={`${href}/schedule`} />

      {
        slots.length === 0 ? (
          <p class="mt-4 text-sm text-base-content/60">
            {canWrite ? (
              <>
                No schedule pushed yet. <CliSetupLink />
              </>
            ) : (
              "No schedule published yet — the instructor pushes it with the CLI."
            )}
          </p>
        ) : (
          <>
            <p class="mt-3 text-sm text-base-content/70">
              {slots
                .map(
                  (slot) =>
                    `${slot.title ?? "Meeting"} · ${WEEKDAY_LABEL[slot.day]} ${formatClock(slot.start)}–${formatTime(toMinutes(slot.start) + durationToMinutes(slot.duration))}`,
                )
                .join(", ")}
            </p>
            <div class="mt-4 flex flex-col gap-3">
              {nextEvents.length === 0 ? (
                <p class="text-sm text-base-content/60">
                  Nothing left on the calendar.
                </p>
              ) : (
                nextEvents.map((event) => (
                  <ListRow href={`${href}/schedule`}>
                    <p class="font-medium">{event.title}</p>
                    <p class="text-sm text-base-content/60">{event.kind}</p>
                    <span slot="trailing" class="text-sm text-base-content/60">
                      {formatDateTime(event.startAt)}
                    </span>
                  </ListRow>
                ))
              )}
            </div>
          </>
        )
      }
    </section>

    {
      isEnrolled && (
        <section class="mt-10 rounded-box border border-base-300 bg-base-100 p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="font-medium">You're enrolled in this course</p>
              <p class="mt-1 text-sm text-base-content/60">
                Joined {formatDate(course.joinedAt)}
              </p>
            </div>
            <button
              type="button"
              class="btn btn-outline btn-error btn-sm"
              data-open-dialog="leave-course-dialog"
            >
              Leave course
            </button>
          </div>
        </section>
      )
    }
  </main>
</AppLayout>

{
  isEnrolled && (
    <dialog id="leave-course-dialog" class="modal">
      <div class="modal-box">
        <form method="dialog">
          <button
            class="btn btn-circle btn-ghost btn-sm absolute right-2 top-2"
            type="button"
          >
            ✕
          </button>
        </form>
        <h3 class="text-lg font-bold">Leave {course.discipline.name}?</h3>
        <ul class="mt-3 flex flex-col gap-2 pl-5 text-sm text-base-content/70 list-disc">
          <li>
            Your access to everything in this course ends immediately —
            including your own past submissions.
          </li>
          <li>
            Nothing is deleted. Your submissions stay on record, and your
            instructor still sees them in the gradebook.
          </li>
          <li>
            Rejoining needs a new classroom invite or a live passphrase — you
            can't undo this yourself.
          </li>
        </ul>
        <div id="leave-course-error" class="alert alert-error mt-4" hidden>
          <span>Something went wrong. Try again.</span>
        </div>
        <form id="leave-course-form" class="modal-action">
          <input type="hidden" name="discipline" value={courseParams.discipline} />
          <input type="hidden" name="course" value={courseParams.course} />
          <button type="submit" class="btn btn-error">
            Leave course
          </button>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button type="button">close</button>
      </form>
    </dialog>
  )
}

<script>
  import { actions } from "astro:actions";

  const form = document.getElementById(
    "leave-course-form",
  ) as HTMLFormElement | null;
  const errorBox = document.getElementById("leave-course-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const { error } = await actions.course.dropEnrollment(new FormData(form));
    if (error) {
      errorBox?.removeAttribute("hidden");
      return;
    }
    window.location.href = "/courses?left=1";
  });
</script>
