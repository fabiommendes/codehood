---
import { hasPerm } from "@/auth/permissions";
import AttendanceSummary from "@/components/attendance/AttendanceSummary.astro";
import CliSetupLink from "@/components/CliSetupLink.astro";
import CourseHeader from "@/components/CourseHeader.astro";
import ExamRow from "@/components/exam/ExamRow.astro";
import ListRow from "@/components/ListRow.astro";
import OpenRollCallDialog from "@/components/roll-call/OpenRollCallDialog";
import SectionHeader from "@/components/SectionHeader.astro";
import Alert from "@/components/ui/Alert";
import { db } from "@/db";
import { escapeHtml, m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { courseHomeExams } from "@/services/course-home";
import { splitByEvent } from "@/services/event-resources";
import type { ExceptionTiming } from "@/services/exam-state";
import { formatGradeValue } from "@/services/grades-table";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { eventKindLabel } from "@/utils/calendar-event-display";
import { loadCourse } from "@/utils/load-course";
import { loadCourseExceptions } from "@/utils/load-exam-exceptions";
import { loadInstructorHome } from "@/utils/load-instructor-home";
import { resourceDetail } from "@/utils/resource-kind";
import { fileDownloadName, resourceHref } from "@/utils/resource-url";
import {
	durationToMinutes,
	formatClock,
	formatDateTime,
	formatTime,
	startOfLocalDay,
	toMinutes,
} from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: loadCourse already required Astro.locals.user.
const actor = Astro.locals.actor!;

// The course's URL segments, read off the loaded course — see roster.astro's
// `courseParams` for why not `Astro.params` directly.
const courseParams = {
	discipline: course.discipline.slug,
	course: `${course.instructor.username}_${course.edition.slug}`,
};
// Looked up by the viewer's own username rather than read off `course` —
// `Course` no longer carries the roster (see the enrollment-privacy fix), and
// `enrollment.read` already lets anyone check their own row. An instructor
// viewing their own course has no enrollment row here — there is nothing for
// them to leave.
const ownEnrollment = await db.enrollment.findOne(
	{ course: course.id, username: actor.username },
	{ actor },
);
const isEnrolled = ownEnrollment?.status === "ACTIVE";
const canWrite = hasPerm(actor, "course.update-contents", course);

function formatDate(date: Date): string {
	return formatDateTime(date, {
		weekday: undefined,
		hour: undefined,
		minute: undefined,
		year: "numeric",
	});
}

const WEEKDAY_LABEL: Record<string, string> = {
	SUNDAY: m.schedule_weekday_sun(),
	MONDAY: m.schedule_weekday_mon(),
	TUESDAY: m.schedule_weekday_tue(),
	WEDNESDAY: m.schedule_weekday_wed(),
	THURSDAY: m.schedule_weekday_thu(),
	FRIDAY: m.schedule_weekday_fri(),
	SATURDAY: m.schedule_weekday_sat(),
};

// Whoever teaches the course also sees their dated drafts and how many answers
// each exam still has to grade.
const now = new Date();
const exams = await db.exam.findMany({ course: course.id }, { actor });
const teaching = canWrite
	? await loadInstructorHome(actor, now, course)
	: undefined;
// A student's own exceptions move their exam dates; the others stay on the server.
const ownExceptions = new Map<string, ExceptionTiming>();
if (!canWrite) {
	for (const [slug, byUser] of await loadCourseExceptions(course.id)) {
		const own = byUser.get(actor.username);
		if (own) ownExceptions.set(slug, own);
	}
}
const examPreview = courseHomeExams(
	exams,
	new Map(teaching?.toGrade.map(({ exam, pending }) => [exam.slug, pending])),
	now,
	{ withDrafts: canWrite, exceptions: ownExceptions },
);

// A student's own grades: the service already narrows a student's read to the
// released columns and their own value.
const gradeColumns =
	isEnrolled && !canWrite
		? await db.gradeColumn.findMany({ course: course.id }, { actor })
		: [];

// The syllabus line and the next few meetings. Both come from the same source
// the Schedule tab reads; this section is a preview of it, not a copy.
const slots = await db.timeSlot.findMany({ course: course.id }, { actor });
const allResources = await db.resource.findMany(
	{ course: course.id },
	{ actor },
);
const { general: resources, byEvent: eventResources } =
	splitByEvent(allResources);
/// The last three general resources added, newest first; the Resources tab lists them all by title.
const newestResources = resources
	.toSorted((a, b) => b.createdAt.getTime() - a.createdAt.getTime())
	.slice(0, 3);

// Roll calls: one query for the course. A student gets a shortcut while one is
// open and their attendance summary; the instructor gets a shortcut for the
// meeting happening now.
const rollCalls = await db.rollCall.findMany({ course: course.id }, { actor });
const openRollCall = rollCalls.some((r) => r.closesAt > now);
const attendanceStudent =
	isEnrolled && !canWrite && rollCalls.length > 0
		? (await db.rollCall.courseAttendance(course.id, { actor })).students[0]
		: undefined;
const meetingNow = canWrite
	? (
			await db.calendarEvent.findMany(
				{
					courseIds: [course.id],
					from: new Date(now.getTime() - 24 * 60 * 60_000),
					limit: 10,
				},
				{ actor },
			)
		).find(
			(e) =>
				e.kind === "REGULAR" &&
				e.startAt <= now &&
				now.getTime() <
					e.startAt.getTime() + durationToMinutes(e.timeSlot.duration) * 60_000,
		)
	: undefined;
const meetingNowRollCall = meetingNow
	? rollCalls.find(
			(r) =>
				r.week === meetingNow.week && r.timeSlot === meetingNow.timeSlot.slug,
		)
	: undefined;

const justJoined = Astro.url.searchParams.has("joined");

const nextEvents = await db.calendarEvent.findMany(
	{ courseIds: [course.id], from: startOfLocalDay(now), limit: 3 },
	{ actor },
);
---

<AppLayout title={course.discipline.name}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    {
      justJoined && (
        <Alert variant="success" class="mb-6">
          <span>{m.attendance_result_joined({ course: course.discipline.name })}</span>
        </Alert>
      )
    }

    <CourseHeader course={course} active="home" />

    {
      course.description && (
        <p class="mt-6 max-w-2xl text-base-content/70">{course.description}</p>
      )
    }

    {
      meetingNow && (
        <div class="mt-6 flex flex-wrap items-center gap-3 rounded-box border border-base-300 bg-base-100 px-4 py-3">
          <span class="font-medium">{meetingNow.title}</span>
          <span class="text-sm text-base-content/60">{m.courses_home_happening_now()}</span>
          {meetingNowRollCall ? (
            <a
              href={`${href}/roll-call/${meetingNow.week}/${meetingNow.timeSlot.slug}`}
              class="btn btn-primary btn-sm ml-auto"
            >
              {m.courses_home_view_roll_call()}
            </a>
          ) : (
            <OpenRollCallDialog
              client:load
              label={m.courses_home_open_roll_call()}
              discipline={courseParams.discipline}
              course={courseParams.course}
              week={meetingNow.week}
              timeSlot={meetingNow.timeSlot.slug}
              href={href}
            />
          )}
        </div>
      )
    }

    {
      isEnrolled && !canWrite && (openRollCall || attendanceStudent) && (
        <div class="mt-6 flex flex-wrap items-center gap-4">
          {openRollCall && (
            <a href="/check-in" class="btn btn-primary btn-sm">{m.courses_home_check_in()}</a>
          )}
          {attendanceStudent && (
            <AttendanceSummary href={href} student={attendanceStudent} />
          )}
        </div>
      )
    }

    {
      examPreview.exams.length > 0 && (
        <section class="mt-10">
          <SectionHeader title={examPreview.title} href={`${href}/exams`} />

          <div class="mt-4 flex flex-col gap-3">
            {examPreview.exams.map(({ exam, pending }) => (
              <ExamRow exam={exam} href={href} pending={pending} exception={ownExceptions.get(exam.slug)} />
            ))}
          </div>
        </section>
      )
    }

    {
      gradeColumns.length > 0 && (
        <section class="mt-10" aria-label={m.nav_course_tab_grades()}>
          <SectionHeader title={m.nav_course_tab_grades()} />

          <ul aria-label={m.nav_course_tab_grades()} class="mt-4 flex flex-col gap-3">
            {gradeColumns.map((column) => {
              const value = column.values[0]?.value;
              return (
                <li class="flex items-baseline justify-between gap-4 rounded-box border border-base-300 bg-base-100 px-4 py-3">
                  <span class="font-medium">{column.title}</span>
                  <span class={value === undefined ? "text-sm text-base-content/60" : "font-medium"}>
                    {value === undefined ? m.courses_home_no_grade() : formatGradeValue(value)}
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <section class="mt-10">
      <SectionHeader title={m.nav_course_tab_resources()} href={`${href}/resources`} />

      {
        resources.length === 0 ? (
          <p class="mt-4 text-sm text-base-content/60">
            {eventResources.size > 0 ? (
              <span
                set:html={m.courses_resources_on_schedule({
                  schedule: `<a href="${escapeHtml(href)}/schedule" class="link">${escapeHtml(m.courses_resources_schedule_link())}</a>`,
                })}
              />
            ) : canWrite ? (
              <>
                {m.courses_home_no_resources_instructor()} <CliSetupLink />
              </>
            ) : (
              m.courses_home_no_resources_student()
            )}
          </p>
        ) : (
          <div class="mt-4 flex flex-col gap-3">
            {newestResources.map((resource) => (
              <ListRow
                href={resourceHref(resource, href)}
                download={
                  resource.data.type === "FILE"
                    ? fileDownloadName(resource, resource.data)
                    : undefined
                }
                external={resource.data.type === "LINK"}
              >
                <p class="font-medium">{resource.title}</p>
                <p class="text-sm text-base-content/60">{resourceDetail(resource)}</p>
              </ListRow>
            ))}
          </div>
        )
      }
    </section>

    <section class="mt-10">
      <SectionHeader title={m.nav_course_tab_schedule()} href={`${href}/schedule`} />

      {
        slots.length === 0 ? (
          <p class="mt-4 text-sm text-base-content/60">
            {canWrite ? (
              <>
                {m.schedule_none_instructor()} <CliSetupLink />
              </>
            ) : (
              m.schedule_none_student()
            )}
          </p>
        ) : (
          <>
            <p class="mt-3 text-sm text-base-content/70">
              {slots
                .map(
                  (slot) =>
                    m.schedule_slot_summary({
                      title: slot.title ?? m.schedule_slot_default_title(),
                      day: WEEKDAY_LABEL[slot.day] ?? slot.day,
                      start: formatClock(slot.start),
                      end: formatTime(
                        toMinutes(slot.start) + durationToMinutes(slot.duration),
                      ),
                    }),
                )
                .join(", ")}
            </p>
            <div class="mt-4 flex flex-col gap-3">
              {nextEvents.length === 0 ? (
                <p class="text-sm text-base-content/60">
                  {m.courses_home_nothing_on_calendar()}
                </p>
              ) : (
                nextEvents.map((event) => (
                  <ListRow href={`${href}/schedule#event-${event.id}`}>
                    <p class="font-medium">{event.title}</p>
                    {eventKindLabel(event.kind) && (
                      <p class="text-sm text-base-content/60">
                        {eventKindLabel(event.kind)}
                      </p>
                    )}
                    <span slot="trailing" class="text-sm text-base-content/60">
                      {formatDateTime(event.startAt)}
                    </span>
                  </ListRow>
                ))
              )}
            </div>
          </>
        )
      }
    </section>

    {
      isEnrolled && (
        <p class="mt-12 border-t border-base-content/10 pt-4 text-sm text-base-content/60">
          {m.courses_home_enrolled_since({ date: formatDate(course.joinedAt) })}{" "}
          <button
            type="button"
            class="link link-hover text-error"
            data-open-dialog="leave-course-dialog"
          >
            {m.courses_home_leave_link()}
          </button>
        </p>
      )
    }
  </main>
</AppLayout>

{
  isEnrolled && (
    <dialog id="leave-course-dialog" class="modal">
      <div class="modal-box">
        <form method="dialog">
          <button
            class="btn btn-circle btn-ghost btn-sm absolute right-2 top-2"
            type="submit"
            aria-label={m.courses_students_close()}
          >
            ✕
          </button>
        </form>
        <h3 class="text-lg font-bold">{m.courses_leave_title({ discipline: course.discipline.name })}</h3>
        <ul class="mt-3 flex flex-col gap-2 pl-5 text-sm text-base-content/70 list-disc">
          <li>
            {m.courses_leave_access()}
          </li>
          <li>
            {m.courses_leave_kept()}
          </li>
          <li>
            {m.courses_leave_rejoin()}
          </li>
        </ul>
        <div id="leave-course-error" class="alert alert-error mt-4" hidden>
          <span>{m.courses_leave_error()}</span>
        </div>
        <form id="leave-course-form" class="modal-action">
          <input type="hidden" name="discipline" value={courseParams.discipline} />
          <input type="hidden" name="course" value={courseParams.course} />
          <button type="submit" class="btn btn-error">
            {m.courses_leave_submit()}
          </button>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button type="submit">{m.courses_close_backdrop()}</button>
      </form>
    </dialog>
  )
}

<script>
  import { actions } from "astro:actions";

  const form = document.getElementById(
    "leave-course-form",
  ) as HTMLFormElement | null;
  const errorBox = document.getElementById("leave-course-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const { error } = await actions.course.dropEnrollment(new FormData(form));
    if (error) {
      errorBox?.removeAttribute("hidden");
      return;
    }
    window.location.href = "/courses?left=1";
  });
</script>
