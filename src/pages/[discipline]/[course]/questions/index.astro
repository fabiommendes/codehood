---
import CourseHeader from "@/components/CourseHeader.astro";
import QuestionsTable from "@/components/question/QuestionsTable";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { listUrl, readPage } from "@/utils/list-page";
import { loadCourse } from "@/utils/load-course";
import { pageLinks } from "@/utils/page-links";
import { readQuestionListQuery } from "@/utils/question-list-query";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course, ref, tabs } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;

const here = listUrl(Astro.url);
const bank = { course: course.id, public: false } as const;
const asked = readQuestionListQuery(here.searchParams);

// A tag no question carries any more filters nothing.
const tags = await db.question.tags(bank, { actor });
const query = {
	...asked,
	tags: asked.tags.filter((tag) => tags.includes(tag)),
};
function some<Item>(items: Item[]): Item[] | undefined {
	return items.length > 0 ? items : undefined;
}
const filter = {
	...bank,
	statuses: some(query.statuses),
	types: some(query.types),
	tags: some(query.tags),
};
const filtered = Boolean(filter.statuses || filter.types || filter.tags);

const [page, total, bankTotal] = await Promise.all([
	readPage(here, (params) =>
		db.question.findPage({ ...filter, sort: query.sort, ...params }, { actor }),
	),
	db.question.count(filter, { actor }),
	filtered ? db.question.count(bank, { actor }) : undefined,
]);

// The course's URL segments, read off the loaded course — see roster.astro's
// `courseParams` for why not `Astro.params` directly.
const courseParams = {
	discipline: course.discipline.slug,
	course: `${course.instructor.username}_${course.edition.slug}`,
};
---

<AppLayout title={m.questions_list_page_title({ discipline: course.discipline.name })}
  trail={breadcrumbs(Astro.url, { course })}
>
  <CourseHeader course={course} tabs={tabs} active="questions" />

  <h2 class="mt-6 page-subheader">{m.questions_title()}</h2>
  <p class="mt-1 text-sm text-muted">{course.discipline.name}</p>

  <QuestionsTable
    questions={page.items.map(({ id: _id, ...q }) => q)}
    cursor={{ ...pageLinks(here, page), total }}
    bankTotal={bankTotal ?? total}
    tags={tags}
    query={query}
    search={here.search}
    courseRef={ref}
    discipline={courseParams.discipline}
    course={courseParams.course}
    client:load
  />
</AppLayout>
