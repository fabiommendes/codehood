---
import CourseHeader from "@/components/CourseHeader.astro";
import QuestionsTable from "@/components/question/QuestionsTable";
import { db } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;

const questions = await db.question.findMany(
	{ courseId: course.id, public: false },
	{ actor },
);
---

<AppLayout title={`Questions · ${course.discipline.name}`}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="questions" />

    <h2 class="mt-6 text-xl font-semibold">Questions</h2>
    <p class="mt-1 text-sm text-base-content/60">{course.discipline.name}</p>

    <QuestionsTable questions={questions} href={href} client:load />
  </main>
</AppLayout>
