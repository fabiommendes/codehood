---
import CourseHeader from "@/components/CourseHeader.astro";
import QuestionsTable from "@/components/question/QuestionsTable";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;

const questions = await db.question.findMany(
	{ course: course.id, public: false },
	{ actor },
);

// The course's URL segments, read off the loaded course — see roster.astro's
// `courseParams` for why not `Astro.params` directly.
const courseParams = {
	discipline: course.discipline.slug,
	course: `${course.instructor.username}_${course.edition.slug}`,
};
---

<AppLayout title={m.questions_list_page_title({ discipline: course.discipline.name })}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="questions" />

    <h2 class="mt-6 text-xl font-semibold">{m.questions_title()}</h2>
    <p class="mt-1 text-sm text-base-content/60">{course.discipline.name}</p>

    <QuestionsTable
      questions={questions.map(({ id: _id, ...q }) => q)}
      href={href}
      discipline={courseParams.discipline}
      course={courseParams.course}
      client:load
    />
  </main>
</AppLayout>
