---
import { firstFencedCode } from "mdq";
import CourseHeader from "@/components/CourseHeader.astro";
import QuestionPage from "@/components/question/QuestionPage";
import Alert from "@/components/ui/Alert";
import Badge from "@/components/ui/Badge";
import { RUNNER_ORIGIN } from "@/core/constants";
import { db } from "@/db";
import { locale, m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { publicForm, questionProblems } from "@/mdq";
import { questionAttachmentUrl, urls } from "@/urls";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { highlightCode } from "@/utils/highlight-code";
import { highlightQuestionCodeBlocks } from "@/utils/highlight-code-blocks";
import { highlightExamples } from "@/utils/highlight-examples";
import { loadCourse } from "@/utils/load-course";
import {
	questionStatusLabels,
	questionTypeLabels,
	statusBadgeClass,
} from "@/utils/question-display";

export const prerender = false;

const { discipline, course: courseSegment, slug } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course, tabs } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;

if (!slug) return Astro.rewrite(urls.notFound());
const question = await db.question.findOne(
	{ course: course.id, slug, public: false },
	{ actor },
);
if (!question) return Astro.rewrite(urls.notFound());
const { question: doc } = question;

const { publicId } = question;
const attachmentUrls = Object.fromEntries(
	(doc.attachments ?? []).map(({ name }) => [
		name,
		questionAttachmentUrl(publicId, name, question.version),
	]),
);
const problems = questionProblems(doc);
const preview = publicForm(doc);
const exampleHtml =
	preview.type === "code" ? await highlightExamples(preview) : [];
const answerKey =
	doc.type === "code" && doc.answerKey ? firstFencedCode(doc.answerKey) : null;
const keyHtml =
	doc.type === "code" && answerKey
		? await highlightCode(answerKey, doc.language ?? null)
		: undefined;
const codeBlocks = await highlightQuestionCodeBlocks(doc);
---

<AppLayout title={m.questions_detail_page_title({ title: doc.title ?? question.slug })}
  trail={breadcrumbs(Astro.url, { course, item: doc.title ?? question.slug })}
  nav={{ context: doc.title ?? question.slug, sections: [] }}
>
  <CourseHeader course={course} tabs={tabs} active="questions" />

  <h2 class="mt-6 page-subheader">{doc.title ?? question.slug}</h2>
  <div class="mt-2 flex flex-wrap items-center gap-2">
    <span class:list={["badge badge-sm", statusBadgeClass(question.status)]}>{questionStatusLabels[question.status]}</span>
    <span class="badge badge-outline badge-sm">{questionTypeLabels[doc.type]}</span>
  </div>
  <div class="mt-2 flex flex-wrap gap-1.5">
    {
      (doc.tags ?? []).map((tag) => (
        <Badge size="xs" style="outline">
          {tag}
        </Badge>
      ))
    }
  </div>

  {
    problems.length > 0 && (
      <Alert variant="warning" class="mt-8">
        <div class="flex flex-col gap-1">
          <span class="font-semibold">{m.questions_problems_heading()}</span>
          <ul class="list-inside list-disc text-sm">
            {problems.map((problem) => (
              <li>{problem.message}</li>
            ))}
          </ul>
        </div>
      </Alert>
    )
  }

  <section class="mt-8">
    <h3 class="page-subsubheader">{m.questions_details()}</h3>
    <dl class="mt-3 grid grid-cols-1 gap-x-8 gap-y-3 rounded-box border border-edge bg-base-100 p-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-muted">{m.questions_field_type()}</dt>
        <dd class="mt-0.5 font-medium">{questionTypeLabels[doc.type]}</dd>
      </div>
      <div>
        <dt class="text-sm text-muted">{m.questions_field_status()}</dt>
        <dd class="mt-0.5 font-medium">{questionStatusLabels[question.status]}</dd>
      </div>
      <div>
        <dt class="text-sm text-muted">{m.questions_field_version()}</dt>
        <dd class="mt-0.5 font-medium">{question.version}</dd>
      </div>
      <div>
        <dt class="text-sm text-muted">{m.questions_field_last_updated()}</dt>
        <dd class="mt-0.5 font-medium">
          {question.updatedAt.toLocaleDateString(locale, { month: "short", day: "numeric", year: "numeric" })}
        </dd>
      </div>
    </dl>
  </section>

  <section class="mt-8">
    <QuestionPage client:load data={doc} runnerOrigin={RUNNER_ORIGIN} exampleHtml={exampleHtml} keyHtml={keyHtml} attachmentUrls={attachmentUrls} codeBlocks={codeBlocks} />
  </section>
</AppLayout>
