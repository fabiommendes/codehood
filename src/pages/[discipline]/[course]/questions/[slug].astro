---
import CourseHeader from "@/components/CourseHeader.astro";
import QuestionPreview from "@/components/question/QuestionPreview";
import Alert from "@/components/ui/Alert";
import Badge from "@/components/ui/Badge";
import { db } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import { Question } from "@/mdq/question";
import { loadCourse } from "@/utils/load-course";
import { questionTypeLabels, statusBadgeClass } from "@/utils/question-display";

export const prerender = false;

const { discipline, course: courseSegment, slug } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;

if (!slug) return Astro.rewrite("/404");
const question = await db.question.findOne(
	{ courseId: course.id, slug, public: false },
	{ actor },
);
if (!question) return Astro.rewrite("/404");
const { question: doc } = question;

const problems = new Question(doc).validate();
---

<AppLayout title={`${doc.title ?? question.slug} · Questions`}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="questions" />

    <a href={`${href}/questions`} class="text-sm text-base-content/60 hover:text-primary">← Questions</a>

    <div class="mt-2 flex flex-wrap items-center gap-2">
      <span class:list={["badge badge-sm", statusBadgeClass(question.status)]}>{question.status}</span>
      <span class="badge badge-outline badge-sm">{questionTypeLabels[doc.type]}</span>
    </div>
    <h2 class="mt-2 text-2xl font-bold">{doc.title ?? question.slug}</h2>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {
        (doc.tags ?? []).map((tag) => (
          <Badge size="xs" style="outline">
            {tag}
          </Badge>
        ))
      }
    </div>

    {
      problems.length > 0 && (
        <Alert variant="warning" class="mt-8">
          <div class="flex flex-col gap-1">
            <span class="font-semibold">This question has problems mdq.spec does not allow:</span>
            <ul class="list-inside list-disc text-sm">
              {problems.map((problem) => (
                <li>{problem.message}</li>
              ))}
            </ul>
          </div>
        </Alert>
      )
    }

    <section class="mt-8">
      <h2 class="text-lg font-semibold">Details</h2>
      <dl class="mt-3 grid grid-cols-1 gap-x-8 gap-y-3 rounded-box border border-base-300 bg-base-100 p-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-base-content/50">Type</dt>
          <dd class="mt-0.5 font-medium">{questionTypeLabels[doc.type]}</dd>
        </div>
        <div>
          <dt class="text-sm text-base-content/50">Status</dt>
          <dd class="mt-0.5 font-medium">{question.status}</dd>
        </div>
        <div>
          <dt class="text-sm text-base-content/50">Version</dt>
          <dd class="mt-0.5 font-medium">{question.version}</dd>
        </div>
        <div>
          <dt class="text-sm text-base-content/50">Last updated</dt>
          <dd class="mt-0.5 font-medium">
            {question.updatedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
          </dd>
        </div>
      </dl>
    </section>

    <section class="mt-8 rounded-box border border-base-300 bg-base-100 p-6">
      <QuestionPreview client:load data={doc} />
    </section>
  </main>
</AppLayout>
