---
import CourseHeader from "@/components/CourseHeader.astro";
import ExamPreview, {
	type PreviewQuestion,
} from "@/components/exam/ExamPreview";
import { RUNNER_ORIGIN } from "@/core/constants";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { shufflePool } from "@/mdq/shuffle";
import { effectiveCodeRun } from "@/services/code-run";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { examNav } from "@/utils/exam-nav";
import { highlightExamples } from "@/utils/highlight-examples";
import { loadExamQuestions } from "@/utils/load-exam-questions";
import { loadExamStaff } from "@/utils/load-exam-staff";
import type { PretestSource } from "@/utils/pretest-sources";

export const prerender = false;

const { discipline, course: courseSegment, slug } = Astro.params;
const result = await loadExamStaff(Astro, discipline, courseSegment, slug, {
	practice: true,
});
if ("redirect" in result) return result.redirect;
const { course, href, exam, data } = result;

// biome-ignore lint/style/noNonNullAssertion: loadExamStaff already redirected an anonymous visitor.
const actor = Astro.locals.actor!;

// Each pinned question at the version the exam pins, with its answer key and in
// its public form.
const staffQuestions = await loadExamQuestions(course.id, exam, false, {
	actor,
});
const publicQuestions = await loadExamQuestions(course.id, exam, true, {
	actor,
});

const codeRun = effectiveCodeRun(exam);
// The preview shuffles like an attempt does, with a seed of its own.
const previewQuestions: PreviewQuestion[] = staffQuestions.flatMap((staff) => {
	const shown = publicQuestions.find((entry) => entry.slug === staff.slug);
	return shown
		? [
				{
					slug: staff.slug,
					question: shufflePool(shown.question, `preview:${staff.slug}`),
					key: staff.question,
				},
			]
		: [];
});
const previewPretests: Record<string, PretestSource[]> = {};
const previewExampleHtml: Record<string, string[]> = {};
await Promise.all(
	staffQuestions.map(async ({ slug, version }) => {
		const shown = previewQuestions.find((entry) => entry.slug === slug);
		if (shown?.question.type !== "code") return;
		previewPretests[slug] = (
			await db.question.codeAnswer(
				{ course: course.id, slug, version },
				{ actor },
			)
		).pretests;
		previewExampleHtml[slug] = await highlightExamples(shown.question);
	}),
);
---

<AppLayout title={`${m.exams_detail_questions_heading()} · ${exam.title}`}
  trail={breadcrumbs(Astro.url, { course, item: exam.title, page: m.exams_detail_questions_heading() })}
  nav={examNav({
    href: `${href}/exams/${exam.slug}`,
    title: exam.title,
    manage: true,
    practice: exam.type === "PRACTICE",
    pending: data.pending,
    regrades: data.openRegrades,
  })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="exams" />

    <a href={`${href}/exams/${exam.slug}`} class="text-sm text-muted hover:text-primary">← {exam.title}</a>
    <h2 class="mt-2 text-2xl font-bold">{m.exams_detail_questions_heading()}</h2>

    {
      previewQuestions.length > 0 ? (
        <div class="mt-4">
          <ExamPreview
            client:load
            questions={previewQuestions}
            pretests={previewPretests}
            exampleHtml={previewExampleHtml}
            codeRun={codeRun.allowed}
            runnerOrigin={RUNNER_ORIGIN}
            course={`${discipline}/${courseSegment}`}
            exam={exam.slug}
          />
        </div>
      ) : (
        <p class="mt-4 text-sm text-muted">{m.exams_detail_no_questions()}</p>
      )
    }
  </main>
</AppLayout>
