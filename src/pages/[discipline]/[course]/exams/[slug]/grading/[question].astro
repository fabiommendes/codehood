---
import CourseHeader from "@/components/CourseHeader.astro";
import type { AnswerPayload } from "@/components/exam/answer-payload";
import QuestionNumber from "@/components/exam/QuestionNumber.astro";
import { pointsByPosition } from "@/components/exam/question-points";
import Answer from "@/components/grading/Answer.astro";
import AnswerControls from "@/components/grading/AnswerControls";
import AnswerKey from "@/components/grading/AnswerKey";
import AppliedItems from "@/components/grading/AppliedItems";
import CodeAnswerKey from "@/components/grading/CodeAnswerKey.astro";
import CodeQueue from "@/components/grading/CodeQueue.astro";
import CodeSends from "@/components/grading/CodeSends.astro";
import Icon from "@/components/grading/Icon.astro";
import ObjectiveReview from "@/components/grading/ObjectiveReview.astro";
import PassHistory from "@/components/grading/PassHistory.astro";
import RubricGrader from "@/components/grading/RubricGrader";
import { db } from "@/db";
import { loadResultPolicy } from "@/db/result-policy";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { publicForm } from "@/mdq";
import { formatScore } from "@/services/exam-result";
import { answersTo, gradingOrder } from "@/services/grading";
import { objectiveReview, restMeans } from "@/services/objective-review";
import { questionStats } from "@/services/question-stats";
import { pendingBlanks, reviewResult } from "@/services/review";
import { urls } from "@/urls";
import { adjustmentLabel } from "@/utils/adjustment-label";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { graderState } from "@/utils/grader-state";
import { wantsList, wantsNames } from "@/utils/grading-urls";
import { highlightQuestionCodeBlocks } from "@/utils/highlight-code-blocks";
import {
	gradingExamNav,
	loadGrading,
	loadStudents,
} from "@/utils/load-grading";
import { highlightCodeBlocks, renderMarkdown } from "@/utils/markdown";
import { isAutoGraded, questionTypeLabels } from "@/utils/question-display";

export const prerender = false;

const {
	discipline,
	course: courseSegment,
	slug,
	question: questionSlug,
} = Astro.params;
const result = await loadGrading(Astro, discipline, courseSegment, slug);
if ("redirect" in result) return result.redirect;
const {
	course,
	href,
	links,
	tabs,
	exam,
	questions,
	answers,
	attempts,
	feedback,
	exceptions,
} = result;

const position = questions.indexOf(questionSlug ?? "");
if (!questionSlug || position < 0) return Astro.rewrite(urls.notFound());

// biome-ignore lint/style/noNonNullAssertion: loadGrading already redirected an anonymous visitor.
const actor = Astro.locals.actor!;
const pinnedVersion = exam.questions[position]?.version ?? null;
const stored = await db.question.findOne(
	{
		course: course.id,
		slug: questionSlug,
		public: false,
		version: pinnedVersion,
	},
	{ actor },
);
if (!stored) return Astro.rewrite(urls.notFound());

const versionMissing =
	pinnedVersion !== null && stored.version !== pinnedVersion;
const doc = stored.question;
const title = doc.title ?? stored.slug;
const points = pointsByPosition(exam.questions)[position] ?? "0";
const asked = publicForm(doc);
// An essay's or upload's model answer is a hint for the grader, not a correct answer.
const hasKey = doc.type !== "essay" && doc.type !== "upload";
// The answer key carries the statement, so only a question without one shows it alone.
const statementHtml = await highlightCodeBlocks(
	renderMarkdown([asked.stem, asked.epilogue].filter(Boolean).join("\n\n")),
);
const [keyBlocks, askedBlocks] = await Promise.all([
	highlightQuestionCodeBlocks(doc),
	highlightQuestionCodeBlocks(asked),
]);

const previous = questions[position - 1];
const next = questions[position + 1];
const names = wantsNames(Astro.url);
const examLinks = links.exam(exam.slug);
// A manual question shows student names only when asked for; an automatic one always does.
const auto = isAutoGraded(doc);
const studentNames = new Map(
	names || auto
		? (await loadStudents(course.id, actor)).map((student) => [
				student.username,
				student.name,
			])
		: [],
);

// The course's instructor is the only person who grades; a bot's pass names no one.
const instructor = course.instructor;
const graderName = (pass: { grader: string | null }): string =>
	pass.grader === null
		? m.grades_question_auto()
		: pass.grader === instructor.username
			? instructor.name
			: pass.grader;

// Open regrade requests, by the submission they contest.
const openRegrades = new Map(
	(
		await db.regradeRequest.findMany(
			{ course: course.id, exam: exam.slug, status: "OPEN" },
			{ actor },
		)
	).map((request) => [request.submission, request.publicId]),
);
const regradesHref = `${href}/exams/${exam.slug}/regrades`;
// The adjustments of the exam, and the factor of each student's on this question.
const sanctions = await db.examAdjustment.findMany(
	{ course: course.id, exam: exam.slug },
	{ actor },
);
const sanctioned = new Map(
	sanctions
		.filter((sanction) => sanction.question === questionSlug)
		.map((sanction) => [sanction.author, Number(sanction.value)]),
);
/// The badge text for a sanctioned answer, or undefined when it is not.
const sanctionLabel = (author: string) => {
	const factor = sanctioned.get(author);
	if (factor === undefined) return undefined;
	return adjustmentLabel({ op: "FACTOR", value: factor });
};

// The view the request asks for, which links forward; an automatic question ignores it.
/// The columns of the answers table: who, what they answered, the score and the badges.
const rowColumns =
	"grid grid-cols-[minmax(7rem,11rem)_minmax(0,1fr)_4.5rem_minmax(5rem,auto)] gap-3";
const wantedList = wantsList(Astro.url);
const listView = wantedList && !auto;

// A code question that goes to a worker also shows its queue and the sends of each answer.
const worker =
	doc.type === "code" && typeof doc.meta?.worker === "string" ? doc : null;
const queue = worker
	? await db.gradingJob.summary(
			{ course: course.id, exam: exam.slug, question: questionSlug },
			{ actor },
		)
	: null;
/// The sends of each answer of the question, by the answer's submission.
const sendsOf = new Map<
	string,
	Awaited<ReturnType<typeof db.gradingJob.forInstructor>>[string]
>();
if (worker) {
	const responseOf = new Map(
		answers
			.filter((answer) => answer.question === questionSlug)
			.flatMap((answer) => {
				const attempt = attempts.find((entry) =>
					entry.submissions.some((sent) => sent.publicId === answer.submission),
				);
				return attempt ? [[answer.submission, attempt.publicId] as const] : [];
			}),
	);
	const responses = [...new Set(responseOf.values())];
	// One call per 500 answers, the most the service reads at once.
	const reads = [];
	for (let start = 0; start < responses.length; start += 500) {
		reads.push(
			db.gradingJob.forInstructor(
				{
					question: questionSlug,
					responses: responses.slice(start, start + 500),
				},
				{ actor },
			),
		);
	}
	const read = Object.assign({}, ...(await Promise.all(reads)));
	for (const [submission, response] of responseOf) {
		if (read[response]) sendsOf.set(submission, read[response]);
	}
}

const { pending, resolved } = answersTo(questionSlug, answers);
const ownAnswers = answers.filter((answer) => answer.question === questionSlug);
// The rubric is read for the one-at-a-time view only; the list and an automatic question never start one.
const rubric =
	listView || auto
		? null
		: await db.rubric.findOne(
				{ course: course.id, exam: exam.slug, question: questionSlug },
				{ actor },
			);
const grader = rubric && graderState(ownAnswers, rubric, actor.username);
const shown = (
	auto ? [] : listView ? [...pending, ...resolved] : gradingOrder(ownAnswers)
).map((answer, index) => ({
	answer,
	label: m.grades_question_answer_n({ n: index + 1 }),
	isPending: answer.state === "pending",
	// The marks the library gives; the score that counts is in the passes below.
	result:
		answer.payload === null
			? undefined
			: reviewResult(doc, answer.payload, {
					score: answer.verdict,
					blanks: answer.blanks,
				}),
	blanks: pendingBlanks(doc, answer.payload),
}));

// The model of an automatic question's page.
const review = auto
	? await (async () => {
			const policy = (await loadResultPolicy(course.id))(exam);
			const rest = restMeans(
				exam.questions,
				questionSlug,
				attempts,
				feedback,
				policy,
			);
			const stats = questionStats(
				exam,
				questions,
				attempts,
				feedback,
				new Date(),
				exceptions,
				policy,
			)[position];
			return objectiveReview({
				question: doc,
				slug: questionSlug,
				answers: ownAnswers.map((answer) => ({
					...answer,
					restMean: rest.get(answer.author) ?? null,
				})),
				stats: stats ?? { correct: null, discrimination: null },
				regrades: openRegrades,
				sanctions: new Map(
					sanctions
						.filter(
							(sanction) =>
								sanction.question === questionSlug && sanction.op === "FACTOR",
						)
						.map((sanction) => [
							sanction.author,
							{
								publicId: sanction.publicId,
								value: Number(sanction.value),
								reason: sanction.reason,
								updatedAt: sanction.updatedAt,
							},
						]),
				),
			});
		})()
	: null;
---

<AppLayout title={m.grades_question_title({ question: `${m.exams_attempt_question_short({ number: position + 1 })} ${title}`, exam: exam.title })}
  trail={breadcrumbs(Astro.url, { course, item: exam.title, question: title })}
  nav={await gradingExamNav(result, actor, undefined, sanctions)}
>
  <CourseHeader course={course} tabs={tabs} active="exams" />

  <a href={examLinks.grading({ names })} class="text-sm text-muted hover:text-primary">← {m.grades_question_back()}</a>

  <p class="mt-2 text-sm">
    <QuestionNumber number={position + 1} points={points} />
    {auto && <span class="badge badge-ghost badge-sm ml-1">{questionTypeLabels[doc.type]}</span>}
  </p>
  {auto ? (
    <div class="relative flex items-center gap-2">
      {previous ? (
        <a href={examLinks.gradingQuestion(previous, { names, view: wantedList ? "list" : undefined })} class="btn btn-ghost btn-sm btn-square text-base-content/60 lg:absolute lg:right-full lg:mr-1" aria-label={m.grades_question_previous()} title={m.grades_question_previous()}>
          <Icon name="chevronLeft" />
        </a>
      ) : <span class="btn btn-ghost btn-sm btn-square invisible lg:absolute lg:right-full lg:mr-1" aria-hidden="true"></span>}
      <h2 class="page-subheader">{title}</h2>
      {next && (
        <a href={examLinks.gradingQuestion(next, { names, view: wantedList ? "list" : undefined })} class="btn btn-ghost btn-sm btn-square text-base-content/60" aria-label={m.grades_question_next()} title={m.grades_question_next()}>
          <Icon name="chevronRight" />
        </a>
      )}
    </div>
  ) : <h2 class="page-subheader">{title}</h2>}

  {!auto && <nav class="mt-3 flex gap-4 text-sm">
    {previous && <a href={examLinks.gradingQuestion(previous, { names, view: wantedList ? "list" : undefined })} class="link">{m.grades_question_previous()}</a>}
    {next && <a href={examLinks.gradingQuestion(next, { names, view: wantedList ? "list" : undefined })} class="link">{m.grades_question_next()}</a>}
    <a href={examLinks.gradingQuestion(questionSlug, { names, view: listView ? undefined : "list" })} class="link">{listView ? m.grades_question_view_one() : m.grades_question_view_list()}</a>
    <a href={examLinks.gradingQuestion(questionSlug, { names: !names, view: wantedList ? "list" : undefined })} role="switch" aria-checked={names ? "true" : "false"} class="link ml-auto">{m.grades_question_show_names()}</a>
  </nav>}

  {versionMissing && (
    <div role="alert" class="alert alert-warning mt-4">
      <span>{m.grades_question_version_missing({ version: pinnedVersion })}</span>
    </div>
  )}

  {
    listView ? (
      hasKey ? (
        <section class="mt-6">
          <h3 class="page-subsubheader">{m.grades_question_correct_answer()}</h3>
          <div class="mt-3 rounded-box border border-edge bg-base-100 p-6">
            {doc.type === "code" ? <CodeAnswerKey question={doc} /> : <AnswerKey client:load question={doc} codeBlocks={keyBlocks} />}
          </div>
        </section>
      ) : (
        <section
          aria-label={m.grades_question_statement()}
          class="prose prose-sm mt-6 max-w-none rounded-box border border-edge bg-base-100 p-6"
          set:html={statementHtml}
        />
      )
    ) : (
      <details class:list={["mt-4 rounded-box border border-edge", auto ? "overflow-hidden bg-base-200/25 shadow-sm" : "bg-base-100"]}>
        <summary class:list={["cursor-pointer px-4 py-2 text-sm font-medium", auto && "bg-base-200/50"]}>{m.grades_grader_questions()}</summary>
        <div class:list={[auto ? "border-t border-edge p-6" : "p-4"]}>
          {hasKey ? (
            doc.type === "code" ? <CodeAnswerKey question={doc} /> : <AnswerKey client:load question={doc} codeBlocks={keyBlocks} />
          ) : (
            <div class="prose prose-sm max-w-none" set:html={statementHtml} />
          )}
        </div>
      </details>
    )
  }

  {queue && (
    <CodeQueue
      summary={queue}
      target={{ discipline: discipline!, course: courseSegment!, exam: exam.slug, question: questionSlug }}
      now={new Date()}
    />
  )}

  {review && (
    <ObjectiveReview
      review={review}
      target={{ discipline: discipline!, course: courseSegment!, exam: exam.slug, question: questionSlug }}
      names={Object.fromEntries(studentNames)}
      regradesHref={regradesHref}
      editHref={`${href}/questions/${questionSlug}`}
    />
  )}

  {!auto && shown.length === 0 && <p class="mt-8 text-base-content/70">{m.grades_question_no_answers()}</p>}

  {
    !listView && grader && shown.length > 0 && (
      <div class="mt-6 grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <section aria-label={m.grades_grader_answer()} class="card card-border bg-base-100">
          <div class="card-body">
            {shown.map(({ answer, result }, position) => (
              <div id={`answer-${answer.submission}`} hidden={position !== 0}>
                {openRegrades.has(answer.submission) && (
                  <a href={`${regradesHref}#regrade-${openRegrades.get(answer.submission)}`} class="badge badge-warning badge-sm">{m.grades_regrade_requested()}</a>
                )}
                {sanctionLabel(answer.author) && <span class="badge badge-error badge-sm">{sanctionLabel(answer.author)}</span>}
                {answer.passes.some((pass) => pass.notes !== undefined) && (
                  <span class="badge badge-error badge-sm">{m.grades_question_suspicious()}</span>
                )}
                {names && <p class="font-medium">{studentNames.get(answer.author) ?? answer.author}</p>}
                <Answer question={asked} codeBlocks={askedBlocks} payload={answer.payload as AnswerPayload} answerKey={doc.type === "upload" ? doc.answerKey : undefined} result={result} submission={answer.submission} />
                {worker && sendsOf.has(answer.submission) && <CodeSends sends={sendsOf.get(answer.submission)!} question={worker} />}
                {answer.passes
                  .filter((pass) => pass.bot !== null)
                  .slice(0, 1)
                  .map((pass) => (
                    <div role="note" class="alert alert-info alert-soft mt-4 block text-sm">
                      <p class="font-semibold">{m.grades_question_auto()}: {pass.bot}</p>
                      <p>{pass.willNotGrade ? m.grades_question_not_graded() : pass.score === null ? m.grades_question_no_score() : formatScore(pass.score)}</p>
                      {pass.comment && <p class="mt-1 whitespace-pre-wrap">{pass.comment}</p>}
                      {pass.notes && <p class="mt-1 whitespace-pre-wrap">{pass.notes}</p>}
                      <AppliedItems items={pass.rubricItems ?? []} />
                    </div>
                  ))}
              </div>
            ))}
          </div>
        </section>
        <RubricGrader
          client:load
          target={{ discipline: discipline!, course: courseSegment!, exam: exam.slug, question: questionSlug }}
          initial={grader}
          queueHref={examLinks.grading({ names })}
        />
      </div>
    )
  }

  {listView && (
  <div class="mt-8 flex flex-col gap-6">
    {
      shown.map(({ answer, label, isPending, result, blanks }, index) => (
        <>
          {!isPending && (index === 0 || shown[index - 1]?.isPending) && (
            <h3 class="page-subsubheader">{m.grades_question_graded()}</h3>
          )}
          <article id={`answer-${answer.submission}`} aria-label={label} class="card card-border bg-base-100">
            <div class="card-body">
              <p class="text-sm font-semibold text-muted">{label}</p>
              {openRegrades.has(answer.submission) && (
                <a href={`${regradesHref}#regrade-${openRegrades.get(answer.submission)}`} class="badge badge-warning badge-sm">{m.grades_regrade_requested()}</a>
              )}
              {sanctionLabel(answer.author) && <span class="badge badge-error badge-sm">{sanctionLabel(answer.author)}</span>}
              {answer.passes.some((pass) => pass.notes !== undefined) && (
                <span class="badge badge-error badge-sm">{m.grades_question_suspicious()}</span>
              )}
              {names && <p class="font-medium">{studentNames.get(answer.author) ?? answer.author}</p>}
              <Answer question={asked} codeBlocks={askedBlocks} payload={answer.payload as AnswerPayload} answerKey={doc.type === "upload" ? doc.answerKey : undefined} result={result} submission={answer.submission} reviewLabel={names ? (studentNames.get(answer.author) ?? answer.author) : label} />
              {worker && sendsOf.has(answer.submission) && <CodeSends sends={sendsOf.get(answer.submission)!} question={worker} />}

              {!isPending && (
                <>
                  <p class="mt-4 text-lg font-semibold">
                    {answer.state === "graded" && answer.verdict !== null
                      ? formatScore(answer.verdict)
                      : m.grades_question_not_graded()}
                  </p>
                  <PassHistory passes={answer.passes} {graderName} />
                </>
              )}

              <AnswerControls
                client:load
                discipline={discipline!}
                course={courseSegment!}
                exam={exam.slug}
                submission={answer.submission}
                state={answer.state}
                blanks={blanks}
              />
            </div>
          </article>
        </>
      ))
    }
  </div>
  )}
</AppLayout>

<script>
  import { FOCUS_KEY } from "@/components/grading/focus";

  // Only a page reloaded by a save asks for focus; an ordinary load leaves it alone.
  if (sessionStorage.getItem(FOCUS_KEY) === location.pathname) {
    sessionStorage.removeItem(FOCUS_KEY);
    document.querySelector<HTMLInputElement>("[data-score-input]")?.focus();
  }
</script>
