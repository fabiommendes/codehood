---
import CourseHeader from "@/components/CourseHeader.astro";
import QuestionNumber from "@/components/exam/QuestionNumber.astro";
import { pointsByPosition } from "@/components/exam/question-points";
import Link from "@/components/Link.astro";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { gradingQueue } from "@/services/grading";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { wantsNames } from "@/utils/grading-urls";
import { gradingExamNav, loadGrading } from "@/utils/load-grading";
import { questionKindLabel } from "@/utils/question-display";

export const prerender = false;

const { discipline, course: courseSegment, slug } = Astro.params;
const result = await loadGrading(Astro, discipline, courseSegment, slug);
if ("redirect" in result) return result.redirect;
const { course, links, tabs, exam, questions, answers } = result;
const names = wantsNames(Astro.url);

// biome-ignore lint/style/noNonNullAssertion: loadGrading already redirected an anonymous visitor.
const actor = Astro.locals.actor!;

const stored = await db.question.findMany(
	{ course: course.id, public: false },
	{ actor },
);
const bySlug = new Map(stored.map((entry) => [entry.slug, entry.question]));

/// The job counts of the code questions that go to a worker, by question slug.
const jobCounts = new Map(
	await Promise.all(
		questions.flatMap((slug) => {
			const doc = bySlug.get(slug);
			return doc?.type === "code" && typeof doc.meta?.worker === "string"
				? [
						db.gradingJob
							.summary(
								{ course: course.id, exam: exam.slug, question: slug },
								{ actor },
							)
							.then((summary) => [slug, summary.counts] as const),
					]
				: [];
		}),
	),
);

const points = pointsByPosition(exam.questions);
const queue = gradingQueue(questions, answers);
const rows = queue.map((entry, index) => {
	const doc = bySlug.get(entry.question);
	const jobs = jobCounts.get(entry.question);
	const jobLines = jobs
		? [
				(jobs.QUEUED ?? 0) + (jobs.CLAIMED ?? 0) > 0 &&
					m.grades_queue_jobs_queued({
						count: (jobs.QUEUED ?? 0) + (jobs.CLAIMED ?? 0),
					}),
				(jobs.DONE ?? 0) > 0 &&
					m.grades_queue_jobs_done({ count: jobs.DONE ?? 0 }),
				(jobs.FAILED ?? 0) > 0 &&
					m.grades_queue_jobs_failed({ count: jobs.FAILED ?? 0 }),
			].filter(Boolean)
		: [];
	const counts = [
		entry.pending > 0 && m.grades_queue_pending({ count: entry.pending }),
		(entry.review ?? 0) > 0 &&
			m.grades_queue_review({ count: entry.review ?? 0 }),
		entry.graded > 0 && m.grades_queue_graded({ count: entry.graded }),
		entry.notGraded > 0 &&
			m.grades_queue_not_graded({ count: entry.notGraded }),
	].filter(Boolean);
	return {
		number: index + 1,
		points: points[index] ?? "0",
		slug: entry.question,
		title: doc?.title ?? entry.question,
		kind: doc ? questionKindLabel(doc) : null,
		counts:
			counts.length > 0
				? counts.join(" · ")
				: jobLines.length > 0
					? jobLines.join(" · ")
					: m.grades_queue_no_answers(),
	};
});

const nothingLeft =
	answers.length > 0 && !answers.some((answer) => answer.state === "pending");
---

<AppLayout title={m.grades_queue_title({ exam: exam.title })}
  trail={breadcrumbs(Astro.url, { course, item: exam.title })}
  nav={await gradingExamNav(result, actor)}
>
  <CourseHeader course={course} tabs={tabs} active="exams" />

  <h2 class="mt-6 page-subheader">{m.grades_queue_heading()}</h2>

  {nothingLeft && <p class="mt-4 text-base-content/70">{m.grades_queue_done()}</p>}

  <ul aria-label={m.grades_queue_questions()} class="mt-6 flex flex-col gap-3">
    {
      rows.map((row) => (
        <li class="group card card-border bg-base-100 transition-colors hover:border-primary">
          <Link
            href={links.exam(exam.slug).gradingQuestion(row.slug, { names })}
            aria-labelledby={`queue-${row.slug}`}
            class="card-body flex-row items-center gap-4 py-4"
          >
            <div class="min-w-0 flex-1">
              <p class="text-sm"><QuestionNumber number={row.number} points={row.points} /></p>
              <span id={`queue-${row.slug}`} class="font-medium group-hover:text-primary">{row.title}</span>
              {row.kind && <p class="text-sm text-muted">{row.kind}</p>}
            </div>
            <span class="text-sm">{row.counts}</span>
          </Link>
        </li>
      ))
    }
  </ul>
</AppLayout>
