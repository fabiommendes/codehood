---
import CourseHeader from "@/components/CourseHeader.astro";
import type { AnswerPayload } from "@/components/exam/answer-payload";
import ReopenAttempt from "@/components/exam/ReopenAttempt";
import Answer from "@/components/grading/Answer.astro";
import { attemptTotalLabel } from "@/components/grading/attempt-total";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { type PublicQuestion, publicForm } from "@/mdq";
import { examResult, formatScore } from "@/services/exam-result";
import { canReopenAttempt } from "@/services/exam-state";
import { attemptRows } from "@/services/grading";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { gradingHref } from "@/utils/grading-urls";
import { loadGrading, loadStudents } from "@/utils/load-grading";
import { durationToMinutes, formatDateTime } from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment, slug, username } = Astro.params;
const result = await loadGrading(Astro, discipline, courseSegment, slug);
if ("redirect" in result) return result.redirect;
const { course, href, exam, questions, attempts, feedback, exceptions } =
	result;

const attempt = attempts.find((entry) => entry.author === username);
if (!attempt) return Astro.rewrite("/404");

// biome-ignore lint/style/noNonNullAssertion: loadGrading already redirected an anonymous visitor.
const actor = Astro.locals.actor!;
const now = new Date();
const [students, stored] = await Promise.all([
	loadStudents(course.id, actor),
	db.question.findMany({ course: course.id, public: false }, { actor }),
]);
const docs = new Map(stored.map((entry) => [entry.slug, entry.question]));

// The results table builds its row the same way, so the two never disagree.
const [row] = attemptRows(
	exam,
	questions,
	[attempt],
	feedback,
	students,
	now,
	exceptions,
);
if (!row) return Astro.rewrite("/404");
const closed = row.state === "submitted";
// The student's exception, if any, and whether their personal window still lets the attempt reopen.
const exception = exceptions.get(row.author) ?? null;
const exceptionExtra = exception?.extraTime
	? m.exams_exceptions_extra({
			minutes: durationToMinutes(exception.extraTime),
		})
	: null;
const exceptionDate = exception?.scheduledAt
	? formatDateTime(exception.scheduledAt, { year: "numeric" })
	: null;
const canReopen =
	closed &&
	!attempt.acceptingSubmissions &&
	canReopenAttempt(exam, exception, attempt, now);
// Open regrade requests of this student, by the submission they contest.
const openRegrades = new Map(
	(
		await db.regradeRequest.findMany(
			{
				course: course.id,
				exam: exam.slug,
				status: "OPEN",
				author: attempt.author,
			},
			{ actor },
		)
	).map((request) => [request.submission, request.publicId]),
);
const outcomes = examResult(questions, attempt.submissions, feedback);

const rows = outcomes.questions.map((outcome, index) => {
	const doc = docs.get(outcome.question);
	const counting = attempt.submissions
		.filter((submission) => submission.question === outcome.question)
		.reduce<(typeof attempt.submissions)[number] | null>(
			(newest, submission) =>
				!newest || submission.createdAt > newest.createdAt
					? submission
					: newest,
			null,
		);
	return {
		label: m.exams_attempt_question_label({ number: index + 1 }),
		outcome,
		title: doc?.title ?? outcome.question,
		asked: doc ? (publicForm(doc) as PublicQuestion) : null,
		counting,
	};
});

const stateLabel = (status: string, score: number | null): string => {
	if (status === "not-graded") return m.exams_attempt_not_graded();
	if (status === "graded" && score !== null) return formatScore(score);
	return m.exams_attempt_waiting();
};
---

<AppLayout title={`${row.name} · ${exam.title}`}
  trail={breadcrumbs(Astro.url, { course, item: exam.title, student: row.name })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="exams" />

    <a href={`${href}/exams/${exam.slug}`} class="text-sm text-base-content/60 hover:text-primary">← {exam.title}</a>

    <h2 class="mt-2 text-2xl font-bold">
      {row.name}
      {row.dropped && <span class="badge badge-outline badge-sm ml-2">{m.exams_attempt_dropped()}</span>}
    </h2>

    <dl class="mt-4 grid grid-cols-1 gap-x-8 gap-y-3 rounded-box border border-base-300 bg-base-100 p-6 sm:grid-cols-3">
      <div>
        <dt class="text-sm text-base-content/50">{m.exams_attempt_started()}</dt>
        <dd class="mt-0.5 font-medium">{formatDateTime(row.startedAt, { year: "numeric" })}</dd>
      </div>
      <div>
        <dt class="text-sm text-base-content/50">{m.exams_attempt_submitted()}</dt>
        <dd class="mt-0.5 font-medium">
          {closed ? formatDateTime(attempt.updatedAt, { year: "numeric" }) : m.exams_attempt_in_progress()}
        </dd>
      </div>
      <div>
        <dt class="text-sm text-base-content/50">{m.exams_attempt_total()}</dt>
        <dd class="mt-0.5 font-medium">{attemptTotalLabel(row.total, row.state)}</dd>
      </div>
    </dl>

    {
      exception && (
        <p class="mt-4 text-sm text-base-content/70">
          <span class="font-medium">{m.exams_attempt_exception()}:</span>{" "}
          {[exceptionExtra, exceptionDate && m.exams_detail_new_date({ date: exceptionDate })].filter(Boolean).join(" · ")}
          {" · "}
          <a class="link" href={`${href}/exams/${exam.slug}#exceptions`}>{m.exams_attempt_edit_exception()}</a>
        </p>
      )
    }

    {
      canReopen && (
        <div class="mt-4">
          <ReopenAttempt
            client:load
            discipline={discipline!}
            course={courseSegment!}
            exam={exam.slug}
            username={row.author}
          />
        </div>
      )
    }

    <div class="mt-8 flex flex-col gap-6">
      {
        rows.map(({ label, outcome, title, asked, counting }) => (
          <article aria-label={label} class="card card-border bg-base-100">
            <div class="card-body">
              <h3 class="text-lg font-semibold">{title}</h3>
              {counting && openRegrades.has(counting.publicId) && (
                <a href={`${href}/exams/${exam.slug}/regrades#regrade-${openRegrades.get(counting.publicId)}`} class="badge badge-warning badge-sm">{m.grades_regrade_requested()}</a>
              )}
              {counting && asked ? (
                <>
                  <Answer question={asked} payload={counting.payload as AnswerPayload} />
                  <p class="mt-4 font-semibold">{stateLabel(outcome.status, outcome.score)}</p>
                  {outcome.comments.map((comment) => (
                    <p class="whitespace-pre-wrap text-sm text-base-content/70">{comment}</p>
                  ))}
                  {closed && (
                    <p class="mt-2">
                      <a
                        class="link"
                        href={gradingHref(`${href}/exams/${exam.slug}/grading/${outcome.question}`, {
                          names: true,
                          anchor: `answer-${counting.publicId}`,
                        })}
                      >
                        {m.exams_attempt_grade_this()}
                      </a>
                    </p>
                  )}
                </>
              ) : (
                <p class="text-base-content/60">{m.exams_attempt_not_answered()}</p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </main>
</AppLayout>
