---
import CourseHeader from "@/components/CourseHeader.astro";
import SanctionActions from "@/components/grading/SanctionActions";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { examNav } from "@/utils/exam-nav";
import { loadExamStaff } from "@/utils/load-exam-staff";
import { formatDateTime } from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment, slug } = Astro.params;
const result = await loadExamStaff(Astro, discipline, courseSegment, slug);
if ("redirect" in result) return result.redirect;
const { course, href, tabs, exam, data } = result;

// biome-ignore lint/style/noNonNullAssertion: loadExamStaff already redirected an anonymous visitor.
const actor = Astro.locals.actor!;
const [sanctions, stored] = await Promise.all([
	db.examSanction.findMany(
		{ course: course.id, exam: exam.slug, revoked: true },
		{ actor },
	),
	db.question.findMany(
		{
			course: course.id,
			public: false,
			slugs: exam.questions.map((question) => question.slug),
		},
		{ actor },
	),
]);
const names = new Map(
	data.students.map((student) => [student.username, student.name]),
);
const titles = new Map(
	stored.map((entry) => [entry.slug, entry.question.title ?? entry.slug]),
);
const examHref = `${href}/exams/${exam.slug}`;
const rows = sanctions.map((sanction) => ({
	sanction,
	student: names.get(sanction.author) ?? sanction.author,
	target:
		sanction.question === null
			? m.grades_sanction_target_exam()
			: (titles.get(sanction.question) ?? sanction.question),
	notes: "notes" in sanction ? sanction.notes : null,
	by: "createdBy" in sanction ? sanction.createdBy : "",
	active: sanction.revokedAt === null,
}));
---

<AppLayout title={`${m.grades_sanction_title()} · ${exam.title}`}
  trail={breadcrumbs(Astro.url, { course, item: exam.title, page: m.grades_sanction_title() })}
  nav={examNav({
    href: examHref,
    title: exam.title,
    manage: true,
    pending: data.pending,
    regrades: data.openRegrades,
    sanctions: data.sanctions,
  })}
>
  <CourseHeader course={course} tabs={tabs} active="exams" />

  <h2 class="mt-6 page-subheader">{m.grades_sanction_title()}</h2>

  {
    rows.length === 0 ? (
      <p class="mt-6 text-base-content/70">{m.grades_sanction_empty()}</p>
    ) : (
      <div class="mt-6 overflow-x-auto rounded-box border border-edge bg-base-100 shadow-sm">
        <table aria-label={m.grades_sanction_title()} class="table">
          <thead class="bg-base-200/50">
            <tr class="uppercase">
              <th scope="col">{m.grades_sanction_col_student()}</th>
              <th scope="col">{m.grades_sanction_col_target()}</th>
              <th scope="col">{m.grades_sanction_col_reason()}</th>
              <th scope="col">{m.grades_sanction_col_date()}</th>
              <th scope="col"><span class="sr-only">{m.grades_sanction_col_actions()}</span></th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ sanction, student, target, notes, by, active }) => (
              <tr class:list={["align-top", !active && "text-base-content/60"]}>
                <th scope="row" class="font-medium">
                  <a href={`${examHref}/attempts/${sanction.author}`} class="link">{student}</a>
                </th>
                <td>
                  <div class="flex flex-wrap items-center gap-2">
                    <span>{target}</span>
                    <span class:list={["badge badge-sm", active ? "badge-error" : "badge-ghost"]}>
                      {active ? m.grades_sanction_active() : m.grades_sanction_revoked()}
                    </span>
                  </div>
                  <div class="text-xs text-muted tabular-nums">{m.grades_sanction_factor_line({ factor: sanction.factor })}</div>
                </td>
                <td>
                  <div class="whitespace-pre-wrap">{sanction.reason}</div>
                  {notes && (
                    <div class="mt-1 whitespace-pre-wrap text-xs text-muted"><span class="font-medium">{m.grades_sanction_col_notes()}:</span> {notes}</div>
                  )}
                </td>
                <td class="whitespace-nowrap">
                  {formatDateTime(sanction.createdAt, { year: "numeric" })}
                  {by && <div class="text-xs text-muted">{m.grades_sanction_by_line({ name: by })}</div>}
                </td>
                <td>
                  {active && (
                    <SanctionActions
                      client:load
                      discipline={discipline!}
                      course={courseSegment!}
                      exam={exam.slug}
                      sanction={sanction.publicId}
                      updatedAt={sanction.updatedAt.toISOString()}
                      wholeExam={sanction.question === null}
                      factor={sanction.factor}
                      reason={sanction.reason}
                      notes={notes}
                    />
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AppLayout>
