---
import { hasPerm } from "@/auth/permissions";
import CourseHeader from "@/components/CourseHeader.astro";
import ExamRow from "@/components/exam/ExamRow.astro";
import ExamsTable from "@/components/exam/ExamsTable";
import { db, groupExamsForStudent, resultsReleased } from "@/db";
import { examResult, formatScore } from "@/db/exam-result";
import AppLayout from "@/layouts/AppLayout.astro";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canWrite = hasPerm(actor, "course.update-contents", course);

// No `public`/`manage` flag here, unlike questions — the exam service
// already narrows DRAFT/ARCHIVED rows to whoever may write the course's
// contents, so this list is exactly what `actor` may see.
const exams = await db.exam.findMany({ course: course.id }, { actor });
const now = new Date();
const groups = canWrite ? [] : groupExamsForStudent(exams, now);

// A student's released total per exam slug, from one attempts query and one
// feedback query for the whole course. Pending or unreleased exams have none.
const scores = new Map<string, string>();
if (!canWrite) {
	const [attempts, feedback] = await Promise.all([
		db.response.findMany(
			{ course: course.id, author: actor.username, practice: false },
			{ actor },
		),
		db.feedback.findMany(
			{ course: course.id, author: actor.username },
			{ actor },
		),
	]);
	for (const exam of exams) {
		const attempt = attempts.find((entry) => entry.exam === exam.slug);
		if (!attempt || !resultsReleased(exam, now)) continue;
		const { total } = examResult(
			exam.questions.map((question) => question.slug),
			attempt.submissions,
			feedback,
		);
		if (total !== null) scores.set(exam.slug, formatScore(total));
	}
}
---

<AppLayout title={`Exams · ${course.discipline.name}`}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="exams" />

    <h2 class="mt-6 text-xl font-semibold">Exams</h2>
    <p class="mt-1 text-sm text-base-content/60">{course.discipline.name}</p>

    {
      exams.length === 0 ? (
        <p class="mt-4 text-sm text-base-content/60">No exams yet.</p>
      ) : canWrite ? (
        <div class="mt-4">
          <ExamsTable
            exams={exams.map(({ id: _id, questions: _questions, ...e }) => e)}
            href={href}
            client:load
          />
        </div>
      ) : (
        <div class="mt-4 flex flex-col gap-6">
          {groups.map((group) => (
            <section>
              <h3 class="text-sm font-semibold tracking-wide text-base-content/50 uppercase">
                {group.label}
              </h3>
              <div class="mt-2 flex flex-col gap-3">
                {group.exams.map((exam) => (
                  <ExamRow exam={exam} href={href} score={scores.get(exam.slug)} />
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </main>
</AppLayout>
