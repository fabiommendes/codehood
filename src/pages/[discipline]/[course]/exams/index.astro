---
import ListRow from "@/components/ListRow.astro";
import Badge from "@/components/ui/Badge";
import AppLayout from "@/layouts/AppLayout.astro";
import { courseHref } from "@/utils/course-url";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course } = result;

const href = courseHref({
	disciplineSlug: course.disciplineSlug,
	username: course.instructor.username,
	edition: course.edition,
});

const exams = [
	{
		name: "Quiz 1: Variables & Loops",
		detail: "Completed · Score 8/10",
		badge: { variant: "neutral" as const, label: "Completed" },
		href: null,
	},
	{
		name: "Midterm Exam",
		detail: "Due Mar 15 · 10 questions",
		badge: { variant: "success" as const, label: "Open" },
		href: `${href}/exams/midterm`,
	},
	{
		name: "Final Project",
		detail: "Opens Apr 10",
		badge: { style: "outline" as const, label: "Upcoming" },
		href: null,
	},
];
---

<AppLayout title={`${course.discipline.name} · Exams`}>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <a href={href} class="text-sm text-base-content/60 hover:text-primary">← {course.discipline.name}</a>

    <h1 class="mt-3 text-3xl font-bold">Exams</h1>
    <p class="mt-2 text-base-content/70">{course.discipline.name} · {course.edition}</p>

    <div class="mt-8 flex flex-col gap-3">
      {
        exams.map((exam) => (
          <ListRow href={exam.href ?? undefined} muted={!exam.href}>
            <p class="font-medium">{exam.name}</p>
            <p class="text-sm text-base-content/60">{exam.detail}</p>
            <Badge slot="trailing" variant={exam.badge.variant} style={exam.badge.style}>
              {exam.badge.label}
            </Badge>
          </ListRow>
        ))
      }
    </div>
  </main>
</AppLayout>
