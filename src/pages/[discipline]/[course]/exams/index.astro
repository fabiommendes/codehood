---
import { canManageEnrollment } from "@/auth/permissions";
import CourseHeader from "@/components/CourseHeader.astro";
import ListRow from "@/components/ListRow.astro";
import Badge from "@/components/ui/Badge";
import AppLayout from "@/layouts/AppLayout.astro";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: loadCourse already required Astro.locals.user.
const canManage = canManageEnrollment(Astro.locals.actor!, course);

// Still mocked — exams and submissions need question rendering (out of scope
// for dev/specs/to-do/course-navigation.md). A draft exam is only ever in
// this list, carrying a Draft badge, for the instructor (see the "no modes"
// design decision: same page, same URL, more rows — never a parallel screen).
const exams = [
	{
		name: "Quiz 1: Variables & Loops",
		status: "closed" as const,
		studentDetail: "Completed · Score 8/10",
		instructorDetail: "38 / 42 submitted",
		badge: {
			variant: "neutral" as const,
			label: "Closed",
			style: undefined,
		},
		href: null,
	},
	{
		name: "Midterm Exam",
		status: "open" as const,
		studentDetail: "Due Mar 15 · 10 questions",
		instructorDetail: "12 / 42 submitted",
		badge: { variant: "success" as const, label: "Open", style: undefined },
		href: `${href}/exams/midterm`,
	},
	{
		name: "Final Project",
		status: "draft" as const,
		studentDetail: "Opens Apr 10",
		instructorDetail: "Not visible to students yet",
		badge: {
			style: "outline" as const,
			label: "Draft",
			variant: undefined,
		},
		href: null,
	},
] as const;

const visibleExams = canManage
	? exams
	: exams.filter((exam) => exam.status !== "draft");
---

<AppLayout title={`${course.discipline.name} · Exams`}>
	<main class="mx-auto max-w-4xl px-4 py-10">
		<CourseHeader course={course} active="exams" />

		<h2 class="text-xl font-semibold">Exams</h2>
		<p class="mt-1 text-sm text-base-content/60">
			{course.discipline.name} · {course.editionSlug}
		</p>

		<div class="mt-6 flex flex-col gap-3">
			{
				visibleExams.map((exam) => (
					<ListRow href={exam.href ?? undefined} muted={!exam.href}>
						<p class="font-medium">{exam.name}</p>
						<p class="text-sm text-base-content/60">
							{canManage
								? exam.instructorDetail
								: exam.studentDetail}
						</p>
						<div
							slot="trailing"
							class="flex flex-col items-end gap-1"
						>
							<Badge
								variant={exam.badge.variant}
								style={exam.badge.style}
							>
								{exam.badge.label}
							</Badge>
							{canManage && exam.status !== "draft" && (
								<a
									href={`${href}/gradebook`}
									class="text-xs text-primary hover:underline"
								>
									Gradebook →
								</a>
							)}
						</div>
					</ListRow>
				))
			}
		</div>
	</main>
</AppLayout>
