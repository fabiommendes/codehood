---
import { hasPerm } from "@/auth/permissions";
import CliSetupLink from "@/components/CliSetupLink.astro";
import CourseHeader from "@/components/CourseHeader.astro";
import ExamRow from "@/components/exam/ExamRow.astro";
import ExamsTable from "@/components/exam/ExamsTable";
import { db, groupExamsForStudent } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { examResult, formatScore } from "@/services/exam-result";
import {
	type AttemptState,
	attemptState,
	type ExceptionTiming,
	personalTiming,
	resultsReleased,
} from "@/services/exam-state";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { loadCourse } from "@/utils/load-course";
import { loadCourseExceptions } from "@/utils/load-exam-exceptions";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canWrite = hasPerm(actor, "course.update-contents", course);

// No `public`/`manage` flag here, unlike questions — the exam service
// already narrows DRAFT/ARCHIVED rows to whoever may write the course's
// contents, so this list is exactly what `actor` may see.
const exams = await db.exam.findMany({ course: course.id }, { actor });
const now = new Date();
// Never sent to the client: the student's own entries shift their windows and
// the whole set decides whether grades are released.
const exceptions = canWrite ? new Map() : await loadCourseExceptions(course.id);
const ownExceptions = new Map<string, ExceptionTiming>();
for (const [slug, byUser] of exceptions) {
	const own = byUser.get(actor.username);
	if (own) ownExceptions.set(slug, own);
}
const groups = canWrite ? [] : groupExamsForStudent(exams, now, ownExceptions);

// A student's attempt state and released total per exam slug, from one
// attempts query and one feedback query for the whole course. Pending or
// unreleased exams have no total.
const states = new Map<string, AttemptState>();
const scores = new Map<string, string>();
if (!canWrite) {
	const [attempts, feedback] = await Promise.all([
		db.response.findMany(
			{ course: course.id, author: actor.username, practice: false },
			{ actor },
		),
		db.feedback.findMany(
			{ course: course.id, author: actor.username },
			{ actor },
		),
	]);
	for (const exam of exams) {
		const attempt = attempts.find((entry) => entry.exam === exam.slug);
		const everyone = [...(exceptions.get(exam.slug)?.values() ?? [])];
		const released = resultsReleased(exam, now, everyone);
		states.set(
			exam.slug,
			attemptState(
				personalTiming(exam, ownExceptions.get(exam.slug) ?? null),
				attempt ?? null,
				now,
				{ released },
			),
		);
		if (!attempt || !released) continue;
		const { total } = examResult(
			exam.questions.map((question) => question.slug),
			attempt.submissions,
			feedback,
		);
		if (total !== null) scores.set(exam.slug, formatScore(total));
	}
}
---

<AppLayout title={m.exams_list_page_title({ discipline: course.discipline.name })}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="exams" />

    <h2 class="mt-6 text-xl font-semibold">{m.exams_list_heading()}</h2>

    {
      exams.length === 0 ? (
        <p class="mt-4 text-sm text-base-content/60">
          {canWrite ? (
            <>
              {m.exams_list_empty_teacher()} <CliSetupLink />
            </>
          ) : (
            m.exams_list_empty_student()
          )}
        </p>
      ) : canWrite ? (
        <div class="mt-4">
          <ExamsTable
            exams={exams.map(({ id: _id, questions: _questions, ...e }) => e)}
            href={href}
            client:load
          />
        </div>
      ) : (
        <div class="mt-4 flex flex-col gap-6">
          {groups.map((group) => (
            <section>
              <h3 class="kicker">
                {group.label}
              </h3>
              <div class="mt-2 flex flex-col gap-3">
                {group.exams.map((exam) => (
                  <ExamRow
                    exam={exam}
                    href={href}
                    score={scores.get(exam.slug)}
                    state={states.get(exam.slug)}
                    exception={ownExceptions.get(exam.slug)}
                    phaseBadge={group.key === "past"}
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </main>
</AppLayout>
