---
import Alert from "@/components/ui/Alert";
import AppLayout from "@/layouts/AppLayout.astro";
import { courseHref } from "@/utils/course-url";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course } = result;

const href = courseHref({
	disciplineSlug: course.disciplineSlug,
	username: course.instructor.username,
	edition: course.edition,
});
---

<AppLayout title={`Midterm Exam — ${course.discipline.name}`}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <a href={`${href}/exams`} class="text-sm text-base-content/60 hover:text-primary">← {course.discipline.name} exams</a>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-3xl font-bold">Midterm Exam</h1>
      <span class="badge badge-success">Open · due Mar 15</span>
    </div>
    <p class="mt-2 text-base-content/60">{course.discipline.name} · 10 questions</p>
    <a href={`${href}/exams/midterm/1`} class="mt-1 inline-block text-sm text-primary hover:underline">
      Try the one-question-at-a-time view →
    </a>
    <a href={`${href}/exams/midterm/results`} class="mt-1 block text-sm text-primary hover:underline">
      Already submitted? See your results →
    </a>

    <Alert variant="info" class="mt-6">
      <span>Preview data — nothing here submits or saves yet.</span>
    </Alert>

    <form class="mt-8 flex flex-col gap-8">
      <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-5">
        <legend class="fieldset-legend px-2">Question 1 · Multiple choice</legend>
        <p class="mb-3 font-medium">
          What does the following expression evaluate to?
          <code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">3 + 4 * 2</code>
        </p>
        <div class="flex flex-col gap-2">
          <label class="label cursor-pointer justify-start gap-3">
            <input type="radio" name="q1" class="radio radio-sm" />
            <span>11</span>
          </label>
          <label class="label cursor-pointer justify-start gap-3">
            <input type="radio" name="q1" class="radio radio-sm" />
            <span>14</span>
          </label>
          <label class="label cursor-pointer justify-start gap-3">
            <input type="radio" name="q1" class="radio radio-sm" />
            <span>10</span>
          </label>
          <label class="label cursor-pointer justify-start gap-3">
            <input type="radio" name="q1" class="radio radio-sm" />
            <span>Syntax error</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-5">
        <legend class="fieldset-legend px-2">Question 2 · Multiple choice</legend>
        <p class="mb-3 font-medium">Which of these is <em>not</em> a primitive type in most languages?</p>
        <div class="flex flex-col gap-2">
          <label class="label cursor-pointer justify-start gap-3">
            <input type="radio" name="q2" class="radio radio-sm" />
            <span>Integer</span>
          </label>
          <label class="label cursor-pointer justify-start gap-3">
            <input type="radio" name="q2" class="radio radio-sm" />
            <span>Boolean</span>
          </label>
          <label class="label cursor-pointer justify-start gap-3">
            <input type="radio" name="q2" class="radio radio-sm" />
            <span>Array</span>
          </label>
          <label class="label cursor-pointer justify-start gap-3">
            <input type="radio" name="q2" class="radio radio-sm" />
            <span>Character</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-5">
        <legend class="fieldset-legend px-2">Question 3 · Short answer</legend>
        <p class="mb-3 font-medium">In one or two sentences, explain the difference between a stack and a queue.</p>
        <textarea class="textarea w-full" rows="4" placeholder="Type your answer here..."></textarea>
      </fieldset>

      <div class="card-actions justify-end">
        <button type="button" class="btn btn-primary" disabled>
          Submit exam
        </button>
      </div>
    </form>
  </main>
</AppLayout>
