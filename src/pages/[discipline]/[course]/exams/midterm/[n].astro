---
import Alert from "@/components/ui/Alert";
import AppLayout from "@/layouts/AppLayout.astro";
import { courseHref } from "@/utils/course-url";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment, n: nParam } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course } = result;

const href = courseHref({
	disciplineSlug: course.disciplineSlug,
	username: course.instructor.username,
	edition: course.edition,
});

// Same three questions shown on the all-at-once exam page — this route previews the
// alternative one-question-at-a-time flow instead.
const questions = [
	{
		kind: "Multiple choice",
		prompt: "What does the following expression evaluate to?",
		code: "3 + 4 * 2",
		options: ["11", "14", "10", "Syntax error"],
	},
	{
		kind: "Multiple choice",
		prompt: "Which of these is not a primitive type in most languages?",
		options: ["Integer", "Boolean", "Array", "Character"],
	},
	{
		kind: "Short answer",
		prompt:
			"In one or two sentences, explain the difference between a stack and a queue.",
	},
] as const;
const totalOnExam = 10; // Midterm Exam is listed as 10 questions; only the first 3 are modeled here.

const n = Number(nParam);
if (!Number.isInteger(n) || n < 1 || n > questions.length) {
	return Astro.redirect(`${href}/exams/midterm/1`);
}
const question = questions[n - 1];
const isLast = n === questions.length;
---

<AppLayout title={`Question ${n} — Midterm Exam`}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <a href={`${href}/exams/midterm`} class="text-sm text-base-content/60 hover:text-primary">← Midterm exam</a>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-3xl font-bold">Question {n}</h1>
      <span class="badge badge-outline">
        {n} of {totalOnExam}
      </span>
    </div>

    <progress class="progress progress-primary mt-4 w-full" value={n} max={totalOnExam}></progress>

    <Alert variant="info" class="mt-6">
      <span>Preview data — nothing here submits or saves yet.</span>
    </Alert>

    <fieldset class="fieldset mt-8 rounded-box border border-base-300 bg-base-100 p-5">
      <legend class="fieldset-legend px-2">{question.kind}</legend>
      <p class="mb-3 font-medium">
        {question.prompt}
        {"code" in question && <code class="ml-1 rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">{question.code}</code>}
      </p>

      {
        "options" in question ? (
          <div class="flex flex-col gap-2">
            {question.options.map((option) => (
              <label class="label cursor-pointer justify-start gap-3">
                <input type="radio" name={`q${n}`} class="radio radio-sm" />
                <span>{option}</span>
              </label>
            ))}
          </div>
        ) : (
          <textarea class="textarea w-full" rows={4} placeholder="Type your answer here..." />
        )
      }
    </fieldset>

    <div class="mt-8 flex items-center justify-between">
      <a href={`${href}/exams/midterm/${n - 1}`} class:list={["btn btn-ghost", n === 1 && "btn-disabled"]}>
        ← Previous
      </a>
      {
        isLast ? (
          <button type="button" class="btn btn-primary" disabled>
            Submit exam
          </button>
        ) : (
          <a href={`${href}/exams/midterm/${n + 1}`} class="btn btn-primary">
            Next →
          </a>
        )
      }
    </div>
  </main>
</AppLayout>
