---
import { hasPerm } from "@/auth/permissions";
import CourseHeader from "@/components/CourseHeader.astro";
import type { AnswerPayload } from "@/components/exam/answer-payload";
import ExamAttempt from "@/components/exam/ExamAttempt";
import ExamExceptions, {
	type ExceptionRow,
} from "@/components/exam/ExamExceptions";
import ExamQuestionsList from "@/components/exam/ExamQuestionsList";
import ReleaseGrades from "@/components/exam/ReleaseGrades";
import ExamResults from "@/components/grading/ExamResults.astro";
import QuestionStatsTable from "@/components/grading/QuestionStats.astro";
import ReleasedScore from "@/components/ReleasedScore.astro";
import type { ExamExceptionView, Question, QuestionPublic } from "@/db";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { examResult } from "@/services/exam-result";
import {
	attemptState,
	examPhase,
	examPhaseLabels,
	gradeReleaseBlocker,
	personalTiming,
	resultsReleased,
	windowEnd,
} from "@/services/exam-state";
import {
	type AttemptRow,
	attemptRows,
	type GradedStudent,
} from "@/services/grading";
import { type QuestionStats, questionStats } from "@/services/question-stats";
import { breadcrumbs } from "@/utils/breadcrumbs";
import {
	examBadge,
	examTypeLabels,
	formatDuration,
} from "@/utils/exam-display";
import { loadCourse } from "@/utils/load-course";
import { loadCourseExceptions } from "@/utils/load-exam-exceptions";
import { loadStudents } from "@/utils/load-grading";
import { renderMarkdown } from "@/utils/markdown";
import {
	durationToMinutes,
	formatDateTime,
	toDuration,
	toLocalDateTimeInput,
} from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment, slug } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canManage = hasPerm(actor, "enrollment.manage", course);

if (!slug) return Astro.rewrite("/404");
const exam = await db.exam.findOne({ course: course.id, slug }, { actor });
if (!exam) return Astro.rewrite("/404");

const now = new Date();
// The exceptions never reach the client: they only shift the student's own
// window and, for the instructor, what still blocks the release.
const exceptions =
	(await loadCourseExceptions(course.id)).get(slug) ?? new Map();
const ownException = canManage
	? null
	: (exceptions.get(actor.username) ?? null);
// What the viewer sees of the schedule: the student's own window, the exam's for the instructor.
const shown = personalTiming(exam, ownException);
const phase = examPhase(shown, now);

// Rendered like a resource note: PLAINTEXT/HTML text is shown as-is rather
// than interpreted, since neither is safe to trust with raw markup.
const descriptionHtml =
	exam.description && exam.format === "MARKDOWN"
		? renderMarkdown(exam.description)
		: null;
const preambleHtml =
	exam.preamble && exam.format === "MARKDOWN"
		? renderMarkdown(exam.preamble)
		: null;

// Each pinned question is fetched with the same `public` flag `canManage`
// already picks for the rest of the page — `ExamQuestion` never sees more
// of a question than the actor it renders for is allowed to. A slug that no
// longer resolves (an archived or otherwise inaccessible question) is
// dropped rather than shown blank.
const pinnedQuestions = (
	await Promise.all(
		exam.questions.map((question) =>
			canManage
				? db.question.findOne(
						{ course: course.id, slug: question.slug, public: false },
						{ actor },
					)
				: db.question.findOne(
						{ course: course.id, slug: question.slug, public: true },
						{ actor },
					),
		),
	)
)
	.filter(
		(question): question is Question | QuestionPublic => question !== null,
	)
	.map(({ id: _id, ...question }) => question);

// A student sees the exam through their own attempt: what they may do now,
// and, once they are in it, the questions with their latest saved answers.
// Practice exams open a new attempt per session, so the newest one counts.
const attempt = canManage
	? null
	: ((
			await db.response.findMany(
				{
					course: course.id,
					exam: slug,
					author: actor.username,
					practice: exam.type === "PRACTICE" ? undefined : false,
				},
				{ actor },
			)
		).at(-1) ?? null);
const state = attemptState(shown, attempt, now, {
	released: resultsReleased(exam, now, [...exceptions.values()]),
});
// The instructor has no attempt of their own, so the phase is all they see.
const badge = examBadge(phase, canManage ? undefined : state);

// One fetch serves both the release control and the results table.
let canRelease = false;
let releaseBlocker: ReturnType<typeof gradeReleaseBlocker> = null;
let students: GradedStudent[] = [];
let storedExceptions: ExamExceptionView[] = [];
let resultRows: AttemptRow[] = [];
let statsRows: QuestionStats[] = [];
const questionTitles = new Map<string, string>();
if (canManage && exam.type !== "PRACTICE") {
	const [attempts, feedback, loadedStudents, loadedExceptions] =
		await Promise.all([
			db.response.findMany(
				{ course: course.id, exam: slug, practice: false },
				{ actor },
			),
			db.feedback.findMany({ course: course.id, exam: slug }, { actor }),
			loadStudents(course.id, actor),
			db.examException.findMany({ course: course.id, exam: slug }, { actor }),
		]);
	students = loadedStudents;
	storedExceptions = loadedExceptions;
	const slugs = exam.questions.map((question) => question.slug);
	const results = attempts.map((entry) =>
		examResult(slugs, entry.submissions, feedback),
	);
	releaseBlocker = gradeReleaseBlocker(exam, results, now, [
		...exceptions.values(),
	]);
	canRelease = releaseBlocker === null;
	resultRows = attemptRows(
		exam,
		slugs,
		attempts,
		feedback,
		students,
		now,
		exceptions,
	);
	statsRows = questionStats(exam, slugs, attempts, feedback, now, exceptions);
	for (const pinned of pinnedQuestions) {
		if (pinned.question.title) {
			questionTitles.set(pinned.slug, pinned.question.title);
		}
	}
}

// The exceptions table, with the dialog's starting values and the personal window each one gives.
// A dropped student stays listed only while they hold an exception, so editing it still shows who it is for.
const exceptionStudents = students
	.filter(
		(student) =>
			!student.dropped ||
			storedExceptions.some((entry) => entry.username === student.username),
	)
	.map(({ username, name }) => ({ username, name }));
const exceptionRows: ExceptionRow[] = storedExceptions
	.map((exception) => {
		const personal = personalTiming(exam, exception);
		const end = windowEnd(personal);
		const extraMinutes = exception.extraTime
			? durationToMinutes(exception.extraTime)
			: 0;
		return {
			username: exception.username,
			name:
				students.find((entry) => entry.username === exception.username)?.name ??
				exception.username,
			extra:
				extraMinutes > 0
					? m.exams_exceptions_extra({ minutes: extraMinutes })
					: null,
			date: exception.scheduledAt
				? formatDateTime(exception.scheduledAt, { year: "numeric" })
				: null,
			window:
				personal.scheduledAt && end
					? `${formatDateTime(personal.scheduledAt, { year: "numeric" })} – ${formatDateTime(end, { year: "numeric" })}`
					: null,
			note: "note" in exception ? exception.note : null,
			extraMinutes: extraMinutes > 0 ? extraMinutes : null,
			scheduledLocal: exception.scheduledAt
				? toLocalDateTimeInput(exception.scheduledAt)
				: null,
		};
	})
	.sort((a, b) => a.name.localeCompare(b.name));

const pendingAnswers = resultRows.reduce((sum, row) => sum + row.pending, 0);

// The student's own extra time, which the exam's line shows next to its duration.
const personalExtra = ownException?.extraTime ?? null;

// One line under the title: what the exam is, when, and how long.
const meta = [
	examTypeLabels[exam.type],
	personalExtra
		? m.exams_detail_duration_personal({
				// The class's own extra time is part of the duration the student's extra comes on top of.
				duration: formatDuration(
					exam.duration && exam.extraTime
						? toDuration(
								durationToMinutes(exam.duration) +
									durationToMinutes(exam.extraTime),
							)
						: exam.duration,
				),
				extra: formatDuration(personalExtra),
			})
		: exam.extraTime
			? m.exams_detail_duration_extra({
					duration: formatDuration(exam.duration),
					extra: formatDuration(exam.extraTime),
				})
			: formatDuration(exam.duration),
	ownException?.scheduledAt
		? m.exams_detail_new_date({
				date: formatDateTime(ownException.scheduledAt),
			})
		: shown.scheduledAt
			? formatDateTime(shown.scheduledAt)
			: canManage
				? m.exams_not_scheduled()
				: null,
	canManage
		? m.exams_detail_question_count({ count: exam.questions.length })
		: null,
	exam.tags.length > 0 ? exam.tags.join(", ") : null,
	canManage
		? m.exams_detail_updated({ date: formatDateTime(exam.updatedAt) })
		: null,
].filter((part): part is string => part !== null);

// Feedback reaches a student only once released, and only on their own work;
// the service enforces both, this just asks for it when the results show.
const examOutcome =
	state.kind === "results" && attempt
		? examResult(
				exam.questions.map((question) => question.slug),
				attempt.submissions,
				await db.feedback.findMany(
					{ course: course.id, exam: slug, author: actor.username },
					{ actor },
				),
			)
		: undefined;

// Fetched with `public: true` above, so a student's copy never held an answer key.
const attemptQuestions = pinnedQuestions.map(({ slug, question }) => ({
	slug,
	question: question as QuestionPublic["question"],
}));
// Questions stay on the server until the student is in the attempt.
const showQuestions =
	state.kind === "in-progress" ||
	state.kind === "submitted" ||
	state.kind === "results";
const latestAnswers: Record<string, AnswerPayload> = {};
for (const submission of attempt?.submissions ?? []) {
	latestAnswers[submission.question] = submission.payload as AnswerPayload;
}
---

<AppLayout title={m.exams_detail_page_title({ title: exam.title })}
  trail={breadcrumbs(Astro.url, { course, item: exam.title })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="exams" />

    <a href={`${href}/exams`} class="text-sm text-base-content/60 hover:text-primary">{m.exams_detail_back()}</a>

    <div class="mt-2 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold">{exam.title}</h2>
        <p class="mt-1 text-sm text-base-content/60">{meta.join(" · ")}</p>
      </div>
      <span class:list={["badge badge-sm mt-1.5 shrink-0", badge.className]}>{badge.label}</span>
    </div>

    {
      exam.description && (
        <p class="mt-4 text-sm text-base-content/70">
          {descriptionHtml ? <span set:html={descriptionHtml} /> : exam.description}
        </p>
      )
    }

    {
      exam.preamble && (
        <section class="mt-6">
          <h2 class="text-lg font-semibold">{m.exams_detail_instructions()}</h2>
          <div class="mt-3 rounded-box border border-base-300 bg-base-100 p-6">
            {preambleHtml ? (
              <div class="prose prose-sm max-w-none" set:html={preambleHtml} />
            ) : (
              <p class="whitespace-pre-wrap text-sm">{exam.preamble}</p>
            )}
          </div>
        </section>
      )
    }

    {
      canManage && pendingAnswers > 0 && (
        <div
          role="status"
          class="mt-6 flex items-center justify-between gap-4 rounded-box border border-base-300 bg-base-200 p-4 text-sm"
        >
          <span>
            {m.exams_detail_pending_banner({
              phase: examPhaseLabels[phase],
              count: pendingAnswers,
            })}
          </span>
          <a href={`${href}/exams/${exam.slug}/grading`} class="btn btn-primary btn-sm">
            {m.exams_detail_grade_answers()}
          </a>
        </div>
      )
    }

    {
      canManage && releaseBlocker === "exception-open" && (
        <p role="status" class="mt-6 text-sm text-base-content/70">
          {m.errors_release_exception_open()}
        </p>
      )
    }

    {
      canManage && (exam.gradesReleasedAt || canRelease) && (
        <section class="mt-6">
          <ReleaseGrades
            client:load
            discipline={discipline!}
            course={courseSegment!}
            exam={slug}
            releasedAt={exam.gradesReleasedAt}
            canRelease={canRelease}
            now={now}
          />
        </section>
      )
    }

    {
      !canManage && examOutcome?.total != null && (
        <section class="mt-8">
          <ReleasedScore score={examOutcome.total} releasedAt={exam.gradesReleasedAt} />
        </section>
      )
    }

    {
      !canManage && (
        <section class="mt-8">
          <ExamAttempt
            client:load
            discipline={discipline!}
            course={courseSegment!}
            exam={slug}
            type={exam.type}
            state={state}
            now={now}
            questions={showQuestions ? attemptQuestions : []}
            answers={latestAnswers}
            result={examOutcome}
          />
        </section>
      )
    }

    {
      canManage && exam.type !== "PRACTICE" && (
        <ExamResults href={`${href}/exams/${exam.slug}`} rows={resultRows} />
      )
    }

    {
      canManage && exam.type !== "PRACTICE" && (
        <section id="exceptions" class="mt-8">
          <h2 class="text-lg font-semibold">{m.exams_exceptions_heading()}</h2>
          <div class="mt-3">
            <ExamExceptions
              client:load
              discipline={discipline!}
              course={courseSegment!}
              exam={slug}
              students={exceptionStudents}
              rows={exceptionRows}
            />
          </div>
        </section>
      )
    }

    {
      canManage && exam.type !== "PRACTICE" && (
        <QuestionStatsTable
          href={`${href}/exams/${exam.slug}`}
          stats={statsRows}
          titles={questionTitles}
        />
      )
    }

    {
      canManage && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold">{m.exams_detail_questions_heading()}</h2>
          {pinnedQuestions.length > 0 ? (
            <div class="mt-3">
              <ExamQuestionsList questions={pinnedQuestions} canManage={canManage} client:load />
            </div>
          ) : (
            <p class="mt-3 text-sm text-base-content/60">{m.exams_detail_no_questions()}</p>
          )}
        </section>
      )
    }
  </main>
</AppLayout>
