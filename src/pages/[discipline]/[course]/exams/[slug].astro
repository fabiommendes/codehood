---
import { hasPerm } from "@/auth/permissions";
import CourseHeader from "@/components/CourseHeader.astro";
import AnswerHistorySwitch from "@/components/exam/AnswerHistorySwitch";
import type { AnswerPayload } from "@/components/exam/answer-payload";
import { type CodeSends, sendsOf } from "@/components/exam/code-sends";
import ExamAttempt from "@/components/exam/ExamAttempt";
import ExamExceptions, {
	type ExceptionRow,
} from "@/components/exam/ExamExceptions";
import ExamPreview, {
	type PreviewQuestion,
} from "@/components/exam/ExamPreview";
import type { QuestionRegrade } from "@/components/exam/RegradeControls";
import ReleaseGrades from "@/components/exam/ReleaseGrades";
import ExamResults from "@/components/grading/ExamResults.astro";
import QuestionStatsTable from "@/components/grading/QuestionStats.astro";
import ReleasedScore from "@/components/ReleasedScore.astro";
import { EXAM_ANSWER_GRACE_MS, RUNNER_ORIGIN } from "@/core/constants";
import type { ExamExceptionView, Question, QuestionPublic } from "@/db";
import { db } from "@/db";
import { loadResultPolicy } from "@/db/result-policy";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { shufflePool } from "@/mdq/shuffle";
import { effectiveAnswerHistory } from "@/services/answer-history";
import { DEFAULT_CODE_PENALTY } from "@/services/code-grading";
import { effectiveCodeRun } from "@/services/code-run";
import { examResult } from "@/services/exam-result";
import {
	attemptOf,
	releaseBlocker as blockerOf,
	examPhase,
	examPhaseLabels,
	examSchedule,
	type GradeReleaseBlocker,
	timingFor,
	windowEnd,
} from "@/services/exam-state";
import {
	type AttemptRow,
	attemptRows,
	type GradedStudent,
} from "@/services/grading";
import { type QuestionStats, questionStats } from "@/services/question-stats";
import { regradeBlocker } from "@/services/regrade";
import { breadcrumbs } from "@/utils/breadcrumbs";
import {
	examBadge,
	examTypeLabels,
	formatDuration,
} from "@/utils/exam-display";
import { examNav } from "@/utils/exam-nav";
import { highlightExamples } from "@/utils/highlight-examples";
import { loadCourse } from "@/utils/load-course";
import { loadCourseExceptions } from "@/utils/load-exam-exceptions";
import { loadStudents } from "@/utils/load-grading";
import { loadReviews } from "@/utils/load-review";
import { renderMarkdown } from "@/utils/markdown";
import type { PretestSource } from "@/utils/pretest-sources";
import {
	durationToMinutes,
	formatDateTime,
	toDuration,
	toLocalDateTimeInput,
} from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment, slug } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canManage = hasPerm(actor, "enrollment.manage", course);

if (!slug) return Astro.rewrite("/404");
const exam = await db.exam.findOne({ course: course.id, slug }, { actor });
if (!exam) return Astro.rewrite("/404");

const now = new Date();
// The exceptions never reach the client: they only shift the student's own
// window and, for the instructor, what still blocks the release.
const exceptions =
	(await loadCourseExceptions(course.id)).get(slug) ?? new Map();
const schedule = examSchedule(exam, exceptions);
const viewer = canManage ? null : actor.username;
const ownException = viewer ? (exceptions.get(viewer) ?? null) : null;
// What the viewer sees of the schedule: the student's own window, the exam's for the instructor.
const shown = timingFor(schedule, viewer);
const phase = examPhase(shown, now);

// Rendered like a resource note: PLAINTEXT/HTML text is shown as-is rather
// than interpreted, since neither is safe to trust with raw markup.
const descriptionHtml =
	exam.description && exam.format === "MARKDOWN"
		? renderMarkdown(exam.description)
		: null;
const preambleHtml =
	exam.preamble && exam.format === "MARKDOWN"
		? renderMarkdown(exam.preamble)
		: null;

// Staff read the pinned questions with their answer keys, everyone their public
// form, both at the version the exam pins. A slug that no longer resolves is
// dropped rather than shown blank.
const staffQuestions = canManage
	? found(
			await Promise.all(
				exam.questions.map(({ slug, version }) =>
					db.question.findOne(
						{ course: course.id, slug, version, public: false },
						{ actor },
					),
				),
			),
		)
	: [];
const publicQuestions = found(
	await Promise.all(
		exam.questions.map(({ slug, version }) =>
			db.question.findOne(
				{ course: course.id, slug, version, public: true },
				{ actor },
			),
		),
	),
);
const studentQuestions = canManage ? [] : publicQuestions;

/// The questions that resolved, without their database ids.
function found<Q extends Question | QuestionPublic>(
	questions: (Q | null)[],
): Omit<Q, "id">[] {
	return questions
		.filter((question): question is Q => question !== null)
		.map(({ id: _id, ...question }) => question);
}

// A student sees the exam through their own attempt: what they may do now,
// and, once they are in it, the questions with their latest saved answers.
// Practice exams open a new attempt per session, so the newest one counts.
const attempt = canManage
	? null
	: ((
			await db.response.findMany(
				{
					course: course.id,
					exam: slug,
					author: actor.username,
					practice: exam.type === "PRACTICE" ? undefined : false,
				},
				{ actor },
			)
		).at(-1) ?? null);
const state = attemptOf(schedule, viewer, attempt, now);
// The instructor has no attempt of their own, so the phase is all they see.
const badge = examBadge(phase, canManage ? undefined : state);

// One fetch serves both the release control and the results table.
let canRelease = false;
let releaseBlocker: GradeReleaseBlocker | null = null;
let students: GradedStudent[] = [];
let storedExceptions: ExamExceptionView[] = [];
let resultRows: AttemptRow[] = [];
let statsRows: QuestionStats[] = [];
const questionTitles = new Map<string, string>();
if (canManage && exam.type !== "PRACTICE") {
	const [attempts, feedback, loadedStudents, loadedExceptions] =
		await Promise.all([
			db.response.findMany(
				{ course: course.id, exam: slug, practice: false },
				{ actor },
			),
			db.feedback.findMany({ course: course.id, exam: slug }, { actor }),
			loadStudents(course.id, actor),
			db.examException.findMany({ course: course.id, exam: slug }, { actor }),
		]);
	students = loadedStudents;
	storedExceptions = loadedExceptions;
	const slugs = exam.questions.map((question) => question.slug);
	const policy = (await loadResultPolicy(course.id))(exam);
	const results = attempts.map((entry) =>
		examResult(slugs, entry.submissions, feedback, policy),
	);
	releaseBlocker = blockerOf(schedule, results, now);
	canRelease = releaseBlocker === null;
	resultRows = attemptRows(
		exam,
		slugs,
		attempts,
		feedback,
		students,
		now,
		exceptions,
		policy,
	);
	statsRows = questionStats(
		exam,
		slugs,
		attempts,
		feedback,
		now,
		exceptions,
		policy,
	);
	for (const pinned of staffQuestions) {
		if (pinned.question.title) {
			questionTitles.set(pinned.slug, pinned.question.title);
		}
	}
}

// The exceptions table, with the dialog's starting values and the personal window each one gives.
// A dropped student stays listed only while they hold an exception, so editing it still shows who it is for.
const exceptionStudents = students
	.filter(
		(student) =>
			!student.dropped ||
			storedExceptions.some((entry) => entry.username === student.username),
	)
	.map(({ username, name }) => ({ username, name }));
const exceptionRows: ExceptionRow[] = storedExceptions
	.map((exception) => {
		const personal = timingFor(schedule, exception.username);
		const end = windowEnd(personal);
		const extraMinutes = exception.extraTime
			? durationToMinutes(exception.extraTime)
			: 0;
		return {
			username: exception.username,
			name:
				students.find((entry) => entry.username === exception.username)?.name ??
				exception.username,
			extra:
				extraMinutes > 0
					? m.exams_exceptions_extra({ minutes: extraMinutes })
					: null,
			date: exception.scheduledAt
				? formatDateTime(exception.scheduledAt, { year: "numeric" })
				: null,
			window:
				personal.scheduledAt && end
					? `${formatDateTime(personal.scheduledAt, { year: "numeric" })} – ${formatDateTime(end, { year: "numeric" })}`
					: null,
			note: "note" in exception ? exception.note : null,
			extraMinutes: extraMinutes > 0 ? extraMinutes : null,
			scheduledLocal: exception.scheduledAt
				? toLocalDateTimeInput(exception.scheduledAt)
				: null,
		};
	})
	.sort((a, b) => a.name.localeCompare(b.name));

const pendingAnswers = resultRows.reduce((sum, row) => sum + row.pending, 0);

// The student's own extra time, which the exam's line shows next to its duration.
const personalExtra = ownException?.extraTime ?? null;

const codeRun = effectiveCodeRun(exam);
const codeRunLabel =
	codeRun.source === "exam"
		? codeRun.allowed
			? m.exams_detail_code_run_on_exam()
			: m.exams_detail_code_run_off_exam()
		: codeRun.allowed
			? m.exams_detail_code_run_on_default({ type: exam.type })
			: m.exams_detail_code_run_off_default({ type: exam.type });

// One line under the title: what the exam is, when, and how long.
const meta = [
	examTypeLabels[exam.type],
	personalExtra
		? m.exams_detail_duration_personal({
				// The class's own extra time is part of the duration the student's extra comes on top of.
				duration: formatDuration(
					exam.duration && exam.extraTime
						? toDuration(
								durationToMinutes(exam.duration) +
									durationToMinutes(exam.extraTime),
							)
						: exam.duration,
				),
				extra: formatDuration(personalExtra),
			})
		: exam.extraTime
			? m.exams_detail_duration_extra({
					duration: formatDuration(exam.duration),
					extra: formatDuration(exam.extraTime),
				})
			: formatDuration(exam.duration),
	ownException?.scheduledAt
		? m.exams_detail_new_date({
				date: formatDateTime(ownException.scheduledAt),
			})
		: shown.scheduledAt
			? formatDateTime(shown.scheduledAt)
			: canManage
				? m.exams_not_scheduled()
				: null,
	canManage
		? m.exams_detail_question_count({ count: exam.questions.length })
		: null,
	exam.tags.length > 0 ? exam.tags.join(", ") : null,
	canManage
		? m.exams_detail_updated({ date: formatDateTime(exam.updatedAt) })
		: null,
].filter((part): part is string => part !== null);

// Feedback reaches a student only once released, and only on their own work;
// the service enforces both, this just asks for it when the results show.
const examOutcome =
	state.kind === "results" && attempt
		? examResult(
				exam.questions.map((question) => question.slug),
				attempt.submissions,
				await db.feedback.findMany(
					{ course: course.id, exam: slug, author: actor.username },
					{ actor },
				),
				(await loadResultPolicy(course.id))(exam),
			)
		: undefined;

// The marks and feedback of each answer, now that the student may see them.
const reviews =
	examOutcome && attempt
		? await loadReviews(
				course.id,
				exam.questions,
				examOutcome,
				attempt.submissions,
			)
		: undefined;

// What the student may do about each answer's grade, decided by the same rule the service enforces.
const requests =
	examOutcome && attempt
		? await db.regradeRequest.findMany(
				{ course: course.id, exam: slug, author: actor.username },
				{ actor },
			)
		: [];
const questionRegrades: Record<string, QuestionRegrade> = {};
for (const outcome of examOutcome?.questions ?? []) {
	if (!outcome.submission || !attempt) continue;
	const request =
		requests.find((entry) => entry.submission === outcome.submission) ?? null;
	questionRegrades[outcome.question] = {
		submission: outcome.submission,
		canRequest:
			regradeBlocker(
				{
					schedule,
					author: actor.username,
					attempt,
					outcome,
					submission: outcome.submission,
					requested: request !== null,
				},
				now,
			) === null,
		request: request && {
			publicId: request.publicId,
			status: request.status,
			message: request.message,
			reply: request.reply,
		},
	};
}

// Regrade requests the instructor has yet to answer.
const openRegrades =
	canManage && exam.type !== "PRACTICE"
		? (
				await db.regradeRequest.findMany(
					{ course: course.id, exam: slug, status: "OPEN" },
					{ actor },
				)
			).length
		: 0;

const attemptQuestions = studentQuestions.map(({ slug, question }) => ({
	slug,
	question: shufflePool(
		question,
		`${attempt?.publicId ?? actor.username}:${slug}`,
	),
}));
// Questions stay on the server until the student is in the attempt.
const showQuestions =
	state.kind === "in-progress" ||
	state.kind === "submitted" ||
	state.kind === "results";
// The pretest sources of each code question, only while the student can answer.
const pretests: Record<string, PretestSource[]> = {};
const exampleHtml: Record<string, string[]> = {};
// The sends of each code question that goes to a worker, by question slug, while answering and in the review.
const codeSends: Record<string, CodeSends> = {};
const codePenalties =
	(await loadResultPolicy(course.id))(exam).codePenalty ?? {};
const answering = state.kind === "in-progress";
if (answering || (state.kind === "results" && attempt)) {
	await Promise.all(
		studentQuestions.map(async ({ slug, version, question }) => {
			if (question.type !== "code") return;
			const context = await db.question.codeAnswer(
				{ course: course.id, slug, version },
				{ actor },
			);
			if (answering) {
				pretests[slug] = context.pretests;
				exampleHtml[slug] = await highlightExamples(question);
			}
			if (!context.sendable || !attempt) return;
			const sent = await db.gradingJob.forStudent(
				{ response: attempt.publicId, question: slug },
				{ actor },
			);
			codeSends[slug] = sendsOf(
				sent,
				codePenalties[slug] ?? DEFAULT_CODE_PENALTY,
			);
		}),
	);
}
// The preview shuffles like an attempt does, with a seed of its own.
const previewQuestions: PreviewQuestion[] = staffQuestions.flatMap((staff) => {
	const shown = publicQuestions.find((entry) => entry.slug === staff.slug);
	return shown
		? [
				{
					slug: staff.slug,
					question: shufflePool(shown.question, `preview:${staff.slug}`),
					key: staff.question,
				},
			]
		: [];
});
const previewPretests: Record<string, PretestSource[]> = {};
const previewExampleHtml: Record<string, string[]> = {};
await Promise.all(
	staffQuestions.map(async ({ slug, version }) => {
		const shown = previewQuestions.find((entry) => entry.slug === slug);
		if (shown?.question.type !== "code") return;
		previewPretests[slug] = (
			await db.question.codeAnswer(
				{ course: course.id, slug, version },
				{ actor },
			)
		).pretests;
		previewExampleHtml[slug] = await highlightExamples(shown.question);
	}),
);

const latestAnswers: Record<string, AnswerPayload> = {};
const answeredAt: Record<string, string> = {};
for (const submission of attempt?.submissions ?? []) {
	latestAnswers[submission.question] = submission.payload as AnswerPayload;
	answeredAt[submission.question] = submission.createdAt.toISOString();
}
---

<AppLayout title={m.exams_detail_page_title({ title: exam.title })}
  trail={breadcrumbs(Astro.url, { course, item: exam.title })}
  nav={examNav({
    href: `${href}/exams/${exam.slug}`,
    title: exam.title,
    manage: canManage,
    practice: exam.type === "PRACTICE",
    pending: canManage ? pendingAnswers : undefined,
    regrades: canManage ? openRegrades : undefined,
    sections: [
      ...(exam.preamble ? [{ id: "instructions", label: m.exams_detail_instructions() }] : []),
      ...(canManage && exam.type !== "PRACTICE" ? [{ id: "exceptions", label: m.exams_exceptions_heading() }] : []),
      { id: "questions", label: m.exams_detail_questions_heading() },
    ],
  })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="exams" />

    <div class="mt-2 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold">{exam.title}</h2>
        <p class="mt-1 text-sm text-muted">{meta.join(" · ")}</p>
        <p class="mt-1 text-sm text-muted" data-testid="code-run-setting">{codeRunLabel}</p>
      </div>
      <span class:list={["badge badge-sm mt-1.5 shrink-0", badge.className]}>{badge.label}</span>
    </div>

    {
      exam.description && (
        <div class="mt-4 text-sm text-base-content/70">
          {descriptionHtml ? <Fragment set:html={descriptionHtml} /> : <p>{exam.description}</p>}
        </div>
      )
    }

    {
      exam.preamble && (
        <section id="instructions" class="mt-6 scroll-mt-20">
          <h2 class="text-lg font-semibold">{m.exams_detail_instructions()}</h2>
          <div class="mt-3 rounded-box border border-base-300 bg-base-100 p-6">
            {preambleHtml ? (
              <div class="prose prose-sm max-w-none" set:html={preambleHtml} />
            ) : (
              <p class="whitespace-pre-wrap text-sm">{exam.preamble}</p>
            )}
          </div>
        </section>
      )
    }

    {
      canManage && pendingAnswers > 0 && (
        <div
          role="status"
          class="mt-6 flex items-center justify-between gap-4 rounded-box border border-base-300 bg-base-200 p-4 text-sm"
        >
          <span>
            {m.exams_detail_pending_banner({
              phase: examPhaseLabels[phase],
              count: pendingAnswers,
            })}
          </span>
          <a href={`${href}/exams/${exam.slug}/grading`} class="btn btn-primary btn-sm">
            {m.exams_detail_grade_answers()}
          </a>
        </div>
      )
    }

    {
      canManage && openRegrades > 0 && (
        <p role="status" class="mt-6 rounded-box border border-base-300 bg-base-200 p-4 text-sm">
          <a href={`${href}/exams/${exam.slug}/regrades`} class="link font-medium">
            {m.grades_regrade_banner({ count: openRegrades })}
          </a>
        </p>
      )
    }

    {
      canManage && releaseBlocker === "exception-open" && (
        <p role="status" class="mt-6 text-sm text-base-content/70">
          {m.errors_release_exception_open()}
        </p>
      )
    }

    {
      canManage && (
        <section class="mt-6">
          <AnswerHistorySwitch
            client:load
            discipline={discipline!}
            course={courseSegment!}
            exam={slug}
            enabled={effectiveAnswerHistory(exam)}
          />
        </section>
      )
    }

    {
      canManage && (exam.gradesReleasedAt || canRelease) && (
        <section class="mt-6">
          <ReleaseGrades
            client:load
            discipline={discipline!}
            course={courseSegment!}
            exam={slug}
            releasedAt={exam.gradesReleasedAt}
            canRelease={canRelease}
            now={now}
          />
        </section>
      )
    }

    {
      !canManage && examOutcome?.total != null && (
        <section class="mt-8">
          <ReleasedScore score={examOutcome.total} releasedAt={exam.gradesReleasedAt} />
        </section>
      )
    }

    {
      !canManage && (
        <section id="questions" class="mt-8 scroll-mt-20">
          <ExamAttempt
            client:load
            discipline={discipline!}
            course={courseSegment!}
            exam={slug}
            type={exam.type}
            state={state}
            now={now}
            questions={showQuestions ? attemptQuestions : []}
            answers={latestAnswers}
            result={examOutcome}
            reviews={reviews}
            regrades={questionRegrades}
            codeRun={codeRun.allowed}
            runnerOrigin={RUNNER_ORIGIN}
            pretests={pretests}
            exampleHtml={exampleHtml}
            codeSends={codeSends}
            username={actor.username}
            answeredAt={answeredAt}
            graceMs={EXAM_ANSWER_GRACE_MS}
            attempt={attempt?.publicId}
            answerHistory={effectiveAnswerHistory(exam)}
          />
        </section>
      )
    }

    {
      canManage && exam.type !== "PRACTICE" && (
        <ExamResults href={`${href}/exams/${exam.slug}`} rows={resultRows} />
      )
    }

    {
      canManage && exam.type !== "PRACTICE" && (
        <section id="exceptions" class="mt-8 scroll-mt-20">
          <h2 class="text-lg font-semibold">{m.exams_exceptions_heading()}</h2>
          <div class="mt-3">
            <ExamExceptions
              client:load
              discipline={discipline!}
              course={courseSegment!}
              exam={slug}
              students={exceptionStudents}
              rows={exceptionRows}
            />
          </div>
        </section>
      )
    }

    {
      canManage && exam.type !== "PRACTICE" && (
        <QuestionStatsTable
          href={`${href}/exams/${exam.slug}`}
          stats={statsRows}
          titles={questionTitles}
        />
      )
    }

    {
      canManage && (
        <section id="questions" class="mt-8 scroll-mt-20">
          <h2 class="text-lg font-semibold">{m.exams_detail_questions_heading()}</h2>
          {previewQuestions.length > 0 ? (
            <div class="mt-3">
              <ExamPreview
                client:load
                questions={previewQuestions}
                pretests={previewPretests}
                exampleHtml={previewExampleHtml}
                codeRun={codeRun.allowed}
                runnerOrigin={RUNNER_ORIGIN}
              />
            </div>
          ) : (
            <p class="mt-3 text-sm text-muted">{m.exams_detail_no_questions()}</p>
          )}
        </section>
      )
    }
  </main>
</AppLayout>
