---
import CourseHeader from "@/components/CourseHeader.astro";
import CsvDownload from "@/components/CsvDownload.astro";
import GradesTable from "@/components/grading/GradesTable.astro";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { loadCourse } from "@/utils/load-course";
import { loadGrades } from "@/utils/load-grading";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment, {
	manage: true,
});
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: loadCourse({ manage: true }) already required Astro.locals.user.
const actor = Astro.locals.actor!;
const { table, pushed, csvRows } = await loadGrades(
	course.id,
	actor,
	new Date(),
);
const report = await db.rollCall.courseAttendance(course.id, { actor });
const attendance =
	report.events.length > 0
		? new Map(report.students.map((s) => [s.username, s]))
		: undefined;
// The file lists students the table leaves out, so it can have rows when the table has none.
const hasGrades =
	(table.columns.length > 0 || pushed.columns.length > 0) && csvRows.length > 1;
const csvFilename = `grades-${course.discipline.slug}-${course.edition.slug}.csv`;
---

<AppLayout title={m.grades_page_title({ discipline: course.discipline.name })}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="grades" />

    <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-2xl font-bold">{m.grades_page_heading()}</h2>
      {
        hasGrades && (
          <CsvDownload id="grades-csv" filename={csvFilename} rows={csvRows} />
        )
      }
    </div>

    {
      table.columns.length === 0 && pushed.columns.length === 0 ? (
        <p class="mt-4 text-base-content/60">{m.grades_page_no_exams()}</p>
      ) : table.rows.length === 0 ? (
        <div class="mt-4">
          <p class="text-base-content/60">{m.grades_page_no_students()}</p>
          <a href={`${href}/roster`} class="link mt-2 inline-block">{m.grades_page_students_link()}</a>
        </div>
      ) : (
        <GradesTable href={href} table={table} pushed={pushed} attendance={attendance} />
      )
    }
  </main>
</AppLayout>
