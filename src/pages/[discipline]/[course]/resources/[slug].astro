---
import CourseHeader from "@/components/CourseHeader.astro";
import Badge from "@/components/ui/Badge";
import { db } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { highlightCode } from "@/utils/highlight-code";
import { loadCourse } from "@/utils/load-course";
import { renderMarkdownBody } from "@/utils/markdown";

export const prerender = false;

const { discipline, course: courseSegment, slug } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;

if (!slug) {
	return Astro.rewrite("/404");
}

const resource = await db.resource.findOne(
	{ course: course.id, slug },
	{ actor },
);
if (!resource) {
	return Astro.rewrite("/404");
}
// LINK and FILE resources have no page of their own: the address sends the
// reader to the link or the download, so a lesson can link it by a stable URL.
if (resource.data.type === "FILE") {
	return Astro.redirect(resource.data.link, 302);
}
if (resource.data.type === "LINK") {
	return Astro.redirect(resource.data.url, 302);
}
const data = resource.data;

// The CODE branch never interprets its text, only highlights it.
const bodyHtml =
	data.type === "MD"
		? renderMarkdownBody(data.content)
		: await highlightCode(data.content, data.language);
---

<AppLayout title={`${resource.title} · ${course.discipline.name}`}
  trail={breadcrumbs(Astro.url, { course, item: resource.title })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader
      course={course}
      active={resource.event ? "schedule" : "resources"}
    />

    <a
      href={resource.event
        ? `${href}/schedule#event-${resource.event.id}`
        : `${href}/resources`}
      class="text-sm text-base-content/60 hover:text-primary"
      >{resource.event ? "← Schedule" : "← Resources"}</a
    >

    <div class="mt-2 flex flex-wrap items-center gap-2">
      <h2 class="text-xl font-semibold">{resource.title}</h2>
      {
        data.type === "CODE" && (
          <Badge size="sm" style="outline">
            {data.language}
          </Badge>
        )
      }
    </div>
    {
      resource.description && (
        <p class="mt-1 text-sm text-base-content/60">{resource.description}</p>
      )
    }

    {
      data.type === "MD" ? (
        <div class="card card-border mt-6 bg-base-200">
          <div class="card-body">
            <div
              class="prose prose-sm max-w-none prose-a:text-primary prose-a:no-underline hover:prose-a:underline [&>:first-child]:mt-0 [&>:last-child]:mb-0"
              set:html={bodyHtml}
            />
          </div>
        </div>
      ) : (
        <div
          class="mockup-code mt-6 overflow-x-auto bg-base-200 text-sm text-base-content [&_.shiki]:!bg-transparent [&_.shiki_span]:!bg-transparent"
          set:html={bodyHtml}
        />
      )
    }
  </main>
</AppLayout>
