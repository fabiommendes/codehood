---
import { hasPerm } from "@/auth/permissions";
import CliSetupLink from "@/components/CliSetupLink.astro";
import CourseHeader from "@/components/CourseHeader.astro";
import Alert from "@/components/ui/Alert";
import { db } from "@/db";
import { escapeHtml, m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { loadCourse } from "@/utils/load-course";
import { formatDateTime } from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canWrite = hasPerm(actor, "course.update-contents", course);

const repositories = await db.repository.findMany(
	{ course: course.id },
	{ actor },
);

/// Inline code markup, for the messages that quote a folder or a command.
function code(text: string): string {
	return `<code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">${escapeHtml(text)}</code>`;
}
---

<AppLayout
  title={m.repositories_page_title({ discipline: course.discipline.name })}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="repositories" />

    {repositories.length === 0 && (
      <Alert variant="info" class="mt-4">
        {canWrite ? (
          <span>
            <span set:html={m.repositories_empty_instructor({
              folder: code("repositories/"),
              command: code("ch push"),
            })} />{" "}
            <CliSetupLink />
          </span>
        ) : (
          <span>{m.repositories_empty_student()}</span>
        )}
      </Alert>
    )}

    <ul class="mt-8 flex flex-col gap-3">
      {repositories.map((repository) => (
        <li class="card border border-base-content/15 bg-base-200/50">
          <div class="card-body gap-1 p-4">
            <a href={`${href}/repositories/${repository.slug}`} class="link link-hover font-medium">{repository.title}</a>
            {repository.head ? (
              <p class="text-sm text-base-content/60">
                {repository.message}
                {repository.committedAt && <> · {formatDateTime(repository.committedAt)}</>}
              </p>
            ) : (
              <p class="text-sm text-base-content/60">{m.repositories_pending()}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </main>
</AppLayout>
