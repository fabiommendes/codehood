---
// The course's own term calendar (FR-CAL-020), grouped by week.
// Read-only: schedule data comes from `codehood push`, `manage import-calendar`
// and the demo seed. Each event carries an `event-<id>` anchor for links from
// the course home and the calendar.
import { hasPerm } from "@/auth/permissions";
import CliSetupLink from "@/components/CliSetupLink.astro";
import CourseHeader from "@/components/CourseHeader.astro";
import Alert from "@/components/ui/Alert";
import { type CalendarEvent, db, isMeeting } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { eventKindLabel } from "@/utils/calendar-event-display";
import { loadCourse } from "@/utils/load-course";
import { renderMarkdown } from "@/utils/markdown";
import {
	durationToMinutes,
	endOf,
	formatClock,
	formatDateTime,
	formatTime,
	SERVER_TZ,
	toMinutes,
} from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canWrite = hasPerm(actor, "course.update-contents", course);

const WEEKDAY_LABEL: Record<string, string> = {
	SUNDAY: "Sun",
	MONDAY: "Mon",
	TUESDAY: "Tue",
	WEDNESDAY: "Wed",
	THURSDAY: "Thu",
	FRIDAY: "Fri",
	SATURDAY: "Sat",
};

const slots = await db.timeSlot.findMany({ course: course.id }, { actor });

const events = await db.calendarEvent.findMany(
	{ courseIds: [course.id] },
	{ actor },
);

const weeks = new Map<number, CalendarEvent[]>();
for (const event of events) {
	weeks.set(event.week, [...(weeks.get(event.week) ?? []), event]);
}
const orderedWeeks = [...weeks.entries()].sort(([a], [b]) => a - b);

const timeFmt = new Intl.DateTimeFormat("en-US", {
	timeZone: SERVER_TZ,
	hour: "2-digit",
	minute: "2-digit",
	hourCycle: "h23",
});
function timeRange(event: CalendarEvent): string {
	const start = timeFmt.format(event.startAt);
	const end = timeFmt.format(
		endOf(event.startAt, durationToMinutes(event.timeSlot.duration)),
	);
	return `${start}–${end}`;
}

/// An event's day of the month, e.g. "Jan 5".
function dayOfMonth(event: CalendarEvent): string {
	return formatDateTime(event.startAt, {
		weekday: undefined,
		hour: undefined,
		minute: undefined,
	});
}

const now = new Date();
const meetingsHeld = events.filter(
	(e) => isMeeting(e.kind) && e.kind !== "CANCELLED" && e.startAt <= now,
).length;
---

<AppLayout title={`Schedule · ${course.discipline.name}`}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="schedule" />

    {
      slots.length === 0 ? (
        <Alert variant="info" class="mt-6">
          <span>
            {canWrite ? (
              <>
                No schedule pushed yet. <CliSetupLink />
              </>
            ) : (
              "No schedule published yet. The instructor pushes it with the CLI."
            )}
          </span>
        </Alert>
      ) : (
        <>
          <div class="mt-6 flex flex-wrap gap-2">
            {slots.map((slot) => (
              <span class="badge badge-outline gap-1.5">
                {slot.title ?? "Meeting"} · {WEEKDAY_LABEL[slot.day]}{" "}
                {formatClock(slot.start)}–
                {formatTime(toMinutes(slot.start) + durationToMinutes(slot.duration))}
              </span>
            ))}
          </div>
          <p class="mt-3 text-xs text-base-content/50">
            {meetingsHeld} {meetingsHeld === 1 ? "meeting" : "meetings"} held so far.
          </p>

          {events.length === 0 ? (
            <p class="mt-8 text-sm text-base-content/60">
              No events on the calendar yet.
            </p>
          ) : (
            <div class="mt-6 flex flex-col gap-8">
              {orderedWeeks.map(([week, weekEvents]) => (
                <div>
                  <h3 class="text-sm font-semibold tracking-wide text-base-content/50 uppercase">
                    Week {week}
                  </h3>
                  <div class="mt-3 flex flex-col gap-3">
                    {weekEvents.map((event) => {
                      const meeting = isMeeting(event.kind);
                      const cancelled = event.kind === "CANCELLED";
                      const dayLabel = WEEKDAY_LABEL[event.timeSlot.day] ?? "";
                      return (
                        <div
                          id={`event-${event.id}`}
                          class:list={[
                            "card card-border scroll-mt-6 bg-base-100 target:ring-2 target:ring-primary",
                            !meeting && "opacity-60",
                          ]}
                        >
                          <div class="card-body flex-row gap-4 py-4">
                            <div class="flex w-20 shrink-0 flex-col items-center gap-0.5 rounded-field border border-base-300 py-1.5 text-center">
                              <span class="text-[11px] font-medium text-base-content/50">
                                {dayLabel}
                              </span>
                              <span class="font-display text-sm leading-none font-semibold">
                                {dayOfMonth(event)}
                              </span>
                              <span class="text-[11px] text-base-content/60">
                                {timeRange(event)}
                              </span>
                            </div>
                            <div class="min-w-0 flex-1">
                              <div class="flex flex-wrap items-center gap-2">
                                <p
                                  class:list={[
                                    "font-medium",
                                    cancelled && "line-through",
                                  ]}
                                >
                                  {event.title}
                                </p>
                                {eventKindLabel(event.kind) && (
                                  <span
                                    class:list={[
                                      "badge badge-sm",
                                      meeting ? "badge-outline" : "badge-ghost",
                                    ]}
                                  >
                                    {eventKindLabel(event.kind)}
                                  </span>
                                )}
                              </div>
                              {event.description && (
                                <div
                                  class="prose prose-sm mt-1 max-w-none text-base-content/70 prose-a:text-primary prose-a:no-underline hover:prose-a:underline"
                                  set:html={renderMarkdown(event.description)}
                                />
                              )}
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          )}
        </>
      )
    }
  </main>
</AppLayout>
