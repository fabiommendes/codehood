---
// The course's own term calendar (FR-CAL-020): its meetings and dated exams,
// grouped by week, with the weeks already over folded away. Read-only:
// schedule data comes from `codehood push`, `manage import-calendar` and the
// demo seed.
import { hasPerm } from "@/auth/permissions";
import CliSetupLink from "@/components/CliSetupLink.astro";
import CourseHeader from "@/components/CourseHeader.astro";
import ScheduleWeek from "@/components/schedule/ScheduleWeek.astro";
import Alert from "@/components/ui/Alert";
import { db, isMeeting } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import { calendarEntries } from "@/services/calendar-entries";
import { courseSchedule } from "@/services/course-schedule";
import { splitByEvent } from "@/services/event-resources";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { loadCourse } from "@/utils/load-course";
import {
	durationToMinutes,
	formatClock,
	formatTime,
	toMinutes,
} from "@/utils/schedule-time";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canWrite = hasPerm(actor, "course.update-contents", course);

const WEEKDAY_LABEL: Record<string, string> = {
	SUNDAY: "Sun",
	MONDAY: "Mon",
	TUESDAY: "Tue",
	WEDNESDAY: "Wed",
	THURSDAY: "Thu",
	FRIDAY: "Fri",
	SATURDAY: "Sat",
};

const now = new Date();
const slots = await db.timeSlot.findMany({ course: course.id }, { actor });
const events = await db.calendarEvent.findMany(
	{ courseIds: [course.id] },
	{ actor },
);
// The exam service already keeps drafts from students.
const exams = await db.exam.findMany({ course: course.id }, { actor });
const { byEvent: eventResources } = splitByEvent(
	await db.resource.findMany({ course: course.id }, { actor }),
);
const entries = calendarEntries(
	events,
	exams.map((exam) => ({ courseId: course.id, exam })),
);
const { past, ahead, next } = courseSchedule(entries, course.startAt, now);
// Folding every week away would leave an empty page once the term is over.
const foldPast = past.length > 0 && ahead.length > 0;

// One query for the whole page. Whoever manages the course sees which
// meetings have a roll call; a student sees their own result on the past ones.
const rollCalls = await db.rollCall.findMany({ course: course.id }, { actor });
const rollCallKeys = new Set(rollCalls.map((r) => `${r.week}/${r.timeSlot}`));
const attendance = new Map<string, "present" | "absent">();
if (!canWrite && rollCallKeys.size > 0) {
	const report = await db.rollCall.courseAttendance(course.id, { actor });
	for (const [key, cell] of Object.entries(report.students[0]?.cells ?? {})) {
		if (cell === "present" || cell === "absent") attendance.set(key, cell);
	}
}
const rollCallManager = canWrite
	? {
			discipline: course.discipline.slug,
			course: `${course.instructor.username}_${course.edition.slug}`,
		}
	: undefined;

const meetingsHeld = events.filter(
	(e) => isMeeting(e.kind) && e.kind !== "CANCELLED" && e.startAt <= now,
).length;

/// "Weeks 1–4", or "Week 1" for a single one.
function weekSpan(weeks: { week: number }[]): string {
	const first = weeks[0]?.week;
	const last = weeks.at(-1)?.week;
	return first === last ? `Week ${first}` : `Weeks ${first}–${last}`;
}
---

<AppLayout title={`Schedule · ${course.discipline.name}`}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="schedule" />

    {
      slots.length === 0 ? (
        <Alert variant="info" class="mt-6">
          <span>
            {canWrite ? (
              <>
                No schedule pushed yet. <CliSetupLink />
              </>
            ) : (
              "No schedule published yet. The instructor pushes it with the CLI."
            )}
          </span>
        </Alert>
      ) : (
        <>
          <p class="mt-6 text-sm text-base-content/70">
            {slots
              .map(
                (slot) =>
                  `${slot.title ?? "Meeting"} · ${WEEKDAY_LABEL[slot.day]} ${formatClock(slot.start)}–${formatTime(toMinutes(slot.start) + durationToMinutes(slot.duration))}`,
              )
              .join(", ")}
          </p>
          <p class="mt-1 text-xs text-base-content/50">
            {meetingsHeld} {meetingsHeld === 1 ? "meeting" : "meetings"} held so far.
          </p>

          {entries.length === 0 ? (
            <p class="mt-8 text-sm text-base-content/60">
              No events on the calendar yet.
            </p>
          ) : (
            <div class="mt-8 flex flex-col gap-8">
              {foldPast && (
                <details id="past-weeks">
                  <summary class="cursor-pointer text-sm font-medium text-base-content/60 hover:text-base-content">
                    {weekSpan(past)}, already held
                  </summary>
                  <div class="mt-6 flex flex-col gap-8">
                    {past.map(({ week, entries }) => (
                      <ScheduleWeek
                        week={week}
                        entries={entries}
                        next={next}
                        href={href}
                        resources={eventResources}
                        rollCallManager={rollCallManager}
                        rollCallKeys={rollCallKeys}
                        attendance={attendance}
                      />
                    ))}
                  </div>
                </details>
              )}
              {(foldPast ? ahead : [...past, ...ahead]).map(({ week, entries }) => (
                <ScheduleWeek
                        week={week}
                        entries={entries}
                        next={next}
                        href={href}
                        resources={eventResources}
                        rollCallManager={rollCallManager}
                        rollCallKeys={rollCallKeys}
                        attendance={attendance}
                      />
              ))}
            </div>
          )}
        </>
      )
    }
  </main>
</AppLayout>

<script>
  // A link to a meeting in a past week has to unfold the weeks first.
  function revealTarget() {
    const id = decodeURIComponent(window.location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    const folded = target?.closest("details");
    if (target && folded && !folded.open) {
      folded.open = true;
      target.scrollIntoView();
    }
  }
  revealTarget();
  window.addEventListener("hashchange", revealTarget);
</script>
