---
// A course's roll call attendance. The service scopes the report: the
// instructor sees every student, a student only their own row. No tab links
// here (see src/urls/README.md); it is reached from Grades and the course home.
import AttendanceTable from "@/components/attendance/AttendanceTable.astro";
import CourseHeader from "@/components/CourseHeader.astro";
import CsvDownload from "@/components/CsvDownload.astro";
import { db } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import { attendanceCsvRows } from "@/services/attendance-table";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const report = await db.rollCall.courseAttendance(course.id, { actor });
const csvFilename = `attendance-${course.discipline.slug}-${course.edition.slug}.csv`;
---

<AppLayout title={`Attendance · ${course.discipline.name}`}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} />

    <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-2xl font-bold">Attendance</h2>
      {
        report.events.length > 0 && report.students.length > 0 && (
          <CsvDownload
            id="attendance-csv"
            filename={csvFilename}
            rows={attendanceCsvRows(report)}
          />
        )
      }
    </div>

    {
      report.events.length === 0 ? (
        <p class="mt-4 text-base-content/60">No roll calls yet.</p>
      ) : report.students.length === 0 ? (
        <p class="mt-4 text-base-content/60">No students enrolled yet.</p>
      ) : (
        <AttendanceTable report={report} />
      )
    }
  </main>
</AppLayout>
