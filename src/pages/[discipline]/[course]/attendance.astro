---
import { hasPerm } from "@/auth/permissions";
// A course's roll call attendance for whoever manages it, in the students tab,
// linked from the course card. A student's own row is on the course home.
import AttendanceTable from "@/components/attendance/AttendanceTable";
import CourseHeader from "@/components/CourseHeader.astro";
import CsvDownload from "@/components/CsvDownload.astro";
import { db } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { attendanceCsvRows } from "@/services/attendance-table";
import { withAnchor } from "@/urls";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { studentsNav } from "@/utils/course-tabs-nav";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, links, tabs } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const manages = hasPerm(actor, "enrollment.manage", course);
// A student's attendance is a section of the course home.
if (!manages) return Astro.redirect(withAnchor(links.index(), "attendance"));
const report = await db.rollCall.courseAttendance(course.id, { actor });
const csvFilename = `attendance-${course.discipline.slug}-${course.edition.slug}.csv`;
---

<AppLayout title={m.attendance_page_title({ discipline: course.discipline.name })}
  trail={breadcrumbs(Astro.url, { course })}
  nav={studentsNav(links)}
>
  <CourseHeader course={course} tabs={tabs} active="students" />

  <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
    <h2 class="page-subheader">{m.attendance_page_heading()}</h2>
    {
      report.events.length > 0 && report.students.length > 0 && (
        <CsvDownload
          id="attendance-csv"
          filename={csvFilename}
          rows={attendanceCsvRows(report)}
        />
      )
    }
  </div>

  {
    report.events.length === 0 ? (
      <p class="mt-4 text-muted">{m.attendance_page_no_roll_calls()}</p>
    ) : report.students.length === 0 ? (
      <p class="mt-4 text-muted">{m.attendance_page_no_students()}</p>
    ) : (
      <AttendanceTable report={report} />
    )
  }
</AppLayout>
