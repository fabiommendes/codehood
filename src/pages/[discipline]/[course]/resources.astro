---
import { hasPerm } from "@/auth/permissions";
import CliSetupLink from "@/components/CliSetupLink.astro";
import CourseHeader from "@/components/CourseHeader.astro";
import ListRow from "@/components/ListRow.astro";
import Alert from "@/components/ui/Alert";
import { db, groupResourcesByType } from "@/db";
import { m } from "@/i18n";
import AppLayout from "@/layouts/AppLayout.astro";
import { splitByEvent } from "@/services/event-resources";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { loadCourse } from "@/utils/load-course";
import { RESOURCE_ACTION_ICONS, RESOURCE_ICONS } from "@/utils/resource-icons";
import { resourceDetail } from "@/utils/resource-kind";
import { fileDownloadName, resourceHref } from "@/utils/resource-url";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canWrite = hasPerm(actor, "course.update-contents", course);

const all = await db.resource.findMany({ course: course.id }, { actor });
const { general: resources, byEvent } = splitByEvent(all);
const hasEventResources = byEvent.size > 0;
const groups = groupResourcesByType(resources);

// Blob URLs carry no auth check of their own (FR-NFR-030); this page's referrer
// still shouldn't leak into every link it hands out.
Astro.response.headers.set("Referrer-Policy", "no-referrer");

/// `text` safe to place inside the HTML of a translated message.
function escapeHtml(text: string): string {
	return text
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;");
}

/// Inline code markup, for the messages that quote a folder or a command.
function code(text: string): string {
	return `<code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">${escapeHtml(text)}</code>`;
}
---

<AppLayout title={m.courses_resources_page_title({ discipline: course.discipline.name })}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="resources" />

    {hasEventResources && <p class="mt-4 text-sm text-base-content/60" set:html={m.courses_resources_on_schedule({
      schedule: `<a href="${escapeHtml(href)}/schedule" class="link">${escapeHtml(m.courses_resources_schedule_link())}</a>`,
    })} />}
    {
      all.length === 0 && canWrite && (
        <Alert variant="info" class="mt-4">
          <span>
            <span set:html={m.courses_resources_empty_instructor({
              folder: code("resources/"),
              command: code("codehood push"),
            })} />{" "}
            <CliSetupLink />
          </span>
        </Alert>
      )
    }
    {
      all.length === 0 && !canWrite && (
        <Alert variant="info" class="mt-4">
          <span>{m.courses_resources_empty_student()}</span>
        </Alert>
      )
    }

    <div class="mt-8 flex flex-col gap-6">
      {
        groups.map((group) => (
          <section>
            <h3 class="text-sm font-semibold tracking-wide text-base-content/50 uppercase">
              {group.label}
            </h3>
            <div class="mt-2 flex flex-col gap-3">
              {group.resources.map((resource) => {
                const file =
                  resource.data.type === "FILE" ? resource.data : undefined;
                return (
                  <ListRow
                    href={resourceHref(resource, href)}
                    download={file ? fileDownloadName(resource, file) : undefined}
                    external={resource.data.type === "LINK"}
                  >
                    <span
                      slot="leading"
                      class="grid h-10 w-10 shrink-0 place-items-center rounded-field bg-primary/10 text-primary"
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path
                          d={RESOURCE_ICONS[resource.data.type]}
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    <p class="font-medium">{resource.title}</p>
                    <p class="text-sm text-base-content/60">
                      {resourceDetail(resource)}
                    </p>
                    {RESOURCE_ACTION_ICONS[resource.data.type] && (
                      <svg
                        slot="trailing"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        class="shrink-0 text-base-content/60"
                        aria-hidden="true"
                      >
                        <path
                          d={RESOURCE_ACTION_ICONS[resource.data.type]}
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                  </ListRow>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</AppLayout>
