---
import { hasPerm } from "@/auth/permissions";
import CliSetupLink from "@/components/CliSetupLink.astro";
import CourseHeader from "@/components/CourseHeader.astro";
import ListRow from "@/components/ListRow.astro";
import Alert from "@/components/ui/Alert";
import { db, groupResourcesByType } from "@/db";
import AppLayout from "@/layouts/AppLayout.astro";
import { breadcrumbs } from "@/utils/breadcrumbs";
import { loadCourse } from "@/utils/load-course";
import { resourceDetail } from "@/utils/resource-kind";
import { fileDownloadName } from "@/utils/resource-url";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canWrite = hasPerm(actor, "course.update-contents", course);

const resources = await db.resource.findMany({ course: course.id }, { actor });
const groups = groupResourcesByType(resources);

// Blob URLs carry no auth check of their own (FR-NFR-030); this page's referrer
// still shouldn't leak into every link it hands out.
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const ICONS = {
	FILE: "M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z M14 3.5V8h4",
	LINK: "M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71",
	MD: "M6 3.5h9l3 3V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z M8 12h8M8 15.5h8M8 8.5h4",
	CODE: "m9 8-4 4 4 4M15 8l4 4-4 4M13.5 6.5l-3 11",
} as const;

/// What a click on the row does, for the rows that leave the page: a download, or another tab.
const TRAILING_ICONS: Partial<Record<keyof typeof ICONS, string>> = {
	FILE: "M12 4v11m0 0 4-4m-4 4-4-4M5 19h14",
	LINK: "M14 4h6v6 M20 4l-9 9 M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5",
};

/// Where a row that is not a file leads: the link itself, or the resource's own page.
function rowHref(resource: (typeof resources)[number]): string {
	switch (resource.data.type) {
		case "FILE":
			return "#";
		case "LINK":
			return resource.data.url;
		case "MD":
		case "CODE":
			return `${href}/resources/${resource.slug}`;
	}
}
---

<AppLayout title={`${course.discipline.name} · Resources`}
  trail={breadcrumbs(Astro.url, { course })}
>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="resources" />

    {
      resources.length === 0 && canWrite && (
        <Alert variant="info" class="mt-4">
          <span>
            Nothing pushed yet. Put files, links, notes and snippets in the
            course repository's{" "}
            <code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">resources/</code>{" "}
            folder and run{" "}
            <code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">codehood push</code>.
            Every file it uploads gets a permanent, unauthenticated URL, so
            nothing whose disclosure matters belongs here.{" "}
            <CliSetupLink />
          </span>
        </Alert>
      )
    }
    {
      resources.length === 0 && !canWrite && (
        <Alert variant="info" class="mt-4">
          <span>No resources yet.</span>
        </Alert>
      )
    }

    <div class="mt-8 flex flex-col gap-6">
      {
        groups.map((group) => (
          <section>
            <h3 class="text-sm font-semibold tracking-wide text-base-content/50 uppercase">
              {group.label}
            </h3>
            <div class="mt-2 flex flex-col gap-3">
              {group.resources.map((resource) => {
                const file =
                  resource.data.type === "FILE" ? resource.data : undefined;
                return (
                  <ListRow
                    href={file ? file.link : rowHref(resource)}
                    download={file ? fileDownloadName(resource, file) : undefined}
                    external={resource.data.type === "LINK"}
                  >
                    <span
                      slot="leading"
                      class="grid h-10 w-10 shrink-0 place-items-center rounded-field bg-primary/10 text-primary"
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path
                          d={ICONS[resource.data.type]}
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    <p class="font-medium">{resource.title}</p>
                    <p class="text-sm text-base-content/60">
                      {resourceDetail(resource)}
                    </p>
                    {TRAILING_ICONS[resource.data.type] && (
                      <svg
                        slot="trailing"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        class="shrink-0 text-base-content/60"
                        aria-hidden="true"
                      >
                        <path
                          d={TRAILING_ICONS[resource.data.type]}
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                  </ListRow>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</AppLayout>
