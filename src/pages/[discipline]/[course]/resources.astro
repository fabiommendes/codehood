---
import { canWriteCourseContent } from "@/auth/permissions";
import CourseHeader from "@/components/CourseHeader.astro";
import ListRow from "@/components/ListRow.astro";
import Alert from "@/components/ui/Alert";
import {
	groupResourcesByType,
	resourceService,
} from "@/db/services/resource.service";
import AppLayout from "@/layouts/AppLayout.astro";
import { formatBytes } from "@/utils/format-bytes";
import { loadCourse } from "@/utils/load-course";
import { blobHref, fileDownloadName } from "@/utils/resource-url";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course, href } = result;

// biome-ignore lint/style/noNonNullAssertion: every course page runs through loadCourse, which already required Astro.locals.user.
const actor = Astro.locals.actor!;
const canWrite = canWriteCourseContent(actor, course);

const resources = await resourceService.findMany(
	{ courseId: course.id },
	{ actor },
);
const groups = groupResourcesByType(resources);

const totalFileBytes = resources
	.filter((r) => r.type === "FILE" && r.file && !r.file.deletedAt)
	.reduce((sum, r) => sum + (r.file?.size ?? 0), 0);

// Blob URLs carry no auth check of their own (FR-NFR-030); this page's referrer
// still shouldn't leak into every link it hands out.
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const ICONS = {
	FILE: "M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z M14 3.5V8h4",
	LINK: "M9.5 14.5 14.5 9.5 M11 8h1.5A3.5 3.5 0 0 1 16 11.5v0A3.5 3.5 0 0 1 12.5 15H11 M13 16h-1.5A3.5 3.5 0 0 1 8 12.5v0A3.5 3.5 0 0 1 11.5 9H13",
	MD: "M6 3.5h9l3 3V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z M8 12h8M8 15.5h8M8 8.5h4",
	CODE: "m9 8-4 4 4 4M15 8l4 4-4 4M13.5 6.5l-3 11",
} as const;

const DOWNLOAD_ICON = "M12 4v11m0 0 4-4m-4 4-4-4M5 19h14";

function detail(resource: (typeof resources)[number]): string {
	switch (resource.type) {
		case "FILE":
			if (resource.file?.deletedAt) return "no longer available";
			return `${resource.file?.mimeType ?? "file"}${resource.file ? ` · ${formatBytes(resource.file.size)}` : ""}`;
		case "LINK":
			return "external";
		case "MD":
			return "markdown";
		case "CODE":
			return resource.extra ? resource.extra : "snippet";
	}
}

function rowHref(resource: (typeof resources)[number]): string {
	switch (resource.type) {
		case "FILE":
			return "#";
		case "LINK":
			return resource.data ?? "#";
		case "MD":
		case "CODE":
			return `${href}/resources/${resource.slug}`;
	}
}
---

<AppLayout title={`${course.discipline.name} · Resources`}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <CourseHeader course={course} active="resources" />

    <h2 class="text-xl font-semibold">Resources</h2>
    <p class="mt-1 text-sm text-base-content/60">
      {course.discipline.name} · {course.editionSlug}
      {
        canWrite &&
          totalFileBytes > 0 &&
          ` · ${formatBytes(totalFileBytes)} total`
      }
    </p>

    {
      resources.length === 0 && canWrite && (
        <Alert variant="info" class="mt-4">
          <span>
            Nothing pushed yet. Run{" "}
            <code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">
              manage import-resources {course.disciplineSlug}{" "}
              {course.instructor.username} {course.editionSlug} ./resources.yaml
            </code>{" "}
            from the CLI. Every file it uploads gets a permanent,
            unauthenticated URL — nothing whose disclosure matters belongs here.
          </span>
        </Alert>
      )
    }
    {
      resources.length === 0 && !canWrite && (
        <Alert variant="info" class="mt-4">
          <span>No resources yet.</span>
        </Alert>
      )
    }

    <div class="mt-8 flex flex-col gap-6">
      {
        groups.map((group) => (
          <section>
            <h3 class="text-sm font-semibold tracking-wide text-base-content/50 uppercase">
              {group.label}
            </h3>
            <div class="mt-2 flex flex-col gap-3">
              {group.resources.map((resource) => {
                const removed =
                  resource.type === "FILE" && resource.file?.deletedAt;
                const downloadFile =
                  resource.type === "FILE" && !removed
                    ? resource.file
                    : undefined;
                const downloadName = downloadFile
                  ? fileDownloadName(resource, downloadFile)
                  : undefined;
                const downloadHref = downloadFile
                  ? blobHref(downloadFile, downloadName)
                  : undefined;
                const linkUrl =
                  resource.type === "LINK" ? rowHref(resource) : undefined;
                const linkDialogId = linkUrl
                  ? `link-resource-${resource.slug}`
                  : undefined;
                return (
                  <>
                    <ListRow
                      href={
                        removed || downloadHref || linkDialogId
                          ? undefined
                          : rowHref(resource)
                      }
                      openDialog={linkDialogId}
                      muted={!!removed}
                    >
                      <span
                        slot="leading"
                        class="grid h-10 w-10 shrink-0 place-items-center rounded-field bg-primary/10 text-primary"
                      >
                        <svg
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                        >
                          <path
                            d={ICONS[resource.type]}
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                      <p
                        class:list={["font-medium", removed && "line-through"]}
                      >
                        {resource.title}
                      </p>
                      <p class="text-sm text-base-content/60">
                        {detail(resource)}
                      </p>
                      {downloadHref && (
                        <a
                          slot="trailing"
                          href={downloadHref}
                          download={downloadName}
                          aria-label={`Download ${resource.title}`}
                          title="Download"
                          class="btn btn-square btn-ghost shrink-0"
                        >
                          <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                          >
                            <path
                              d={DOWNLOAD_ICON}
                              stroke="currentColor"
                              stroke-width="1.6"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </a>
                      )}
                    </ListRow>
                    {linkDialogId && linkUrl && (
                      <dialog id={linkDialogId} class="modal">
                        <div class="modal-box">
                          <form method="dialog">
                            <button class="btn btn-circle btn-ghost btn-sm absolute right-2 top-2">
                              ✕
                            </button>
                          </form>
                          <h3 class="text-lg font-bold">
                            Do you want to go to this link?
                          </h3>
                          <p class="mt-3 break-all text-sm">
                            <a href={linkUrl} class="link link-primary">
                              {linkUrl}
                            </a>
                          </p>
                          <div class="modal-action">
                            <form method="dialog">
                              <button type="submit" class="btn btn-ghost">
                                Cancel
                              </button>
                            </form>
                            <a
                              href={linkUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="btn btn-primary"
                            >
                              Open in another tab
                            </a>
                          </div>
                        </div>
                        <form method="dialog" class="modal-backdrop">
                          <button>close</button>
                        </form>
                      </dialog>
                    )}
                  </>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</AppLayout>
