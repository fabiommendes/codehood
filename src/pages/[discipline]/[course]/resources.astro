---
import ListRow from "@/components/ListRow.astro";
import Alert from "@/components/ui/Alert";
import AppLayout from "@/layouts/AppLayout.astro";
import { courseHref } from "@/utils/course-url";
import { loadCourse } from "@/utils/load-course";

export const prerender = false;

const { discipline, course: courseSegment } = Astro.params;
const result = await loadCourse(Astro, discipline, courseSegment);
if ("redirect" in result) return result.redirect;
const { course } = result;

const href = courseHref({
	disciplineSlug: course.disciplineSlug,
	username: course.instructor.username,
	edition: course.edition,
});

const resources = [
	{ name: "Syllabus", detail: "PDF · updated Jan 8", kind: "file" as const },
	{
		name: "Lecture slides — Weeks 1–4",
		detail: "PDF · updated Feb 2",
		kind: "file" as const,
	},
	{
		name: "Course repository",
		detail: "github.com/codehood-cs101/coursework",
		kind: "link" as const,
	},
	{
		name: "Structure and Interpretation of Computer Programs",
		detail: "External textbook",
		kind: "link" as const,
	},
	{
		name: "Setting up your dev environment",
		detail: "PDF · updated Jan 10",
		kind: "file" as const,
	},
	{
		name: "Office hours sign-up",
		detail: "calendly.com/ada-lovelace",
		kind: "link" as const,
	},
	{
		name: "Midterm study guide",
		detail: "PDF · updated Mar 1",
		kind: "file" as const,
	},
];

const icons = {
	file: "M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z M14 3.5V8h4",
	link: "M9.5 14.5 14.5 9.5 M11 8h1.5A3.5 3.5 0 0 1 16 11.5v0A3.5 3.5 0 0 1 12.5 15H11 M13 16h-1.5A3.5 3.5 0 0 1 8 12.5v0A3.5 3.5 0 0 1 11.5 9H13",
};
---

<AppLayout title={`${course.discipline.name} · Resources`}>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <a href={href} class="text-sm text-base-content/60 hover:text-primary">← {course.discipline.name}</a>

    <h1 class="mt-3 text-3xl font-bold">Resources</h1>
    <p class="mt-2 text-base-content/70">{course.discipline.name} · {course.edition}</p>

    <Alert variant="info" class="mt-6">
      <span>Preview data — nothing here downloads or links out yet.</span>
    </Alert>

    <div class="mt-8 flex flex-col gap-3">
      {
        resources.map((resource) => (
          <ListRow>
            <span slot="leading" class="grid h-10 w-10 shrink-0 place-items-center rounded-field bg-primary/10 text-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path
                  d={icons[resource.kind]}
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <p class="font-medium">{resource.name}</p>
            <p class="text-sm text-base-content/60">{resource.detail}</p>
          </ListRow>
        ))
      }
    </div>
  </main>
</AppLayout>
