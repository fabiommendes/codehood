---
import HeroScene from "@/components/brand/HeroScene.astro";
import PartyLights from "@/components/brand/PartyLights.astro";
import { C, O, roof, wall } from "@/components/brand/paper";
import Scene from "@/components/brand/Scene.astro";
import type { SceneName } from "@/components/brand/scenes";
import TileWall from "@/components/brand/TileWall.astro";
import CourseTile from "@/components/CourseTile.astro";
import Logo from "@/components/Logo.astro";
import AppFooter from "@/components/nav/AppFooter.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { m } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

export const prerender = false;

if (Astro.locals.actor) {
	return Astro.rewrite("/home");
}

/// Each step is marked with a piece of the logo: the C, an o, the house.
const steps = [
	{
		mark: {
			viewBox: "-2 -2 31 40",
			paths: [{ d: C(0, 0), class: "fill-primary" }],
		},
		title: m.auth_home_step1_title(),
		body: m.auth_home_step1_body(),
		command: "codehood init",
	},
	{
		mark: {
			viewBox: "-2 -2 28 28",
			paths: [{ d: O(12, 12), class: "fill-error" }],
		},
		title: m.auth_home_step2_title(),
		body: m.auth_home_step2_body(),
	},
	{
		mark: {
			viewBox: "-5 -4 34 38",
			paths: [
				{ d: wall(0, 0), class: "fill-success" },
				{ d: roof(0, 0), class: "fill-secondary" },
			],
		},
		title: m.auth_home_step3_title(),
		body: m.auth_home_step3_body(),
		command: "codehood push",
	},
];

const features: { scene: SceneName; title: string; body: string }[] = [
	{
		scene: "lateNight",
		title: m.auth_home_feature1_title(),
		body: m.auth_home_feature1_body(),
	},
	{
		scene: "constellation",
		title: m.auth_home_feature2_title(),
		body: m.auth_home_feature2_body(),
	},
];
---

<Layout title={m.auth_home_title()}>
  <div class="min-h-screen text-base-content">
    <header class="border-b border-base-300">
      <div class="wrap flex items-center justify-between py-3">
        <a href="#top" aria-label={m.auth_home_logo_label()}><Logo height={40} /></a>
        <div class="flex items-center gap-2">
          <ThemeToggle />
          <a class="btn btn-primary" href="/login">{m.auth_login_action()}</a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="wrap grid items-center gap-10 py-14 lg:grid-cols-[1.05fr_1fr] lg:py-20">
        <div>
          <p class="eyebrow">{m.auth_home_eyebrow()}</p>
          <h1 class="mt-4 text-5xl font-bold leading-[1.02] lg:text-6xl">{m.auth_home_headline()}</h1>
          <p class="mt-6 max-w-xl text-lg text-base-content/75">
            {m.auth_home_lead()}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a class="btn btn-primary btn-lg" href="/login">{m.auth_login_action()}</a>
            <a class="link link-hover font-bold" href="#how-it-works">{m.auth_home_see_how()}</a>
            <a class="link link-hover font-bold" href="#join">{m.auth_home_have_code()}</a>
          </div>
        </div>

        <div class="relative">
          <HeroScene />
          <div class="terminal card tape tilt-r absolute border border-base-300 -bottom-6 left-2 w-64 p-4 sm:left-6 sm:w-72">
            <pre><span class="prompt">$</span> codehood init
<span class="quiet">created course/</span>
<span class="prompt">$</span> codehood push
<span class="quiet">syncing questions/*.mdq.md</span>
<span class="ok">✓ live for your students</span></pre>
          </div>
        </div>
      </section>

      <section id="how-it-works" class="relative mt-10 overflow-hidden py-24">
        <TileWall seed={3} />
        <div class="wrap relative">
          <div class="card tape tilt-l inline-block bg-base-100 px-7 py-5 shadow-lg">
            <p class="eyebrow">{m.auth_home_how_eyebrow()}</p>
            <h2 class="mt-2 text-4xl font-bold">{m.auth_home_how_heading()}</h2>
          </div>
          <div class="mt-12 grid gap-8 md:grid-cols-3">
            {
              steps.map((step, i) => (
                <article class:list={["card tape bg-base-100 p-7 shadow-xl", i % 2 ? "tilt-r" : "tilt-l"]}>
                  <svg class="h-10 w-10" viewBox={step.mark.viewBox} aria-hidden="true">
                    {step.mark.paths.map((p) => (
                      <path d={p.d} class={p.class} />
                    ))}
                  </svg>
                  <p class="eyebrow mt-5">{m.auth_home_step_n({ n: i + 1 })}</p>
                  <h3 class="mt-1 text-xl font-bold">{step.title}</h3>
                  <p class="mt-3 text-base-content/75">
                    {step.command && <code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">{step.command}</code>}{" "}
                    {step.body}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="wrap grid items-center gap-12 py-20 lg:grid-cols-2">
        <div>
          <p class="eyebrow">{m.auth_home_students_eyebrow()}</p>
          <h2 class="mt-3 text-4xl font-bold">{m.auth_home_students_heading()}</h2>
          <p class="mt-5 max-w-lg text-lg text-base-content/75">
            {m.auth_home_students_lead()}
          </p>
          <ul class="mt-8 grid gap-5">
            <li>
              <strong class="font-display text-lg">{m.auth_home_students_next_title()}</strong>
              <p class="text-base-content/70">{m.auth_home_students_next_body()}</p>
            </li>
            <li>
              <strong class="font-display text-lg">{m.auth_home_students_exams_title()}</strong>
              <p class="text-base-content/70">{m.auth_home_students_exams_body()}</p>
            </li>
          </ul>
        </div>

        <div class="card tilt-l bg-base-100 p-6 shadow-lg">
          <div class="flex items-center gap-4">
            <CourseTile seed="/cs101/ada_2026-2" size={56} />
            <div>
              <p class="font-mono text-xs text-base-content/60">cs101 · 2026-2</p>
              <p class="font-display text-xl font-bold">{m.auth_home_demo_course()}</p>
              <p class="text-sm text-base-content/70">{m.auth_home_demo_instructor()}</p>
            </div>
          </div>
          <div role="tablist" class="tabs tabs-border mt-4">
            <span role="tab" class="tab tab-active">{m.auth_home_demo_tab_home()}</span>
            <span role="tab" class="tab">{m.auth_home_demo_tab_exams()}</span>
            <span role="tab" class="tab">{m.auth_home_demo_tab_resources()}</span>
            <span role="tab" class="tab">{m.auth_home_demo_tab_schedule()}</span>
          </div>
          <ul class="mt-4 grid gap-3">
            <li class="flex items-center gap-3 rounded-field border border-base-300 p-3">
              <span class="badge badge-success">{m.auth_home_demo_open_now()}</span>
              <span class="flex-1">{m.auth_home_demo_quiz3()}</span>
              <span class="btn btn-primary btn-sm">{m.auth_home_demo_start()}</span>
            </li>
            <li class="flex items-center gap-3 rounded-field border border-base-300 p-3">
              <span class="badge badge-ghost">{m.auth_home_demo_in_2_days()}</span>
              <span class="flex-1">{m.auth_home_demo_midterm()}</span>
            </li>
            <li class="flex items-center gap-3 rounded-field border border-base-300 p-3">
              <span class="badge badge-accent">{m.auth_home_demo_graded()}</span>
              <span class="flex-1">{m.auth_home_demo_quiz2()}</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="bg-base-100/60 py-20">
        <div class="wrap">
          <p class="eyebrow">{m.auth_home_why_eyebrow()}</p>
          <h2 class="mt-3 text-4xl font-bold">{m.auth_home_why_heading()}</h2>
          <div class="mt-12 grid gap-12 md:grid-cols-2">
            {
              features.map((f, i) => (
                <article>
                  <div class:list={["tape shadow-lg", i % 2 ? "tilt-r" : "tilt-l"]}>
                    <Scene name={f.scene} />
                  </div>
                  <h3 class="mt-6 text-2xl font-bold">{f.title}</h3>
                  <p class="mt-2 max-w-md text-base-content/75">{f.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="join" class="relative overflow-hidden py-20">
        <TileWall seed={11} />
        <div class="wrap relative">
          <div class="card tape tilt-l bg-base-100 px-8 pb-10 pt-4 shadow-xl">
            <PartyLights />
            <div class="mt-6 flex flex-wrap items-end justify-between gap-8">
              <div>
                <h2 class="text-3xl font-bold">{m.auth_home_join_heading()}</h2>
                <p class="mt-2 max-w-md text-base-content/75">
                  {m.auth_home_join_body()}
                </p>
              </div>
              <form method="GET" action="/courses/join" class="flex w-full max-w-md flex-wrap items-end gap-3">
                <fieldset class="fieldset flex-1">
                  <label class="fieldset-legend" for="join-code">{m.auth_home_join_code_label()}</label>
                  <input
                    type="text"
                    id="join-code"
                    name="code"
                    required
                    autocomplete="off"
                    autocapitalize="characters"
                    spellcheck="false"
                    class="input w-full font-mono uppercase tracking-widest"
                  />
                </fieldset>
                <button type="submit" class="btn btn-primary">{m.auth_join_submit()}</button>
                <a class="btn btn-ghost" href="/login">{m.auth_login_action()}</a>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <AppFooter class="wrap bg-base-100/60" />
  </div>
</Layout>

<style>
  .wrap {
    width: min(1180px, 100% - 3rem);
    margin-inline: auto;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .terminal {
    background: var(--color-neutral);
    color: var(--color-neutral-content);
    box-shadow: 0 16px 30px -16px rgb(0 0 0 / 0.6);
  }

  .terminal .prompt {
    color: #4aa0ff;
  }

  .terminal .quiet {
    color: #8fb3a4;
  }

  .terminal .ok {
    color: #4cd08a;
  }

  .terminal pre {
    font: 0.85rem/1.7 var(--font-mono);
    white-space: pre-wrap;
  }
</style>
