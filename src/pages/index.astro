---
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Layout from "@/layouts/Layout.astro";

export const prerender = false;

if (Astro.locals.actor) {
  return Astro.redirect("/courses");
}
---

<Layout title="Codehood — Run your course like a Git repo">
  <div class="landing">
    <div
      style="position:sticky;top:0;z-index:10;background:var(--header-bg);backdrop-filter:blur(8px);border-bottom:1px solid var(--border);"
    >
      <div
        class="container"
        style="display:flex;align-items:center;justify-content:space-between;height:76px;"
      >
        <Logo height={34} />
        <div style="display:flex;align-items:center;gap:12px;">
          <ThemeToggle />
          <a
            href="/login"
            class="btn btn-primary"
            style="height:40px;padding:0 20px;font-size:14px;">Log in</a
          >
        </div>
      </div>
    </div>

    <div class="container" style="padding-top:88px;padding-bottom:96px;">
      <div
        class="hero-grid"
        style="display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center;"
      >
        <div>
          <div
            style="display:flex;align-items:center;gap:10px;margin-bottom:20px;flex-wrap:wrap;"
          >
            <div style="display:flex;gap:4px;">
              <span
                style="width:10px;height:10px;border-radius:3px;background:var(--accent);display:inline-block;"
              ></span>
              <span
                style="width:10px;height:10px;border-radius:3px;background:var(--red);display:inline-block;"
              ></span>
              <span
                style="width:10px;height:10px;border-radius:3px;background:var(--yellow);display:inline-block;"
              ></span>
              <span
                style="width:10px;height:10px;border-radius:3px;background:var(--green);display:inline-block;"
              ></span>
            </div>
            <span class="kicker"
              >A learning management system for programmers</span
            >
          </div>
          <h1
            style="font-size:56px;line-height:1.06;font-weight:700;color:var(--ink);"
          >
            Run your course like a Git repo.
          </h1>
          <p
            style="margin-top:24px;font-size:19px;line-height:1.6;color:var(--ink-soft);max-width:520px;"
          >
            Codehood is a simple LMS for instructors who'd rather write
            questions, exams, and resources as plain text files than click
            through a web form. Edit locally, push when you're ready, and
            students see it instantly in their browser.
          </p>
          <div
            style="display:flex;align-items:center;gap:24px;margin-top:36px;flex-wrap:wrap;"
          >
            <a href="/login" class="btn btn-primary">Log in</a>
            <a
              href="#how-it-works"
              style="display:inline-flex;align-items:center;gap:6px;font-weight:600;font-size:15px;color:var(--ink);"
            >
              See how it works
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                ><path
                  d="M4 6l4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
          </div>
        </div>
        <div
          style="background:var(--dark);border-radius:16px;overflow:hidden;box-shadow:0 24px 60px -20px rgba(22,35,45,0.45);"
        >
          <div
            style="display:flex;align-items:center;gap:8px;padding:16px 20px;border-bottom:1px solid rgba(255,255,255,0.08);"
          >
            <span
              style="width:11px;height:11px;border-radius:50%;background:#e0574a;display:inline-block;"
            ></span>
            <span
              style="width:11px;height:11px;border-radius:50%;background:#f1c40f;display:inline-block;"
            ></span>
            <span
              style="width:11px;height:11px;border-radius:50%;background:#27ae60;display:inline-block;"
            ></span>
            <span
              style="margin-left:8px;font-size:12px;color:rgba(219,230,238,0.5);"
              >course &mdash; codehood</span
            >
          </div>
          <div style="padding:24px 24px 28px;font-size:14px;line-height:1.9;">
            <div>
              <span style="color:var(--green);">$</span>
              <span style="color:#ffffff;">codehood init</span>
            </div>
            <div style="color:rgba(219,230,238,0.55);">
              &nbsp;&nbsp;created course/ (codehood.toml, content/)
            </div>
            <div style="margin-top:10px;">
              <span style="color:var(--green);">$</span>
              <span style="color:#ffffff;">codehood push</span>
            </div>
            <div style="color:rgba(219,230,238,0.55);">
              &nbsp;&nbsp;syncing content/questions/*.q.md
            </div>
            <div style="color:rgba(219,230,238,0.55);">
              &nbsp;&nbsp;syncing content/exams/midterm.md
            </div>
            <div style="color:#6fcf97;">&nbsp;&nbsp;live for your students</div>
          </div>
        </div>
      </div>
    </div>

    <div id="how-it-works" class="container" style="padding:96px 40px;">
      <div style="max-width:560px;">
        <span class="kicker">How it works</span>
        <h2
          style="margin-top:12px;font-size:36px;font-weight:700;color:var(--ink);"
        >
          Three steps, and you're teaching.
        </h2>
      </div>
      <div
        class="steps-grid"
        style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:56px;"
      >
        <div>
          <div class="step-badge" style="background:var(--red);">1</div>
          <h3
            style="margin-top:20px;font-size:19px;font-weight:600;color:var(--ink);"
          >
            Scaffold your course
          </h3>
          <p
            style="margin-top:10px;font-size:15px;line-height:1.65;color:var(--ink-soft);"
          >
            <code
              style="background:var(--accent-soft);color:var(--accent-hover);padding:2px 6px;border-radius:5px;font-size:13px;"
              >codehood init</code
            > creates a course/ folder &mdash; a config file plus directories for
            questions, exams, calendar, and resources. All plain text, all yours to
            version.
          </p>
        </div>
        <div>
          <div class="step-badge" style="background:var(--yellow);">2</div>
          <h3
            style="margin-top:20px;font-size:19px;font-weight:600;color:var(--ink);"
          >
            Write content your way
          </h3>
          <p
            style="margin-top:10px;font-size:15px;line-height:1.65;color:var(--ink-soft);"
          >
            Craft questions, exams, and resources locally, in whatever editor
            and workflow you already use. No forms, no lock-in.
          </p>
        </div>
        <div>
          <div class="step-badge" style="background:var(--green);">3</div>
          <h3
            style="margin-top:20px;font-size:19px;font-weight:600;color:var(--ink);"
          >
            Push, and it's live
          </h3>
          <p
            style="margin-top:10px;font-size:15px;line-height:1.65;color:var(--ink-soft);"
          >
            <code
              style="background:var(--accent-soft);color:var(--accent-hover);padding:2px 6px;border-radius:5px;font-size:13px;"
              >codehood push</code
            > syncs your changes to the server. Students see updates in their browser
            immediately &mdash; no separate publish step.
          </p>
        </div>
      </div>
    </div>

    <div style="background:var(--bg-alt);padding:80px 0;">
      <div
        style="max-width:680px;margin:0 auto;padding:0 40px;text-align:center;"
      >
        <h2 style="font-size:32px;font-weight:700;color:var(--ink);">
          Students just open a browser.
        </h2>
        <p
          style="margin-top:16px;font-size:17px;line-height:1.65;color:var(--ink-soft);"
        >
          No CLI required. Students use Codehood like a regular web-based LMS
          &mdash; checking the calendar, taking exams, working through questions
          their instructor has published. The CLI is there if they want it,
          never if they don't.
        </p>
      </div>
    </div>

    <div class="container" style="padding:96px 40px;">
      <div style="max-width:560px;">
        <span class="kicker">Why Codehood</span>
        <h2
          style="margin-top:12px;font-size:36px;font-weight:700;color:var(--ink);"
        >
          Built for how you already work.
        </h2>
      </div>
      <div
        class="feature-grid"
        style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:56px;"
      >
        <div class="card" style="padding:28px;">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            style="color:var(--accent);"
            ><path
              d="M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path><path
              d="M14 3.5V8h4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path><path
              d="M8.5 12h7M8.5 15.5h7M8.5 9h3"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path></svg
          >
          <h3
            style="margin-top:18px;font-size:17px;font-weight:600;color:var(--ink);"
          >
            Plain text, version-controlled
          </h3>
          <p
            style="margin-top:10px;font-size:14px;line-height:1.6;color:var(--ink-soft);"
          >
            Course content lives in a Git repository on your machine &mdash;
            questions, exams, and resources as files you can diff, branch, and
            review like code.
          </p>
        </div>
        <div class="card" style="padding:28px;">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            style="color:var(--accent);"
            ><rect
              x="3"
              y="4.5"
              width="18"
              height="15"
              rx="2"
              stroke="currentColor"
              stroke-width="1.6"></rect><path
              d="M7 9.5 10.5 12 7 14.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path><path
              d="M12.5 14.5h4.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path></svg
          >
          <h3
            style="margin-top:18px;font-size:17px;font-weight:600;color:var(--ink);"
          >
            CLI-first, browser-friendly
          </h3>
          <p
            style="margin-top:10px;font-size:14px;line-height:1.6;color:var(--ink-soft);"
          >
            Instructors push from the command line. Students never need to touch
            a terminal unless they want to.
          </p>
        </div>
        <div class="card" style="padding:28px;">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            style="color:var(--accent);"
            ><rect
              x="4"
              y="3.5"
              width="16"
              height="17"
              rx="2"
              stroke="currentColor"
              stroke-width="1.6"></rect><path
              d="M7.5 8.5 8.7 9.7 11 7.3"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path><path
              d="M13 8.5h4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path><path
              d="M7.5 14.5 8.7 15.7 11 13.3"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path><path
              d="M13 14.5h4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path></svg
          >
          <h3
            style="margin-top:18px;font-size:17px;font-weight:600;color:var(--ink);"
          >
            Built-in question types
          </h3>
          <p
            style="margin-top:10px;font-size:14px;line-height:1.6;color:var(--ink-soft);"
          >
            Multiple choice and short answer today, with more on the way &mdash;
            write once, reuse across exams.
          </p>
        </div>
        <div class="card" style="padding:28px;">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            style="color:var(--accent);"
            ><circle
              cx="7"
              cy="6"
              r="2"
              stroke="currentColor"
              stroke-width="1.6"></circle><circle
              cx="7"
              cy="18"
              r="2"
              stroke="currentColor"
              stroke-width="1.6"></circle><circle
              cx="17"
              cy="12"
              r="2"
              stroke="currentColor"
              stroke-width="1.6"></circle><path
              d="M7 8v8"
              stroke="currentColor"
              stroke-width="1.6"></path><path
              d="M7 8c0 4 3 4 8 4h.5"
              stroke="currentColor"
              stroke-width="1.6"></path></svg
          >
          <h3
            style="margin-top:18px;font-size:17px;font-weight:600;color:var(--ink);"
          >
            Your content, your repo
          </h3>
          <p
            style="margin-top:10px;font-size:14px;line-height:1.6;color:var(--ink-soft);"
          >
            Nothing is locked in a database you can't export. It's a Git repo
            before it's anything else.
          </p>
        </div>
      </div>
    </div>

    <div style="background:var(--dark);padding:88px 0;">
      <div
        style="max-width:560px;margin:0 auto;padding:0 40px;text-align:center;"
      >
        <h2 style="font-size:32px;font-weight:700;color:#ffffff;">
          Already teaching with Codehood?
        </h2>
        <div style="margin-top:32px;">
          <a href="/login" class="btn btn-on-dark">Log in</a>
        </div>
        <p
          style="margin-top:24px;font-size:14px;line-height:1.6;color:rgba(219,230,238,0.65);"
        >
          Codehood is invite-only right now &mdash; instructors and students get
          access through a course invite.
        </p>
      </div>
    </div>

    <div style="padding:40px 0;">
      <div
        class="container"
        style="display:flex;align-items:center;justify-content:center;gap:10px;flex-direction:column;"
      >
        <Logo height={40} style="opacity:0.7" />
        <span style="font-size:13px;color:var(--muted);"
          >the learning community</span
        >
      </div>
    </div>
  </div>
</Layout>

<style>
  .landing {
    --bg: #f7f9fb;
    --bg-alt: #ecf0f1;
    --ink: #1c2b36;
    --ink-soft: #4a5b6b;
    --muted: #8194a3;
    --accent: #2980b9;
    --accent-hover: #1f6690;
    --accent-soft: #e9f2f9;
    --red: #c0392b;
    --yellow: #f1c40f;
    --green: #27ae60;
    --dark: #16232d;
    --border: #dde5ea;
    --card-bg: #ffffff;
    --header-bg: rgba(247, 249, 251, 0.9);
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "IBM Plex Sans", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .landing * {
    box-sizing: border-box;
  }
  .landing h1,
  .landing h2,
  .landing h3 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    margin: 0;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .landing p {
    margin: 0;
    text-wrap: pretty;
  }
  .landing a {
    color: var(--accent);
    text-decoration: none;
  }
  .landing a:hover {
    color: var(--accent-hover);
  }
  .landing code {
    font-family: "IBM Plex Mono", monospace;
  }
  .landing .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .landing .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 26px;
    border-radius: 999px;
    font-family: "IBM Plex Sans", sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border: 1.5px solid transparent;
    cursor: pointer;
  }
  .landing .btn-primary {
    background: var(--accent);
    color: #fff;
  }
  .landing .btn-primary:hover {
    background: var(--accent-hover);
    color: #fff;
  }
  .landing .btn-on-dark {
    background: #ffffff;
    color: var(--dark);
  }
  .landing .btn-on-dark:hover {
    background: #e7edf1;
  }
  .landing .kicker {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .landing .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
  }
  .landing .step-badge {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 17px;
    flex-shrink: 0;
  }
  @media (max-width: 768px) {
    .landing .container {
      padding: 0 24px;
    }
    .landing h1 {
      font-size: 36px !important;
    }
    .landing h2 {
      font-size: 26px !important;
    }
    .landing .hero-grid {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
    .landing .steps-grid {
      grid-template-columns: 1fr !important;
    }
    .landing .feature-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
  @media (max-width: 480px) {
    .landing .feature-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<style is:global>
  /* Dark counterpart of the palette above. A separate `is:global` block because
     `[data-theme]` lives on <html>, outside this component's scoped styles —
     same reason ThemeToggle.astro's dark-mode rules are global too. Mirrors
     src/styles/global.css's "codehood-dark" daisyUI theme rather than inventing
     a new palette, so the landing page matches the rest of the app. */
  html[data-theme="codehood-dark"] .landing {
    --bg: #16232d;
    --bg-alt: #1c2b36;
    --ink: #ecf0f1;
    --ink-soft: #a9bac5;
    --muted: #7c93a3;
    --accent: #5dade2;
    --accent-hover: #85c3ea;
    --accent-soft: #1f2f3d;
    --red: #e74c3c;
    --yellow: #f1c40f;
    --green: #2ecc71;
    --dark: #0d1620;
    --border: #2f4150;
    --card-bg: #1c2b36;
    --header-bg: rgba(22, 35, 45, 0.85);
  }
</style>
