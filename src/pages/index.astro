---
import Logo from "@/components/Logo.astro";
import PageKicker from "@/components/PageKicker.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Layout from "@/layouts/Layout.astro";

export const prerender = false;
---

<Layout title="Codehood — Run your course like a Git repo">
  <div class="landing-page">
    <header class="navbar">
      <div class="wrap navbar-inner">
        <div class="navbar-start">
          <a class="brand" href="#top" aria-label="Codehood home">
            <Logo height={30} />
          </a>
        </div>
        <div class="navbar-end">
          <ThemeToggle />
          <a class="btn btn-primary" href="/login">Log in</a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <span class="eyebrow"
              >A learning management system for programmers</span
            >
            <h1>Run your course like a Git repo.</h1>
            <p class="lede">
              Codehood is a simple LMS for instructors who'd rather write
              questions, exams, and resources as plain text files than click
              through a web form. Edit locally, push when you're ready, and
              students see it instantly in their browser.
            </p>
            <div class="actions">
              <a class="btn btn-primary" href="/login">Log in</a>
              <a class="text-link" href="#how-it-works">
                See how it works <span aria-hidden="true">-&gt;</span>
              </a>
            </div>
          </div>
          <section class="terminal" aria-label="Codehood command line preview">
            <div class="terminal-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <strong>course / codehood</strong>
            </div>
            <div class="mockup-code">
              <pre data-prefix="$"><code>codehood init</code></pre>
              <pre><code class="muted">created course/</code></pre>
              <pre data-prefix="$"><code>codehood push</code></pre>
              <pre><code class="muted">syncing content/questions/*.q.md</code></pre>
              <pre><code class="muted">syncing content/exams/midterm.md</code></pre>
              <pre><code class="ok">live for your students</code></pre>
            </div>
          </section>
        </div>
      </section>

      <section class="section section-muted" id="how-it-works">
        <div class="wrap">
          <div class="section-heading">
            <span class="eyebrow">How it works</span>
            <h2>Three steps, and you're teaching.</h2>
          </div>
          <div class="course-steps">
            <article class="step">
              <div class="step-number">1</div>
              <h3>Scaffold your course</h3>
              <p>
                <code>codehood init</code> creates a course/ folder, a config file
                plus directories for questions, exams, calendar, and resources. All
                plain text, all yours to version.
              </p>
            </article>
            <article class="step">
              <div class="step-number">2</div>
              <h3>Write content your way</h3>
              <p>
                Craft questions, exams, and resources locally, in whatever
                editor and workflow you already use. No forms, no lock-in.
              </p>
            </article>
            <article class="step">
              <div class="step-number">3</div>
              <h3>Push, and it's live</h3>
              <p>
                <code>codehood push</code> syncs your changes to the server. Students
                see updates in their browser immediately, no separate publish step.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap callout">
          <div>
            <span
              class="eyebrow"
              style="margin-bottom: 12px; display: inline-flex;"
              >Student Experience</span
            >
            <h2
              style="font-size: clamp(2rem, 3.5vw, 2.8rem); line-height: 1.05; margin-bottom: 24px; color: var(--ink);"
            >
              Students just open a browser.
            </h2>
            <p
              style="color: var(--muted); font-size: 16.5px; line-height: 1.65; margin-bottom: 28px; text-wrap: pretty;"
            >
              No CLI required. Students use Codehood like a regular web-based
              LMS &mdash; checking the calendar, taking exams, and working
              through questions their instructor has published. The CLI is there
              if they want it, never if they don't.
            </p>
            <div
              class="student-features"
              style="display: flex; flex-direction: column; gap: 18px; text-align: left;"
            >
              <div style="display: flex; gap: 14px; align-items: start;">
                <span
                  style="color: var(--green); font-size: 16px; font-weight: bold; line-height: 1.2;"
                  >✓</span
                >
                <div>
                  <strong
                    style="color: var(--ink); font-size: 15px; display: block; font-family: 'Space Grotesk', sans-serif;"
                    >Interactive Course Hub</strong
                  >
                  <span style="color: var(--muted); font-size: 13.5px;"
                    >Beautiful, lightweight dashboards custom-rendered for every
                    enrolled student.</span
                  >
                </div>
              </div>
              <div style="display: flex; gap: 14px; align-items: start;">
                <span
                  style="color: var(--green); font-size: 16px; font-weight: bold; line-height: 1.2;"
                  >✓</span
                >
                <div>
                  <strong
                    style="color: var(--ink); font-size: 15px; display: block; font-family: 'Space Grotesk', sans-serif;"
                    >Exams & Assignments</strong
                  >
                  <span style="color: var(--muted); font-size: 13.5px;"
                    >Perfect support for multiple-choice and markdown
                    short-answer question sheets.</span
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="mock-browser">
            <div class="browser-header">
              <div class="browser-dots">
                <span class="browser-dot red"></span>
                <span class="browser-dot yellow"></span>
                <span class="browser-dot green"></span>
              </div>
              <div class="browser-address">codehood.edu/cs101/intro-to-cs</div>
            </div>
            <div class="browser-body">
              <div class="sim-sidebar">
                <div class="sim-logo">CODEHOOD</div>
                <div class="sim-nav">
                  <span class="sim-nav-item active">Home</span>
                  <span class="sim-nav-item">Exams</span>
                  <span class="sim-nav-item">Practice</span>
                  <span class="sim-nav-item">Schedule</span>
                </div>
              </div>
              <div class="sim-content">
                <div class="sim-course-header">
                  <span class="sim-discipline">CS 101</span>
                  <h4 class="sim-course-title">Intro to Computer Science</h4>
                  <p class="sim-instructor">Prof. Ada Lovelace · Spring 2026</p>
                </div>
                <div class="sim-tabs">
                  <span class="sim-tab active">Overview</span>
                  <span class="sim-tab">Exams</span>
                  <span
                    class="sim-tab"
                    style="font-family: var(--font-mono); opacity: 0.5; font-size: 10px;"
                    >content/</span
                  >
                </div>
                <div class="sim-card-list">
                  <div class="sim-card">
                    <div
                      style="display: flex; flex-direction: column; gap: 2px;"
                    >
                      <span class="sim-card-title">Midterm Exam</span>
                      <span style="font-size: 10px; color: var(--muted);"
                        >Due Mar 15 · 10 questions</span
                      >
                    </div>
                    <span class="sim-tag badge-success">Open</span>
                  </div>
                  <div class="sim-card">
                    <div
                      style="display: flex; flex-direction: column; gap: 2px;"
                    >
                      <span class="sim-card-title">Final Project Spec</span>
                      <span style="font-size: 10px; color: var(--muted);"
                        >Due Apr 20 · Resources</span
                      >
                    </div>
                    <span class="sim-tag badge-info">New</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-muted">
        <div class="wrap">
          <div class="section-heading">
            <span class="eyebrow">Why Codehood</span>
            <h2>Built for how you already work.</h2>
          </div>
          <div class="feature-grid">
            <article class="feature">
              <div class="feature-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"
                  ></path>
                  <path d="M14 3.5V8h4"></path>
                  <path d="M8.5 12h7M8.5 15.5h7M8.5 9h3"></path>
                </svg>
              </div>
              <h3>Plain text, version-controlled</h3>
              <p>
                Course content lives in a Git repository on your machine,
                questions, exams, and resources as files you can diff, branch,
                and review like code.
              </p>
            </article>
            <article class="feature">
              <div class="feature-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="4.5" width="18" height="15" rx="2"></rect>
                  <path d="M7 9.5 10.5 12 7 14.5"></path>
                  <path d="M12.5 14.5h4.5"></path>
                </svg>
              </div>
              <h3>CLI-first, browser-friendly</h3>
              <p>
                Instructors push from the command line. Students never need to
                touch a terminal unless they want to.
              </p>
            </article>
            <article class="feature">
              <div class="feature-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="4" y="3.5" width="16" height="17" rx="2"></rect>
                  <path d="M7.5 8.5 8.7 9.7 11 7.3"></path>
                  <path d="M13 8.5h4"></path>
                  <path d="M7.5 14.5 8.7 15.7 11 13.3"></path>
                  <path d="M13 14.5h4"></path>
                </svg>
              </div>
              <h3>Built-in question types</h3>
              <p>
                Multiple choice and short answer today, with more on the way.
                Write once, reuse across exams.
              </p>
            </article>
            <article class="feature">
              <div class="feature-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="7" cy="6" r="2"></circle>
                  <circle cx="7" cy="18" r="2"></circle>
                  <circle cx="17" cy="12" r="2"></circle>
                  <path d="M7 8v8"></path>
                  <path d="M7 8c0 4 3 4 8 4h.5"></path>
                </svg>
              </div>
              <h3>Your content, your repo</h3>
              <p>
                Nothing is locked in a database you can't export. It's a Git
                repo before it's anything else.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="closing" id="login">
        <div class="wrap closing-inner">
          <div>
            <h2>Already teaching with Codehood?</h2>
            <p>
              Codehood is invite-only right now. Instructors and students get
              access through a course invite.
            </p>
          </div>
          <a class="btn btn-primary" href="/login">Log in</a>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <div class="footer-layout">
          <div class="footer-brand">
            <Logo height={28} style="opacity: 0.8;" />
            <span class="footer-tagline">the learning community</span>
          </div>
          <span class="footer-concept">Astro design concept, 2026</span>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .landing-page {
    --page: #f7f8f6;
    --surface: #fff;
    --muted-surface: #e5ece9;
    --ink: #182b35;
    --muted: #61727a;
    --line: #d7e1df;
    --primary: #2980b9;
    --primary-strong: #1f6690;
    --primary-soft: #dff0f7;
    --red: #d94d3f;
    --yellow: #e4ad19;
    --green: #229b62;
    --terminal: #10202a;
    --terminal-ink: #eff8f2;
    --terminal-muted: #a8bec0;

    background: var(--page);
    color: var(--ink);
    font-family: "IBM Plex Sans", sans-serif;
    min-height: 100vh;
  }

  :global([data-theme="codehood-dark"]) .landing-page {
    --page: #101b22;
    --surface: #172832;
    --muted-surface: #0d171e;
    --ink: #f2f6f3;
    --muted: #a9b8ba;
    --line: #2d4149;
    --primary: #65b8e6;
    --primary-strong: #9cdbf5;
    --primary-soft: #1e3f4e;
    --red: #f06a5c;
    --yellow: #f1c94b;
    --green: #4bd08c;
    --terminal: #081217;
    --terminal-ink: #eff8f2;
    --terminal-muted: #a5bdc2;
  }

  .landing-page * {
    box-sizing: border-box;
  }

  .wrap {
    width: min(1080px, calc(100% - 80px));
    margin-inline: auto;
  }

  .navbar {
    min-height: 76px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--page) 88%, transparent);
    backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
  }

  .navbar-start,
  .navbar-end {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .hero {
    position: relative;
    padding: 96px 0 94px;
    overflow: hidden;
  }

  .hero::before {
    position: absolute;
    inset: 0 0 auto;
    height: 520px;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45),
      transparent 72%
    );
    content: "";
    opacity: 0.38;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(390px, 0.98fr);
    align-items: center;
    gap: clamp(48px, 7vw, 92px);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--primary);
    font:
      600 12px/1 "IBM Plex Mono",
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 34px;
    height: 5px;
    background: linear-gradient(
      90deg,
      var(--primary),
      var(--red),
      var(--yellow),
      var(--green)
    );
    content: "";
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  h1 {
    max-width: 670px;
    margin-top: 21px;
    font-size: clamp(2.3rem, 5.04vw, 4.1rem);
    line-height: 0.96;
    color: var(--ink);
  }

  .lede {
    max-width: 580px;
    margin: 27px 0 0;
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 34px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 20px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14.5px;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--primary);
    color: #fff !important;
    box-shadow: 0 12px 25px -16px var(--primary-strong);
    transition:
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .btn-primary:hover {
    background: var(--primary-strong);
    box-shadow: 0 16px 28px -15px var(--primary-strong);
    transform: translateY(-2px);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 4px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .text-link span {
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .text-link:hover span {
    transform: translateX(4px);
  }

  .terminal {
    border: 1px solid color-mix(in srgb, var(--terminal-ink) 12%, transparent);
    border-radius: 12px;
    background: var(--terminal);
    box-shadow: 0 26px 70px -42px rgba(18, 45, 53, 0.7);
    transform: rotate(1.5deg);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .terminal:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    color: var(--terminal-muted);
    font:
      500 11px "IBM Plex Mono",
      monospace;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red {
    background: #e5574b;
  }

  .dot.yellow {
    background: #e5b72d;
  }

  .dot.green {
    background: #2cba70;
  }

  .terminal-bar strong {
    margin-left: 8px;
    font-weight: 500;
  }

  .mockup-code {
    overflow: hidden;
    padding: 25px 24px 28px;
    border-radius: 0;
    background: transparent;
    color: var(--terminal-ink);
    font:
      13px/1.9 "IBM Plex Mono",
      monospace;
    text-align: left;
  }

  .mockup-code pre {
    white-space: pre-wrap;
    margin: 0;
  }

  .mockup-code pre[data-prefix]::before {
    content: "$ ";
    color: var(--green);
  }

  .mockup-code .muted {
    color: var(--terminal-muted);
  }

  .mockup-code .ok {
    color: var(--green);
  }

  .section {
    padding: 132px 0;
  }

  .section-muted {
    background: var(--muted-surface);
    border-block: 1px solid var(--line);
  }

  .section-heading {
    max-width: 610px;
  }

  .section-heading h2 {
    margin-top: 14px;
    font-size: clamp(1.76rem, 4vw, 2.8rem);
    line-height: 1;
    color: var(--ink);
  }

  .section-heading p {
    margin: 19px 0 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
  }

  .course-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 62px;
    gap: 32px;
  }

  .step {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 36px 32px;
    min-height: 280px;
    box-shadow: 0 4px 24px -6px rgba(18, 45, 53, 0.04);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .step:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -10px rgba(18, 45, 53, 0.08);
    border-color: var(--primary);
  }

  .step-number {
    display: grid;
    width: 37px;
    height: 37px;
    place-items: center;
    border-radius: 7px;
    color: #fff !important;
    font:
      600 14px "IBM Plex Mono",
      monospace;
  }

  .step:nth-child(1) .step-number {
    background: var(--red);
  }

  .step:nth-child(2) .step-number {
    background: var(--yellow);
    color: #4b3910 !important;
  }

  .step:nth-child(3) .step-number {
    background: var(--green);
  }

  .step h3 {
    margin-top: 28px;
    font-size: 17px;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .step p,
  .feature p {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  code {
    padding: 3px 6px;
    border-radius: 4px;
    background: var(--primary-soft);
    color: var(--primary-strong);
    font:
      500 12px "IBM Plex Mono",
      monospace;
  }

  .callout {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: 64px;
  }

  /* Mock Browser */
  .mock-browser {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 20px 48px -20px rgba(18, 45, 53, 0.12);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 380px;
    width: 100%;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .mock-browser:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 64px -20px rgba(18, 45, 53, 0.18);
  }

  .browser-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--page) 50%, var(--surface));
  }

  .browser-dots {
    display: flex;
    gap: 6px;
  }

  .browser-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .browser-dot.red {
    background: #e5574b;
  }
  .browser-dot.yellow {
    background: #e5b72d;
  }
  .browser-dot.green {
    background: #2cba70;
  }

  .browser-address {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 4px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  .sim-sidebar {
    width: 130px;
    border-right: 1px solid var(--line);
    background: color-mix(in srgb, var(--page) 15%, var(--surface));
    padding: 24px 14px;
    display: flex;
    flex-direction: column;
