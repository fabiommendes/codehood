---
import HeroScene from "@/components/brand/HeroScene.astro";
import PartyLights from "@/components/brand/PartyLights.astro";
import { C, O, roof, wall } from "@/components/brand/paper";
import Scene from "@/components/brand/Scene.astro";
import type { SceneName } from "@/components/brand/scenes";
import TileWall from "@/components/brand/TileWall.astro";
import CourseTile from "@/components/CourseTile.astro";
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Layout from "@/layouts/Layout.astro";

export const prerender = false;

if (Astro.locals.actor) {
	return Astro.rewrite("/home");
}

/// Each step is marked with a piece of the logo: the C, an o, the house.
const steps = [
	{
		mark: {
			viewBox: "-2 -2 31 40",
			paths: [{ d: C(0, 0), class: "fill-primary" }],
		},
		title: "Scaffold your course",
		body: "creates a course folder with a config file and directories for questions, exams, the calendar and resources. Plain text, yours to version.",
		command: "codehood init",
	},
	{
		mark: {
			viewBox: "-2 -2 28 28",
			paths: [{ d: O(12, 12), class: "fill-error" }],
		},
		title: "Write content your way",
		body: "Questions, exams and resources are files you write in the editor and workflow you already use. No forms, no lock-in.",
	},
	{
		mark: {
			viewBox: "-5 -4 34 38",
			paths: [
				{ d: wall(0, 0), class: "fill-success" },
				{ d: roof(0, 0), class: "fill-secondary" },
			],
		},
		title: "Push, and it's live",
		body: "syncs your changes to the server. Students see them in the browser right away, with no separate publish step.",
		command: "codehood push",
	},
];

const features: { scene: SceneName; title: string; body: string }[] = [
	{
		scene: "lateNight",
		title: "Your course is a Git repository",
		body: "Questions, exams and resources are plain text files on your machine. Diff them, branch them, review them like code. Nothing is locked in a database you can't export.",
	},
	{
		scene: "constellation",
		title: "Write a question once",
		body: "Multiple choice and short answer today, more on the way. A question lives in your course, ready to reuse in the next exam or the next semester.",
	},
];
---

<Layout title="Codehood: run your course like a Git repo">
  <div class="min-h-screen text-base-content">
    <header class="border-b border-base-300">
      <div class="wrap flex items-center justify-between py-3">
        <a href="#top" aria-label="Codehood home"><Logo height={40} /></a>
        <div class="flex items-center gap-2">
          <ThemeToggle />
          <a class="btn btn-primary" href="/login">Log in</a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="wrap grid items-center gap-10 py-14 lg:grid-cols-[1.05fr_1fr] lg:py-20">
        <div>
          <p class="eyebrow">A learning management system for programmers</p>
          <h1 class="mt-4 text-5xl font-bold leading-[1.02] lg:text-6xl">Run your course like a Git repo.</h1>
          <p class="mt-6 max-w-xl text-lg text-base-content/75">
            Write questions, exams and resources as plain text files instead of clicking through web forms. Edit
            locally, push when you're ready, and your students see it in their browser.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a class="btn btn-primary btn-lg" href="/login">Log in</a>
            <a class="link link-hover font-bold" href="#how-it-works">See how it works</a>
            <a class="link link-hover font-bold" href="#join">Have a course code?</a>
          </div>
        </div>

        <div class="relative">
          <HeroScene />
          <div class="terminal card tape tilt-r absolute border border-base-300 -bottom-6 left-2 w-64 p-4 sm:left-6 sm:w-72">
            <pre><span class="prompt">$</span> codehood init
<span class="quiet">created course/</span>
<span class="prompt">$</span> codehood push
<span class="quiet">syncing questions/*.mdq.md</span>
<span class="ok">✓ live for your students</span></pre>
          </div>
        </div>
      </section>

      <section id="how-it-works" class="relative mt-10 overflow-hidden py-24">
        <TileWall seed={3} />
        <div class="wrap relative">
          <div class="card tape tilt-l inline-block bg-base-100 px-7 py-5 shadow-lg">
            <p class="eyebrow">How it works</p>
            <h2 class="mt-2 text-4xl font-bold">Three steps, and you're teaching.</h2>
          </div>
          <div class="mt-12 grid gap-8 md:grid-cols-3">
            {
              steps.map((step, i) => (
                <article class:list={["card tape bg-base-100 p-7 shadow-xl", i % 2 ? "tilt-r" : "tilt-l"]}>
                  <svg class="h-10 w-10" viewBox={step.mark.viewBox} aria-hidden="true">
                    {step.mark.paths.map((p) => (
                      <path d={p.d} class={p.class} />
                    ))}
                  </svg>
                  <p class="eyebrow mt-5">Step {i + 1}</p>
                  <h3 class="mt-1 text-xl font-bold">{step.title}</h3>
                  <p class="mt-3 text-base-content/75">
                    {step.command && <code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-sm">{step.command}</code>}{" "}
                    {step.body}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="wrap grid items-center gap-12 py-20 lg:grid-cols-2">
        <div>
          <p class="eyebrow">For students</p>
          <h2 class="mt-3 text-4xl font-bold">Students just open a browser.</h2>
          <p class="mt-5 max-w-lg text-lg text-base-content/75">
            No CLI required. Students check the calendar, take exams and work through the questions their instructor
            published, like in any web-based LMS. The CLI is there if they want it.
          </p>
          <ul class="mt-8 grid gap-5">
            <li>
              <strong class="font-display text-lg">A home that says what's next</strong>
              <p class="text-base-content/70">What's open now, what's coming this week and what was graded.</p>
            </li>
            <li>
              <strong class="font-display text-lg">Exams in the browser</strong>
              <p class="text-base-content/70">Answers save as they change, with the time left always in view.</p>
            </li>
          </ul>
        </div>

        <div class="card tilt-l bg-base-100 p-6 shadow-lg">
          <div class="flex items-center gap-4">
            <CourseTile seed="/cs101/ada_2026-2" size={56} />
            <div>
              <p class="font-mono text-xs text-base-content/60">cs101 · 2026-2</p>
              <p class="font-display text-xl font-bold">Intro to Computer Science</p>
              <p class="text-sm text-base-content/70">Ada Lovelace · you take this course</p>
            </div>
          </div>
          <div role="tablist" class="tabs tabs-border mt-4">
            <span role="tab" class="tab tab-active">Home</span>
            <span role="tab" class="tab">Exams</span>
            <span role="tab" class="tab">Resources</span>
            <span role="tab" class="tab">Schedule</span>
          </div>
          <ul class="mt-4 grid gap-3">
            <li class="flex items-center gap-3 rounded-field border border-base-300 p-3">
              <span class="badge badge-success">Open now</span>
              <span class="flex-1">Quiz 3 · closes in 2 hours</span>
              <span class="btn btn-primary btn-sm">Start</span>
            </li>
            <li class="flex items-center gap-3 rounded-field border border-base-300 p-3">
              <span class="badge badge-ghost">In 2 days</span>
              <span class="flex-1">Midterm · 10 questions</span>
            </li>
            <li class="flex items-center gap-3 rounded-field border border-base-300 p-3">
              <span class="badge badge-accent">Graded</span>
              <span class="flex-1">Quiz 2 · 8.5 / 10</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="bg-base-100/60 py-20">
        <div class="wrap">
          <p class="eyebrow">Why Codehood</p>
          <h2 class="mt-3 text-4xl font-bold">Built for how you already work.</h2>
          <div class="mt-12 grid gap-12 md:grid-cols-2">
            {
              features.map((f, i) => (
                <article>
                  <div class:list={["tape shadow-lg", i % 2 ? "tilt-r" : "tilt-l"]}>
                    <Scene name={f.scene} />
                  </div>
                  <h3 class="mt-6 text-2xl font-bold">{f.title}</h3>
                  <p class="mt-2 max-w-md text-base-content/75">{f.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="join" class="relative overflow-hidden py-20">
        <TileWall seed={11} />
        <div class="wrap relative">
          <div class="card tape tilt-l bg-base-100 px-8 pb-10 pt-4 shadow-xl">
            <PartyLights />
            <div class="mt-6 flex flex-wrap items-end justify-between gap-8">
              <div>
                <h2 class="text-3xl font-bold">Got a course code?</h2>
                <p class="mt-2 max-w-md text-base-content/75">
                  Codehood is invite-only for now. Type the code your instructor shows in class, or log in if you
                  already have an account.
                </p>
              </div>
              <form method="GET" action="/courses/join" class="flex w-full max-w-md flex-wrap items-end gap-3">
                <fieldset class="fieldset flex-1">
                  <label class="fieldset-legend" for="join-code">Course code</label>
                  <input
                    type="text"
                    id="join-code"
                    name="code"
                    required
                    autocomplete="off"
                    autocapitalize="characters"
                    spellcheck="false"
                    class="input w-full font-mono uppercase tracking-widest"
                  />
                </fieldset>
                <button type="submit" class="btn btn-primary">Join</button>
                <a class="btn btn-ghost" href="/login">Log in</a>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-base-100/60">
      <div class="wrap flex flex-wrap items-center justify-between gap-4 py-8">
        <Logo height={28} />
      </div>
    </footer>
  </div>
</Layout>

<style>
  .wrap {
    width: min(1180px, 100% - 3rem);
    margin-inline: auto;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .terminal {
    background: var(--color-neutral);
    color: var(--color-neutral-content);
    box-shadow: 0 16px 30px -16px rgb(0 0 0 / 0.6);
  }

  .terminal .prompt {
    color: #4aa0ff;
  }

  .terminal .quiet {
    color: #8fb3a4;
  }

  .terminal .ok {
    color: #4cd08a;
  }

  .terminal pre {
    font: 0.85rem/1.7 var(--font-mono);
    white-space: pre-wrap;
  }
</style>
