---
export const prerender = false;

import { actions } from "astro:actions";
import { FULL_ACCESS } from "@/auth/actor";
import Field from "@/components/form/Field";
import FormAlert from "@/components/form/FormAlert";
import PasswordConfirm from "@/components/PasswordConfirm.astro";
import { inviteAccept } from "@/core/schemas";
import { db } from "@/db";
import { actionForm } from "@/forms/form-state";
import { escapeHtml, m } from "@/i18n";
import CenteredLayout from "@/layouts/CenteredLayout.astro";
import { courseHref } from "@/urls";

const { token } = Astro.params;
const viewer = Astro.locals.actor;

const invite = token ? await db.invite.findOne({ token }, FULL_ACCESS) : null;
const isExpired = invite ? invite.expiresAt < new Date() : false;
const isExhausted =
	invite?.maxUses != null ? invite.redemptions >= invite.maxUses : false;
const isValid = Boolean(invite) && !isExpired && !isExhausted;
const course = invite?.courseId
	? await db.course.findOne({ id: invite.courseId }, FULL_ACCESS)
	: null;
const href = course
	? courseHref({
			discipline: course.discipline.slug,
			instructor: course.instructor.username,
			edition: course.edition.slug,
		})
	: null;

const result = Astro.getActionResult(actions.auth.acceptInvite);
if (result && !result.error) {
	return Astro.redirect("/");
}
const joined = Astro.getActionResult(actions.auth.joinWithInvite);
if (joined && !joined.error && href) {
	return Astro.redirect(`${href}?joined`);
}
const joinError = joined?.error;

const isStudentInvite = invite?.invitedRole === "STUDENT";
// Someone logged in joins with the account they have; only a student invite
// to a course can be used that way.
const canJoin =
	viewer !== undefined &&
	isStudentInvite &&
	course !== null &&
	viewer.role === "STUDENT";
const enrollment =
	canJoin && course
		? await db.enrollment.findOne(
				{ course: course.id, username: viewer.username },
				FULL_ACCESS,
			)
		: null;
const alreadyIn = enrollment?.status === "ACTIVE";
const roleHtml = {
	STUDENT: m.auth_invite_role_student(),
	INSTRUCTOR: m.auth_invite_role_instructor(),
	ADMIN: m.auth_invite_role_admin(),
};

const invitedHtml = invite
	? m.auth_invite_invited({
			name: escapeHtml(invite.createdBy.name),
			target: course
				? `<strong>${escapeHtml(course.discipline.name)} (${escapeHtml(course.edition.slug)})</strong>`
				: "Codehood",
			role: roleHtml[invite.invitedRole],
		})
	: "";
const logInHref = `/login?next=${encodeURIComponent(`/invite/${token}`)}`;
const logInLink = `<a class="link link-primary" href="${escapeHtml(logInHref)}">${escapeHtml(m.auth_invite_log_in_to_join())}</a>`;

// GitHub and school id are optional for roles other than student.
const form = await actionForm(Astro, actions.auth.acceptInvite, inviteAccept, {
	id: "accept-invite",
	fields: {
		githubId: {
			label: isStudentInvite
				? m.forms_label_github_username()
				: m.forms_label_github_username_optional(),
		},
		schoolId: {
			label: isStudentInvite
				? m.forms_label_school_id()
				: m.forms_label_school_id_optional(),
		},
	},
});
const email = form.field("email");
---

<CenteredLayout title={canJoin ? m.auth_invite_title_join() : m.auth_invite_title_accept()}>
  {
    !isValid && !alreadyIn && (
      <div role="alert" class="alert alert-error">
        <span>
          {!invite && m.auth_invite_invalid()}
          {invite && isExpired && m.auth_invite_expired()}
          {invite && isExhausted && m.auth_invite_exhausted()}
        </span>
      </div>
    )
  }

  {
    joinError && (
      <div role="alert" class="alert alert-error">
        <span>{joinError.message}</span>
      </div>
    )
  }

  {
    invite && (isValid || alreadyIn) && (
      <p class="text-sm text-base-content/70" set:html={invitedHtml} />
    )
  }

  {
    alreadyIn && href && (
      <>
        <p class="text-sm">{m.auth_invite_already_in()}</p>
        <a href={href} class="btn btn-primary btn-block rounded-full">
          {m.auth_invite_open_course()}
        </a>
      </>
    )
  }

  {
    isValid && canJoin && !alreadyIn && viewer && (
      <form method="POST" action={actions.auth.joinWithInvite} class="flex flex-col gap-4">
        <input type="hidden" name="token" value={token} />
        <p
          class="text-sm"
          set:html={m.auth_invite_logged_in_as({ name: escapeHtml(viewer.name), username: escapeHtml(viewer.username) })}
        />
        <button type="submit" class="btn btn-primary btn-block rounded-full">
          {m.auth_invite_join_course()}
        </button>
      </form>
    )
  }

  {
    isValid && viewer && !canJoin && (
      <>
        <p
          class="text-sm"
          set:html={m.auth_invite_logged_in_nothing_to_add({ name: escapeHtml(viewer.name) })}
        />
        <a href="/" class="btn btn-block rounded-full">{m.auth_invite_go_home()}</a>
      </>
    )
  }

  {
    isValid && invite && !viewer && (
      <>
        {course && isStudentInvite && (
          <p class="text-sm text-base-content/70" set:html={m.auth_invite_have_account({ link: logInLink })} />
        )}

        <form
          method="POST"
          action={actions.auth.acceptInvite}
          class="flex flex-col gap-1"
        >
          <input type="hidden" name="token" value={token} />
          <FormAlert error={form.error} class="mb-2" />

          <Field {...form.field("name")} control={{ autocomplete: "name" }} />
          {
            invite.kind === "PERSONAL" ? (
              <Field
                {...email}
                value={invite.email ?? ""}
                class="bg-base-200 text-base-content/70"
                control={{ autocomplete: "email", readonly: true }}
              />
            ) : (
              <Field {...email} control={{ autocomplete: "email" }} />
            )
          }
          <Field {...form.field("username")} control={{ autocomplete: "username" }} />

          <div class="grid gap-x-3 sm:grid-cols-2">
            <Field {...form.field("password")} control={{ autocomplete: "new-password" }} />
            <PasswordConfirm id="accept-invite-passwordConfirm" />
          </div>

          <div class="grid gap-x-3 sm:grid-cols-2">
            <Field {...form.field("githubId")} required={isStudentInvite} />
            <Field {...form.field("schoolId")} required={isStudentInvite} />
          </div>
          {isStudentInvite && (
            <p class="label whitespace-normal">
              {m.auth_identify_note()}
            </p>
          )}

          <button
            type="submit"
            class="btn btn-primary btn-block mt-4 rounded-full"
          >
            {m.auth_create_account()}
          </button>
        </form>
      </>
    )
  }
</CenteredLayout>
