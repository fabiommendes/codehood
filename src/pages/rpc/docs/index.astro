---
export const prerender = false;

// Same isolated-document reasoning as src/pages/api/docs/index.astro: no
// global.css, because Tailwind's preflight reset strips the default styling
// Swagger UI's own CSS depends on. The vendor assets are shared with that
// page rather than served twice.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RPC Reference — Codehood</title>
    <link rel="icon" href="/api/docs/vendor/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/api/docs/vendor/favicon-16x16.png" sizes="16x16" />
    <link rel="stylesheet" href="/api/docs/vendor/swagger-ui.css" />
    <style>
      body {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div id="swagger-ui"></div>

    <script src="/api/docs/vendor/swagger-ui-bundle.js" is:inline></script>
    <script src="/api/docs/vendor/swagger-ui-standalone-preset.js" is:inline></script>
    <script is:inline>
      window.onload = () => {
        window.ui = SwaggerUIBundle({
          url: "/rpc/docs/openapi.json",
          dom_id: "#swagger-ui",
          presets: [SwaggerUIBundle.presets.apis, SwaggerUIStandalonePreset],
          layout: "StandaloneLayout",
        });
      };
    </script>
  </body>
</html>
