---
import "../styles/fonts.css";
import "../styles/global.css";
import DraftSession from "@/components/exam/DraftSession.astro";
import { locale } from "@/i18n";

interface Props {
	title?: string;
}

const { title = "Codehood" } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<!-- The browser's own chrome takes base-100 of the theme on the page. The
		     media queries hold without JS; the scripts below and in ThemeToggle.astro
		     point both tags at the theme actually shown. -->
		<meta name="theme-color" content="#fffdf8" media="(prefers-color-scheme: light)" data-light="#fffdf8" data-dark="#15302a" />
		<meta name="theme-color" content="#15302a" media="(prefers-color-scheme: dark)" data-light="#fffdf8" data-dark="#15302a" />
		<script is:inline>
			// Runs before first paint to avoid a flash of the wrong theme. Mirrors the
			// resolution logic in ThemeToggle.astro — keep the two in sync.
			(function () {
				try {
					var stored = localStorage.getItem("codehood-theme");
					var theme =
						stored === "codehood" || stored === "codehood-dark"
							? stored
							: window.matchMedia("(prefers-color-scheme: dark)").matches
								? "codehood-dark"
								: "codehood";
					document.documentElement.setAttribute("data-theme", theme);
					document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
						meta.content = theme === "codehood-dark" ? meta.dataset.dark : meta.dataset.light;
					});
				} catch (e) {}
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<DraftSession username={Astro.locals.actor?.username} />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
