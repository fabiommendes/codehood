---
import { actions } from "astro:actions";
import Avatar from "@/components/Avatar.astro";
import Sketch, { type SketchArt } from "@/components/brand/Sketch.astro";
import CourseTile from "@/components/CourseTile.astro";
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { db } from "@/db";
import { courseHref } from "@/urls";
import { homepage, version } from "../../package.json";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
}

const { title } = Astro.props;
const user = Astro.locals.actor;

const nav = [
	{
		label: "Home",
		href: "/",
		icon: "M4 11.5 12 4l8 7.5M6 10v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-9",
	},
	{
		label: "My courses",
		href: "/courses",
		icon: "M4 5.5A2.5 2.5 0 0 1 6.5 3H19a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6.5A2.5 2.5 0 0 0 4 21.5v-16ZM4 17.5A2.5 2.5 0 0 1 6.5 15H20",
	},
	{
		label: "Calendar",
		href: "/calendar",
		icon: "M7 3.5v3M17 3.5v3M4 9h16M5.5 6h13A1.5 1.5 0 0 1 20 7.5v12A1.5 1.5 0 0 1 18.5 21h-13A1.5 1.5 0 0 1 4 19.5v-12A1.5 1.5 0 0 1 5.5 6Z",
	},
	...(user?.role === "ADMIN"
		? [
				{
					label: "Admin",
					href: "/admin",
					icon: "M12 3.5 4.5 6.5v5c0 5 3.2 8.5 7.5 9.5 4.3-1 7.5-4.5 7.5-9.5v-5L12 3.5Z",
				},
			]
		: []),
];

/// Human labels for the role shown in the user menu.
const ROLE_LABEL = {
	STUDENT: "Student",
	INSTRUCTOR: "Instructor",
	ADMIN: "Admin",
} as const;

const courses = user
	? (await db.course.findMany({}, { actor: user })).map((course) => ({
			code: course.discipline.slug,
			edition: course.edition.slug,
			teaching: course.instructor.username === user.username,
			href: courseHref({
				discipline: course.discipline.slug,
				instructor: course.instructor.username,
				edition: course.edition.slug,
			}),
		}))
	: [];

const currentPath = Astro.url.pathname;
function isActive(href: string): boolean {
	// `/` renders the home page by rewrite, so the request path reads `/home`.
	if (href === "/") return currentPath === "/" || currentPath === "/home";
	return currentPath === href || currentPath.startsWith(`${href}/`);
}

/// The drawing at the foot of the sidebar: one per area, and inside a course
/// an Athos panel seeded like the course tile, so each course keeps its own.
function sidebarSketch(): { art: SketchArt; seed?: string } {
	const course = courses.find((c) => isActive(c.href));
	if (course) return { art: "athos", seed: course.href };
	if (isActive("/courses")) return { art: "loose" };
	if (isActive("/calendar")) return { art: "construction" };
	if (isActive("/admin")) return { art: "protractor" };
	const [discipline, edition] = currentPath.split("/").filter(Boolean);
	if (edition?.includes("_"))
		return { art: "athos", seed: `/${discipline}/${edition}` };
	return { art: "blueprint" };
}
---

<Layout title={title ? `${title} — Codehood` : undefined}>
  <div class="flex min-h-screen flex-col">
    <div
      class="navbar sticky top-0 z-30 border-b border-base-300 bg-base-100 p-0"
    >
      <div
        class="navbar-start gap-2 px-4 lg:w-64 lg:shrink-0 lg:border-r lg:border-base-300"
      >
        <label
          for="app-drawer"
          aria-label="Open sidebar"
          class="btn btn-square btn-ghost btn-sm lg:hidden"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path
              d="M4 6h16M4 12h16M4 18h16"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </label>
        <a href="/" class="flex items-center gap-2">
          <Logo height={36} />
        </a>
      </div>
      <div class="navbar-end w-auto flex-1 gap-2 px-4">
        <ThemeToggle />
        {
          user ? (
            <details class="dropdown dropdown-end">
              <summary class="btn btn-ghost h-auto min-h-10 gap-2 px-2 py-1 font-normal">
                <Avatar username={user.username} size={32} />
                <span class="hidden text-left leading-tight sm:grid">
                  <span class="font-semibold">{user.name}</span>
                  <span class="text-xs text-base-content/70">{ROLE_LABEL[user.role]}</span>
                </span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <ul class="menu dropdown-content z-40 mt-2 w-56 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
                <li class="menu-title flex-row items-center gap-3 px-3 pt-1 pb-2 font-normal text-base-content">
                  <Avatar username={user.username} size={36} />
                  <span class="grid leading-tight">
                    <span class="font-semibold">{user.name}</span>
                    <span class="text-xs text-base-content/60">@{user.username}</span>
                  </span>
                </li>
                <li>
                  <a href="/profile">Profile</a>
                </li>
                <li>
                  <a href="/getting-started">Set up the CLI</a>
                </li>
                <li>
                  <form method="POST" action={actions.auth.logout} class="p-0">
                    <button type="submit" class="w-full px-3 py-1.5 text-left">
                      Log out
                    </button>
                  </form>
                </li>
              </ul>
            </details>
          ) : (
            <a href="/login" class="btn btn-primary btn-sm rounded-full">
              Log in
            </a>
          )
        }
      </div>
    </div>

    <div class="drawer lg:drawer-open flex-1">
      <input
        id="app-drawer"
        type="checkbox"
        class="drawer-toggle"
        autocomplete="off"
      />

      <div class="drawer-content relative flex flex-col bg-base-100">
        <div
          class="pointer-events-none absolute inset-x-0 top-0 z-0 h-64 bg-gradient-to-b from-base-200 to-transparent"
        >
        </div>
        <div class="relative z-10 flex-1">
          <slot />
        </div>
        <footer
          class="relative z-10 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-base-300 px-6 py-3 text-sm text-base-content/60"
        >
          <Logo height={22} />
          <a href={homepage} class="hover:text-primary">Source code</a>
          {
            import.meta.env.DEV && (
              <a href="/design" class="hover:text-primary">
                Design system
              </a>
            )
          }
          <span class="ml-auto font-mono text-xs">v{version}</span>
        </footer>
      </div>

      <div class="drawer-side top-16 z-20 h-[calc(100vh-4rem)] overflow-hidden">
        <label
          for="app-drawer"
          aria-label="Close sidebar"
          class="drawer-overlay"></label>
        <div class="flex h-full w-64 flex-col border-r border-base-300 bg-base-100">
          <ul class="menu min-h-0 w-full flex-1 flex-nowrap gap-1 overflow-y-auto p-4">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                      "gap-3 hover:bg-base-200",
                      isActive(item.href)
                        ? "bg-base-200 font-semibold text-primary"
                        : "text-base-content",
                    ]}
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                      class:list={[!isActive(item.href) && "opacity-60"]}
                    >
                      <path
                        d={item.icon}
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {item.label}
                  </a>
                </li>
              ))
            }

            {courses.length > 0 && <li class="menu-title mt-4">Courses</li>}
            {
              courses.map((course) => (
                <li>
                  <a
                    href={course.href}
                    aria-current={isActive(course.href) ? "page" : undefined}
                    class:list={[
                      "gap-3 text-base-content hover:bg-base-200",
                      isActive(course.href) && "bg-base-200 font-semibold",
                    ]}
                  >
                    <CourseTile seed={course.href} size={18} class="ring-1 ring-base-300" />
                    <span class="flex-1 truncate">
                      <span class="font-mono">{course.code}</span>
                      <span class="text-base-content/60"> · {course.edition}</span>
                    </span>
                    {course.teaching && <span class="badge badge-ghost badge-xs">teaching</span>}
                  </a>
                </li>
              ))
            }
          </ul>
          <Sketch {...sidebarSketch()} class="shrink-0 px-2 pb-2" />
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Generic opener for any <dialog> on the page: a trigger carries
  // data-open-dialog="<id>" and this wires it up, so pages (and the
  // components they render, like Table-driven admin lists) don't each
  // repeat the same three lines.
  document
    .querySelectorAll<HTMLButtonElement>("[data-open-dialog]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.openDialog;
        const dialog = id ? document.getElementById(id) : null;
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    });
</script>
