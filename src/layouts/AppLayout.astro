---
import Logo from "@/components/Logo.astro";
import AppFooter from "@/components/nav/AppFooter.astro";
import AppSidebar from "@/components/nav/AppSidebar.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import PencilFilter from "@/components/nav/PencilFilter.astro";
import UserMenu from "@/components/nav/UserMenu.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { db } from "@/db";
import { m } from "@/i18n";
import { courseHref } from "@/urls";
import { breadcrumbs, type Crumb } from "@/utils/breadcrumbs";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	/// The breadcrumb in the top bar; defaults to the trail built from the URL
	/// and `title`.
	trail?: readonly Crumb[];
}

const { title, trail } = Astro.props;
const crumbs = trail ?? breadcrumbs(Astro.url, { page: title });
const user = Astro.locals.actor;

const courses = user
	? (await db.course.findMany({}, { actor: user })).map((course) => ({
			code: course.discipline.slug,
			edition: course.edition.slug,
			teaching: course.instructor.username === user.username,
			href: courseHref({
				discipline: course.discipline.slug,
				instructor: course.instructor.username,
				edition: course.edition.slug,
			}),
		}))
	: [];
---

<Layout title={title ? m.nav_page_title({ title }) : undefined}>
  <PencilFilter />
  <div class="flex min-h-screen flex-col">
    <div
      class="navbar sticky top-0 z-30 border-b border-base-300 bg-base-100 p-0"
    >
      <div
        class="navbar-start gap-2 px-4 lg:w-64 lg:shrink-0 lg:justify-center lg:self-stretch lg:border-r lg:border-base-300"
      >
        <label
          for="app-drawer"
          aria-label={m.nav_open_sidebar()}
          class="btn btn-square btn-ghost btn-sm lg:hidden"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path
              d="M4 6h16M4 12h16M4 18h16"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </label>
        <a
          href="/"
          class="absolute left-1/2 flex -translate-x-1/2 items-center lg:static lg:translate-x-0"
        >
          <Logo height={36} class="h-8 w-auto lg:h-9" />
        </a>
      </div>
      <div class="navbar-end w-auto min-w-0 flex-1 gap-2 pr-5.5 pl-4 lg:px-4">
        <Breadcrumbs trail={crumbs} />
        <div class="flex shrink-0 items-center gap-2">
          <ThemeToggle class={user ? "hidden lg:inline-flex" : undefined} />
          {
            user ? (
              <UserMenu user={user} />
            ) : (
              <a href="/login" class="btn btn-primary btn-sm rounded-full">
                {m.nav_log_in()}
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div class="drawer lg:drawer-open flex-1">
      <input
        id="app-drawer"
        type="checkbox"
        class="drawer-toggle"
        autocomplete="off"
      />

      <div class="drawer-content relative flex flex-col bg-base-100">
        <div
          class="pointer-events-none absolute inset-x-0 top-0 z-0 h-64 bg-gradient-to-b from-base-200 to-transparent"
        >
        </div>
        <div class="relative z-10 flex-1">
          <slot />
        </div>
        <AppFooter class="relative z-10 px-6" />
      </div>

      <div class="drawer-side top-16 z-20 h-[calc(100vh-4rem)] overflow-hidden">
        <label
          for="app-drawer"
          aria-label={m.nav_close_sidebar()}
          class="drawer-overlay"></label>
        <AppSidebar
          courses={courses}
          currentPath={Astro.url.pathname}
          admin={user?.role === "ADMIN"}
        />
      </div>
    </div>
  </div>
</Layout>

<script>
  // Generic opener for any <dialog> on the page: a trigger carries
  // data-open-dialog="<id>" and this wires it up, so pages (and the
  // components they render, like Table-driven admin lists) don't each
  // repeat the same three lines.
  document
    .querySelectorAll<HTMLButtonElement>("[data-open-dialog]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.openDialog;
        const dialog = id ? document.getElementById(id) : null;
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    });
</script>
