---
import GlassWall from "@/components/brand/GlassWall.astro";
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { m } from "@/i18n";
import Layout from "./Layout.astro";

interface Props {
	title: string;
	/// For a form people fill in at work, such as the check-in in class: no tile
	/// wall behind the card, and no tape on it.
	quiet?: boolean;
}

const { title, quiet = false } = Astro.props;
---

<Layout title={m.nav_page_title({ title })}>
  <main class="relative isolate flex min-h-screen items-center justify-center overflow-hidden bg-base-200 p-4 py-12">
    {!quiet && <GlassWall class="-z-10" />}
    <ThemeToggle class="absolute top-4 right-4 z-10" />
    <div class:list={["card card-border w-full max-w-sm bg-base-100", quiet ? "shadow-sm" : "tape shadow-xl"]}>
      <div class="card-body">
        <a href="/" class="mb-2">
          <Logo height={34} />
        </a>
        <h2 class="card-title">{title}</h2>
        <slot />
      </div>
    </div>
  </main>
</Layout>
