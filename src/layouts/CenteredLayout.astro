---
import TileWall from "@/components/brand/TileWall.astro";
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Layout from "./Layout.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<Layout title={`${title} — Codehood`}>
  <main class="relative isolate flex min-h-screen items-center justify-center overflow-hidden bg-base-200 p-4 py-12">
    <TileWall seed={7} class="-z-10" />
    <ThemeToggle class="absolute top-4 right-4 z-10" />
    <div class="card card-border tape w-full max-w-sm bg-base-100 shadow-xl">
      <div class="card-body">
        <a href="/" class="mb-2">
          <Logo height={34} />
        </a>
        <h2 class="card-title">{title}</h2>
        <slot />
      </div>
    </div>
  </main>
</Layout>
