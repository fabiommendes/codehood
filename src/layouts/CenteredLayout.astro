---
import TileWall from "@/components/brand/TileWall.astro";
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { m } from "@/i18n";
import Layout from "./Layout.astro";

interface Props {
	title: string;
	/// For a form people fill in at work, such as the check-in in class: the
	/// tile wall shrinks to a single row along the top and the card loses its tape.
	quiet?: boolean;
}

const { title, quiet = false } = Astro.props;
---

<Layout title={m.nav_page_title({ title })}>
  <main class="relative isolate flex min-h-screen items-center justify-center overflow-hidden bg-base-200 p-4 py-12">
    {
      quiet ? (
        <div class="absolute inset-x-0 top-0 -z-10 h-10 border-b border-base-300 md:h-15">
          <TileWall seed={7} />
        </div>
      ) : (
        <TileWall seed={7} class="-z-10" />
      )
    }
    <ThemeToggle class:list={["absolute right-4 z-10", quiet ? "top-12 md:top-17" : "top-4"]} />
    <div class:list={["card card-border w-full max-w-sm bg-base-100", quiet ? "shadow-sm" : "tape shadow-xl"]}>
      <div class="card-body">
        <a href="/" class="mb-2">
          <Logo height={34} />
        </a>
        <h2 class="card-title">{title}</h2>
        <slot />
      </div>
    </div>
  </main>
</Layout>
