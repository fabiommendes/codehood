---
import Link from "@/components/Link.astro";
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Tabs from "@/components/ui/Tabs.astro";
import { urls } from "@/urls";
import Layout from "./Layout.astro";

interface Props {
	title: string;
	active:
		| "overview"
		| "brand"
		| "motifs"
		| "typography"
		| "colors"
		| "layouts"
		| "elements"
		| "questions"
		| "forms"
		| "components"
		| "playground";
}

const { title, active } = Astro.props;

const tabs = [
	{ key: "overview", label: "Overview", href: urls.design.index() },
	{ key: "brand", label: "Brand", href: urls.design.brand() },
	{ key: "motifs", label: "Motifs", href: urls.design.motifs() },
	{ key: "themes", label: "Themes", href: urls.design.themes() },
	{ key: "typography", label: "Typography", href: urls.design.typography() },
	{ key: "colors", label: "Colors", href: urls.design.colors() },
	{ key: "layouts", label: "Layouts", href: urls.design.layouts.index() },
	{ key: "elements", label: "Elements", href: urls.design.elements() },
	{ key: "questions", label: "Questions", href: urls.design.questions() },
	{ key: "forms", label: "Forms", href: urls.design.forms() },
	{
		key: "components",
		label: "Components",
		href: urls.design.components.index(),
	},
	{ key: "playground", label: "Playground", href: urls.design.playground() },
] as const;
---

<Layout title={`Design: ${title} — Codehood`}>
  <div class="border-b border-edge bg-base-100">
    <div class="navbar mx-auto max-w-5xl px-4">
      <div class="navbar-start">
        <Link href={urls.root()} class="flex items-center gap-2">
          <Logo height={30} />
        </Link>
        <span class="badge badge-outline ml-3">design system</span>
      </div>
      <div class="navbar-end">
        <ThemeToggle />
      </div>
    </div>
    <div class="mx-auto max-w-5xl px-4 [&_[role=tablist]]:mb-0">
      <Tabs items={tabs} active={active} />
    </div>
  </div>
  <main class="mx-auto max-w-5xl px-4 py-10">
    <slot />
  </main>
</Layout>
