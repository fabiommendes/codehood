# Codehood behind nginx.
#
# Blobs are content-addressed and served straight off disk; everything else is
# proxied to the Astro server. Copy into /etc/nginx/sites-available/ and adjust
# the domain, the upstream address and the blob root.
#
# URL shape:   /files/<hash>/<filename>        (or /files/<hash> for the raw blob)
# Disk layout: <RESOURCE_ROOT>/<hash[0:2]>/<hash>/<hash>      the bytes
#              <RESOURCE_ROOT>/<hash[0:2]>/<hash>/<filename>  link per attachment
#
# The per-attachment links carry the real filename and therefore a real
# extension, so nginx derives Content-Type from its own mime.types and
# Codehood ships no mime map of its own. Content-Disposition is deliberately
# absent: the browser picks inline-vs-download from the type and takes the
# download name from the URL's last segment, which is already the filename.
#
# One type nginx does not know is the question format. Add it to your
# mime.types (it cannot be extended from here -- a `types` block in a location
# replaces the inherited table rather than adding to it):
#
#     text/markdown  md mdq;
#
# ATTACHMENT_LINK_MODE=symlink (the default) needs symlink following, which is
# nginx's default. Do not set `disable_symlinks on` for this location, or
# switch Codehood to ATTACHMENT_LINK_MODE=hardlink.

upstream codehood_app {
	server 127.0.0.1:4321;
}

server {
	listen 443 ssl http2;
	server_name codehood.example.com;

	ssl_certificate     /etc/letsencrypt/live/codehood.example.com/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/codehood.example.com/privkey.pem;

	# Uploads arrive as multipart/form-data on the resource endpoints. Keep
	# this at or above the largest per-role quota.
	client_max_body_size 1g;

	# The URL is the content's own hash, so the bytes can never change.
	# SVG can carry script; the CSP is what makes serving it inline safe.
	add_header Cache-Control           "public, max-age=31536000, immutable";
	add_header X-Content-Type-Options  "nosniff";
	add_header Content-Security-Policy "default-src 'none'; sandbox";

	# /files/ab/abcdef.../handout.pdf -> /ab/abcdef.../handout.pdf
	location ~ "^/files/([0-9a-f]{2})([0-9a-f]{62})/(.+)$" {
		alias /srv/codehood/storage/resources/$1/$1$2/$3;
		# A miss falls through to the app, which answers 410 with an
		# explanation for a tombstoned blob and 404 for an unknown hash.
		try_files "" @app;
	}

	# /files/ab/abcdef... -> the canonical, unnamed blob
	location ~ "^/files/([0-9a-f]{2})([0-9a-f]{62})$" {
		alias /srv/codehood/storage/resources/$1/$1$2/$1$2;
		default_type application/octet-stream;
		try_files "" @app;
	}

	location @app {
		proxy_pass         http://codehood_app;
		proxy_set_header   Host $host;
		proxy_set_header   X-Real-IP $remote_addr;
		proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header   X-Forwarded-Proto $scheme;
	}

	location / {
		proxy_pass         http://codehood_app;
		proxy_set_header   Host $host;
		proxy_set_header   X-Real-IP $remote_addr;
		proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header   X-Forwarded-Proto $scheme;
	}
}

server {
	listen 80;
	server_name codehood.example.com;
	return 301 https://$host$request_uri;
}
